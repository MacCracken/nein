# Bundle-consumability guard (1.6.2): a host (daimon) supplies bote +
# sigil + stdlib, then consumes nein's opt-in dist/nein-mcp.cyr and drives
# the firewall tools through the dispatch adapter. If the [lib.mcp] bundle
# drifts (missing a module, or nein-mcp.cyr not regenerated) this fails at
# CI. Pure/no-nft: only nein_validate + the tool table + unknown-tool path
# are exercised (the live tools need root+nft, covered by apply_smoke).

include "lib/thread.cyr"
include "lib/thread_local.cyr"
include "lib/sigil.cyr"
include "lib/bote-core.cyr"
include "dist/nein-mcp.cyr"

# A host gate under the 1.9.0 contract: permit the offline tool only — or,
# with _smoke_deny_all set, nothing, so a denial proves the gate was asked
# (with no gate at all, the offline tool would run).
var _smoke_deny_all = 0;
fn _smoke_gate(name: cstring, claims: i64): i64 {
    if (_smoke_deny_all == 1) { return 0; }
    if (nein_tool_class(nein_tool_index(name)) == NEIN_TOOL_OFFLINE) { return NEIN_GATE_PERMIT; }
    return 0;
}

fn test_consume() {
    test_group("mcp_consume");

    # tool table is present in the bundle
    assert_eq(nein_tool_count(), 6, "bundle exposes 6-tool table");
    assert(streq(nein_tool_name(0), "nein_status") == 1, "bundle tool 0 = nein_status");
    assert_eq(nein_tool_read_only(1), 0, "bundle: nein_allow mutating");

    # dispatch adapter routes a pure tool through the bundle
    var ok = nein_mcp_dispatch("nein_validate", "{\"protocol\":\"tcp\",\"port\":443}", 0);
    assert(str_contains_cstr(str_from(ok), "\"isError\":false") == 1, "bundle dispatch validate ok");
    assert(str_contains_cstr(str_from(ok), "valid") == 1, "bundle dispatch validate -> valid");

    var bad = nein_mcp_dispatch("nein_validate", "{\"port\":443}", 0);
    assert(str_contains_cstr(str_from(bad), "\"isError\":true") == 1, "bundle dispatch bad input errs");

    var unk = nein_mcp_dispatch("bogus_tool", "{}", 0);
    assert(str_contains_cstr(str_from(unk), "unknown nein tool") == 1, "bundle dispatch unknown errs");

    # signing surface is in the bundle too (sign a body, verify round-trip)
    var sk = alloc(64);
    var pk = alloc(32);
    assert(sign_keygen(sk, pk) == 1, "bundle sign_keygen ok");
    var body = str_from("table inet filter { }");
    var sr_t, sr_v = sign_ruleset_body(body, sk, "smoke");
    assert(is_err_result(sr_t) == 0, "bundle sign_ruleset_body ok");
    assert(is_err_result(verify_ruleset(sr_v, pk)) == 0, "bundle verify round-trips");

    # 1.9.0 surface: tool classes, the no-gate default, the gate contract, and
    # the replay-bound v2 envelope — all reachable through the bundle.
    assert_eq(nein_tool_class(nein_tool_index("nein_list")), NEIN_TOOL_READS_LIVE, "bundle: nein_list reads live");
    var ng = nein_mcp_dispatch("nein_status", "{}", 0);
    assert(str_contains_cstr(str_from(ng), "no host gate installed") == 1, "bundle: ungated status denied");
    assert_eq(nein_mcp_set_gate(&_smoke_gate), 0, "bundle: gate installs");
    _smoke_deny_all = 1;
    var gd = nein_mcp_dispatch("nein_validate", "{\"protocol\":\"tcp\",\"port\":443}", 0);
    assert(str_contains_cstr(str_from(gd), "tool gated by host policy") == 1, "bundle: the gate is consulted");
    assert_eq(nein_mcp_set_gate(0), 1, "bundle: gate cannot be cleared");
    var gd2 = nein_mcp_dispatch("nein_validate", "{\"protocol\":\"tcp\",\"port\":443}", 0);
    assert(str_contains_cstr(str_from(gd2), "tool gated by host policy") == 1, "bundle: the gate survives a refused clear");
    _smoke_deny_all = 0;
    var gv = nein_mcp_dispatch("nein_validate", "{\"protocol\":\"tcp\",\"port\":443}", 0);
    assert(str_contains_cstr(str_from(gv), "\"isError\":false") == 1, "bundle: gate permits validate");
    var v2_t, v2_v = sign_ruleset_body_v2(body, sk, "smoke", "host-1", 3, 0);
    assert(is_err_result(v2_t) == 0, "bundle sign_ruleset_body_v2 ok");
    var vv_t, vv_v = verify_ruleset_v2(v2_v, pk, "host-1", 3, 1800000000);
    assert(is_err_result(vv_t) == 0 && vv_v == 3, "bundle v2 verify returns the seq");

    return 0;
}

fn main() {
    alloc_init();
    test_consume();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
