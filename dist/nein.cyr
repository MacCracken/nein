}

# --- Ipv6ExtHdr ---
fn cfg_parse_ipv6_ext_hdr(s: cstring): i64 {
    if (streq(s, "hbh") == 1) { return EXT_HOP_BY_HOP; }
    if (streq(s, "rt") == 1) { return EXT_ROUTING; }
    if (streq(s, "frag") == 1) { return EXT_FRAGMENT; }
    if (streq(s, "dst") == 1) { return EXT_DESTINATION; }
    if (streq(s, "mh") == 1) { return EXT_MOBILITY; }
    if (streq(s, "auth") == 1) { return EXT_AUTH; }
    return _cfg_unknown();
}

# --- CmpOp ---
fn cfg_parse_cmp_op(s: cstring): i64 {
    if (s == 0) { return _cfg_unknown(); }   # NULL (1.8.2, audit B-10: was strlen(0))
    if (streq(s, "==") == 1) { return NFT_CMP_EQ; }
    if (streq(s, "!=") == 1) { return NFT_CMP_NE; }
    if (streq(s, "<") == 1) { return NFT_CMP_LT; }
    if (streq(s, ">") == 1) { return NFT_CMP_GT; }
    if (streq(s, "<=") == 1) { return NFT_CMP_LE; }
    if (streq(s, ">=") == 1) { return NFT_CMP_GE; }
    return _cfg_unknown();
}

# --- LogLevel ---
fn cfg_parse_log_level(s: cstring): i64 {
    if (s == 0) { return _cfg_unknown(); }   # NULL (1.8.2, audit B-10: was strlen(0))
    if (streq(s, "emerg") == 1) { return NFT_LOG_EMERG; }
    if (streq(s, "alert") == 1) { return NFT_LOG_ALERT; }
    if (streq(s, "crit") == 1) { return NFT_LOG_CRIT; }
    if (streq(s, "err") == 1) { return NFT_LOG_ERR; }
    if (streq(s, "warn") == 1) { return NFT_LOG_WARN; }
    if (streq(s, "notice") == 1) { return NFT_LOG_NOTICE; }
    if (streq(s, "info") == 1) { return NFT_LOG_INFO; }
    if (streq(s, "debug") == 1) { return NFT_LOG_DEBUG; }
    return _cfg_unknown();
}

# --- RejectReason ---
fn cfg_parse_reject_reason(s: cstring): i64 {
    if (s == 0) { return _cfg_unknown(); }   # NULL (1.8.2, audit B-10: was strlen(0))
    if (streq(s, "icmp-host-unreachable") == 1) { return REJECT_ICMP_HOST_UNREACH; }
    if (streq(s, "icmp-port-unreachable") == 1) { return REJECT_ICMP_PORT_UNREACH; }
    if (streq(s, "icmp-net-unreachable") == 1) { return REJECT_ICMP_NET_UNREACH; }
    if (streq(s, "icmp-admin-prohibited") == 1) { return REJECT_ICMP_ADMIN_PROHIB; }
    if (streq(s, "icmpx-admin-prohibited") == 1) { return REJECT_ICMPX_ADMIN_PROHIB; }
    if (streq(s, "tcp-reset") == 1) { return REJECT_TCP_RESET; }
    return _cfg_unknown();
}

# --- SetType ---
fn cfg_parse_set_type(s: cstring): i64 {
    if (s == 0) { return _cfg_unknown(); }   # NULL (1.8.2, audit B-10: was strlen(0))
    if (streq(s, "ipv4_addr") == 1) { return SET_IPV4_ADDR; }
    if (streq(s, "ipv6_addr") == 1) { return SET_IPV6_ADDR; }
    if (streq(s, "inet_service") == 1) { return SET_INET_SERVICE; }
    if (streq(s, "inet_proto") == 1) { return SET_INET_PROTO; }
    if (streq(s, "ifname") == 1) { return SET_IFNAME; }
    return _cfg_unknown();
}

# --- SetFlag ---
fn cfg_parse_set_flag(s: cstring): i64 {
    if (s == 0) { return _cfg_unknown(); }   # NULL (1.8.2, audit B-10: was strlen(0))
    if (streq(s, "constant") == 1) { return SETFLAG_CONSTANT; }
    if (streq(s, "interval") == 1) { return SETFLAG_INTERVAL; }
    if (streq(s, "timeout") == 1) { return SETFLAG_TIMEOUT; }
    return _cfg_unknown();
}

# --- Transport (engine) ---
fn cfg_parse_transport(s: cstring): i64 {
    if (s == 0) { return _cfg_unknown(); }   # NULL (1.8.2, audit B-10: was strlen(0))
    if (streq(s, "tcp") == 1) { return TRANS_TCP; }
    if (streq(s, "udp") == 1) { return TRANS_UDP; }
    if (streq(s, "quic") == 1) { return TRANS_QUIC; }
    return _cfg_unknown();
}

# --- Helper: wrap result as Result<int, NEIN_ERR_PARSE> ---
# Useful when a parse function wants consistent error handling
fn cfg_result(v: i64): i64 {
    if (v < 0) { return nein_err(NEIN_ERR_PARSE); }
    return Ok(v);
}

# --- netns.cyr ---

# nein netns module — network namespace firewall builder
#
# Builds a Firewall tailored for agent network namespaces (input/output
# chains, established tracking, loopback, optional DNS). The actual
# apply-to-namespace side lives outside nein:
# `netns_apply_nftables_ruleset(handle, ruleset)` (agnosys, now agnodrm) —
# consumers vendor that module and hand it the ruleset text.
#
# ⚠ Hand it `firewall_render_checked(nsf_build(nsf))`, NOT `firewall_render`
# (1.8.2, audit I-5 / S-7). This header used to say `firewall_render(fw)`,
# which never validates — and nothing else on that path does either, so an
# agent name such as `agent7" accept ; flush ruleset ; #` reached nft text and
# let the agent flush its own namespace firewall. The checked render returns
# the validation Err instead.
#
# This module stays lean (builder only) so the core nein library doesn't
# transitively drag in agnosys's full netns implementation.

# ================================================================
# NamespaceFirewall — builder state
# Layout:
#   [agent_name:8][inbound:8][outbound:8][outbound_hosts:8]
#   [allow_established:8][allow_loopback:8][allow_dns:8]
#   [inbound_policy:8][outbound_policy:8]
# = 9 * 8 = 72 bytes
# ================================================================

fn namespace_firewall_new(agent_name: cstring): i64 {
    var nsf = alloc(72);
    store64(nsf, agent_name);
    store64(nsf + 8, vec_new());      # allowed_inbound
    store64(nsf + 16, vec_new());     # allowed_outbound
    store64(nsf + 24, vec_new());     # allowed_outbound_hosts
    store64(nsf + 32, 1);             # allow_established (default on)
    store64(nsf + 40, 1);             # allow_loopback (default on)
    store64(nsf + 48, 1);             # allow_dns (default on)
    store64(nsf + 56, POLICY_DROP);   # inbound_policy (default drop)
    store64(nsf + 64, POLICY_ACCEPT); # outbound_policy (default accept)
    return nsf;
}

fn nsf_agent_name(nsf: i64): i64 { return load64(nsf); }
fn nsf_inbound(nsf: i64): i64 { return load64(nsf + 8); }
fn nsf_outbound(nsf: i64): i64 { return load64(nsf + 16); }
fn nsf_outbound_hosts(nsf: i64): i64 { return load64(nsf + 24); }
fn nsf_allow_established(nsf: i64): i64 { return load64(nsf + 32); }
fn nsf_allow_loopback(nsf: i64): i64 { return load64(nsf + 40); }
fn nsf_allow_dns(nsf: i64): i64 { return load64(nsf + 48); }
fn nsf_inbound_policy(nsf: i64): i64 { return load64(nsf + 56); }
fn nsf_outbound_policy(nsf: i64): i64 { return load64(nsf + 64); }

fn nsf_allow_inbound(nsf: i64, ps: i64): i64 { vec_push(load64(nsf + 8), ps); return nsf; }
fn nsf_allow_outbound(nsf: i64, ps: i64): i64 { vec_push(load64(nsf + 16), ps); return nsf; }
fn nsf_allow_outbound_host(nsf: i64, cidr: cstring): i64 { vec_push(load64(nsf + 24), cidr); return nsf; }
fn nsf_set_inbound_policy(nsf: i64, p: i64): i64 { store64(nsf + 56, p); return nsf; }
fn nsf_set_outbound_policy(nsf: i64, p: i64): i64 { store64(nsf + 64, p); return nsf; }
fn nsf_no_established(nsf: i64): i64 { store64(nsf + 32, 0); return nsf; }
fn nsf_no_loopback(nsf: i64): i64 { store64(nsf + 40, 0); return nsf; }
fn nsf_no_dns(nsf: i64): i64 { store64(nsf + 48, 0); return nsf; }

# ================================================================
# Comment builders
# ================================================================

fn _nsf_cstr_from_sb(sb: i64): cstring {
    var s = str_builder_build(sb);
    var out = alloc(str_len(s) + 1);
    memcpy(out, str_data(s), str_len(s));
    store8(out + str_len(s), 0);
    return out;
}

# "AGENT loopback"
fn _nsf_loopback_comment(agent_name: cstring): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, agent_name);
    str_builder_add_cstr(sb, " loopback");
    return _nsf_cstr_from_sb(sb);
}

# "AGENT loopback out"
fn _nsf_loopback_out_comment(agent_name: cstring): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, agent_name);
    str_builder_add_cstr(sb, " loopback out");
    return _nsf_cstr_from_sb(sb);
}

# "AGENT dns"
fn _nsf_dns_comment(agent_name: cstring): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, agent_name);
    str_builder_add_cstr(sb, " dns");
    return _nsf_cstr_from_sb(sb);
}

# "AGENT DIR PROTO:PORT"
fn _nsf_port_comment(agent_name: cstring, direction: cstring, protocol: i64, port: i64): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, agent_name);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, direction);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, _proto_str(protocol));
    str_builder_add_cstr(sb, ":");
    str_builder_add_int(sb, port);
    return _nsf_cstr_from_sb(sb);
}

# "AGENT outbound PROTO:PORT -> HOST"
fn _nsf_outbound_host_comment(agent_name: cstring, protocol: i64, port: i64, host: cstring): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, agent_name);
    str_builder_add_cstr(sb, " outbound ");
    str_builder_add_cstr(sb, _proto_str(protocol));
    str_builder_add_cstr(sb, ":");
    str_builder_add_int(sb, port);
    str_builder_add_cstr(sb, " -> ");
    str_builder_add_cstr(sb, host);
    return _nsf_cstr_from_sb(sb);
}

# ================================================================
# Build the Firewall
# ================================================================

fn nsf_build(nsf: i64): i64 {
    var fw = firewall_new();
    var t = table_new("agnos_agent", FAMILY_INET);
    var agent_name = nsf_agent_name(nsf);

    # Input chain
    var input = chain_base("input", CHAIN_FILTER, HOOK_INPUT, 0, nsf_inbound_policy(nsf));

    if (nsf_allow_established(nsf) == 1) {
        chain_add_rule(input, allow_established());
    }
    if (nsf_allow_loopback(nsf) == 1) {
        var r = rule_new(verdict_accept());
        rule_add_match(r, match_iif("lo"));
        rule_set_comment(r, _nsf_loopback_comment(agent_name));
        chain_add_rule(input, r);
    }

    var in_specs = nsf_inbound(nsf);
    var ilen = vec_len(in_specs);
    var i = 0;
    while (i < ilen) {
        var ps = vec_get(in_specs, i);
        var r = rule_new(verdict_accept());
        rule_add_match(r, match_protocol(ps_protocol(ps)));
        rule_add_match(r, match_dport(ps_port(ps)));
        rule_set_comment(r, _nsf_port_comment(agent_name, "inbound", ps_protocol(ps), ps_port(ps)));
        chain_add_rule(input, r);
        i = i + 1;
    }

    # Output chain
    var output = chain_base("output", CHAIN_FILTER, HOOK_OUTPUT, 0, nsf_outbound_policy(nsf));

    if (nsf_allow_established(nsf) == 1) {
        chain_add_rule(output, allow_established());
    }
    if (nsf_allow_loopback(nsf) == 1) {
        var r = rule_new(verdict_accept());
        rule_add_match(r, match_oif("lo"));
        rule_set_comment(r, _nsf_loopback_out_comment(agent_name));
        chain_add_rule(output, r);
    }
    if (nsf_allow_dns(nsf) == 1) {
        var r = rule_new(verdict_accept());
        rule_add_match(r, match_protocol(PROTO_UDP));
        rule_add_match(r, match_dport(53));
        rule_set_comment(r, _nsf_dns_comment(agent_name));
        chain_add_rule(output, r);
    }

    var out_specs = nsf_outbound(nsf);
    var olen = vec_len(out_specs);
    var hosts = nsf_outbound_hosts(nsf);
    var hlen = vec_len(hosts);
    i = 0;
    while (i < olen) {
        var ps = vec_get(out_specs, i);
        if (hlen > 0) {
            # One rule per (port, host) pair
            var j = 0;
            while (j < hlen) {
                var host = vec_get(hosts, j);
                var r = rule_new(verdict_accept());
                rule_add_match(r, match_protocol(ps_protocol(ps)));
                rule_add_match(r, match_dport(ps_port(ps)));
                rule_add_match(r, _match_addr(host, 1));
                rule_set_comment(r, _nsf_outbound_host_comment(agent_name, ps_protocol(ps), ps_port(ps), host));
                chain_add_rule(output, r);
                j = j + 1;
            }
        } else {
            var r = rule_new(verdict_accept());
            rule_add_match(r, match_protocol(ps_protocol(ps)));
            rule_add_match(r, match_dport(ps_port(ps)));
            rule_set_comment(r, _nsf_port_comment(agent_name, "outbound", ps_protocol(ps), ps_port(ps)));
            chain_add_rule(output, r);
        }
        i = i + 1;
    }

    table_add_chain(t, input);
    table_add_chain(t, output);
    firewall_add_table(fw, t);
    return fw;
}

# --- apply.cyr ---

# nein apply module — execute nftables rules via the nft command
#
# Uses fork+execve to spawn `nft -f -` with the ruleset staged in a memfd on
# its stdin (1.8.2; through 1.8.1 a pipe). Synchronous, with a deadline.
# nft's stderr goes to a second memfd and is logged on failure.

# ================================================================
# nft binary path — pinned, configurable, no PATH consultation
# ================================================================
#
# v1.4.0 hardening (threat-model T-3): the nft subprocess is always
# launched via an *absolute* path. No PATH lookup. The default is
# /usr/sbin/nft; callers running on systems with nft elsewhere
# (Alpine, Void, embedded distros) override via `nein_set_nft_path`.
#
# Pre-v1.4.0 behavior tried /usr/sbin/nft → /sbin/nft → /usr/bin/nft
# in order, which was a soft form of PATH consultation (an attacker
# who controlled /usr/sbin/ could plant a malicious binary before the
# real one). v1.4.0 forces a single explicit path so the operator
# either trusts /usr/sbin/nft exactly, or sets the path explicitly.

# Stored as a global-data cstring slot. alloc_init() sets the default;
# callers can override at runtime via nein_set_nft_path.
var _nein_nft_path = "/usr/sbin/nft";

# --- portable child reap (1.6.12) ---------------------------------------
# agnos and Linux disagree on BOTH the arity and the meaning of waitpid, so
# every reap in this file goes through here rather than calling sys_waitpid
# directly. Linux: `waitpid(pid, &status, 0)` BLOCKS and writes a status word.
# agnos `waitpid(pid)` (#4) takes ONE argument, is NON-BLOCKING by design, and
# answers the exit code / -2 (WOULD_BLOCK) / -1 (no such child) with no status
# word at all — the kernel notes "-2 vs -1 IS THE WHOLE CONTRACT", because
# collapsing them makes "still running" indistinguishable from "no children".
#
# Found by daimon at its 2.1.8 adoption: a raw 3-arg `sys_waitpid` is a hard
# COMPILE error on `--agnos`, so dist/nein-mcp.cyr could not be built for that
# target by any consumer.
#
# Contract here, identical on both: returns > 0 on a successful reap, < 0 on
# failure, and writes a Linux-shaped status word so the existing WEXITSTATUS
# decoding below is unchanged. The agnos arm synthesises that word as
# `exit_code << 8`, which is exactly what Linux reports for a normal exit.
var _NEIN_REAP_TRIES = 2000;      # ~2s at 1ms — nft apply is fast or wedged

fn _nein_waitpid(pid: i64, status_ptr: i64): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    var ts: i64[2];
    store64(&ts, 0);
    store64(&ts + 8, 1000000);              # 1 ms
    var i = 0;
    while (i < _NEIN_REAP_TRIES) {
        var r = sys_waitpid(pid);
        if (r >= 0) { store64(status_ptr, r << 8); return 1; }
        if (r != 0 - 2) { return r; }       # -1 no such child, or other error
        sys_nanosleep(&ts, 0);
        i = i + 1;
    }
    return 0 - 1;                           # outlived the budget: fail closed
    #else
    var wr = sys_waitpid(pid, status_ptr, 0);
    while (wr == 0 - 4) { wr = sys_waitpid(pid, status_ptr, 0); }   # -EINTR
    return wr;
    #endif
}

fn nein_nft_path(): cstring { return _nein_nft_path; }

# Override the absolute path to nft. Must start with '/'. Returns
# Ok(0) on accept, Err(NEIN_ERR_INVALID_RULE) on reject.
#
# The path is COPIED (1.8.2, audit S-10). Through 1.8.1 nein kept the caller's
# pointer, so a path built in a stack buffer or a reused heap buffer later had
# execve run whatever bytes were there by then.
var _nein_nft_path_buf[264];
fn nein_set_nft_path(path: cstring): i64 {
    if (path == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (load8(path) != 47) { return nein_err(NEIN_ERR_INVALID_RULE); }   # '/'
    var n = strlen(path);
    if (n > 256) { return nein_err(NEIN_ERR_INVALID_RULE); }
    memcpy(&_nein_nft_path_buf, path, n);
    store8(&_nein_nft_path_buf + n, 0);
    _nein_nft_path = &_nein_nft_path_buf;
    return nein_ok();
}

# ================================================================
# SIGPIPE guard (1.6.10, audit H-7)
# ================================================================
#
# Writing the ruleset to nft's stdin raises SIGPIPE if the child is already
# gone — a failed execve, a parse error that made nft exit early, an OOM kill.
# SIGPIPE's default disposition TERMINATES THE WHOLE CALLING PROCESS, so a
# missing or unexecutable /usr/sbin/nft killed the host instead of returning
# an error. Reproduced as exit 141; it also falsified threat-model T-4's claim
# that the parent observes the child's exit status on execve failure.
#
# With SIGPIPE ignored the write returns -EPIPE instead, which the loop
# treated as a hard error. Since 1.8.2 nein writes to no pipe at all (the
# ruleset is staged in a memfd), so the guard is no longer load-bearing for
# nein; it is kept so a host relying on its process-wide effect sees no change,
# and the nft child has SIGPIPE reset to SIG_DFL before exec.
#
# This is process-wide state, so it is worth being explicit about: setting it
# changes SIGPIPE disposition for the ENTIRE host process, not just for nein's
# subprocess window. That is what essentially every process that writes to a
# pipe wants — and nein's consumers (stiva / daimon / aegis / sutra) are
# daemons that already do it — but a host that manages SIGPIPE itself can turn
# it off with `nein_set_sigpipe_guard(0)` before the first apply. Applied once
# and latched; nein never restores the previous disposition, because doing so
# would reopen the same window on the next call.
var _nein_sigpipe_guard = 1;
var _nein_sigpipe_applied = 0;

# Enable (1, default) or disable (0) the SIGPIPE guard. Returns Ok(0).
fn nein_set_sigpipe_guard(enabled: i64): i64 {
    if (enabled == 0) { _nein_sigpipe_guard = 0; } else { _nein_sigpipe_guard = 1; }
    return nein_ok();
}

fn nein_sigpipe_guard(): i64 { return _nein_sigpipe_guard; }

fn _nein_apply_sigpipe_guard() {
    if (_nein_sigpipe_guard == 0) { return 0; }
    if (_nein_sigpipe_applied == 1) { return 0; }
    signal_ignore(13);
    _nein_sigpipe_applied = 1;
    return 0;
}

# ================================================================
# Low-level: run nft with its stdio on memfds (1.8.2)
# ================================================================
#
# Through 1.8.1 the ruleset went to nft over a pipe written AFTER the fork,
# and stderr came back over a second pipe. The 2026-11-03 P(-1) audit found
# four defects in that shape (docs/audit/2026-11-03-audit.md, S-1 to S-4):
#   - the child built argv with alloc() between fork and execve, so in a
#     threaded host it could inherit the allocator's lock held and spin
#     forever, with the parent blocked behind it;
#   - the pipes were not close-on-exec, so any process the host forked during
#     an apply held nft's stdin open and nft saw no EOF until it exited;
#   - a host killed mid-write left nft an EOF on a prefix, which nft commits
#     atomically: for a diff's chain rebuild, the deletes without the adds;
#   - writing everything before draining stderr could deadlock (unreachable
#     with real nft 1.1.7, reachable through nein_set_nft_path).
# Now the whole ruleset is in a memfd BEFORE the fork, stdout and stderr go to
# /dev/null and a memfd, every descriptor nein opens is close-on-exec, the
# child allocates nothing, and the parent waits on a pidfd with a deadline.
# No pipe remains, so none of the four can happen.

var _NEIN_NFT_DEADLINE_MS = 60000;   # a wedged nft is SIGKILLed after this
var _NEIN_ETIMEDOUT = 0 - 110;

#ifndef CYRIUS_TARGET_AGNOS
# Child side, between fork and execve. Allocates nothing (S-1). Puts in_fd /
# out_fd / err_fd on 0 / 1 / 2 by way of close-on-exec copies above 10, so a
# source that already sits on 0-2 (a daemonized host closed them) cannot be
# clobbered by another's dup2 — the class the 1.6.10 `_child_redirect` guarded
# one case of. Resets the signal state nft would otherwise inherit from the
# host (an ignored SIGPIPE, a blocked mask), asks to die with the host, and
# closes every other descriptor the host had open (S-9).
fn _nein_child_exec(in_fd: i64, out_fd: i64, err_fd: i64, argv: i64, ppid: i64) {
    var empty[8];
    store64(&empty, 0);
    sys_sigprocmask(2, &empty, 0);              # SIG_SETMASK: unblock everything
    signal_default(13);                         # SIGPIPE back to SIG_DFL
    signal_default(25);                         # SIGXFSZ back to SIG_DFL
    sys_prctl(1, 9, 0, 0, 0);                   # PR_SET_PDEATHSIG = SIGKILL
    if (sys_getppid() != ppid) { sys_exit(127); }   # host died before the prctl
    var a = sys_fcntl(in_fd, 1030, 10);         # F_DUPFD_CLOEXEC, lowest fd >= 10
    var b = sys_fcntl(out_fd, 1030, 10);
    var c = sys_fcntl(err_fd, 1030, 10);
    if (a < 0 || b < 0 || c < 0) { sys_exit(127); }
    if (sys_dup2(a, 0) < 0) { sys_exit(127); }  # dup2 clears close-on-exec on 0-2
    if (sys_dup2(b, 1) < 0) { sys_exit(127); }
    if (sys_dup2(c, 2) < 0) { sys_exit(127); }
    syscall(436, 3, 0xFFFFFFFF, 0);             # close_range(3, ~0U); best effort, Linux 5.9+
    # Single pinned absolute path — no PATH consultation (T-3).
    sys_execve(_nein_nft_path, argv, 0);
    sys_exit(127);
    return 0;
}

# Parent side: wait for the child with a deadline (S-4). A pidfd turns "the
# child exited" into a readable descriptor, so the wait can time out; on a
# timeout the child is SIGKILLed and reaped and the caller fails closed. A
# kernel without pidfd_open (< 5.3) falls back to the plain blocking wait used
# through 1.8.1. Returns what _nein_waitpid returns, or _NEIN_ETIMEDOUT.
fn _nein_wait_deadline(pid: i64, status_ptr: i64): i64 {
    var pfd = sys_pidfd_open(pid, 0);
    if (pfd >= 0) {
        var r = fd_wait_ready(pfd, 0, _NEIN_NFT_DEADLINE_MS);
        while (r == 0 - 4) { r = fd_wait_ready(pfd, 0, _NEIN_NFT_DEADLINE_MS); }   # -EINTR
        sys_close(pfd);
        if (r == 0) {
            sys_kill(pid, 9);
            _nein_waitpid(pid, status_ptr);
            return _NEIN_ETIMEDOUT;
        }
    }
    return _nein_waitpid(pid, status_ptr);
}

# A fresh close-on-exec memfd holding all of buf[0..len), rewound to 0.
# Returns the fd, or < 0. -EINTR is retried; any other short write fails.
fn _nein_memfd_with(name: cstring, buf: i64, len: i64): i64 {
    var fd = sys_memfd_create(name, 1);         # MFD_CLOEXEC
    if (fd < 0) { return fd; }
    var off = 0;
    while (off < len) {
        var n = sys_write(fd, buf + off, len - off);
        if (n == 0 - 4) { continue; }
        if (n <= 0) { sys_close(fd); return 0 - 5; }
        off = off + n;
    }
    if (sys_lseek(fd, 0, 0) != 0) { sys_close(fd); return 0 - 5; }
    return fd;
}

# Append the memfd's contents (from offset 0, at most `cap` bytes; cap < 0
# for all) to `sb`. With `flatten` set, control bytes become spaces so nft's
# stderr — which echoes rule text — cannot forge lines in a log. The child has
# exited before this runs, so a read of 0 is the end, not a pause: the
# EINTR-truncated capture of 1.8.1 (S-5) cannot happen. Returns bytes or < 0.
fn _nein_memfd_read(fd: i64, sb: i64, cap: i64, flatten: i64): i64 {
    if (sys_lseek(fd, 0, 0) != 0) { return 0 - 5; }
    var buf[4096];
    var total = 0;
    while (cap < 0 || total < cap) {
        var want = 4096;
        if (cap >= 0 && cap - total < want) { want = cap - total; }
        var n = sys_read(fd, &buf, want);
        if (n == 0 - 4) { continue; }
        if (n < 0) { return n; }
        if (n == 0) { break; }
        var i = 0;
        while (i < n) {
            var ch = load8(&buf + i);
            if (flatten == 1 && ch < 32) { ch = 32; }
            str_builder_add_byte(sb, ch);
            i = i + 1;
        }
        total = total + n;
    }
    return total;
}

# Log a failure with up to 1 KiB of nft's own stderr appended (through 1.8.1
# nft's stderr was drained and discarded, so no failure said why).
fn _nein_log_nft_failure(msg: cstring, err_fd: i64): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, msg);
    str_builder_add_cstr(sb, " | nft: ");
    _nein_memfd_read(err_fd, sb, 1024, 1);
    var line = str_data(str_builder_build(sb));
    sakshi_warn(line, strlen(line));
    return 0;
}

# The child's fate as 0 (nft exited 0) or a NEIN_ERR code. `commits` is 1
# when nft was handed a ruleset to apply (`nft -f -`) and 0 for a read
# (`nft list ...`). Where nein cannot learn what the child did — killed at the
# deadline, reaped by someone else, or dead on a signal — an apply may still
# have committed (nft sends its batch, then waits for the kernel's answer), so
# it is NEIN_ERR_OUTCOME_UNKNOWN (1.9.0, audit S-8), never a plain failure a
# caller might retry. A read changes nothing, so for it the same is a failure.
fn _nein_nft_unknown(commits: i64): i64 {
    if (commits == 1) { return NEIN_ERR_OUTCOME_UNKNOWN; }
    return NEIN_ERR_NFT_FAILED;
}

fn _nein_nft_outcome(wr: i64, status: i64, err_fd: i64, commits: i64): i64 {
    if (wr == _NEIN_ETIMEDOUT) {
        _nein_log_nft_failure("nein.apply: nft outlived its deadline and was killed", err_fd);
        return _nein_nft_unknown(commits);
    }
    # The return value MUST be checked (1.6.10, audit MEDIUM). On failure
    # waitpid does not write `status`, which stays 0 — and the stdlib decodes 0
    # as a clean exit-zero child (WIFEXITED(0)==1, WEXITSTATUS(0)==0). So an
    # unchecked wait reported a failed apply as SUCCESS. Reachable whenever the
    # host installs a SIGCHLD reaper or sets SIGCHLD to SIG_IGN, which process
    # supervisors — nein's own consumers — routinely do.
    # Through 1.8.2 this returned NFT_FAILED, which read as "nothing applied".
    if (wr < 0) {
        var sk_wait = "nein.apply: waitpid failed — child fate unknown (SIGCHLD ignored, or reaped elsewhere)";
        sakshi_error(sk_wait, strlen(sk_wait));
        return _nein_nft_unknown(commits);
    }
    if (WIFEXITED(status) == 1) {
        if (WEXITSTATUS(status) == 127) {
            var sk_perm = "nein.apply: nft exit=127 (no executable found, or child setup failed)";
            sakshi_error(sk_perm, strlen(sk_perm));
            return NEIN_ERR_PERMISSION_DENIED;
        }
        if (WEXITSTATUS(status) != 0) {
            _nein_log_nft_failure("nein.apply: nft exit nonzero", err_fd);
            return NEIN_ERR_NFT_FAILED;
        }
        var sk_ok = "nein.apply: nft exit=0";
        sakshi_info(sk_ok, strlen(sk_ok));
        return 0;
    }
    _nein_log_nft_failure("nein.apply: nft died on a signal", err_fd);
    return _nein_nft_unknown(commits);
}
#endif

# ================================================================
# Low-level: run `nft -f -` with the ruleset on stdin.
# Returns Ok(0) on exit 0, Err(NEIN_ERR_*) on refusal or failure, and
# Err(NEIN_ERR_OUTCOME_UNKNOWN) when nft ran and its fate cannot be learned.
# ================================================================

fn _run_nft_stdin(input_buf, input_len) {
    #ifdef CYRIUS_TARGET_AGNOS
    # ⛔ nft does not exist on agnos. nein's apply layer drives LINUX
    # NETFILTER by exec'ing /usr/sbin/nft; agnos is spawn-not-fork-exec and has
    # its own network stack (`sys_net_config` and peers) with no nftables at
    # all, so there is nothing to port until nein grows an agnos BACKEND — a
    # different piece of work from a syscall shim (found by daimon at 2.1.8).
    # Failing closed at the entry point, loudly and specifically, is the honest
    # behaviour: a diagnosable refusal, and the firewall is never half-applied.
    # No span is open here, so none is closed (1.8.2: the old arm called
    # sakshi_span_exit() without an enter and popped the caller's span).
    var sk_agnos = "nein.apply: no nftables backend on agnos - refusing, not half-applying";
    sakshi_error(sk_agnos, strlen(sk_agnos));
    return nein_err(NEIN_ERR_NFT_FAILED);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var sk_span_name = "nein.apply.run_nft_stdin";
    sakshi_span_enter(sk_span_name, strlen(sk_span_name));

    # nft stops parsing at the first NUL byte and exits 0, applying only what
    # came before it (S-6). Refuse instead of half-applying.
    if (memchr(input_buf, 0, input_len) >= 0) {
        var sk_nul = "nein.apply: ruleset contains a NUL byte — nft would apply only the prefix; refusing";
        sakshi_error(sk_nul, strlen(sk_nul));
        sakshi_span_exit();
        return nein_err(NEIN_ERR_INVALID_RULE);
    }

    # Kept for compatibility: the guard predates the memfd path, which writes
    # to no pipe, and is retained so a host that relied on nein's process-wide
    # SIGPIPE disposition sees no change in 1.8.2. See its note above.
    _nein_apply_sigpipe_guard();

    var in_fd = _nein_memfd_with("nein-ruleset", input_buf, input_len);
    if (in_fd < 0) {
        var sk_mfd = "nein.apply: could not stage the ruleset in a memfd";
        sakshi_error(sk_mfd, strlen(sk_mfd));
        sakshi_span_exit();
        return nein_err(NEIN_ERR_NFT_FAILED);
    }
    var err_fd = sys_memfd_create("nein-nft-stderr", 1);
    var null_fd = sys_open("/dev/null", 1 | 524288, 0);   # O_WRONLY | O_CLOEXEC
    if (err_fd < 0 || null_fd < 0) {
        sys_close(in_fd);
        if (err_fd >= 0) { sys_close(err_fd); }
        if (null_fd >= 0) { sys_close(null_fd); }
        var sk_fds = "nein.apply: could not open nft's stdout / stderr";
        sakshi_error(sk_fds, strlen(sk_fds));
        sakshi_span_exit();
        return nein_err(NEIN_ERR_NFT_FAILED);
    }

    # argv: ["nft", "-f", "-", 0], on this frame, built before the fork so the
    # child allocates nothing (S-1).
    var argv[32];
    store64(&argv, "nft");
    store64(&argv + 8, "-f");
    store64(&argv + 16, "-");
    store64(&argv + 24, 0);
    var ppid = sys_getpid();

    var pid = sys_fork();
    if (pid < 0) {
        sys_close(in_fd); sys_close(err_fd); sys_close(null_fd);
        var sk_fork_err = "nein.apply: sys_fork failed";
        sakshi_error(sk_fork_err, strlen(sk_fork_err));
        sakshi_span_exit();
        return nein_err(NEIN_ERR_NFT_FAILED);
    }
    if (pid == 0) { _nein_child_exec(in_fd, null_fd, err_fd, &argv, ppid); }

    sys_close(in_fd);
    sys_close(null_fd);
    var status = 0;
    var wr = _nein_wait_deadline(pid, &status);
    var code = _nein_nft_outcome(wr, status, err_fd, 1);
    sys_close(err_fd);
    sakshi_span_exit();
    if (code == 0) { return nein_ok(); }
    return nein_err(code);
    #endif
}

# ================================================================
# Low-level: spawn nft with args, capture stdout into a Str
# Returns Ok(stdout_str) on success, Err on failure.
# ================================================================

fn _run_nft_capture(argv, nft_path) {
    #ifdef CYRIUS_TARGET_AGNOS
    # ⛔ nft does not exist on agnos. nein's apply layer drives LINUX
    # NETFILTER by exec'ing /usr/sbin/nft; agnos is spawn-not-fork-exec and has
    # its own network stack (`sys_net_config` and peers) with no nftables at
    # all, so there is nothing to port until nein grows an agnos BACKEND — a
    # different piece of work from a syscall shim (found by daimon at 2.1.8).
    # Failing closed at the entry point, loudly and specifically, is the honest
    # behaviour: a diagnosable refusal, and the firewall is never half-applied.
    # No span is open here, so none is closed (1.8.2: the old arm called
    # sakshi_span_exit() without an enter and popped the caller's span).
    var sk_agnos = "nein.apply: no nftables backend on agnos - refusing, not half-applying";
    sakshi_error(sk_agnos, strlen(sk_agnos));
    return nein_err(NEIN_ERR_NFT_FAILED);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var sk_span_name = "nein.apply.run_nft_capture";
    sakshi_span_enter(sk_span_name, strlen(sk_span_name));

    # stdout and stderr to memfds, stdin from /dev/null (through 1.8.1 the
    # capture child read the HOST's stdin and wrote its stderr to the host's,
    # which in a stdio MCP host is the protocol stream).
    var out_fd = sys_memfd_create("nein-nft-stdout", 1);
    var err_fd = sys_memfd_create("nein-nft-stderr", 1);
    var null_fd = sys_open("/dev/null", 0 | 524288, 0);   # O_RDONLY | O_CLOEXEC
    if (out_fd < 0 || err_fd < 0 || null_fd < 0) {
        if (out_fd >= 0) { sys_close(out_fd); }
        if (err_fd >= 0) { sys_close(err_fd); }
        if (null_fd >= 0) { sys_close(null_fd); }
        var sk_pe = "nein.apply: could not open nft capture descriptors";
        sakshi_error(sk_pe, strlen(sk_pe));
        sakshi_span_exit();
        return nein_err(NEIN_ERR_NFT_FAILED);
    }

    var ppid = sys_getpid();
    var pid = sys_fork();
    if (pid < 0) {
        sys_close(out_fd); sys_close(err_fd); sys_close(null_fd);
        var sk_fe = "nein.apply: sys_fork(capture) failed";
        sakshi_error(sk_fe, strlen(sk_fe));
        sakshi_span_exit();
        return nein_err(NEIN_ERR_NFT_FAILED);
    }
    if (pid == 0) { _nein_child_exec(null_fd, out_fd, err_fd, argv, ppid); }

    sys_close(null_fd);
    var status = 0;
    var wr = _nein_wait_deadline(pid, &status);
    var code = _nein_nft_outcome(wr, status, err_fd, 0);
    sys_close(err_fd);
    if (code != 0) {
        sys_close(out_fd);
        sakshi_span_exit();
        return nein_err(code);
    }
    var sb = str_builder_new();
    var got = _nein_memfd_read(out_fd, sb, 0 - 1, 0);
    sys_close(out_fd);
    sakshi_span_exit();
    if (got < 0) { return nein_err(NEIN_ERR_NFT_FAILED); }
    return Ok(str_builder_build(sb));
    #endif
}

# ================================================================
# Build a small nft command string + deliver it over stdin
# ================================================================

fn _nft_cmd(cmd_cstr) {
    return _run_nft_stdin(cmd_cstr, strlen(cmd_cstr));
}

# ================================================================
# Public: batch operations
# ================================================================

# Apply a ruleset (Str or cstr). For Str, caller should use apply_ruleset_str.
fn apply_ruleset_cstr(ruleset_cstr: cstring): i64 {
    return _run_nft_stdin(ruleset_cstr, strlen(ruleset_cstr));
}

fn apply_ruleset_str(ruleset_str: Str): i64 {
    return _run_nft_stdin(str_data(ruleset_str), str_len(ruleset_str));
}

# Validate, render, and apply a Firewall.
#
# Honors the firewall's dry-run flag (`firewall_set_dry_run`): in dry-run the
# ruleset is still validated AND rendered — so a caller gets the same errors a
# real apply would raise — but nft is never spawned. Returns Ok(0).
#
# The flag is checked with `!= 0` rather than `== 1` deliberately: any non-zero
# value means "do not touch the live firewall". Fail-safe direction — a
# malformed flag skips the apply instead of performing one.
fn apply_firewall(fw: i64): i64 {
    var vr1_t, vr1_v = firewall_validate(fw);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    var ruleset = firewall_render(fw);
    if (firewall_dry_run(fw) != 0) {
        var sk_dry = "nein.apply: dry-run set — rendered but not applied";
        sakshi_info(sk_dry, strlen(sk_dry));
        return nein_ok();
    }
    return apply_ruleset_str(ruleset);
}

fn flush_ruleset(): i64 {
    return _nft_cmd("flush ruleset\n");
}

# ================================================================
# Public: table/chain operations
# ================================================================

fn _build_nft_line(verb, family, table, chain_or_null) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, verb);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, family);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, table);
    if (chain_or_null != 0) {
        str_builder_add_cstr(sb, " ");
        str_builder_add_cstr(sb, chain_or_null);
    }
    str_builder_add_cstr(sb, "\n");
    var s = str_builder_build(sb);
    var out = alloc(str_len(s) + 1);
    memcpy(out, str_data(s), str_len(s));
    store8(out + str_len(s), 0);
    return out;
}

fn flush_table(family: cstring, table: cstring): i64 {
    var vr1_t, vr1_v = validate_family(family);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    var vr2_t, vr2_v = validate_nft_name(table);
    if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
    return _nft_cmd(_build_nft_line("flush table", family, table, 0));
}

fn delete_table(family: cstring, table: cstring): i64 {
    var vr1_t, vr1_v = validate_family(family);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    var vr2_t, vr2_v = validate_nft_name(table);
    if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
    return _nft_cmd(_build_nft_line("delete table", family, table, 0));
}

fn flush_chain(family: cstring, table: cstring, chain: cstring): i64 {
    var vr1_t, vr1_v = validate_family(family);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    var vr2_t, vr2_v = validate_nft_name(table);
    if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
    var vr3_t, vr3_v = validate_nft_name(chain);
    if (is_err_result(vr3_t) == 1) { return Err(vr3_v); }
    return _nft_cmd(_build_nft_line("flush chain", family, table, chain));
}

fn delete_chain(family: cstring, table: cstring, chain: cstring): i64 {
    var vr1_t, vr1_v = validate_family(family);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    var vr2_t, vr2_v = validate_nft_name(table);
    if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
    var vr3_t, vr3_v = validate_nft_name(chain);
    if (is_err_result(vr3_t) == 1) { return Err(vr3_v); }
    return _nft_cmd(_build_nft_line("delete chain", family, table, chain));
}

# ================================================================
# Public: incremental rule operations
# ================================================================

# Helper: build "add rule FAM TAB CHN RULE\n" variants
fn _build_rule_line(verb_prefix, family, table, chain, rule, suffix_prefix, suffix_val) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, verb_prefix);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, family);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, table);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, chain);
    if (suffix_prefix != 0) {
        str_builder_add_cstr(sb, " ");
        str_builder_add_cstr(sb, suffix_prefix);
        str_builder_add_cstr(sb, " ");
        str_builder_add_int(sb, suffix_val);
    }
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, rule);
    str_builder_add_cstr(sb, "\n");
    var s = str_builder_build(sb);
    var out = alloc(str_len(s) + 1);
    memcpy(out, str_data(s), str_len(s));
    store8(out + str_len(s), 0);
    return out;
}

fn _validate_rule_args(family, table, chain, rule) {
    var vr1_t, vr1_v = validate_family(family);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    var vr2_t, vr2_v = validate_nft_name(table);
    if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
    var vr3_t, vr3_v = validate_nft_name(chain);
    if (is_err_result(vr3_t) == 1) { return Err(vr3_v); }
    var vr4_t, vr4_v = validate_nft_element(rule);
    if (is_err_result(vr4_t) == 1) { return Err(vr4_v); }
    return nein_ok();
}

# add rule FAM TAB CHN RULE
fn add_rule_live(family: cstring, table: cstring, chain: cstring, rule: cstring): i64 {
    var vr1_t, vr1_v = _validate_rule_args(family, table, chain, rule);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    return _nft_cmd(_build_rule_line("add rule", family, table, chain, rule, 0, 0));
}

# insert rule FAM TAB CHN RULE (prepends)
fn insert_rule_live(family: cstring, table: cstring, chain: cstring, rule: cstring): i64 {
    var vr1_t, vr1_v = _validate_rule_args(family, table, chain, rule);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    return _nft_cmd(_build_rule_line("insert rule", family, table, chain, rule, 0, 0));
}

# add rule FAM TAB CHN position POS RULE
fn add_rule_after_live(family: cstring, table: cstring, chain: cstring, position_handle: i64, rule: cstring): i64 {
    var vr1_t, vr1_v = _validate_rule_args(family, table, chain, rule);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    return _nft_cmd(_build_rule_line("add rule", family, table, chain, rule, "position", position_handle));
}

# replace rule FAM TAB CHN handle H RULE
fn replace_rule_live(family: cstring, table: cstring, chain: cstring, handle: i64, new_rule: cstring): i64 {
    var vr1_t, vr1_v = _validate_rule_args(family, table, chain, new_rule);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    return _nft_cmd(_build_rule_line("replace rule", family, table, chain, new_rule, "handle", handle));
}

# delete rule FAM TAB CHN handle H
fn delete_rule_live(family: cstring, table: cstring, chain: cstring, handle: i64): i64 {
    var vr1_t, vr1_v = validate_family(family);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    var vr2_t, vr2_v = validate_nft_name(table);
    if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
    var vr3_t, vr3_v = validate_nft_name(chain);
    if (is_err_result(vr3_t) == 1) { return Err(vr3_v); }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "delete rule ");
    str_builder_add_cstr(sb, family);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, table);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, chain);
    str_builder_add_cstr(sb, " handle ");
    str_builder_add_int(sb, handle);
    str_builder_add_cstr(sb, "\n");
    var s = str_builder_build(sb);
    var cstr = alloc(str_len(s) + 1);
    memcpy(cstr, str_data(s), str_len(s));
    store8(cstr + str_len(s), 0);
    return _nft_cmd(cstr);
}

# ================================================================
# Public: list / inspect
# ================================================================

fn list_ruleset(): i64 {
    var argv = alloc(32);
    store64(argv, "nft");
    store64(argv + 8, "list");
    store64(argv + 16, "ruleset");
    store64(argv + 24, 0);
    return _run_nft_capture(argv, 0);
}

fn list_ruleset_with_handles(): i64 {
    var argv = alloc(40);
    store64(argv, "nft");
    store64(argv + 8, "-a");
    store64(argv + 16, "list");
    store64(argv + 24, "ruleset");
    store64(argv + 32, 0);
    return _run_nft_capture(argv, 0);
}

# `nft -a list table FAMILY TABLE` — handles, scoped to one table.
#
# The scoped form matters for the comment-keyed handle lookup
# (`find_rules_by_comment` in diff.cyr): listing one table instead of the whole
# ruleset keeps the parse bounded and stops a match in an unrelated table from
# ever entering the result set. Both names are validated before they reach
# argv — they are operator-supplied and land in an execve argument vector.
fn list_table_with_handles(family: cstring, table: cstring): i64 {
    var vr1_t, vr1_v = validate_family(family);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    var vr2_t, vr2_v = validate_nft_name(table);
    if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
    # `list table` reads the name in a scope of its own, where `rules`,
    # `tables`, `count`, ... are keywords (1.9.1): refused here, not by nft
    # with a syntax error after the fork.
    if (_nft_list_keyword(table) == 1) { return nein_err(NEIN_ERR_INVALID_RULE); }

    var argv = alloc(56);
    store64(argv, "nft");
    store64(argv + 8, "-a");
    store64(argv + 16, "list");
    store64(argv + 24, "table");
    store64(argv + 32, family);
    store64(argv + 40, table);
    store64(argv + 48, 0);
    return _run_nft_capture(argv, 0);
}

# --- inspect.cyr ---

# nein inspect module — query current firewall state
#
# Wraps apply::list_ruleset and parses the output into a FirewallStatus.

# ================================================================
# FirewallStatus — { table_names(vec of cstr), total_rules, raw_ruleset(Str) }
# Layout: [tables:8][total_rules:8][raw:8] = 24 bytes
# ================================================================

fn firewall_status_new(tables: i64, total_rules: i64, raw: Str): i64 {
    var s = alloc(24);
    store64(s, tables);
    store64(s + 8, total_rules);
    store64(s + 16, raw);
    return s;
}

fn status_tables(s: i64): i64 { return load64(s); }
fn status_total_rules(s: i64): i64 { return load64(s + 8); }
fn status_raw_ruleset(s: i64): i64 { return load64(s + 16); }

# ================================================================
# Parse a raw ruleset into tables + rule count
# ================================================================

# Check if a cstr starts with a prefix
fn _cstr_starts_with(s: cstring, prefix: cstring): i64 {
    var plen = strlen(prefix);
    if (strlen(s) < plen) { return 0; }
    var i = 0;
    while (i < plen) {
        if (load8(s + i) != load8(prefix + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Trim leading/trailing whitespace; returns a fresh cstr
fn _trim_line(s: i64, len: i64): cstring {
    var start = 0;
    while (start < len) {
        var c = load8(s + start);
        if (c != 32 && c != 9) { break; }   # not space, not tab
        start = start + 1;
    }
    var end = len;
    while (end > start) {
        var c = load8(s + end - 1);
        if (c != 32 && c != 9 && c != 13) { break; }
        end = end - 1;
    }
    var out_len = end - start;
    var out = alloc(out_len + 1);
    memcpy(out, s + start, out_len);
    store8(out + out_len, 0);
    return out;
}

# Strip trailing " {" if present
fn _strip_open_brace(s: cstring): cstring {
    var len = strlen(s);
    if (len >= 2) {
        if (load8(s + len - 1) == 123) {   # '{'
            if (load8(s + len - 2) == 32) {   # ' '
                var out = alloc(len - 1);
                memcpy(out, s, len - 2);
                store8(out + len - 2, 0);
                return out;
            }
        }
    }
    return s;
}

# Block-nesting context — only lines inside a `chain` block count as
# rules. v1.4.0 hardening: previously every non-table/non-chain/non-type
# line was counted as a rule, which mis-counted contents of `set`,
# `map`, `flowtable`, `ct timeout` blocks (e.g. `flags interval;`,
# `elements = { … };`) as rules. The block-stack tracker keeps a
# string for the innermost open block kind: "chain", "set", "map",
# "flowtable", "ct_timeout", or 0 (top-level / table).
#
# A line counts as a rule iff:
#   - block_kind == "chain"
#   - the line is not a `chain` opener, `type ` header, `policy `
#     declaration, `}` close, comment (#), or blank
enum BlockKind {
    BLOCK_NONE = 0;
    BLOCK_TABLE = 1;
    BLOCK_CHAIN = 2;
    BLOCK_SET = 3;
    BLOCK_MAP = 4;
    BLOCK_FLOWTABLE = 5;
    BLOCK_CT_TIMEOUT = 6;
    BLOCK_OTHER = 7;
    BLOCK_ANON = 8;      # 1.8.2: an anonymous chain inside a rule (`jump {` ... `} # handle N`)
}

# Classify the opening line of a block by its first word, once
# `_line_opens_block` has established that it opens one.
fn _classify_block_open(trimmed: cstring): i64 {
    if (_cstr_starts_with(trimmed, "table ") == 1) { return BLOCK_TABLE; }
    if (_cstr_starts_with(trimmed, "chain ") == 1) { return BLOCK_CHAIN; }
    if (_cstr_starts_with(trimmed, "set ") == 1) { return BLOCK_SET; }
    if (_cstr_starts_with(trimmed, "map ") == 1) { return BLOCK_MAP; }
    if (_cstr_starts_with(trimmed, "flowtable ") == 1) { return BLOCK_FLOWTABLE; }
    if (_cstr_starts_with(trimmed, "ct timeout ") == 1) { return BLOCK_CT_TIMEOUT; }
    # counter / quota / limit / synproxy / secmark / ct helper /
    # ct expectation / tunnel, and whatever object nft adds next.
    return BLOCK_OTHER;
}

# 1 when the line ends in "{" — ignoring a trailing ` # handle N`, which nft -a
# prints after every block opener.
fn _line_ends_open(trimmed: cstring): i64 {
    var len = strlen(trimmed);
    var end = len;
    var mk = " # handle ";
    var ml = strlen(mk);
    var k = 0;
    while (k + ml <= len) {
        if (memeq(trimmed + k, mk, ml) == 1) { end = k; }
        k = k + 1;
    }
    while (end > 0 && load8(trimmed + end - 1) == 32) { end = end - 1; }
    if (end > 0 && load8(trimmed + end - 1) == 123) { return 1; }
    return 0;
}

# The kind of block this line opens in the current context, or BLOCK_NONE
# (1.8.2, audit P-2 / P-7). Through 1.8.1 a line opened a block whenever it
# STARTED with an opener word, at any depth — so a rule beginning
# `counter packets 0 bytes 0 accept`, `limit rate ...` or `ct helper set ...`
# (nein renders all three itself) opened a phantom block: that rule and every
# later rule in its chain vanished from the parse, nein_diff appended the
# target on top on every run, and the 1.6.10 ordering fix (audit H-5) became
# append-only again. A block now opens only where one can: `table` at the top
# level, any object directly inside a table, and a nested brace inside a
# non-chain object. Inside a chain a line ending in "{" is a RULE that holds
# an anonymous chain (BLOCK_ANON), which the caller consumes whole.
fn _line_opens_block(trimmed: cstring, current_block: i64): i64 {
    if (_line_ends_open(trimmed) == 0) { return BLOCK_NONE; }
    if (current_block == BLOCK_NONE) {
        if (_cstr_starts_with(trimmed, "table ") == 1) { return BLOCK_TABLE; }
        return BLOCK_OTHER;
    }
    if (current_block == BLOCK_TABLE) { return _classify_block_open(trimmed); }
    if (current_block == BLOCK_CHAIN || current_block == BLOCK_ANON) { return BLOCK_ANON; }
    return BLOCK_OTHER;
}

# A block close: "}" alone, or "} # handle N" (an anonymous chain's end).
fn _line_closes_block(trimmed: cstring): i64 {
    if (load8(trimmed) != 125) { return 0; }
    if (load8(trimmed + 1) == 0) { return 1; }
    if (_cstr_starts_with(trimmed, "} # handle ") == 1) { return 1; }
    return 0;
}

# nft prints a chain's comment on its own line inside the chain:
# `comment "managed by nein"`. It is not a rule (audit P-3).
fn _line_is_chain_comment(trimmed: cstring): i64 {
    if (_cstr_starts_with(trimmed, "comment \"") == 1) { return 1; }
    return 0;
}

# Parse the raw ruleset Str, populating:
#   tables_vec: pushed with each "table FAM NAME" line
#   Returns rule count — counted only inside `chain` blocks; lines
#   inside set/map/flowtable/ct_timeout bodies are NOT rules.
#
# Block-stack depth is bounded by nesting in real nft output
# (table → chain/set/map → optional inner). 16 slots is comfortable —
# and `var buf[N]` is N BYTES, so 16 i64 slots need 128 bytes.
fn _parse_ruleset(raw_str: Str, tables_vec: i64): i64 {
    var data = str_data(raw_str);
    var len = str_len(raw_str);
    var rule_count = 0;
    var line_start = 0;
    var i = 0;

    var block_stack[128];
    var bs_depth = 0;
    store64(&block_stack, BLOCK_NONE);

    while (i <= len) {
        var at_end = 0;
        if (i == len) { at_end = 1; }
        var c = 0;
        if (at_end == 0) { c = load8(data + i); }
        if (at_end == 1 || c == 10) {   # LF
            var line_len = i - line_start;
            if (line_len > 0 || at_end == 0) {
                var trimmed = _trim_line(data + line_start, line_len);
                var tlen = strlen(trimmed);
                if (tlen > 0) {
                    var current_block = load64(&block_stack + bs_depth * 8);

                    var opens = _line_opens_block(trimmed, current_block);
                    if (_line_closes_block(trimmed) == 1) {
                        # Block close. Pop the stack if we have anything.
                        if (bs_depth > 0) { bs_depth = bs_depth - 1; }
                    } elif (opens == BLOCK_ANON) {
                        # A rule holding an anonymous chain is ONE rule; its
                        # inner lines are swallowed until the matching close.
                        if (current_block == BLOCK_CHAIN) { rule_count = rule_count + 1; }
                        if (bs_depth < 15) {
                            bs_depth = bs_depth + 1;
                            store64(&block_stack + bs_depth * 8, BLOCK_ANON);
                        }
                    } elif (opens != BLOCK_NONE) {
                        if (opens == BLOCK_TABLE) { vec_push(tables_vec, _strip_open_brace(trimmed)); }
                        if (bs_depth < 15) {
                            bs_depth = bs_depth + 1;
                            store64(&block_stack + bs_depth * 8, opens);
                        }
                    } elif (current_block == BLOCK_CHAIN) {
                        # Inside a chain: count only real rule lines.
                        # Skip the `type … hook … priority …; policy …;` header,
                        # the chain's own `comment "…"` line, and any
                        # `# handle N` annotations.
                        if (_cstr_starts_with(trimmed, "type ") == 1) {
                            # not a rule
                        } elif (_cstr_starts_with(trimmed, "policy ") == 1) {
                            # not a rule
                        } elif (_line_is_chain_comment(trimmed) == 1) {
                            # the chain's comment, not a rule (audit P-3)
                        } elif (load8(trimmed) == 35) {   # '#'
                            # comment / handle annotation
                        } else {
                            rule_count = rule_count + 1;
                        }
                    }
                    # Otherwise: inside set/map/flowtable/ct_timeout/table —
                    # nothing to count.
                }
            }
            line_start = i + 1;
        }
        i = i + 1;
    }
    return rule_count;
}

# ================================================================
# Public API
# ================================================================

# status() — query live firewall state.
# Returns Ok(FirewallStatus) or Err on nft failure.
fn status(): i64 {
    var res1_t, res1_v = list_ruleset();
    if (is_err_result(res1_t) == 1) { return Err(res1_v); }
    var raw = res1_v;

    var tables = vec_new();
    var count = _parse_ruleset(raw, tables);

    return Ok(firewall_status_new(tables, count, raw));
}

# --- diff.cyr ---

# nein diff module — live-rule diff + idempotent apply
#
# Compute the minimal set of nft operations that converge the live
# kernel ruleset onto a target firewall plan. Pairs with sutra's
# idempotent-apply playbook semantics: a sutra run can render its
# firewall, compute the diff against the live state, and apply only
# the deltas — no full re-apply if nothing changed.
#
# v1.5.0 scope:
#   - Rule-level diff: add rules in target but not live; delete rules
#     in live but not target (matched by handle).
#   - Table-level / chain-level create/delete are NOT computed —
#     tables and chains are assumed to exist with the right shapes.
#     A future revision can extend.
#
# Matching strategy: each chain the target declares is compared with the
# live chain as an ordered sequence of rule bodies (see diff_compute). A live
# body is what nft lists, `# handle N` stripped. nft lists its own spelling,
# not the one it was given (`ip saddr 10.0.0.5/32` lists as `ip saddr
# 10.0.0.5`), so since 1.9.2 (audit P-8) the target side of the comparison is
# rendered in that spelling (rule.cyr's "Canonical spellings") and the live
# side drops counter and quota state; ops still carry the body as rendered.
# Through 1.9.1 the bodies were compared as written, and every chain holding
# such a rule was rebuilt on every diff, resetting its counters.

# ================================================================
# LiveRule struct — { family, table, chain, body, handle, cmp, src }
# Layout: [family:8][table:8][chain:8][body:8][handle:8][cmp:8][src:8] = 56
# All name fields are cstrings; handle is i64. Two fields only the diff sets
# (1.9.2): `cmp`, the form it compares (0 means the body itself), and `src`,
# a target rule's chain rule, so its body is rendered only for an add op.
# ================================================================

fn _live_rule_new(family: cstring, table: cstring, chain: cstring,
  body: cstring, handle: i64): i64 {
    var lr = alloc(56);
    store64(lr, family);
    store64(lr + 8, table);
    store64(lr + 16, chain);
    store64(lr + 24, body);
    store64(lr + 32, handle);
    store64(lr + 40, 0);
    store64(lr + 48, 0);
    return lr;
}

fn live_rule_family(lr: i64): cstring { return load64(lr); }
fn live_rule_table(lr: i64): cstring { return load64(lr + 8); }
fn live_rule_chain(lr: i64): cstring { return load64(lr + 16); }
fn live_rule_body(lr: i64): cstring { return load64(lr + 24); }
fn live_rule_handle(lr: i64): i64 { return load64(lr + 32); }

# The body as the diff compares it.
fn _live_rule_cmp(lr: i64): cstring {
    var c = load64(lr + 40);
    if (c != 0) { return c; }
    return load64(lr + 24);
}

fn _live_rule_set_cmp(lr: i64, c: cstring): i64 {
    store64(lr + 40, c);
    return 0;
}

# ================================================================
# Stateful values — dropped before comparing (1.9.2, audit P-8)
# ================================================================
# nft lists a counter with its values (`counter packets 6 bytes 504`) and a
# quota with what it has used (` used 5 kbytes`). Those are state, not the
# rule: nein renders a bare `counter`, so through 1.9.1 every chain with a
# counter in it compared unequal and was rebuilt — counters reset — on every
# diff. Removed only outside quoted strings and only at a token start, so a
# comment or log prefix that spells `counter packets 1 bytes 2` is untouched.

# Index just past a run of decimal digits at s[i], or -1 when there is none.
fn _diff_digits(s: cstring, i: i64): i64 {
    var j = i;
    while (load8(s + j) >= 48 && load8(s + j) <= 57) { j = j + 1; }
    if (j == i) { return 0 - 1; }
    return j;
}

# Index just past " <digits> <unit>" at s[i] — unit bytes, kbytes or mbytes,
# the units nft lists a quota in — or -1.
fn _diff_amount(s: cstring, i: i64): i64 {
    if (load8(s + i) != 32) { return 0 - 1; }
    var j = _diff_digits(s, i + 1);
    if (j < 0 || load8(s + j) != 32) { return 0 - 1; }
    j = j + 1;
    if (_cstr_starts_with(s + j, "bytes") == 1) { return j + 5; }
    if (_cstr_starts_with(s + j, "kbytes") == 1) { return j + 6; }
    if (_cstr_starts_with(s + j, "mbytes") == 1) { return j + 6; }
    return 0 - 1;
}

# 1 when s[i] ends a token: the end of the body or a space.
fn _diff_tok_end(s: cstring, i: i64): i64 {
    if (load8(s + i) == 0 || load8(s + i) == 32) { return 1; }
    return 0;
}

# `body` without counter values and quota usage; `body` itself when it has
# neither. Nothing is copied until something is dropped: most bodies hold
# neither, and the diff strips every live rule.
fn _diff_strip_state(body: cstring): cstring {
    if (body == 0) { return 0; }
    var len = strlen(body);
    var sb = 0;
    var from = 0;   # body[from..i) is still to be copied
    var q = 0;
    var tok = 1;
    var i = 0;
    while (i < len) {
        var c0 = load8(body + i);
        if (q == 0 && tok == 1 && (c0 == 99 || c0 == 113)) {   # 'c', 'q'
            var keep = 0 - 1;   # body[i..keep) stays, body[keep..skip) goes
            var skip = 0;
            if (_cstr_starts_with(body + i, "counter packets ") == 1) {
                var j = _diff_digits(body, i + 16);
                if (j >= 0 && _cstr_starts_with(body + j, " bytes ") == 1) {
                    var k = _diff_digits(body, j + 7);
                    if (k >= 0 && _diff_tok_end(body, k) == 1) { keep = i + 7; skip = k; }
                }
            } elif (_cstr_starts_with(body + i, "quota ") == 1) {
                var a = i + 5;
                if (_cstr_starts_with(body + a, " over ") == 1) { a = a + 5; }
                var e = _diff_amount(body, a);
                if (e >= 0 && _cstr_starts_with(body + e, " used") == 1) {
                    var u = _diff_amount(body, e + 5);
                    if (u >= 0 && _diff_tok_end(body, u) == 1) { keep = e; skip = u; }
                }
            }
            if (keep >= 0) {
                if (sb == 0) { sb = str_builder_new(); }
                str_builder_add(sb, str_new(body + from, keep - from));
                from = skip;
                i = skip;
                tok = 0;
                continue;
            }
        }
        if (c0 == 34) { q = 1 - q; }
        tok = 0;
        if (q == 0 && c0 == 32) { tok = 1; }
        i = i + 1;
    }
    if (sb == 0) { return body; }
    str_builder_add(sb, str_new(body + from, len - from));
    return str_cstr(str_builder_build(sb));
}

# ================================================================
# Live ruleset parser — extracts LiveRule tuples from `nft list ruleset -a`
# ================================================================

# After a header's name, exactly what nft prints: " {", then either the end
# of the line or " # handle N" and the end. 1 when that holds. (The fuzz
# harness found `table inet fil{ ter {` slipping past a looser check.)
fn _header_rest_is_open(p: cstring): i64 {
    if (load8(p) != 32 || load8(p + 1) != 123) { return 0; }
    p = p + 2;
    if (load8(p) == 0) { return 1; }
    if (_cstr_starts_with(p, " # handle ") == 0) { return 0; }
    p = p + 10;
    var d = 0;
    while (load8(p) >= 48 && load8(p) <= 57) { p = p + 1; d = d + 1; }
    if (d == 0 || load8(p) != 0) { return 0; }
    return 1;
}

# Parse the "FAMILY NAME" suffix of a `table FAMILY NAME { # handle N`
# header. Sets *family_out and *table_out to fresh cstrings. Returns
# the position past the parsed names (or 0 on parse failure).
fn _parse_table_header(line: cstring): i64 {
    # Skip "table "
    var p = line + 6;
    var family_start = p;
    while (load8(p) != 32 && load8(p) != 0) { p = p + 1; }   # ' '
    if (load8(p) == 0) { return 0; }
    var family_len = p - family_start;
    var family = alloc(family_len + 1);
    memcpy(family, family_start, family_len);
    store8(family + family_len, 0);

    p = p + 1;   # skip space
    var name_start = p;
    while (load8(p) != 32 && load8(p) != 123 && load8(p) != 0) { p = p + 1; }
    var name_len = p - name_start;
    # Exactly `table FAMILY NAME {` (1.8.2, audit P-4): a name nft printed with
    # a space in it — `table inet filter x {` — used to parse as `filter`, a
    # VALID name, and that foreign table's rules were attributed to nein's.
    if (_header_rest_is_open(p) == 0) { return 0; }
    var name = alloc(name_len + 1);
    memcpy(name, name_start, name_len);
    store8(name + name_len, 0);

    # Store both in a 16-byte alloc — caller pulls family + name out.
    var out = alloc(16);
    store64(out, family);
    store64(out + 8, name);
    return out;
}

# Parse "chain NAME { # handle N" — extracts the chain name.
fn _parse_chain_header(line: cstring): cstring {
    var p = line + 6;   # skip "chain "
    var start = p;
    while (load8(p) != 32 && load8(p) != 123 && load8(p) != 0) { p = p + 1; }
    var len = p - start;
    if (_header_rest_is_open(p) == 0) { return 0; }   # exactly `chain NAME {` (P-4)
    var name = alloc(len + 1);
    memcpy(name, start, len);
    store8(name + len, 0);
    return name;
}

# Strip a `# handle N` suffix from a rule line. Returns (body_cstr, handle).
# A 16-byte alloc holds [body:8][handle:8]; handle is 0 if no handle present.
#
# QUOTE-AWARE since 1.6.10 (audit H-6). The old scan walked backwards looking
# for the last textual " # handle " with no notion of quoting, so a rule whose
# COMMENT contained that literal text — `comment "x # handle 9"` — had its body
# truncated at the comment and a handle read out of the comment text. The
# mis-parsed rule then drove add/delete decisions. Now the scan runs forward
# tracking quote state and only accepts a marker outside quotes. Backslash is
# not an escape inside nft quoted strings (verified against nftables 1.1.6),
# so every `"` toggles.
#
# The handle integer is also bounded (audit MEDIUM): the old accumulator was
# `handle = handle * 10 + digit` with no limit, so 20 digits silently wrapped
# and produced a `delete rule ... handle <wrapped>` that could target an
# unrelated rule. More than 18 digits, or no digits at all, now yields handle
# 0 — which _emit_del_rule refuses to build an op from.
fn _strip_handle_suffix(trimmed: cstring): i64 {
    var len = strlen(trimmed);
    var marker = " # handle ";
    var mlen = strlen(marker);

    # Forward scan: remember the last marker position that is OUTSIDE quotes.
    var found = 0 - 1;
    var in_quote = 0;
    var i = 0;
    while (i < len) {
        var c = load8(trimmed + i);
        if (c == 34) {
            if (in_quote == 0) { in_quote = 1; } else { in_quote = 0; }
        } elif (in_quote == 0 && i + mlen <= len) {
            var ok = 1;
            var j = 0;
            while (j < mlen) {
                if (load8(trimmed + i + j) != load8(marker + j)) { ok = 0; break; }
                j = j + 1;
            }
            if (ok == 1) { found = i; }
        }
        i = i + 1;
    }

    if (found < 0) {
        # No handle marker outside quotes — body is the whole line.
        var body1 = alloc(len + 1);
        memcpy(body1, trimmed, len);
        store8(body1 + len, 0);
        var out1 = alloc(16);
        store64(out1, body1);
        store64(out1 + 8, 0);
        return out1;
    }

    # Body is [0, found); handle is the bounded integer at found+mlen.
    var body = alloc(found + 1);
    memcpy(body, trimmed, found);
    store8(body + found, 0);

    var hp = trimmed + found + mlen;
    var handle = 0;
    var digits = 0;
    while (load8(hp) >= 48 && load8(hp) <= 57) {
        if (digits >= 18) { handle = 0; digits = 0 - 1; break; }
        handle = handle * 10 + (load8(hp) - 48);
        digits = digits + 1;
        hp = hp + 1;
    }
    # The handle must END the line (1.8.2, audit P-4). A quote smuggled into a
    # comment through `nft -j` defeats the quote tracker above, so
    # `accept comment "x" # handle 3" # handle 4` would read handle 3 where
    # the real one is 4. Anything after the digits fails closed.
    if (digits > 0 && load8(hp) != 0) { digits = 0; }
    if (digits <= 0) {
        # No digits, or an over-long run that could have wrapped. Fail closed:
        # handle 0 makes _emit_del_rule suppress the op entirely.
        var sk_bh = "nein.diff: unparseable rule handle — treated as absent";
        sakshi_warn(sk_bh, strlen(sk_bh));
        handle = 0;
    }

    var out = alloc(16);
    store64(out, body);
    store64(out + 8, handle);
    return out;
}

# 1 when a line holds an odd number of '"'. nft prints quoted strings
# verbatim — a comment created with an embedded newline or quote comes back
# split or unbalanced — so a line whose quotes do not balance cannot be
# trusted to say where its body or its handle is (1.8.2, audit P-4).
fn _quotes_unbalanced(s: cstring): i64 {
    var n = 0;
    var i = 0;
    var len = strlen(s);
    while (i < len) {
        if (load8(s + i) == 34) { n = n + 1; }
        i = i + 1;
    }
    return n & 1;
}

# Parse the live ruleset into a Vec of LiveRule tuples. `bad` gets 1 when the
# listing cannot be trusted (a line with unbalanced quotes); those lines are
# skipped. Block structure follows the shared rules in inspect.cyr
# (_line_opens_block / _line_closes_block).
fn _diff_parse(raw_str: Str, bad: i64): i64 {
    store64(bad, 0);
    var data = str_data(raw_str);
    var len = str_len(raw_str);
    var rules = vec_new();
    var line_start = 0;
    var i = 0;

    var current_family = 0;
    var current_table = 0;
    var current_chain = 0;

    var diff_bstack[128];
    var bs_depth = 0;
    store64(&diff_bstack, BLOCK_NONE);

    # An anonymous chain inside a rule (audit P-3): nft prints it as
    # `ip saddr 1.2.3.4 jump {` / inner rules / `} # handle N`. Through 1.8.1
    # the opening line became a handle-0 rule, each inner rule another, and
    # the close a phantom rule carrying the real handle — which blocked the
    # chain for good. It is now read as ONE rule, its handle from the close.
    var anon_sb = 0;
    var anon_depth = 0;

    while (i <= len) {
        var at_end = 0;
        if (i == len) { at_end = 1; }
        var c = 0;
        if (at_end == 0) { c = load8(data + i); }
        if (at_end == 1 || c == 10) {
            var line_len = i - line_start;
            if (line_len > 0 || at_end == 0) {
                var trimmed = _trim_line(data + line_start, line_len);
                var tlen = strlen(trimmed);
                if (tlen > 0) {
                    var current_block = load64(&diff_bstack + bs_depth * 8);
                    if (_quotes_unbalanced(trimmed) == 1) {
                        store64(bad, 1);
                        var sk_q = "nein.diff: unbalanced quotes in the live listing — not trusted";
                        sakshi_error(sk_q, strlen(sk_q));
                    }

                    if (anon_depth > 0) {
                        if (_line_closes_block(trimmed) == 1) {
                            anon_depth = anon_depth - 1;
                            if (anon_depth == 0) {
                                var bh0 = _strip_handle_suffix(trimmed);
                                str_builder_add_cstr(anon_sb, " ");
                                str_builder_add_cstr(anon_sb, load64(bh0));
                                if (current_family == 0 || current_table == 0 || current_chain == 0) {
                                    var sk_da = "nein.diff: anonymous chain outside a usable chain — skipped";
                                    sakshi_warn(sk_da, strlen(sk_da));
                                } else {
                                    vec_push(rules, _live_rule_new(current_family, current_table,
                                        current_chain, str_cstr(str_builder_build(anon_sb)), load64(bh0 + 8)));
                                }
                                anon_sb = 0;
                            } else {
                                str_builder_add_cstr(anon_sb, " ");
                                str_builder_add_cstr(anon_sb, trimmed);
                            }
                        } else {
                            if (_line_ends_open(trimmed) == 1) { anon_depth = anon_depth + 1; }
                            str_builder_add_cstr(anon_sb, " ");
                            str_builder_add_cstr(anon_sb, trimmed);
                        }
                    } else {
                        var opens = _line_opens_block(trimmed, current_block);
                        if (_line_closes_block(trimmed) == 1) {
                            if (bs_depth > 0) { bs_depth = bs_depth - 1; }
                            if (bs_depth == 0) {
                                current_family = 0;
                                current_table = 0;
                            }
                        } elif (opens == BLOCK_ANON) {
                            anon_depth = 1;
                            anon_sb = str_builder_new();
                            str_builder_add_cstr(anon_sb, trimmed);
                        } elif (opens == BLOCK_TABLE) {
                            # Names are validated (audit P-4 / P-5): nft prints
                            # them verbatim, and one created through `nft -j`
                            # with a space or a tab was truncated or carried
                            # its payload into the ops. A table or chain whose
                            # name is not a plain identifier is foreign by
                            # definition — nein never makes one — so its rules
                            # are skipped, never attributed elsewhere.
                            current_family = 0;
                            current_table = 0;
                            var th = _parse_table_header(trimmed);
                            if (th != 0) {
                                var tf_t, tf_v = validate_family(load64(th));
                                var tn_t, tn_v = validate_identifier(load64(th + 8));
                                if (is_err_result(tf_t) == 0 && is_err_result(tn_t) == 0) {
                                    current_family = load64(th);
                                    current_table = load64(th + 8);
                                }
                            }
                            if (bs_depth < 15) {
                                bs_depth = bs_depth + 1;
                                store64(&diff_bstack + bs_depth * 8, BLOCK_TABLE);
                            }
                        } elif (opens == BLOCK_CHAIN) {
                            current_chain = _parse_chain_header(trimmed);
                            var cn_t, cn_v = validate_identifier(current_chain);
                            if (is_err_result(cn_t) == 1) { current_chain = 0; }
                            if (bs_depth < 15) {
                                bs_depth = bs_depth + 1;
                                store64(&diff_bstack + bs_depth * 8, BLOCK_CHAIN);
                            }
                        } elif (opens != BLOCK_NONE) {
                            if (bs_depth < 15) {
                                bs_depth = bs_depth + 1;
                                store64(&diff_bstack + bs_depth * 8, opens);
                            }
                        } elif (current_block == BLOCK_CHAIN) {
                            if (_cstr_starts_with(trimmed, "type ") == 1) {
                                # not a rule
                            } elif (_cstr_starts_with(trimmed, "policy ") == 1) {
                                # not a rule
                            } elif (_line_is_chain_comment(trimmed) == 1) {
                                # the chain's own comment line (audit P-3)
                            } elif (load8(trimmed) == 35) {
                                # comment line
                            } elif (_quotes_unbalanced(trimmed) == 1) {
                                # untrusted (flagged above) — never a LiveRule
                            } else {
                                # Defence in depth (1.6.9): never build a LiveRule
                                # with a NULL family/table/chain — they are zeroed
                                # when the brace stack unwinds to 0 and when a
                                # header's name is unusable, and every consumer
                                # hands them to streq() -> strlen(NULL).
                                if (current_family == 0 || current_table == 0
                                  || current_chain == 0) {
                                    var sk_ds = "nein.diff: rule outside a usable table/chain — skipped";
                                    sakshi_warn(sk_ds, strlen(sk_ds));
                                } else {
                                    var bh = _strip_handle_suffix(trimmed);
                                    var lr = _live_rule_new(current_family,
                                      current_table,
                                      current_chain,
                                      load64(bh),
                                      load64(bh + 8));
                                    vec_push(rules, lr);
                                }
                            }
                        }
                    }
                }
            }
            line_start = i + 1;
        }
        i = i + 1;
    }
    # A listing that ends inside an anonymous chain is truncated: untrusted.
    if (anon_depth > 0) { store64(bad, 1); }
    return rules;
}

# Parse the live ruleset into a Vec of LiveRule tuples. Lines the parser
# cannot trust are skipped; nein_diff uses the status-reporting form above and
# refuses to act on such a listing.
fn diff_parse_live(raw_str: Str): i64 {
    var bad[8];
    return _diff_parse(raw_str, &bad);
}

# ================================================================
# Target rule extraction — walk a Firewall, yield Vec of LiveRule
# tuples (with handle=0 — target rules don't have handles).
# ================================================================

fn _family_to_cstr(fam: i64): cstring {
    if (fam == FAMILY_INET) { return "inet"; }
    if (fam == FAMILY_IP) { return "ip"; }
    if (fam == FAMILY_IP6) { return "ip6"; }
    if (fam == FAMILY_ARP) { return "arp"; }
    if (fam == FAMILY_BRIDGE) { return "bridge"; }
    if (fam == FAMILY_NETDEV) { return "netdev"; }
    return "inet";
}

fn _render_to_cstr(s: Str): cstring {
    var slen = str_len(s);
    var out = alloc(slen + 1);
    memcpy(out, str_data(s), slen);
    store8(out + slen, 0);
    return out;
}

fn diff_target_rules(fw: i64): i64 { return _diff_target_rules_x(fw, 1); }

# `written` 0 (the diff's own path): only the form nft lists is rendered; the
# body as written is rendered by _emit_add_rule, for the rules that need it.
# A chain in sync then costs one render per rule, not two.
fn _diff_target_rules_x(fw: i64, written: i64): i64 {
    var rules = vec_new();
    var tables = firewall_tables(fw);
    var tlen = vec_len(tables);
    var ti = 0;
    while (ti < tlen) {
        var t = vec_get(tables, ti);
        var family_cstr = _family_to_cstr(table_family(t));
        var table_name = table_name(t);
        var chains = table_chains(t);
        var clen = vec_len(chains);
        var ci = 0;
        while (ci < clen) {
            var ch = vec_get(chains, ci);
            var chain_name = chain_name(ch);
            var crules = chain_rules(ch);
            var rlen = vec_len(crules);
            var ri = 0;
            while (ri < rlen) {
                var cr = vec_get(crules, ri);
                # FAIL CLOSED (1.6.9). Until now this rendered straight to text
                # with no validation anywhere on the diff path, so nein_diff
                # piped un-validated rule bodies to `nft -f -` while
                # apply_firewall validated the same tree first. A rule that
                # cannot be validated is DROPPED from the target set rather
                # than emitted: refusing to add a rule is always safer than
                # adding one whose contents were never checked.
                if (is_err_result(chain_rule_validate(cr)) == 1) {
                    var sk_inv = "nein.diff: target rule failed validation — not emitted";
                    sakshi_error(sk_inv, strlen(sk_inv));
                    ri = ri + 1;
                    continue;
                }
                var body = 0;
                if (written == 1) { body = _render_to_cstr(chain_rule_render(cr)); }
                var tlr = _live_rule_new(family_cstr, table_name, chain_name, body, 0);
                store64(tlr + 48, cr);
                # Compared in the spelling nft lists it in (1.9.2, audit P-8).
                _live_rule_set_cmp(tlr, _diff_strip_state(_render_to_cstr(
                      _chain_rule_render_canon(cr, table_family(t)))));
                vec_push(rules, tlr);
                ri = ri + 1;
            }
            ci = ci + 1;
        }
        ti = ti + 1;
    }
    return rules;
}

# ================================================================
# Diff computation — emit nft commands to converge live → target.
# Returns Vec<cstring>: each entry is a complete nft command line
# (including trailing newline) suitable for piping into `nft -f -`.
# ================================================================

# Match a target rule against the live ruleset. Returns 1 if any
# live rule has the same (family, table, chain) and compares equal; 0
# otherwise.
fn _target_in_live(target_rule: i64, live_rules: i64): i64 {
    var fam = live_rule_family(target_rule);
    var tab = live_rule_table(target_rule);
    var chn = live_rule_chain(target_rule);
    var body = _live_rule_cmp(target_rule);
    var n = vec_len(live_rules);
    var i = 0;
    while (i < n) {
        var lr = vec_get(live_rules, i);
        if (streq(live_rule_family(lr), fam) == 1
          && streq(live_rule_table(lr), tab) == 1
          && streq(live_rule_chain(lr), chn) == 1
          && streq(_live_rule_cmp(lr), body) == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

# Every name an op interpolates is checked (1.8.2, audit P-5). Through 1.8.1
# none was: a live chain created through `nft -j` with the name
# `A<TAB>handle<TAB>2;delete<TAB>table<TAB>inet<TAB>filter;#` produced a
# delete op that, applied, deleted nein's whole table; and a TARGET chain
# name reached `diff_compute` + `diff_apply` unvalidated (firewall_validate
# catches it only on the nein_diff path). 0 when any name is unusable.
fn _diff_names_ok(rule: i64): i64 {
    var f_t, f_v = validate_family(live_rule_family(rule));
    if (is_err_result(f_t) == 1) { return 0; }
    var t_t, t_v = validate_nft_name(live_rule_table(rule));
    if (is_err_result(t_t) == 1) { return 0; }
    var c_t, c_v = validate_nft_name(live_rule_chain(rule));
    if (is_err_result(c_t) == 1) { return 0; }
    return 1;
}

# Build "add rule FAM TAB CHN BODY\n", or 0 if a name is unusable.
fn _emit_add_rule(rule: i64): cstring {
    if (_diff_names_ok(rule) == 0) {
        var sk_an = "nein.diff: unusable table/chain name — add op refused";
        sakshi_error(sk_an, strlen(sk_an));
        return 0;
    }
    var body = live_rule_body(rule);
    if (body == 0 && load64(rule + 48) != 0) { body = _render_to_cstr(chain_rule_render(load64(rule + 48))); }
    if (body == 0) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "add rule ");
    str_builder_add_cstr(sb, live_rule_family(rule));
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, live_rule_table(rule));
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, live_rule_chain(rule));
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, body);
    str_builder_add_cstr(sb, "\n");
    return _render_to_cstr(str_builder_build(sb));
}

# Build "delete rule FAM TAB CHN handle N\n"
fn _emit_del_rule(rule: i64): cstring {
    # Handle 0 is not a real nft handle — it is what _strip_handle_suffix
    # returns when a line carried no `# handle N` suffix at all. Emitting
    # `delete rule ... handle 0` makes nft reject the ENTIRE batch, so a
    # single unparsed line silently discarded every add in the same
    # transaction. Refuse to build the op instead (1.6.9).
    if (live_rule_handle(rule) == 0) {
        var sk_h0 = "nein.diff: live rule has no handle — delete op suppressed";
        sakshi_error(sk_h0, strlen(sk_h0));
        return 0;
    }
    if (_diff_names_ok(rule) == 0) {
        var sk_dn = "nein.diff: unusable table/chain name — delete op refused";
        sakshi_error(sk_dn, strlen(sk_dn));
        return 0;
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "delete rule ");
    str_builder_add_cstr(sb, live_rule_family(rule));
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, live_rule_table(rule));
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, live_rule_chain(rule));
    str_builder_add_cstr(sb, " handle ");
    str_builder_add_int(sb, live_rule_handle(rule));
    str_builder_add_cstr(sb, "\n");
    return _render_to_cstr(str_builder_build(sb));
}

# Each live rule's comparison form: its body without counter or quota state.
fn _diff_live_cmp(live_rules: i64): i64 {
    var i = 0;
    while (i < vec_len(live_rules)) {
        var lr = vec_get(live_rules, i);
        _live_rule_set_cmp(lr, _diff_strip_state(live_rule_body(lr)));
        i = i + 1;
    }
    return 0;
}

# Do two LiveRules belong to the same (family, table, chain)?
fn _same_chain(a: i64, b: i64): i64 {
    if (streq(live_rule_family(a), live_rule_family(b)) != 1) { return 0; }
    if (streq(live_rule_table(a), live_rule_table(b)) != 1) { return 0; }
    if (streq(live_rule_chain(a), live_rule_chain(b)) != 1) { return 0; }
    return 1;
}

# Are the two sides' rule bodies for this chain identical AND in the same
# order? Order is the whole point — see diff_compute's note.
fn _chain_in_sync(key: i64, target_rules: i64, live_rules: i64): i64 {
    var ti = 0; var li = 0;
    var tn = vec_len(target_rules); var ln = vec_len(live_rules);

    while (1 == 1) {
        while (ti < tn && _same_chain(vec_get(target_rules, ti), key) == 0) { ti = ti + 1; }
        while (li < ln && _same_chain(vec_get(live_rules, li), key) == 0) { li = li + 1; }
        if (ti >= tn && li >= ln) { return 1; }        # both exhausted together
        if (ti >= tn || li >= ln) { return 0; }        # one side has extra rules
        if (streq(_live_rule_cmp(vec_get(target_rules, ti)),
            _live_rule_cmp(vec_get(live_rules, li))) != 1) { return 0; }
        ti = ti + 1; li = li + 1;
    }
    return 1;
}

# Compute the diff: returns Vec<cstring> of nft commands.
# Empty vec = already in sync.
#
# ORDER-PRESERVING since 1.6.10 (audit H-5). The previous implementation
# treated each chain as an unordered SET: any target rule whose body already
# existed live was considered satisfied, and every other one became
# `add rule ...`, which nft APPENDS to the end of the chain. Rule order is
# nftables' evaluation semantics, so that could leave a chain matching neither
# the old nor the target ruleset. The concrete case: live `input` holds
# `ip saddr 10.0.0.0/8 accept`; the target prepends
# `ip saddr 10.0.0.5/32 drop` to block a compromised host. The accept already
# matched, so only the drop was emitted — and it landed AFTER the accept.
# The host stayed permitted. The old header comment called the byte-equality
# strategy "conservative but always correct"; it was not.
#
# Strategy now: compare each chain as an ORDERED sequence. A chain already in
# sync emits nothing, so the common no-op case stays free. A chain that
# differs in any way is rebuilt — every live rule deleted, every target rule
# re-added in order. That is safe because diff_apply concatenates all ops into
# a SINGLE `nft -f -`, and nftables commits a batch atomically: no packet ever
# observes a half-built chain.
#
# Fail-closed case: if a differing chain contains a live rule with no usable
# handle, it cannot be deleted — and re-adding the target rules on top would
# duplicate rather than replace. Such a chain is skipped entirely with an
# error rather than half-converged — and since 1.8.2 that is REPORTED: the
# status form returns NEIN_ERR_PARSE, and nein_diff then applies nothing
# (it used to return Ok with the chain silently left as it was; audit P-3).
#
# TARGET-SCOPED since 1.8.2 (audit P-1, HIGH). Through 1.8.1 every chain on
# EITHER side became a key, so a live chain the target never mentions was
# "out of sync" and every rule in it was deleted: with nein's `inet filter`
# fully in sync, a docker-style `ip nat POSTROUTING` masquerade was deleted
# (verified against nft 1.1.7). stiva, aegis, daimon, docker, libvirt and
# kube-proxy on one host would each have wiped the others' rules. Only the
# chains the target firewall declares are reconciled now — including an
# EMPTY target chain, which is how a caller empties one of its own chains.
# This also bounds the work by the target's chain count (audit P-6: the old
# key build was quadratic in the live chain count — 22.9 s at 8,000 chains).
# One key per chain the TARGET declares (rules or not).
fn _diff_target_keys(fw: i64): i64 {
    var keys = vec_new();
    var tables = firewall_tables(fw);
    var ti = 0;
    while (ti < vec_len(tables)) {
        var t = vec_get(tables, ti);
        var chains = table_chains(t);
        var ci = 0;
        while (ci < vec_len(chains)) {
            vec_push(keys, _live_rule_new(_family_to_cstr(table_family(t)), table_name(t),
                chain_name(vec_get(chains, ci)), 0, 0));
            ci = ci + 1;
        }
        ti = ti + 1;
    }
    return keys;
}

# The diff, with a status: `status_out` gets 0, or NEIN_ERR_PARSE when the
# live listing could not be trusted (then no ops at all are returned) or a
# target chain could not be converged (then its ops are withheld).
fn _diff_compute(target_fw: i64, live_raw: Str, status_out: i64): i64 {
    store64(status_out, 0);
    var ops = vec_new();
    var target_rules = _diff_target_rules_x(target_fw, 0);
    var bad[8];
    var live_rules = _diff_parse(live_raw, &bad);
    if (load64(&bad) != 0) {
        var sk_untr = "nein.diff: live listing not trusted — no ops computed";
        sakshi_error(sk_untr, strlen(sk_untr));
        store64(status_out, NEIN_ERR_PARSE);
        return ops;
    }
    _diff_live_cmp(live_rules);

    var keys = _diff_target_keys(target_fw);
    var ki = 0;
    while (ki < vec_len(keys)) {
        var key = vec_get(keys, ki);

        if (_chain_in_sync(key, target_rules, live_rules) == 1) {
            ki = ki + 1;
            continue;
        }

        # Build this chain's ops on the side; they join `ops` only if every
        # one of them could be built — a chain is converged whole or not at all.
        var chain_ops = vec_new();
        var ok = 1;
        var l = 0;
        while (l < vec_len(live_rules)) {
            var lr = vec_get(live_rules, l);
            if (_same_chain(lr, key) == 1) {
                var del_op = _emit_del_rule(lr);
                if (del_op == 0) { ok = 0; } else { vec_push(chain_ops, del_op); }
            }
            l = l + 1;
        }
        var t = 0;
        while (t < vec_len(target_rules)) {
            var tr = vec_get(target_rules, t);
            if (_same_chain(tr, key) == 1) {
                var add_op = _emit_add_rule(tr);
                if (add_op == 0) { ok = 0; } else { vec_push(chain_ops, add_op); }
            }
            t = t + 1;
        }
        if (ok == 0) {
            var sk_blk = "nein.diff: chain not converged (no-handle live rule or unusable name) — untouched";
            sakshi_error(sk_blk, strlen(sk_blk));
            store64(status_out, NEIN_ERR_PARSE);
        } else {
            var oi = 0;
            while (oi < vec_len(chain_ops)) { vec_push(ops, vec_get(chain_ops, oi)); oi = oi + 1; }
        }
        ki = ki + 1;
    }

    return ops;
}

# Compute the diff: Vec<cstring> of nft commands, empty when in sync — or
# when the live listing could not be trusted, or no target chain could be
# converged. Use nein_diff (which reports those as Err) to act on it.
fn diff_compute(target_fw: i64, live_raw: Str): i64 {
    var st[8];
    return _diff_compute(target_fw, live_raw, &st);
}

# ================================================================
# Apply a diff — concatenate ops into a single `nft -f -` invocation
# so the kernel applies them atomically (transaction semantics).
# ================================================================

fn diff_apply(ops: i64): i64 {
    var n = vec_len(ops);
    if (n == 0) { return nein_ok(); }

    var sb = str_builder_new();
    var i = 0;
    while (i < n) {
        str_builder_add_cstr(sb, vec_get(ops, i));
        i = i + 1;
    }
    var combined = str_builder_build(sb);
    return apply_ruleset_str(combined);
}

# ================================================================
# Convenience: list live + compute diff + apply.
# Returns Vec<cstring> of ops that WERE applied, or Err on failure.
#
# Honors the target firewall's dry-run flag: the live ruleset is still listed
# and the op set still computed, but nothing is applied. The returned Vec is
# then the set of ops that WOULD have been applied — which is exactly what a
# dry-run caller wants to inspect. Same `!= 0` fail-safe check as
# `apply_firewall`.
# ================================================================

fn nein_diff(target_fw: i64): i64 {
    # Validate the whole target tree before anything is rendered or applied.
    # apply_firewall has always done this; the diff path did not, which made
    # nein_diff a way to reach `nft -f -` with un-validated rule text (1.6.9).
    var vr1_t, vr1_v = firewall_validate(target_fw);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }

    # `-a` is required: without it nft omits the `# handle N` suffixes and
    # every parsed live rule gets handle 0, so every delete op was emitted as
    # `delete rule ... handle 0` and nft rejected the whole batch (1.6.9).
    var live_res1_t, live_res1_v = list_ruleset_with_handles();
    if (is_err_result(live_res1_t) == 1) { return Err(live_res1_v); }
    var live_raw = live_res1_v;
    var dst[8];
    var ops = _diff_compute(target_fw, live_raw, &dst);
    # A listing nein cannot trust, or a chain it cannot converge, is an error
    # and NOTHING is applied (1.8.2, audit P-3): through 1.8.1 nein_diff
    # returned Ok with that chain silently left as it was.
    if (load64(&dst) != 0) { return nein_err(load64(&dst)); }
    if (firewall_dry_run(target_fw) != 0) {
        var sk_dry = "nein.diff: dry-run set — ops computed but not applied";
        sakshi_info(sk_dry, strlen(sk_dry));
        return Ok(ops);
    }
    var apply_res1_t, apply_res1_v = diff_apply(ops);
    if (is_err_result(apply_res1_t) == 1) { return Err(apply_res1_v); }
    return Ok(ops);
}

# ================================================================
# Comment-keyed handle lookup
#
# The live-rule parser above keys on rule BODY. This pair keys on the rule's
# nft comment instead, which is how a consumer finds "every rule I created for
# agent X" without having to reconstruct the exact rendered text. That is the
# input `add_rule_after_live` / `delete_rule_live` need: both take a handle,
# and until now nothing produced one from a comment.
#
# The needle is `comment "PREFIX` — the opening quote is part of it, so a
# prefix cannot match inside some other rule's operand text.
# ================================================================

# Substring search over cstrings. Returns 1 if haystack contains needle.
fn _cstr_contains(haystack: cstring, needle: cstring): i64 {
    var nlen = strlen(needle);
    if (nlen == 0) { return 1; }
    var hlen = strlen(haystack);
    if (nlen > hlen) { return 0; }

    var i = 0;
    while (i <= hlen - nlen) {
        var j = 0;
        while (j < nlen && load8(haystack + i + j) == load8(needle + j)) {
            j = j + 1;
        }
        if (j == nlen) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Pure function — parse `nft -a` output and keep only rules whose comment
# starts with `comment_prefix`. Separated from the subprocess call so it is
# testable against captured nft output without root. Returns Vec<LiveRule>.
fn parse_rules_with_handles(raw_str: Str, comment_prefix: cstring): i64 {
    var all = diff_parse_live(raw_str);
    var out = vec_new();

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "comment \"");
    str_builder_add_cstr(sb, comment_prefix);
    var needle = str_cstr(str_builder_build(sb));

    var n = vec_len(all);
    var i = 0;
    while (i < n) {
        var lr = vec_get(all, i);
        if (_cstr_contains(live_rule_body(lr), needle) == 1) {
            vec_push(out, lr);
        }
        i = i + 1;
    }
    return out;
}

# Find live rules in one table whose comment starts with `comment_prefix`.
# Returns Ok(Vec<LiveRule>) or Err. All three arguments are validated before
# any subprocess runs — comment_prefix goes through validate_comment because
# it is operator input that reaches an execve argv via the table listing.
fn find_rules_by_comment(family: cstring, table: cstring, comment_prefix: cstring): i64 {
    var vr1_t, vr1_v = validate_comment(comment_prefix);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }

    # list_table_with_handles validates family + table itself.
    var res1_t, res1_v = list_table_with_handles(family, table);
    if (is_err_result(res1_t) == 1) { return Err(res1_v); }

    return Ok(parse_rules_with_handles(res1_v, comment_prefix));
}
