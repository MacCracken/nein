# nein mcp module — MCP tool descriptors + handlers over bote's core
#
# Exposes nein's firewall operations as Model Context Protocol tools so
# an agent host can drive nein through bote's Dispatcher / ToolRegistry.
# nein owns no transport — the consuming binary builds the dispatcher and
# a transport (stdio/http/...), then calls `nein_tools_register(d)` to
# mount these tools. Handlers follow bote's 2.0 ABI: fn(args, claims) ->
# result_cstr, where `args` is the raw JSON `arguments` object (cstr) and
# the return is a `{"content":[...],"isError":bool}` envelope cstr.
#
# Tools (merged agent-ergonomic + diff surface), by class (1.9.0):
#   nein_validate {protocol,port,source?,table?,chain?} -> ok / error      OFFLINE
#   nein_status   {}                                  -> table/rule summary READS_LIVE
#   nein_list     {table?,chain?}                      -> live rules        READS_LIVE
#   nein_diff     {rules:[{protocol,port,verdict}]}    -> nft ops vs live   READS_LIVE
#   nein_allow    {protocol,port,source?,table?,chain?} -> add accept rule  MUTATES
#   nein_deny     {protocol,port,source?,table?,chain?} -> add drop rule    MUTATES
# Without a host gate only OFFLINE runs; see the gate section.
#
# Depends on the bote-core bundle ([deps.bote-core] -> lib/bote-core.cyr): the
# dispatcher/registry/schema/jsonx surface + _json_emit_escaped. Backing
# nein ops come from the modules included ahead of this one (inspect.cyr,
# apply.cyr, validate.cyr, diff.cyr, rule.cyr, ...).

# ================================================================
# Result envelope — mirrors bote's fs_tools `_fs_result`. The MCP
# text-content envelope is hand-built (str_builder + _json_emit_escaped for
# injection-safe escaping); since bote 3.4.6 that escaper writes every
# control byte as an escape, and since 3.4.15 replaces invalid UTF-8 with
# U+FFFD, so an envelope is valid JSON whatever nft text it carries.
# ================================================================

# Finish a builder as a C string. A Str's bytes are not NUL-terminated in
# general (str_sub / str_split borrow their parent's), which is why cyrius
# 6.6.13+ warns on str_data(..) into a `: cstring` param. A FRESH
# str_builder_build is the exception: lib/str.cyr allocates `total + 1` and
# writes the trailing NUL as documented contract. Every builder-to-cstring
# hand-off in this module goes through here so that reliance lives in one
# place instead of six.
fn _mcp_sb_cstr(sb): cstring { return str_data(str_builder_build(sb)); }

# ================================================================
# Argument shape (1.8.2, audit M-1 / M-5)
# ================================================================
#
# bote reads a JSON key as what it DECODES to and lets the FIRST occurrence of
# a duplicated key win; a standard JSON parser (JSON.parse, Python json)
# lets the LAST win. So `{"port":22,"port":80}` — or `{"port":80,"\u0070ort":22}`
# — showed a human approval UI or a host-side argument filter port 80 while
# nein opened 22. Arguments are refused unless they are one JSON object whose
# top-level keys are spelled plainly and appear once, which leaves the two
# readings nothing to disagree about.

fn _mcp_ws(buf: cstring, len: i64, i: i64): i64 {
    while (i < len) {
        var c = load8(buf + i);
        if (c != 32 && c != 9 && c != 10 && c != 13) { return i; }
        i = i + 1;
    }
    return i;
}

# Index just past the JSON value at buf[i] (leading whitespace skipped), or -1.
# String-aware: braces and quotes inside a string are text, and an escaped
# quote does not end it — the property the old brace counter in nein_diff
# lacked (audit M-5).
fn _mcp_skip_value(buf: cstring, len: i64, i: i64): i64 {
    i = _mcp_ws(buf, len, i);
    if (i >= len) { return 0 - 1; }
    var c = load8(buf + i);
    if (c == 34) {
        i = i + 1;
        while (i < len) {
            var sc = load8(buf + i);
            if (sc == 92) { i = i + 2; }
            elif (sc == 34) { return i + 1; }
            else { i = i + 1; }
        }
        return 0 - 1;
    }
    if (c == 123 || c == 91) {
        var depth = 0;
        while (i < len) {
            var cc = load8(buf + i);
            if (cc == 34) {
                var e = _mcp_skip_value(buf, len, i);
                if (e < 0) { return 0 - 1; }
                i = e;
            } else {
                if (cc == 123 || cc == 91) { depth = depth + 1; }
                elif (cc == 125 || cc == 93) {
                    depth = depth - 1;
                    if (depth == 0) { return i + 1; }
                }
                i = i + 1;
            }
        }
        return 0 - 1;
    }
    while (i < len) {
        var bc = load8(buf + i);
        if (bc == 44 || bc == 125 || bc == 93 || bc == 58 || bc == 32 || bc == 9 || bc == 10 || bc == 13) { return i; }
        i = i + 1;
    }
    return i;
}

# 0 when `obj` is one JSON object with plainly spelled, unique top-level keys;
# otherwise an error message for the caller to return.
fn _mcp_args_shape(obj: cstring): cstring {
    if (obj == 0) { return "arguments missing"; }
    var len = strlen(obj);
    if (jsonx_valid(obj, len) != 1) { return "arguments are not valid JSON"; }
    var i = _mcp_ws(obj, len, 0);
    if (i >= len || load8(obj + i) != 123) { return "arguments must be a JSON object"; }
    i = _mcp_ws(obj, len, i + 1);
    if (i < len && load8(obj + i) == 125) { return 0; }       # {}
    var keys = vec_new();
    while (i < len) {
        if (load8(obj + i) != 34) { return "malformed arguments"; }
        var ke = _mcp_skip_value(obj, len, i);
        if (ke < 0) { return "malformed arguments"; }
        var ks = i + 1;
        var kl = ke - ks - 1;
        if (memchr(obj + ks, 92, kl) >= 0) { return "argument keys must be spelled without escapes"; }
        var k = 0;
        while (k < vec_len(keys)) {
            if (vec_get(keys, k + 1) == kl) {
                if (memeq(obj + vec_get(keys, k), obj + ks, kl) == 1) { return "duplicate argument key"; }
            }
            k = k + 2;
        }
        vec_push(keys, ks);
        vec_push(keys, kl);
        i = _mcp_ws(obj, len, ke);
        if (i >= len || load8(obj + i) != 58) { return "malformed arguments"; }
        var ve = _mcp_skip_value(obj, len, i + 1);
        if (ve < 0) { return "malformed arguments"; }
        i = _mcp_ws(obj, len, ve);
        if (i < len && load8(obj + i) == 44) { i = _mcp_ws(obj, len, i + 1); }
        elif (i < len && load8(obj + i) == 125) { return 0; }
        else { return "malformed arguments"; }
    }
    return "malformed arguments";
}

# A port from its raw JSON token: 1-5 digits, no sign, leading zero, fraction
# or exponent, value 1..65535 (audit M-1). `atoi` on the raw token wrapped
# "18446744073709551638" to 22 — nft received `tcp dport 22 accept` and the
# tool reported success — read "2e4" as 2 and "22.9" as 22. -1 if invalid.
fn _mcp_port(raw: cstring): i64 {
    if (raw == 0) { return 0 - 1; }
    var n = strlen(raw);
    if (_parse_dec(raw, 0, n, 5, 65535) != n) { return 0 - 1; }
    var p = atoi(raw);
    if (p < 1) { return 0 - 1; }
    return p;
}

fn _mcp_result(msg: cstring, is_err: i64): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"content\":[{\"type\":\"text\",\"text\":\"");
    _json_emit_escaped(sb, msg);
    str_builder_add_cstr(sb, "\"}],\"isError\":");
    if (is_err == 1) { str_builder_add_cstr(sb, "true}"); }
    else { str_builder_add_cstr(sb, "false}"); }
    return _mcp_sb_cstr(sb);
}

fn _mcp_ok(msg: cstring): cstring { return _mcp_result(msg, 0); }
fn _mcp_err(msg: cstring): cstring { return _mcp_result(msg, 1); }

# Public envelope builders — daimon's future firewall tools (1.6.2) reuse
# these so every consumer emits the identical injection-safe MCP envelope
# instead of re-deriving (and re-escaping) it. Same output as _mcp_ok/_err.
fn nein_mcp_ok(msg: cstring): cstring { return _mcp_result(msg, 0); }
fn nein_mcp_err(msg: cstring): cstring { return _mcp_result(msg, 1); }

# ================================================================
# Tool table — single source of truth for the 6 tools.
# Both integration paths (bote-dispatcher registration, and the daimon-style
# dispatch adapter) and the gate read these accessors, so names, descriptions
# and classes never drift between them. A host that dispatches by name
# (daimon's model) registers descriptors from nein_tool_name / nein_tool_desc
# and routes with nein_mcp_dispatch; its gate classifies with nein_tool_class.
# ================================================================

# What a tool can reach (1.9.0, audit M-3). Through 1.8.2 the table said only
# read-only or not, and read-only covered three tools that run `nft -a list
# ruleset` as root and hand back the live ruleset — set elements, allowed
# sources, comments — which hosts took as safe to expose.
enum NeinToolClass {
    NEIN_TOOL_OFFLINE = 1;      # touches nothing outside the process: nein_validate
    NEIN_TOOL_READS_LIVE = 2;   # runs nft as root, returns live state: nein_status / nein_list / nein_diff
    NEIN_TOOL_MUTATES = 3;      # changes the live firewall: nein_allow / nein_deny
}

fn nein_tool_count(): i64 { return 6; }

fn nein_tool_name(i: i64): cstring {
    if (i == 0) { return "nein_status"; }
    if (i == 1) { return "nein_allow"; }
    if (i == 2) { return "nein_deny"; }
    if (i == 3) { return "nein_validate"; }
    if (i == 4) { return "nein_list"; }
    if (i == 5) { return "nein_diff"; }
    return "";
}

fn nein_tool_desc(i: i64): cstring {
    if (i == 0) { return "get current nftables firewall status (table count, rule count); args {}"; }
    if (i == 1) { return "add an accept rule to the live firewall; args {protocol, port, source?, table?, chain?}"; }
    if (i == 2) { return "add a drop rule to the live firewall; args {protocol, port, source?, table?, chain?}"; }
    if (i == 3) { return "validate a port-rule request (no apply); args {protocol, port, source?, table?, chain?}"; }
    if (i == 4) { return "list live firewall rules, optionally filtered; args {table?, chain?}"; }
    if (i == 5) { return "preview nft ops to reach target rules (no apply); args {rules:[{protocol,port,verdict}]}"; }
    return "";
}

# The table index of a tool name, or -1 (NULL, or not a nein tool). A gate is
# handed a name; this is how it finds the class without restating the table.
fn nein_tool_index(name: cstring): i64 {
    if (name == 0) { return 0 - 1; }
    var i = 0;
    while (i < nein_tool_count()) {
        if (streq(name, nein_tool_name(i)) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# NEIN_TOOL_OFFLINE / _READS_LIVE / _MUTATES, or 0 for an index outside the
# table — so `nein_tool_class(nein_tool_index(name))` is 0 for an unknown name,
# which no gate should permit.
fn nein_tool_class(i: i64): i64 {
    if (i == 3) { return NEIN_TOOL_OFFLINE; }      # nein_validate
    if (i == 0 || i == 4 || i == 5) { return NEIN_TOOL_READS_LIVE; }   # status / list / diff
    if (i == 1 || i == 2) { return NEIN_TOOL_MUTATES; }   # allow / deny
    return 0;
}

# 1 = does not change the firewall (MCP readOnlyHint); 0 = mutating. ⚠ Not
# "safe to expose": three of the four read the live ruleset as root — gate on
# nein_tool_class. Unchanged since 1.6.1 for hosts that read it.
fn nein_tool_read_only(i: i64): i64 {
    if (nein_tool_class(i) == NEIN_TOOL_MUTATES) { return 0; }
    return 1;
}

# 1 = the mutating tools (the firewall_admin profile); 0 otherwise.
fn nein_tool_admin(i: i64): i64 {
    if (nein_tool_class(i) == NEIN_TOOL_MUTATES) { return 1; }
    return 0;
}

# ================================================================
# Access-control gate — the host's policy, consulted before every tool acts.
#
# gate_fp = fn(tool_name: cstring, claims: i64) -> NEIN_GATE_PERMIT to permit;
# ANY other value denies. `claims` is whatever bote hands the handler: 0 when
# the host configures no auth, and (bote 3.7.5) a NUL-terminated heap copy of
# the verified token when HTTP or WebSocket auth is configured — a copy the
# handler may keep (bote_req_claims_kept). nein passes it to the gate
# unchanged and never dereferences it; reading it is the host's policy.
#
# 1.9.0 contract (audit M-2 / M-3), replacing 1.6.1's "1 permit / 0 deny":
#   - Permit is one distinctive value. nein calls the gate through a run-time
#     pointer (fncall2), and cyrius truncates a Result returned that way to
#     its tag: a gate written to return Ok / Err read Err (tag 1) as permit.
#     A bool, a Result tag, -1, an error code and (being above the 47/48-bit
#     user-space range of x86_64 and aarch64) any pointer all now DENY. A 1.8
#     gate returning 1 denies everything — fails closed until migrated.
#   - One gate per process, installed once. The handler ABI (args, claims)
#     carries no registration, so a gate cannot be held per dispatcher; what
#     1.9.0 closes is the replacement — through 1.8.2 any later
#     nein_tools_register_gated or nein_mcp_set_gate(0) silently swapped or
#     removed the gate for every dispatcher already serving. Installing the
#     gate already installed is a no-op; any other install is refused.
#   - With no gate installed, only the offline tool (nein_validate) runs. The
#     live readers and the mutating pair need a gate that permits them —
#     through 1.8.2, plain nein_tools_register ran all six, nein_allow and
#     nein_deny included, for any caller.
# ================================================================

enum NeinGateVerdict {
    NEIN_GATE_PERMIT = 0x4E45494E2D4F4B21;   # "NEIN-OK!" as ASCII bytes
}

var _nein_gate = 0;

# Install `gate_fp` as the process's gate. 0 when it is now the gate (just
# installed, or already the one installed); 1 when refused — a NULL gate, or a
# different gate already installed — with the installed gate left in place.
# Compare-and-swap, so two threads installing at once cannot both win.
fn _nein_gate_install(gate_fp: i64): i64 {
    if (gate_fp == 0) {
        var sk_null = "nein.mcp: refused a NULL host gate (a gate cannot be cleared)";
        sakshi_error(sk_null, strlen(sk_null));
        return 1;
    }
    if (atomic_cas(&_nein_gate, 0, gate_fp) == 1) { return 0; }
    if (atomic_load(&_nein_gate) == gate_fp) { return 0; }
    var sk_repl = "nein.mcp: refused to replace the installed host gate (one gate per process)";
    sakshi_error(sk_repl, strlen(sk_repl));
    return 1;
}

# Returns 0 if the tool is permitted, else an "access denied" error envelope
# the handler returns directly, before it touches anything.
fn _nein_gate_check(name: cstring, claims: i64): cstring {
    var gate = atomic_load(&_nein_gate);
    if (gate == 0) {
        if (nein_tool_class(nein_tool_index(name)) == NEIN_TOOL_OFFLINE) { return 0; }
        return _mcp_err("access denied: no host gate installed for a tool that reads or changes the live firewall");
    }
    if (fncall2(gate, name, claims) == NEIN_GATE_PERMIT) { return 0; }
    return _mcp_err("access denied: tool gated by host policy");
}

# ================================================================
# Shared arg validation for the port-rule tools (allow/deny/validate).
# Returns Ok(0) if {protocol,port,source?,table?,chain?} are all valid,
# else Err with a NeinError code — the caller maps it to a message.
# Reads are re-done by each handler; this only validates.
# ================================================================

fn _mcp_valid_proto(proto: cstring): i64 {
    if (proto == 0) { return 0; }
    if (streq(proto, "tcp") == 1) { return 1; }
    if (streq(proto, "udp") == 1) { return 1; }
    return 0;
}

# Validate the shared rule args. Returns 0 if all valid, or a cstr error
# message if not (so handlers can return it directly).
fn _mcp_check_rule_args(args: cstring): cstring {
    var shape = _mcp_args_shape(args);
    if (shape != 0) { return shape; }
    var proto = jsonx_get_str(args, "protocol");
    if (proto == 0) { return "missing 'protocol' (tcp or udp)"; }
    if (_mcp_valid_proto(proto) == 0) { return "unsupported protocol (use tcp or udp)"; }

    var port_raw = jsonx_get_raw(args, "port");
    if (port_raw == 0) { return "missing 'port'"; }
    if (_mcp_port(port_raw) < 1) { return "port must be an integer 1-65535"; }

    var table = jsonx_get_str(args, "table");
    if (table == 0) { table = "filter"; }
    if (is_err_result(validate_identifier(table)) == 1) { return "invalid 'table' name"; }

    var chain = jsonx_get_str(args, "chain");
    if (chain == 0) { chain = "input"; }
    if (is_err_result(validate_identifier(chain)) == 1) { return "invalid 'chain' name"; }

    var src = jsonx_get_str(args, "source");
    if (src != 0) {
        if (is_err_result(validate_addr(src)) == 1) { return "invalid 'source' CIDR/address"; }
    }
    return 0;
}

# Build the nft rule body from validated args + a verdict cstr. Caller
# has already run _mcp_check_rule_args, so components are injection-safe.
fn _mcp_build_rule(args: cstring, verdict: cstring): cstring {
    var sb = str_builder_new();
    var src = jsonx_get_str(args, "source");
    if (src != 0) {
        str_builder_add_cstr(sb, "ip saddr ");
        str_builder_add_cstr(sb, src);
        str_builder_add_cstr(sb, " ");
    }
    str_builder_add_cstr(sb, jsonx_get_str(args, "protocol"));
    str_builder_add_cstr(sb, " dport ");
    str_builder_add_int(sb, _mcp_port(jsonx_get_raw(args, "port")));
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, verdict);
    return _mcp_sb_cstr(sb);
}

# ================================================================
# Handlers
# ================================================================

# nein_status {} -> live firewall summary (table count + rule count).
fn _nein_status_handler(args: cstring, claims: i64): cstring {
    var g = _nein_gate_check("nein_status", claims);
    if (g != 0) { return g; }
    var shape = _mcp_args_shape(args);
    if (shape != 0) { return _mcp_err(shape); }
    var res_t, res_v = status();
    if (is_err_result(res_t) == 1) {
        return _mcp_err("nein_status: nft query failed (needs root + nft installed)");
    }
    var st = res_v;
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "tables=");
    str_builder_add_int(sb, vec_len(status_tables(st)));
    str_builder_add_cstr(sb, " total_rules=");
    str_builder_add_int(sb, status_total_rules(st));
    return _mcp_ok(_mcp_sb_cstr(sb));
}

# Shared allow/deny body: validate, build rule, apply live, report.
fn _mcp_apply_verdict(args: cstring, verdict: cstring, label: cstring): cstring {
    var bad = _mcp_check_rule_args(args);
    if (bad != 0) { return _mcp_err(bad); }

    var table = jsonx_get_str(args, "table");
    if (table == 0) { table = "filter"; }
    var chain = jsonx_get_str(args, "chain");
    if (chain == 0) { chain = "input"; }

    var rule = _mcp_build_rule(args, verdict);
    var res_t, res_v = add_rule_live("inet", table, chain, rule);
    if (is_err_result(res_t) == 1) {
        # 1.9.0 (audit S-8): nft may have committed. An agent that reads
        # "failed" retries, and a retried add duplicates the rule.
        if (res_v == NEIN_ERR_OUTCOME_UNKNOWN) {
            return _mcp_err("apply outcome unknown: the rule may be live; check with nein_list before retrying");
        }
        return _mcp_err("apply failed (needs root + nft; verify the table/chain exist)");
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, label);
    str_builder_add_cstr(sb, ": inet ");
    str_builder_add_cstr(sb, table);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, chain);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, rule);
    return _mcp_ok(_mcp_sb_cstr(sb));
}

# nein_allow {protocol,port,source?,table?,chain?} -> add accept rule (live).
fn _nein_allow_handler(args: cstring, claims: i64): cstring {
    var g = _nein_gate_check("nein_allow", claims);
    if (g != 0) { return g; }
    return _mcp_apply_verdict(args, "accept", "allowed");
}

# nein_deny {protocol,port,source?,table?,chain?} -> add drop rule (live).
fn _nein_deny_handler(args: cstring, claims: i64): cstring {
    var g = _nein_gate_check("nein_deny", claims);
    if (g != 0) { return g; }
    return _mcp_apply_verdict(args, "drop", "denied");
}

# nein_validate {protocol,port,source?,table?,chain?} -> ok / error (no apply).
fn _nein_validate_handler(args: cstring, claims: i64): cstring {
    var g = _nein_gate_check("nein_validate", claims);
    if (g != 0) { return g; }
    var bad = _mcp_check_rule_args(args);
    if (bad != 0) { return _mcp_err(bad); }
    return _mcp_ok("valid");
}

# nein_list {table?,chain?} -> live rules (optionally filtered), as a JSON
# array in the text content: [{family,table,chain,rule,handle}, ...].
fn _nein_list_handler(args: cstring, claims: i64): cstring {
    var g = _nein_gate_check("nein_list", claims);
    if (g != 0) { return g; }
    var shape = _mcp_args_shape(args);
    if (shape != 0) { return _mcp_err(shape); }
    var res_t, res_v = list_ruleset_with_handles();
    if (is_err_result(res_t) == 1) {
        return _mcp_err("nein_list: nft query failed (needs root + nft installed)");
    }
    var rules = diff_parse_live(res_v);
    var ftable = jsonx_get_str(args, "table");
    var fchain = jsonx_get_str(args, "chain");

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "[");
    var n = vec_len(rules);
    var count = 0;
    var i = 0;
    while (i < n) {
        var lr = vec_get(rules, i);
        var keep = 1;
        if (ftable != 0) {
            if (streq(live_rule_table(lr), ftable) == 0) { keep = 0; }
        }
        if (fchain != 0) {
            if (streq(live_rule_chain(lr), fchain) == 0) { keep = 0; }
        }
        if (keep == 1) {
            if (count > 0) { str_builder_add_cstr(sb, ","); }
            str_builder_add_cstr(sb, "{\"family\":\"");
            _json_emit_escaped(sb, live_rule_family(lr));
            str_builder_add_cstr(sb, "\",\"table\":\"");
            _json_emit_escaped(sb, live_rule_table(lr));
            str_builder_add_cstr(sb, "\",\"chain\":\"");
            _json_emit_escaped(sb, live_rule_chain(lr));
            str_builder_add_cstr(sb, "\",\"rule\":\"");
            _json_emit_escaped(sb, live_rule_body(lr));
            str_builder_add_cstr(sb, "\",\"handle\":");
            str_builder_add_int(sb, live_rule_handle(lr));
            str_builder_add_cstr(sb, "}");
            count = count + 1;
        }
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]");
    return _mcp_ok(_mcp_sb_cstr(sb));
}

# nein_diff {rules:[{protocol,port,verdict?}]} -> nft ops to converge the
# live ruleset onto the given target rules (PREVIEW — does not apply).
# Target is built in table `filter` / chain `input` (family inet). Rules
# without a verdict default to accept. Returns {"ops":[...],"count":N}.
fn _nein_diff_handler(args: cstring, claims: i64): cstring {
    var g = _nein_gate_check("nein_diff", claims);
    if (g != 0) { return g; }
    var shape = _mcp_args_shape(args);
    if (shape != 0) { return _mcp_err(shape); }
    var arr = jsonx_get_raw(args, "rules");
    if (arr == 0) { return _mcp_err("missing 'rules' array"); }

    var fw = firewall_new();
    var t = table_new("filter", FAMILY_INET);
    var c = chain_base("input", CHAIN_FILTER, HOOK_INPUT, 0, POLICY_DROP);

    # Walk the array element by element with the string-aware skipper (1.8.2,
    # audit M-5). The old walk counted braces without regard to strings, so
    # `{"protocol":"tcp","port":22,"x":"{"}` swallowed the next element and
    # the preview silently dropped a rule.
    var alen = strlen(arr);
    var count = 0;
    var i = _mcp_ws(arr, alen, 0);
    if (i >= alen || load8(arr + i) != 91) { return _mcp_err("'rules' must be an array"); }
    i = _mcp_ws(arr, alen, i + 1);
    while (i < alen && load8(arr + i) != 93) {
        if (load8(arr + i) != 123) { return _mcp_err("each rule must be an object"); }
        var j = _mcp_skip_value(arr, alen, i);
        if (j < 0) { return _mcp_err("malformed 'rules' array"); }
        var elen = j - i;
        var elem = alloc(elen + 1);
        memcpy(elem, arr + i, elen);
        store8(elem + elen, 0);
        var eshape = _mcp_args_shape(elem);
        if (eshape != 0) { return _mcp_err(eshape); }

        var proto = jsonx_get_str(elem, "protocol");
        if (proto == 0) { return _mcp_err("a rule is missing 'protocol'"); }
        if (_mcp_valid_proto(proto) == 0) { return _mcp_err("a rule has an unsupported protocol"); }
        var port_raw = jsonx_get_raw(elem, "port");
        if (port_raw == 0) { return _mcp_err("a rule is missing 'port'"); }
        var port = _mcp_port(port_raw);
        if (port < 1) { return _mcp_err("a rule 'port' must be an integer 1-65535"); }

        var vd = verdict_accept();
        var verdict_s = jsonx_get_str(elem, "verdict");
        if (verdict_s != 0) {
            if (streq(verdict_s, "drop") == 1) { vd = verdict_drop(); }
            elif (streq(verdict_s, "accept") == 0) { return _mcp_err("a rule 'verdict' must be accept or drop"); }
        }
        var proto_id = PROTO_TCP;
        if (streq(proto, "udp") == 1) { proto_id = PROTO_UDP; }

        var rule = rule_new(vd);
        rule_add_match(rule, match_protocol(proto_id));
        rule_add_match(rule, match_dport(port));
        chain_add_rule(c, rule);
        count = count + 1;
        i = _mcp_ws(arr, alen, j);
        if (i < alen && load8(arr + i) == 44) { i = _mcp_ws(arr, alen, i + 1); }
    }
    if (count == 0) { return _mcp_err("no rules provided"); }

    table_add_chain(t, c);
    firewall_add_table(fw, t);

    # `-a` required — without the handle suffixes every live rule parses with
    # handle 0 and no delete op can be emitted (1.6.9; same fix as diff.cyr).
    var live_t, live_v = list_ruleset_with_handles();
    if (is_err_result(live_t) == 1) {
        return _mcp_err("nein_diff: nft query failed (needs root + nft installed)");
    }
    var dst[8];
    var ops = _diff_compute(fw, live_v, &dst);
    if (load64(&dst) != 0) {
        return _mcp_err("nein_diff: live ruleset not parsed safely, or a chain not convergeable — no ops");
    }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"ops\":[");
    var n = vec_len(ops);
    var k = 0;
    while (k < n) {
        if (k > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "\"");
        _json_emit_escaped(sb, vec_get(ops, k));
        str_builder_add_cstr(sb, "\"");
        k = k + 1;
    }
    str_builder_add_cstr(sb, "],\"count\":");
    str_builder_add_int(sb, n);
    str_builder_add_cstr(sb, "}");
    return _mcp_ok(_mcp_sb_cstr(sb));
}

# ================================================================
# Registration — mount nein's tools on an existing bote dispatcher.
# Each descriptor carries bote ToolAnnotations (read-only vs destructive)
# and profile tags (firewall, plus firewall_read / firewall_admin by class)
# so a client can list them by what they reach. Access is the gate's.
# ================================================================

# Profile tags by class. `firewall` is on all six, so tools/list?profile=
# firewall lists every nein tool, as it always has; `firewall_read` (1.9.0)
# marks the live readers and `firewall_admin` the mutating pair. A profile
# is a listing filter a client chooses (bote's tools/list), not access
# control — that is the gate's job.
fn _nein_profiles(i: i64): i64 {
    var v = vec_new();
    vec_push(v, "firewall");
    var c = nein_tool_class(i);
    if (c == NEIN_TOOL_READS_LIVE) { vec_push(v, "firewall_read"); }
    if (c == NEIN_TOOL_MUTATES) { vec_push(v, "firewall_admin"); }
    return v;
}

fn _nein_handler(i: i64): i64 {
    if (i == 0) { return &_nein_status_handler; }
    if (i == 1) { return &_nein_allow_handler; }
    if (i == 2) { return &_nein_deny_handler; }
    if (i == 3) { return &_nein_validate_handler; }
    if (i == 4) { return &_nein_list_handler; }
    if (i == 5) { return &_nein_diff_handler; }
    return 0;
}

# --- Path A: bote-dispatcher registration -------------------------------
# For hosts that run a bote Dispatcher. Register descriptor (schema +
# annotations + profiles) and bind the handler, from the tool table.
#
# One bote call per tool (1.8.2). Through 1.8.1 this was registry_register
# then dispatcher_handle: two writes, so on a host that registers while it
# serves, a call landing between them found the tool and no handler; bote
# published no TOPIC_TOOL_REGISTERED, so its listen streams (3.7.2+) never
# heard of nein's tools; and registry_register's refusal was ignored while
# dispatcher_handle still bound the handler, leaving a handler with no
# listed tool. dispatcher_register_tool validates, then adds the definition
# and the handler under one registries write lock, then publishes the event.

# Register one definition + handler. 0 when it landed; 1 when bote refused
# it (nothing is added — bote binds the handler only after validation), with
# bote's reason logged.
fn _nein_register_one(dispatcher: i64, td: i64, handler_fp: i64): i64 {
    var err = dispatcher_register_tool(dispatcher, td, handler_fp);
    if (err == 0) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "nein.mcp: bote refused tool registration: ");
    var why = bote_err_reason(err);
    if (why == 0) { why = "(no reason given)"; }
    str_builder_add_cstr(sb, why);
    var msg = _mcp_sb_cstr(sb);
    sakshi_error(msg, strlen(msg));
    return 1;
}

fn _nein_reg(dispatcher: i64, i: i64): i64 {
    var ann = ann_read_only();
    if (nein_tool_class(i) == NEIN_TOOL_MUTATES) { ann = ann_destructive(); }
    var td = tool_def_new(nein_tool_name(i), nein_tool_desc(i), schema_new("object", 0, vec_new()));
    td = tool_def_with_annotations(td, ann);
    td = tool_def_with_profiles(td, _nein_profiles(i));
    return _nein_register_one(dispatcher, td, _nein_handler(i));
}

# Returns the number of tools bote refused: 0 when all six registered.
# (Through 1.8.1 it returned 0 unconditionally, so a caller that ignores the
# result is unaffected; one that checks `== 0` now gets a true answer.)
#
# The tools run under the PROCESS's gate — whichever is installed, now or
# later, by any component. A host that mounts nein on two dispatchers with
# different trust (a stdio loop and an unauthenticated HTTP endpoint, say)
# gets one policy for both; the gate must tell them apart through `claims`.
fn nein_tools_register(dispatcher: i64): i64 {
    if (atomic_load(&_nein_gate) == 0) {
        var sk_ng = "nein.mcp: tools registered with no host gate — only nein_validate runs until one is installed";
        sakshi_warn(sk_ng, strlen(sk_ng));
    }
    var refused = 0;
    var i = 0;
    while (i < nein_tool_count()) {
        refused = refused + _nein_reg(dispatcher, i);
        i = i + 1;
    }
    return refused;
}

# Like nein_tools_register, but first installs the host access-control gate
# (see the gate section: permit is NEIN_GATE_PERMIT, one gate per process).
# Every handler consults it before acting; a denied call returns an "access
# denied" envelope and never touches the firewall. Returns the refused count,
# as nein_tools_register does — and when the gate itself is refused (NULL, or
# another gate is installed) registers nothing and returns nein_tool_count(),
# so this call never mounts tools under a gate other than the one it names.
# (Tools mounted by plain nein_tools_register have no such guarantee: they run
# under whatever gate the process installs.)
fn nein_tools_register_gated(dispatcher: i64, gate_fp: i64): i64 {
    if (_nein_gate_install(gate_fp) != 0) { return nein_tool_count(); }
    return nein_tools_register(dispatcher);
}

# --- Path B: daimon-friendly dispatch adapter ---------------------------
# For hosts that route MCP calls by name (daimon's mcp_dispatch_builtin
# model) rather than standing up a bote Dispatcher. The host registers
# descriptors from the tool table and forwards every "nein_*" call to
# nein_mcp_dispatch. Install the gate first with nein_mcp_set_gate.

# Install the access-control gate for the dispatch-adapter path (the same
# one gate the gated register installs). 0 when `gate_fp` is the gate; 1 when
# refused — NULL, or a different gate already installed, which stays. Through
# 1.8.2 it returned 0 and replaced whatever was there, NULL included.
fn nein_mcp_set_gate(gate_fp: i64): i64 {
    return _nein_gate_install(gate_fp);
}

# Route a tool call by name -> the handler's MCP result envelope cstr, or
# an "unknown tool" error envelope. Handlers consult the installed gate.
fn nein_mcp_dispatch(name: cstring, args: cstring, claims: i64): cstring {
    var i = nein_tool_index(name);   # NULL is -1: was streq(0), a crash (audit M-7)
    if (i < 0) { return _mcp_err("unknown nein tool"); }
    return fncall2(_nein_handler(i), args, claims);
}
