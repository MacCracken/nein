# nein chain module — chain types, hooks, policies, and chain rendering

# ================================================================
# Enums
# ================================================================

enum ChainTypeEnum {
    CHAIN_FILTER = 1;
    CHAIN_NAT = 2;
    CHAIN_ROUTE = 3;
}

enum HookEnum {
    HOOK_PREROUTING = 1;
    HOOK_INPUT = 2;
    HOOK_FORWARD = 3;
    HOOK_OUTPUT = 4;
    HOOK_POSTROUTING = 5;
    HOOK_INGRESS = 6;
}

enum PolicyEnum {
    POLICY_ACCEPT = 1;
    POLICY_DROP = 2;
}

fn _chain_type_str(t: i64): cstring {
    if (t == CHAIN_FILTER) { return "filter"; }
    if (t == CHAIN_NAT) { return "nat"; }
    if (t == CHAIN_ROUTE) { return "route"; }
    return "__nein_invalid_chain_type__";
}

fn _hook_str(h: i64): cstring {
    if (h == HOOK_PREROUTING) { return "prerouting"; }
    if (h == HOOK_INPUT) { return "input"; }
    if (h == HOOK_FORWARD) { return "forward"; }
    if (h == HOOK_OUTPUT) { return "output"; }
    if (h == HOOK_POSTROUTING) { return "postrouting"; }
    if (h == HOOK_INGRESS) { return "ingress"; }
    return "__nein_invalid_hook__";
}

fn _policy_str(p: i64): cstring {
    if (p == POLICY_ACCEPT) { return "accept"; }
    if (p == POLICY_DROP) { return "drop"; }
    # Through 1.8.1 an unknown policy rendered "accept" and an unknown hook
    # "input" (audit I-3): `cfg_parse_hook("Forward")` / `cfg_parse_policy("DROP")`
    # — a capitalisation slip in operator config — return -1, and the chain
    # applied as `hook input ... policy accept`, an open input chain. Now
    # chain_header_validate refuses them and an unvalidated render fails closed.
    return "__nein_invalid_policy__";
}

# A base chain's header is in range (1.8.2, audit I-3): a known type, hook
# and policy, and a priority that fits nft's signed 32-bit field. A regular
# chain (type 0) carries no header.
fn chain_header_validate(c: i64): i64 {
    var ct = chain_type_val(c);
    if (ct == 0) { return nein_ok(); }
    if (ct < CHAIN_FILTER || ct > CHAIN_ROUTE) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var h = chain_hook(c);
    if (h < HOOK_PREROUTING || h > HOOK_INGRESS) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var p = chain_policy(c);
    if (p < POLICY_ACCEPT || p > POLICY_DROP) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var pr = chain_priority(c);
    if (pr < 0 - 2147483648 || pr > 2147483647) { return nein_err(NEIN_ERR_INVALID_RULE); }
    return nein_ok();
}

# A base chain's type and hook in a table of family `fam` (1.9.3, probed
# against nft 1.1.7 on Linux 7.2). inet, ip and ip6: filter on any hook but
# ingress, which only inet has; nat on prerouting, input, output and
# postrouting; route on output. arp: filter on input and output. bridge: filter
# on any hook but ingress. netdev: filter on ingress. Anything else nft refuses
# ("does not support this hook", "Chain of type ... is not supported"). A
# regular chain (type 0) carries no header.
fn _chain_header_family_ok(c: i64, fam: i64): i64 {
    var ct = chain_type_val(c);
    if (ct == 0) { return 1; }
    var h = chain_hook(c);
    if (fam == FAMILY_INET || fam == FAMILY_IP || fam == FAMILY_IP6) {
        if (ct == CHAIN_FILTER) {
            if (h == HOOK_INGRESS && fam != FAMILY_INET) { return 0; }
            return 1;
        }
        if (ct == CHAIN_NAT) {
            if (h == HOOK_FORWARD || h == HOOK_INGRESS) { return 0; }
            return 1;
        }
        if (h == HOOK_OUTPUT) { return 1; }   # route
        return 0;
    }
    if (ct != CHAIN_FILTER) { return 0; }
    if (fam == FAMILY_ARP) {
        if (h == HOOK_INPUT || h == HOOK_OUTPUT) { return 1; }
        return 0;
    }
    if (fam == FAMILY_BRIDGE) {
        if (h == HOOK_INGRESS) { return 0; }
        return 1;
    }
    if (fam == FAMILY_NETDEV && h == HOOK_INGRESS) { return 1; }
    return 0;
}

# ================================================================
# ChainRule — tagged wrapper: { type, inner }
# Layout: [type:8][inner:8] = 16 bytes
# type: CR_RULE=1 (standard rule) or CR_NAT=2 (NAT rule)
# ================================================================

enum ChainRuleType {
    CR_RULE = 1;
    CR_NAT = 2;
}

fn chain_rule_new(ctype: i64, inner: i64): i64 {
    var cr = alloc(16);
    store64(cr, ctype);
    store64(cr + 8, inner);
    return cr;
}

fn chain_rule_render(cr: i64): Str {
    var ct = load64(cr);
    var inner = load64(cr + 8);
    if (ct == CR_NAT) { return nat_render(inner); }
    return rule_render(inner);
}

# The rule as nft lists it in a table of family `fam` — what nein_diff
# compares (1.9.2, audit P-8; rule.cyr's "Canonical spellings").
fn _chain_rule_render_canon(cr: i64, fam: i64): Str {
    var ct = load64(cr);
    var inner = load64(cr + 8);
    if (ct == CR_NAT) { return _nat_render_canon(inner, fam); }
    return _rule_render_canon(inner, fam);
}

fn chain_rule_validate(cr: i64): i64 {
    var ct = load64(cr);
    var inner = load64(cr + 8);
    if (ct == CR_NAT) { return nat_validate(inner); }
    return rule_validate(inner);
}

# The chain rule in a table of family `fam`: -1 when nft refuses it there,
# else 1 when only some hooks take it (any NAT; see _rule_family_needs) and 0
# when every hook does.
fn _chain_rule_family_needs(cr: i64, fam: i64): i64 {
    var inner = load64(cr + 8);
    if (load64(cr) == CR_NAT) {
        if (_nat_family_ok(inner, fam) == 0) { return 0 - 1; }
        return 1;
    }
    return _rule_family_needs(inner, fam);
}

# 1 when the kernel takes the chain rule below a base chain of type `ctype` at
# hook `hook`, in a table of family `fam` (1.9.3; `nft -c` does not check
# this, only a load does). NAT: _nat_hook_ok. `reject`: not at postrouting,
# and in a bridge table only at prerouting or input. `flow offload`: only at
# forward. Everything else loads at every hook its chain type has.
fn _chain_rule_context_ok(cr: i64, fam: i64, ctype: i64, hook: i64): i64 {
    var inner = load64(cr + 8);
    if (load64(cr) == CR_NAT) { return _nat_hook_ok(inner, ctype, hook); }
    var vt = verdict_type(rule_verdict(inner));
    if (vt == VERDICT_REJECT || vt == VERDICT_REJECT_WITH) {
        if (hook == HOOK_POSTROUTING) { return 0; }
        if (fam == FAMILY_BRIDGE && hook != HOOK_PREROUTING && hook != HOOK_INPUT) { return 0; }
    }
    if (hook != HOOK_FORWARD) {
        var matches = rule_matches(inner);
        var i = 0;
        while (i < vec_len(matches)) {
            if (match_type(vec_get(matches, i)) == MATCH_FLOW_OFFLOAD) { return 0; }
            i = i + 1;
        }
    }
    return 1;
}

# The chain a rule jumps or goes to, or 0.
fn _chain_rule_jump_target(cr: i64): cstring {
    if (load64(cr) != CR_RULE) { return 0; }
    var v = rule_verdict(load64(cr + 8));
    var vt = verdict_type(v);
    if (vt == VERDICT_JUMP || vt == VERDICT_GOTO) { return verdict_val1(v); }
    return 0;
}

# ================================================================
# Chain — { name, chain_type, hook, priority, policy, rules(vec) }
# Layout: [name:8][chain_type:8][hook:8][priority:8][policy:8][rules:8] = 48 bytes
# chain_type/hook/policy = 0 means "not set" (regular chain)
# ================================================================

fn chain_base(name: cstring, ctype: i64, hook: i64, priority: i64, policy: i64): i64 {
    var c = alloc(48);
    store64(c, name);
    store64(c + 8, ctype);
    store64(c + 16, hook);
    store64(c + 24, priority);
    store64(c + 32, policy);
    store64(c + 40, vec_new());
    return c;
}

fn chain_regular(name: cstring): i64 {
    var c = alloc(48);
    store64(c, name);
    store64(c + 8, 0);
    store64(c + 16, 0);
    store64(c + 24, 0);
    store64(c + 32, 0);
    store64(c + 40, vec_new());
    return c;
}

fn chain_name(c: i64): i64 { return load64(c); }
fn chain_type_val(c: i64): i64 { return load64(c + 8); }
fn chain_hook(c: i64): i64 { return load64(c + 16); }
fn chain_priority(c: i64): i64 { return load64(c + 24); }
fn chain_policy(c: i64): i64 { return load64(c + 32); }
fn chain_rules(c: i64): i64 { return load64(c + 40); }

fn chain_add_rule(c: i64, rule: i64): i64 {
    vec_push(load64(c + 40), chain_rule_new(CR_RULE, rule));
    return c;
}

fn chain_add_nat_rule(c: i64, natrule: i64): i64 {
    vec_push(load64(c + 40), chain_rule_new(CR_NAT, natrule));
    return c;
}

fn chain_render(c: i64): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "  chain ");
    str_builder_add_cstr(sb, chain_name(c));
    str_builder_add_cstr(sb, " {\n");

    # Base chain header
    if (chain_type_val(c) != 0) {
        str_builder_add_cstr(sb, "    type ");
        str_builder_add_cstr(sb, _chain_type_str(chain_type_val(c)));
        str_builder_add_cstr(sb, " hook ");
        str_builder_add_cstr(sb, _hook_str(chain_hook(c)));
        str_builder_add_cstr(sb, " priority ");
        str_builder_add_int(sb, chain_priority(c));
        str_builder_add_cstr(sb, "; policy ");
        str_builder_add_cstr(sb, _policy_str(chain_policy(c)));
        str_builder_add_cstr(sb, ";\n");
    }

    # Rules
    var rules = chain_rules(c);
    var rlen = vec_len(rules);
    var i = 0;
    while (i < rlen) {
        str_builder_add_cstr(sb, "    ");
        var rendered = chain_rule_render(vec_get(rules, i));
        str_builder_add_cstr(sb, str_data(rendered));
        str_builder_add_cstr(sb, "\n");
        i = i + 1;
    }

    str_builder_add_cstr(sb, "  }\n");
    return str_builder_build(sb);
}
