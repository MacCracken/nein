# nein policy module — network policies (K8s-style)

enum PolicyActionEnum {
    PACT_ALLOW = 1;
    PACT_DENY = 2;
}

# ================================================================
# PolicyPort — { protocol, port }
# Layout: [protocol:8][port:8] = 16 bytes
# ================================================================

fn policy_port_new(protocol: i64, port: i64): i64 {
    var p = alloc(16);
    store64(p, protocol);
    store64(p + 8, port);
    return p;
}

fn policy_port_protocol(p: i64): i64 { return load64(p); }
fn policy_port_port(p: i64): i64 { return load64(p + 8); }

# ================================================================
# PolicyRule — { peer(str), ports(vec of PolicyPort) }
# Layout: [peer:8][ports:8] = 16 bytes
# ================================================================

fn policy_rule_new(peer: cstring): i64 {
    var pr = alloc(16);
    store64(pr, peer);
    store64(pr + 8, vec_new());
    return pr;
}

fn policy_rule_peer(pr: i64): i64 { return load64(pr); }
fn policy_rule_ports(pr: i64): i64 { return load64(pr + 8); }

fn policy_rule_add_port(pr: i64, protocol: i64, port: i64): i64 {
    vec_push(load64(pr + 8), policy_port_new(protocol, port));
    return pr;
}

# ================================================================
# NetworkPolicy — { name, target, ingress(vec), egress(vec), default_action }
# Layout: [name:8][target:8][ingress:8][egress:8][default_action:8] = 40 bytes
# ================================================================

fn nein_network_policy_new(name: cstring, target: cstring, default_action: i64): i64 {
    var np = alloc(40);
    store64(np, name);
    store64(np + 8, target);
    store64(np + 16, vec_new());
    store64(np + 24, vec_new());
    store64(np + 32, default_action);
    return np;
}

fn policy_name(np: i64): i64 { return load64(np); }
fn policy_target(np: i64): i64 { return load64(np + 8); }
fn policy_ingress(np: i64): i64 { return load64(np + 16); }
fn policy_egress(np: i64): i64 { return load64(np + 24); }
fn policy_default_action(np: i64): i64 { return load64(np + 32); }

fn policy_add_ingress(np: i64, pr: i64): i64 {
    vec_push(load64(np + 16), pr);
    return np;
}

fn policy_add_egress(np: i64, pr: i64): i64 {
    vec_push(load64(np + 24), pr);
    return np;
}

# ================================================================
# Validate
# ================================================================

fn _validate_policy_rules(rules: i64): i64 {
    var rlen = vec_len(rules);
    var i = 0;
    var vr = 0;
    while (i < rlen) {
        var pr = vec_get(rules, i);
        var peer = policy_rule_peer(pr);
        # "any" peer is allowed without validation
        if (streq(peer, "any") == 0) {
            var vr1_t, vr1_v = validate_addr(peer);
            if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
        }
        i = i + 1;
    }
    return nein_ok();
}

fn policy_validate(np: i64): i64 {
    var vr1_t, vr1_v = validate_identifier(policy_name(np));
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    # The target (1.8.2, audit B-6): an address — matched on every rule — or a
    # selector label / "any", which names the workload whose own chain the
    # consumer places the rules in. A label is never rendered; it is checked
    # as an identifier for hygiene.
    var tgt = policy_target(np);
    if (tgt == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (streq(tgt, "any") == 0 && _addr_family(tgt) == 0) {
        var vt_t, vt_v = validate_identifier(tgt);
        if (is_err_result(vt_t) == 1) { return Err(vt_v); }
    }
    var da = policy_default_action(np);
    if (da != PACT_ALLOW && da != PACT_DENY) { return nein_err(NEIN_ERR_INVALID_RULE); }

    var vr2_t, vr2_v = _validate_policy_rules(policy_ingress(np));
    if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }

    var vr3_t, vr3_v = _validate_policy_rules(policy_egress(np));
    if (is_err_result(vr3_t) == 1) { return Err(vr3_v); }

    return nein_ok();
}

# ================================================================
# Convert policy to rules
# ================================================================

# Build the comment string "policy:NAME direction from/to PEER"
fn _policy_comment(name: cstring, direction: cstring, preposition: cstring, peer: cstring): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "policy:");
    str_builder_add_cstr(sb, name);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, direction);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, preposition);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, peer);
    var s = str_builder_build(sb);
    # Need null-terminated cstr for rule_set_comment
    var out = alloc(str_len(s) + 1);
    memcpy(out, str_data(s), str_len(s));
    store8(out + str_len(s), 0);
    return out;
}

# The policy's own endpoint, matched on every rule it renders (1.8.2,
# audit B-6): through 1.8.1 neither `target` nor `default_action` was read
# anywhere, so `agent_to_agent(.., "10.0.0.1", "10.0.0.2", TCP, 8090)`
# rendered `tcp dport 8090 ip saddr 10.0.0.1 accept` — in a forward or shared
# input chain the source reached that port on EVERY destination — and a
# PACT_DENY policy rendered exactly what a PACT_ALLOW one did.
#
# Only an ADDRESS target is matched. A label target ("webserver") names the
# workload whose dedicated chain the consumer puts these rules in, so it adds
# no match — and no default drop, because an unscoped `drop` placed in a
# shared chain would drop everything after it.
fn _policy_has_target(np: i64): i64 {
    var tgt = policy_target(np);
    if (tgt == 0) { return 0; }
    if (_addr_family(tgt) == 0) { return 0; }
    return 1;
}

fn _policy_deny_rule(np: i64, is_ingress: i64): i64 {
    var r = rule_new(verdict_drop());
    if (_policy_has_target(np) == 1) { rule_add_match(r, _match_addr(policy_target(np), is_ingress)); }
    if (is_ingress == 1) { rule_set_comment(r, _policy_comment(policy_name(np), "ingress", "default", "deny")); }
    else { rule_set_comment(r, _policy_comment(policy_name(np), "egress", "default", "deny")); }
    return r;
}

fn policy_to_rules(np: i64): i64 {
    var rules = vec_new();
    var name = policy_name(np);

    # Ingress: accept on dport with optional source addr
    var ing = policy_ingress(np);
    var ilen = vec_len(ing);
    var i = 0;
    while (i < ilen) {
        var pr = vec_get(ing, i);
        var peer = policy_rule_peer(pr);
        var ports = policy_rule_ports(pr);
        var plen = vec_len(ports);
        var j = 0;
        while (j < plen) {
            var pp = vec_get(ports, j);
            var r = rule_new(verdict_accept());
            if (_policy_has_target(np) == 1) { rule_add_match(r, _match_addr(policy_target(np), 1)); }
            if (streq(peer, "any") == 0) {
                rule_add_match(r, _match_addr(peer, 0));
            }
            rule_add_match(r, match_protocol(policy_port_protocol(pp)));
            rule_add_match(r, match_dport(policy_port_port(pp)));
            rule_set_comment(r, _policy_comment(name, "ingress", "from", peer));
            vec_push(rules, r);
            j = j + 1;
        }
        i = i + 1;
    }

    # Egress: accept on dport with optional dest addr
    var eg = policy_egress(np);
    var elen = vec_len(eg);
    i = 0;
    while (i < elen) {
        var pr = vec_get(eg, i);
        var peer = policy_rule_peer(pr);
        var ports = policy_rule_ports(pr);
        var plen = vec_len(ports);
        var j = 0;
        while (j < plen) {
            var pp = vec_get(ports, j);
            var r = rule_new(verdict_accept());
            if (_policy_has_target(np) == 1) { rule_add_match(r, _match_addr(policy_target(np), 0)); }
            if (streq(peer, "any") == 0) {
                rule_add_match(r, _match_addr(peer, 1));
            }
            rule_add_match(r, match_protocol(policy_port_protocol(pp)));
            rule_add_match(r, match_dport(policy_port_port(pp)));
            rule_set_comment(r, _policy_comment(name, "egress", "to", peer));
            vec_push(rules, r);
            j = j + 1;
        }
        i = i + 1;
    }

    # PACT_DENY closes each direction that has rules: whatever the allows above
    # did not match, for this target, is dropped. PACT_ALLOW leaves the rest to
    # the chain's policy.
    if (policy_default_action(np) == PACT_DENY && _policy_has_target(np) == 1) {
        if (ilen > 0) { vec_push(rules, _policy_deny_rule(np, 1)); }
        if (elen > 0) { vec_push(rules, _policy_deny_rule(np, 0)); }
    }

    return rules;
}

# ================================================================
# Convenience: agent-to-agent policy
# ================================================================

fn agent_to_agent(name: cstring, source: cstring, dest: cstring, protocol: i64, port: i64): i64 {
    var np = nein_network_policy_new(name, dest, PACT_DENY);
    var pr = policy_rule_new(source);
    policy_rule_add_port(pr, protocol, port);
    policy_add_ingress(np, pr);
    return np;
}
