# nein nat module — NAT rules (DNAT, SNAT, masquerade, redirect)
#
# NatRule as tagged union struct — 5 variants share same layout:
# { type, val1..val6 } — 56 bytes total.

enum NatType {
    NAT_DNAT = 1;
    NAT_SNAT = 2;
    NAT_MASQUERADE = 3;
    NAT_REDIRECT = 4;
    NAT_DNAT_RANGE = 5;
}

# NatRule layout (56 bytes):
#   [type:8][v1:8][v2:8][v3:8][v4:8][v5:8][v6:8]
#
# DNAT:           type=NAT_DNAT, v1=protocol, v2=dest_port, v3=to_addr, v4=to_port, v5=comment, v6=0
# SNAT:           type=NAT_SNAT, v1=source_cidr, v2=to_addr, v3=comment, v4=0, v5=0, v6=0
# MASQUERADE:     type=NAT_MASQUERADE, v1=source_cidr, v2=oif (0 if none), v3=comment, v4=0, v5=0, v6=0
# REDIRECT:       type=NAT_REDIRECT, v1=protocol, v2=dest_port, v3=to_port, v4=comment, v5=0, v6=0
# DNAT_RANGE:     type=NAT_DNAT_RANGE, v1=protocol, v2=dest_port_start, v3=dest_port_end,
#                 v4=to_addr, v5=to_port_start, v6=to_port_end (comment stored in v7 needs extra field)
#
# DNAT_RANGE needs 7 fields; we'll allocate 64 bytes for all for simplicity.

fn nat_new(ntype: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64): i64 {
    var n = alloc(64);
    store64(n, ntype);
    store64(n + 8, v1);
    store64(n + 16, v2);
    store64(n + 24, v3);
    store64(n + 32, v4);
    store64(n + 40, v5);
    store64(n + 48, v6);
    store64(n + 56, 0);
    return n;
}

fn nat_type(n: i64): i64 { return load64(n); }
fn nat_v1(n: i64): i64 { return load64(n + 8); }
fn nat_v2(n: i64): i64 { return load64(n + 16); }
fn nat_v3(n: i64): i64 { return load64(n + 24); }
fn nat_v4(n: i64): i64 { return load64(n + 32); }
fn nat_v5(n: i64): i64 { return load64(n + 40); }
fn nat_v6(n: i64): i64 { return load64(n + 48); }
fn nat_v7(n: i64): i64 { return load64(n + 56); }
fn nat_set_v7(n: i64, val: i64): i64 { store64(n + 56, val); return n; }

# --- Constructors ---

fn nat_dnat(protocol: i64, dest_port: i64, to_addr: cstring, to_port: i64, comment: cstring): i64 {
    return nat_new(NAT_DNAT, protocol, dest_port, to_addr, to_port, comment, 0);
}

fn nat_snat(source_cidr: cstring, to_addr: cstring, comment: cstring): i64 {
    return nat_new(NAT_SNAT, source_cidr, to_addr, comment, 0, 0, 0);
}

fn nat_masquerade(source_cidr: cstring, oif: cstring, comment: cstring): i64 {
    return nat_new(NAT_MASQUERADE, source_cidr, oif, comment, 0, 0, 0);
}

fn nat_redirect(protocol: i64, dest_port: i64, to_port: i64, comment: cstring): i64 {
    return nat_new(NAT_REDIRECT, protocol, dest_port, to_port, comment, 0, 0);
}

fn nat_dnat_range(protocol: i64, dest_port_start: i64, dest_port_end: i64,
  to_addr: cstring, to_port_start: i64, to_port_end: i64,
  comment: cstring): i64 {
    var n = nat_new(NAT_DNAT_RANGE, protocol, dest_port_start, dest_port_end, to_addr, to_port_start, to_port_end);
    nat_set_v7(n, comment);
    return n;
}

# --- Helper: check if an address contains ':' (IPv6) ---
fn _addr_has_colon(s: cstring): i64 {
    var len = strlen(s);
    var i = 0;
    while (i < len) {
        if (load8(s + i) == 58) { return 1; }   # ':'
        i = i + 1;
    }
    return 0;
}

# The network-layer keyword for an address: "ip6" for IPv6, "ip" otherwise.
fn _nat_l3(addr: cstring): cstring {
    if (_addr_has_colon(addr) == 1) { return "ip6"; }
    return "ip";
}

# --- Render ---
#
# Three 1.8.2 changes (docs/audit/2026-11-03-audit.md):
#
#   B-1 (HIGH)  Every DNAT is scoped with `fib daddr type local`. A host port
#               mapping rendered `tcp dport 80 dnat to 172.17.1.2:80` with no
#               destination scope, so in prerouting it rewrote EVERY routed
#               packet to port 80, whatever its real destination — verified
#               live: a LAN client fetching an external site got the container,
#               and other containers' own outbound port-80 traffic broke. Docker
#               scopes the same rule with `-m addrtype --dst-type LOCAL`.
#   I-4         A port range that SHIFTS (host 8000-8010 -> container 9000-9010)
#               renders an explicit `tcp dport map`. `dnat to A:9000-9010`
#               without the kernel's offset flag picks the first free port in
#               the range for every connection — verified by packet test: 8000,
#               8005 and 8010 all reached 9000. nft 1.1.7 has no port-shift
#               syntax, so the map is the only correct form. An unshifted range
#               renders `dnat ... to A`, which keeps each packet's own port.
#   I-7         `dnat` / `snat` name their family (`dnat ip to`, `dnat ip6 to`),
#               which an `inet` table requires; SNAT and masquerade match
#               `ip6 saddr` for an IPv6 source (both hardcoded `ip saddr`); and
#               masquerade matches `oifname` (load-time `oif` fails on an absent
#               interface).

fn _nat_comment(sb: i64, c: cstring): i64 {
    if (c != 0) {
        str_builder_add_cstr(sb, " comment \"");
        str_builder_add_cstr(sb, c);
        str_builder_add_cstr(sb, "\"");
    }
    return 0;
}

fn nat_render(n: i64): Str { return _nat_render_cf(n, 0); }

# The NAT rule as nft lists it in a table of family `fam` (1.9.2, audit P-8):
# what nein_diff compares. nft drops the `ip` / `ip6` after dnat / snat in a
# table of one family (`dnat to`), lists addresses in canonical form, brackets
# an IPv6 target only when a port or a map follows it, and joins the map to the
# address (`172.17.0.3:tcp dport map { ... }`). See rule.cyr's "Canonical
# spellings".
fn _nat_render_canon(n: i64, fam: i64): Str { return _nat_render_cf(n, fam); }

# The `ip` / `ip6` after dnat / snat: kept as written, and under `cf` only in
# a table that holds both families.
fn _nat_l3_cf(sb: i64, addr: cstring, cf: i64): i64 {
    if (cf == FAMILY_IP || cf == FAMILY_IP6) { return 0; }
    str_builder_add_cstr(sb, _nat_l3(addr));
    str_builder_add_cstr(sb, " ");
    return 0;
}

# A NAT address: as written, or canonical under `cf`; an IPv6 one bracketed
# when `bracket` (a port or map follows).
fn _sb_add_nat_addr(sb: i64, addr: cstring, cf: i64, bracket: i64): i64 {
    var a = addr;
    if (cf != 0) {
        var c = _addr_canon(addr);
        if (c != 0) { a = c; }
    }
    if (bracket == 1 && _addr_has_colon(a) == 1) {
        str_builder_add_cstr(sb, "[");
        str_builder_add_cstr(sb, a);
        str_builder_add_cstr(sb, "]");
    } else {
        str_builder_add_cstr(sb, a);
    }
    return 0;
}

fn _nat_render_cf(n: i64, cf: i64): Str {
    var sb = str_builder_new();
    var nt = nat_type(n);

    if (nt == NAT_DNAT) {
        str_builder_add_cstr(sb, "fib daddr type local ");
        str_builder_add_cstr(sb, _proto_str(nat_v1(n)));
        str_builder_add_cstr(sb, " dport ");
        str_builder_add_int(sb, nat_v2(n));
        str_builder_add_cstr(sb, " dnat ");
        _nat_l3_cf(sb, nat_v3(n), cf);
        str_builder_add_cstr(sb, "to ");
        _sb_add_nat_addr(sb, nat_v3(n), cf, 1);
        str_builder_add_cstr(sb, ":");
        str_builder_add_int(sb, nat_v4(n));
        _nat_comment(sb, nat_v5(n));
    } elif (nt == NAT_SNAT) {
        str_builder_add_cstr(sb, _nat_l3(nat_v1(n)));
        str_builder_add_cstr(sb, " saddr ");
        _sb_add_nat_addr(sb, nat_v1(n), cf, 0);
        str_builder_add_cstr(sb, " snat ");
        _nat_l3_cf(sb, nat_v2(n), cf);
        str_builder_add_cstr(sb, "to ");
        _sb_add_nat_addr(sb, nat_v2(n), cf, 0);
        _nat_comment(sb, nat_v3(n));
    } elif (nt == NAT_MASQUERADE) {
        str_builder_add_cstr(sb, _nat_l3(nat_v1(n)));
        str_builder_add_cstr(sb, " saddr ");
        _sb_add_nat_addr(sb, nat_v1(n), cf, 0);
        if (nat_v2(n) != 0) {
            str_builder_add_cstr(sb, " oifname \"");
            str_builder_add_cstr(sb, nat_v2(n));
            str_builder_add_cstr(sb, "\"");
        }
        str_builder_add_cstr(sb, " masquerade");
        _nat_comment(sb, nat_v3(n));
    } elif (nt == NAT_REDIRECT) {
        str_builder_add_cstr(sb, _proto_str(nat_v1(n)));
        str_builder_add_cstr(sb, " dport ");
        str_builder_add_int(sb, nat_v2(n));
        str_builder_add_cstr(sb, " redirect to :");
        str_builder_add_int(sb, nat_v3(n));
        _nat_comment(sb, nat_v4(n));
    } elif (nt == NAT_DNAT_RANGE) {
        var proto = _proto_str(nat_v1(n));
        var dps = nat_v2(n);
        var dpe = nat_v3(n);
        var tps = nat_v5(n);
        str_builder_add_cstr(sb, "fib daddr type local ");
        str_builder_add_cstr(sb, proto);
        str_builder_add_cstr(sb, " dport ");
        str_builder_add_int(sb, dps);
        str_builder_add_cstr(sb, "-");
        str_builder_add_int(sb, dpe);
        str_builder_add_cstr(sb, " dnat ");
        _nat_l3_cf(sb, nat_v4(n), cf);
        str_builder_add_cstr(sb, "to ");
        # As written, an IPv6 target is always bracketed; canonical, only
        # when the map follows (nft lists `dnat to fd00::4` with no port).
        var br = 1;
        if (cf != 0 && tps == dps) { br = 0; }
        _sb_add_nat_addr(sb, nat_v4(n), cf, br);
        if (tps != dps) {
            if (cf != 0) { str_builder_add_cstr(sb, ":"); } else { str_builder_add_cstr(sb, " : "); }
            str_builder_add_cstr(sb, proto);
            str_builder_add_cstr(sb, " dport map { ");
            var p = dps;
            while (p <= dpe) {
                if (p > dps) { str_builder_add_cstr(sb, ", "); }
                str_builder_add_int(sb, p);
                str_builder_add_cstr(sb, " : ");
                str_builder_add_int(sb, tps + (p - dps));
                p = p + 1;
            }
            str_builder_add_cstr(sb, " }");
        }
        _nat_comment(sb, nat_v7(n));
    } else {
        # Unknown NAT type: rendered nothing through 1.8.1. Fail closed.
        str_builder_add_cstr(sb, "__nein_invalid_nat__");
    }

    return str_builder_build(sb);
}

# --- Validate ---

fn _nat_port_ok(p: i64): i64 {
    if (p < 1 || p > 65535) { return 0; }
    return 1;
}

# NAT ports need a transport protocol with ports: tcp or udp.
fn _nat_proto_ok(proto: i64): i64 {
    if (proto == PROTO_TCP || proto == PROTO_UDP) { return 1; }
    return 0;
}

fn nat_validate(n: i64): i64 {
    var nt = nat_type(n);
    var vr = 0;

    if (nt == NAT_DNAT) {
        var vr1_t, vr1_v = validate_addr(nat_v3(n));
        if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
        # Ports and protocol were never checked through 1.8.1 (audit B-7 / I-8):
        # `dnat to A:0` was accepted, 70000 failed the whole batch at apply.
        if (_nat_proto_ok(nat_v1(n)) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if (_nat_port_ok(nat_v2(n)) == 0 || _nat_port_ok(nat_v4(n)) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if (nat_v5(n) != 0) {
            var vr2_t, vr2_v = validate_comment(nat_v5(n));
            if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
        }
    } elif (nt == NAT_SNAT) {
        var vr3_t, vr3_v = validate_addr(nat_v1(n));
        if (is_err_result(vr3_t) == 1) { return Err(vr3_v); }
        var vr4_t, vr4_v = validate_addr(nat_v2(n));
        if (is_err_result(vr4_t) == 1) { return Err(vr4_v); }
        # Source and translated address must be one family (nft refuses a mix).
        if (_addr_family(nat_v1(n)) != _addr_family(nat_v2(n))) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if (nat_v3(n) != 0) {
            var vr5_t, vr5_v = validate_comment(nat_v3(n));
            if (is_err_result(vr5_t) == 1) { return Err(vr5_v); }
        }
    } elif (nt == NAT_MASQUERADE) {
        var vr6_t, vr6_v = validate_addr(nat_v1(n));
        if (is_err_result(vr6_t) == 1) { return Err(vr6_v); }
        if (nat_v2(n) != 0) {
            var vr7_t, vr7_v = validate_iface(nat_v2(n));
            if (is_err_result(vr7_t) == 1) { return Err(vr7_v); }
        }
        if (nat_v3(n) != 0) {
            var vr8_t, vr8_v = validate_comment(nat_v3(n));
            if (is_err_result(vr8_t) == 1) { return Err(vr8_v); }
        }
    } elif (nt == NAT_REDIRECT) {
        if (_nat_proto_ok(nat_v1(n)) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if (_nat_port_ok(nat_v2(n)) == 0 || _nat_port_ok(nat_v3(n)) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if (nat_v4(n) != 0) {
            var vr9_t, vr9_v = validate_comment(nat_v4(n));
            if (is_err_result(vr9_t) == 1) { return Err(vr9_v); }
        }
    } elif (nt == NAT_DNAT_RANGE) {
        var vr10_t, vr10_v = validate_addr(nat_v4(n));
        if (is_err_result(vr10_t) == 1) { return Err(vr10_v); }
        var dps = nat_v2(n);
        var dpe = nat_v3(n);
        var tps = nat_v5(n);
        var tpe = nat_v6(n);
        if (_nat_proto_ok(nat_v1(n)) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if (_nat_port_ok(dps) == 0 || _nat_port_ok(dpe) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if (_nat_port_ok(tps) == 0 || _nat_port_ok(tpe) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if (dps > dpe) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if (tps > tpe) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if ((dpe - dps) != (tpe - tps)) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if (nat_v7(n) != 0) {
            var vr11_t, vr11_v = validate_comment(nat_v7(n));
            if (is_err_result(vr11_t) == 1) { return Err(vr11_v); }
        }
    } else {
        return nein_err(NEIN_ERR_INVALID_RULE);    # unknown NAT type (audit I-3)
    }

    return nein_ok();
}

# NAT in a table of family `fam` (1.9.3, probed against nft 1.1.7): inet, ip
# and ip6 only ("NAT is only supported for IPv4/IPv6"), and in an ip or ip6
# table every address the rule names must be that family's — nft refuses an
# IPv6 target in an ip table and an IPv4 one in an ip6 table. See rule.cyr's
# "Family".
fn _nat_addr_family_ok(addr: cstring, fam: i64): i64 {
    if (addr == 0) { return 1; }
    var v6 = _addr_has_colon(addr);
    if (fam == FAMILY_IP && v6 == 1) { return 0; }
    if (fam == FAMILY_IP6 && v6 == 0) { return 0; }
    return 1;
}

fn _nat_family_ok(n: i64, fam: i64): i64 {
    if (fam != FAMILY_INET && fam != FAMILY_IP && fam != FAMILY_IP6) { return 0; }
    var nt = nat_type(n);
    if (nt == NAT_DNAT) { return _nat_addr_family_ok(nat_v3(n), fam); }
    if (nt == NAT_DNAT_RANGE) { return _nat_addr_family_ok(nat_v4(n), fam); }
    # snat's target needs no check of its own: nat_validate holds it to its
    # source's family.
    if (nt == NAT_MASQUERADE || nt == NAT_SNAT) { return _nat_addr_family_ok(nat_v1(n), fam); }
    return 1;   # redirect names no address
}

# Where the kernel takes a NAT rule: dnat (and its port ranges) and redirect
# only in a nat chain on prerouting or output, snat only in one on postrouting
# or input, masquerade only on postrouting ("Operation not supported" anywhere
# else, at load — `nft -c` does not check it). 1 when chain type `ctype` at
# hook `hook` takes it.
fn _nat_hook_ok(n: i64, ctype: i64, hook: i64): i64 {
    if (ctype != CHAIN_NAT) { return 0; }
    var nt = nat_type(n);
    if (nt == NAT_MASQUERADE) {
        if (hook == HOOK_POSTROUTING) { return 1; }
        return 0;
    }
    if (nt == NAT_SNAT) {
        if (hook == HOOK_POSTROUTING || hook == HOOK_INPUT) { return 1; }
        return 0;
    }
    if (hook == HOOK_PREROUTING || hook == HOOK_OUTPUT) { return 1; }
    return 0;
}

# --- Convenience ---

fn port_forward(host_port: i64, container_addr: cstring, container_port: i64): i64 {
    return nat_dnat(PROTO_TCP, host_port, container_addr, container_port, "container port fwd");
}

fn port_range_forward(host_start: i64, host_end: i64, container_addr: cstring, container_start: i64): i64 {
    var range_size = host_end - host_start;
    var container_end = container_start + range_size;
    return nat_dnat_range(PROTO_TCP, host_start, host_end, container_addr,
      container_start, container_end, "container port range fwd");
}

fn container_masquerade(subnet: cstring, outbound_iface: cstring): i64 {
    return nat_masquerade(subnet, outbound_iface, "container outbound NAT");
}
