# nein diff module — live-rule diff + idempotent apply
#
# Compute the minimal set of nft operations that converge the live
# kernel ruleset onto a target firewall plan. Pairs with sutra's
# idempotent-apply playbook semantics: a sutra run can render its
# firewall, compute the diff against the live state, and apply only
# the deltas — no full re-apply if nothing changed.
#
# v1.5.0 scope:
#   - Rule-level diff: add rules in target but not live; delete rules
#     in live but not target (matched by handle).
#   - Table-level / chain-level create/delete are NOT computed —
#     tables and chains are assumed to exist with the right shapes.
#     A future revision can extend.
#
# Matching strategy: rule bodies are compared as byte-equal cstrings.
# Target rules go through `rule_render` (Str → cstring). Live rules
# come from the inspect parser with their `# handle N` suffix stripped.
# Exact match means "same rule"; any drift in whitespace or operand
# ordering produces a delete+add pair, which is conservative but
# always correct (nft accepts duplicate adds and rejects invalid
# deletes, both of which are surfaced as NEIN_ERR_NFT_FAILED).

# ================================================================
# LiveRule struct — { family, table, chain, body, handle }
# Layout: [family:8][table:8][chain:8][body:8][handle:8] = 40 bytes
# All four name fields are cstrings; handle is i64.
# ================================================================

fn _live_rule_new(family: cstring, table: cstring, chain: cstring,
  body: cstring, handle: i64): i64 {
    var lr = alloc(40);
    store64(lr, family);
    store64(lr + 8, table);
    store64(lr + 16, chain);
    store64(lr + 24, body);
    store64(lr + 32, handle);
    return lr;
}

fn live_rule_family(lr: i64): cstring { return load64(lr); }
fn live_rule_table(lr: i64): cstring { return load64(lr + 8); }
fn live_rule_chain(lr: i64): cstring { return load64(lr + 16); }
fn live_rule_body(lr: i64): cstring { return load64(lr + 24); }
fn live_rule_handle(lr: i64): i64 { return load64(lr + 32); }

# ================================================================
# Live ruleset parser — extracts LiveRule tuples from `nft list ruleset -a`
# ================================================================

# After a header's name, exactly what nft prints: " {", then either the end
# of the line or " # handle N" and the end. 1 when that holds. (The fuzz
# harness found `table inet fil{ ter {` slipping past a looser check.)
fn _header_rest_is_open(p: cstring): i64 {
    if (load8(p) != 32 || load8(p + 1) != 123) { return 0; }
    p = p + 2;
    if (load8(p) == 0) { return 1; }
    if (_cstr_starts_with(p, " # handle ") == 0) { return 0; }
    p = p + 10;
    var d = 0;
    while (load8(p) >= 48 && load8(p) <= 57) { p = p + 1; d = d + 1; }
    if (d == 0 || load8(p) != 0) { return 0; }
    return 1;
}

# Parse the "FAMILY NAME" suffix of a `table FAMILY NAME { # handle N`
# header. Sets *family_out and *table_out to fresh cstrings. Returns
# the position past the parsed names (or 0 on parse failure).
fn _parse_table_header(line: cstring): i64 {
    # Skip "table "
    var p = line + 6;
    var family_start = p;
    while (load8(p) != 32 && load8(p) != 0) { p = p + 1; }   # ' '
    if (load8(p) == 0) { return 0; }
    var family_len = p - family_start;
    var family = alloc(family_len + 1);
    memcpy(family, family_start, family_len);
    store8(family + family_len, 0);

    p = p + 1;   # skip space
    var name_start = p;
    while (load8(p) != 32 && load8(p) != 123 && load8(p) != 0) { p = p + 1; }
    var name_len = p - name_start;
    # Exactly `table FAMILY NAME {` (1.8.2, audit P-4): a name nft printed with
    # a space in it — `table inet filter x {` — used to parse as `filter`, a
    # VALID name, and that foreign table's rules were attributed to nein's.
    if (_header_rest_is_open(p) == 0) { return 0; }
    var name = alloc(name_len + 1);
    memcpy(name, name_start, name_len);
    store8(name + name_len, 0);

    # Store both in a 16-byte alloc — caller pulls family + name out.
    var out = alloc(16);
    store64(out, family);
    store64(out + 8, name);
    return out;
}

# Parse "chain NAME { # handle N" — extracts the chain name.
fn _parse_chain_header(line: cstring): cstring {
    var p = line + 6;   # skip "chain "
    var start = p;
    while (load8(p) != 32 && load8(p) != 123 && load8(p) != 0) { p = p + 1; }
    var len = p - start;
    if (_header_rest_is_open(p) == 0) { return 0; }   # exactly `chain NAME {` (P-4)
    var name = alloc(len + 1);
    memcpy(name, start, len);
    store8(name + len, 0);
    return name;
}

# Strip a `# handle N` suffix from a rule line. Returns (body_cstr, handle).
# A 16-byte alloc holds [body:8][handle:8]; handle is 0 if no handle present.
#
# QUOTE-AWARE since 1.6.10 (audit H-6). The old scan walked backwards looking
# for the last textual " # handle " with no notion of quoting, so a rule whose
# COMMENT contained that literal text — `comment "x # handle 9"` — had its body
# truncated at the comment and a handle read out of the comment text. The
# mis-parsed rule then drove add/delete decisions. Now the scan runs forward
# tracking quote state and only accepts a marker outside quotes. Backslash is
# not an escape inside nft quoted strings (verified against nftables 1.1.6),
# so every `"` toggles.
#
# The handle integer is also bounded (audit MEDIUM): the old accumulator was
# `handle = handle * 10 + digit` with no limit, so 20 digits silently wrapped
# and produced a `delete rule ... handle <wrapped>` that could target an
# unrelated rule. More than 18 digits, or no digits at all, now yields handle
# 0 — which _emit_del_rule refuses to build an op from.
fn _strip_handle_suffix(trimmed: cstring): i64 {
    var len = strlen(trimmed);
    var marker = " # handle ";
    var mlen = strlen(marker);

    # Forward scan: remember the last marker position that is OUTSIDE quotes.
    var found = 0 - 1;
    var in_quote = 0;
    var i = 0;
    while (i < len) {
        var c = load8(trimmed + i);
        if (c == 34) {
            if (in_quote == 0) { in_quote = 1; } else { in_quote = 0; }
        } elif (in_quote == 0 && i + mlen <= len) {
            var ok = 1;
            var j = 0;
            while (j < mlen) {
                if (load8(trimmed + i + j) != load8(marker + j)) { ok = 0; break; }
                j = j + 1;
            }
            if (ok == 1) { found = i; }
        }
        i = i + 1;
    }

    if (found < 0) {
        # No handle marker outside quotes — body is the whole line.
        var body1 = alloc(len + 1);
        memcpy(body1, trimmed, len);
        store8(body1 + len, 0);
        var out1 = alloc(16);
        store64(out1, body1);
        store64(out1 + 8, 0);
        return out1;
    }

    # Body is [0, found); handle is the bounded integer at found+mlen.
    var body = alloc(found + 1);
    memcpy(body, trimmed, found);
    store8(body + found, 0);

    var hp = trimmed + found + mlen;
    var handle = 0;
    var digits = 0;
    while (load8(hp) >= 48 && load8(hp) <= 57) {
        if (digits >= 18) { handle = 0; digits = 0 - 1; break; }
        handle = handle * 10 + (load8(hp) - 48);
        digits = digits + 1;
        hp = hp + 1;
    }
    # The handle must END the line (1.8.2, audit P-4). A quote smuggled into a
    # comment through `nft -j` defeats the quote tracker above, so
    # `accept comment "x" # handle 3" # handle 4` would read handle 3 where
    # the real one is 4. Anything after the digits fails closed.
    if (digits > 0 && load8(hp) != 0) { digits = 0; }
    if (digits <= 0) {
        # No digits, or an over-long run that could have wrapped. Fail closed:
        # handle 0 makes _emit_del_rule suppress the op entirely.
        var sk_bh = "nein.diff: unparseable rule handle — treated as absent";
        sakshi_warn(sk_bh, strlen(sk_bh));
        handle = 0;
    }

    var out = alloc(16);
    store64(out, body);
    store64(out + 8, handle);
    return out;
}

# 1 when a line holds an odd number of '"'. nft prints quoted strings
# verbatim — a comment created with an embedded newline or quote comes back
# split or unbalanced — so a line whose quotes do not balance cannot be
# trusted to say where its body or its handle is (1.8.2, audit P-4).
fn _quotes_unbalanced(s: cstring): i64 {
    var n = 0;
    var i = 0;
    var len = strlen(s);
    while (i < len) {
        if (load8(s + i) == 34) { n = n + 1; }
        i = i + 1;
    }
    return n & 1;
}

# Parse the live ruleset into a Vec of LiveRule tuples. `bad` gets 1 when the
# listing cannot be trusted (a line with unbalanced quotes); those lines are
# skipped. Block structure follows the shared rules in inspect.cyr
# (_line_opens_block / _line_closes_block).
fn _diff_parse(raw_str: Str, bad: i64): i64 {
    store64(bad, 0);
    var data = str_data(raw_str);
    var len = str_len(raw_str);
    var rules = vec_new();
    var line_start = 0;
    var i = 0;

    var current_family = 0;
    var current_table = 0;
    var current_chain = 0;

    var diff_bstack[128];
    var bs_depth = 0;
    store64(&diff_bstack, BLOCK_NONE);

    # An anonymous chain inside a rule (audit P-3): nft prints it as
    # `ip saddr 1.2.3.4 jump {` / inner rules / `} # handle N`. Through 1.8.1
    # the opening line became a handle-0 rule, each inner rule another, and
    # the close a phantom rule carrying the real handle — which blocked the
    # chain for good. It is now read as ONE rule, its handle from the close.
    var anon_sb = 0;
    var anon_depth = 0;

    while (i <= len) {
        var at_end = 0;
        if (i == len) { at_end = 1; }
        var c = 0;
        if (at_end == 0) { c = load8(data + i); }
        if (at_end == 1 || c == 10) {
            var line_len = i - line_start;
            if (line_len > 0 || at_end == 0) {
                var trimmed = _trim_line(data + line_start, line_len);
                var tlen = strlen(trimmed);
                if (tlen > 0) {
                    var current_block = load64(&diff_bstack + bs_depth * 8);
                    if (_quotes_unbalanced(trimmed) == 1) {
                        store64(bad, 1);
                        var sk_q = "nein.diff: unbalanced quotes in the live listing — not trusted";
                        sakshi_error(sk_q, strlen(sk_q));
                    }

                    if (anon_depth > 0) {
                        if (_line_closes_block(trimmed) == 1) {
                            anon_depth = anon_depth - 1;
                            if (anon_depth == 0) {
                                var bh0 = _strip_handle_suffix(trimmed);
                                str_builder_add_cstr(anon_sb, " ");
                                str_builder_add_cstr(anon_sb, load64(bh0));
                                if (current_family == 0 || current_table == 0 || current_chain == 0) {
                                    var sk_da = "nein.diff: anonymous chain outside a usable chain — skipped";
                                    sakshi_warn(sk_da, strlen(sk_da));
                                } else {
                                    vec_push(rules, _live_rule_new(current_family, current_table,
                                        current_chain, str_cstr(str_builder_build(anon_sb)), load64(bh0 + 8)));
                                }
                                anon_sb = 0;
                            } else {
                                str_builder_add_cstr(anon_sb, " ");
                                str_builder_add_cstr(anon_sb, trimmed);
                            }
                        } else {
                            if (_line_ends_open(trimmed) == 1) { anon_depth = anon_depth + 1; }
                            str_builder_add_cstr(anon_sb, " ");
                            str_builder_add_cstr(anon_sb, trimmed);
                        }
                    } else {
                        var opens = _line_opens_block(trimmed, current_block);
                        if (_line_closes_block(trimmed) == 1) {
                            if (bs_depth > 0) { bs_depth = bs_depth - 1; }
                            if (bs_depth == 0) {
                                current_family = 0;
                                current_table = 0;
                            }
                        } elif (opens == BLOCK_ANON) {
                            anon_depth = 1;
                            anon_sb = str_builder_new();
                            str_builder_add_cstr(anon_sb, trimmed);
                        } elif (opens == BLOCK_TABLE) {
                            # Names are validated (audit P-4 / P-5): nft prints
                            # them verbatim, and one created through `nft -j`
                            # with a space or a tab was truncated or carried
                            # its payload into the ops. A table or chain whose
                            # name is not a plain identifier is foreign by
                            # definition — nein never makes one — so its rules
                            # are skipped, never attributed elsewhere.
                            current_family = 0;
                            current_table = 0;
                            var th = _parse_table_header(trimmed);
                            if (th != 0) {
                                var tf_t, tf_v = validate_family(load64(th));
                                var tn_t, tn_v = validate_identifier(load64(th + 8));
                                if (is_err_result(tf_t) == 0 && is_err_result(tn_t) == 0) {
                                    current_family = load64(th);
                                    current_table = load64(th + 8);
                                }
                            }
                            if (bs_depth < 15) {
                                bs_depth = bs_depth + 1;
                                store64(&diff_bstack + bs_depth * 8, BLOCK_TABLE);
                            }
                        } elif (opens == BLOCK_CHAIN) {
                            current_chain = _parse_chain_header(trimmed);
                            var cn_t, cn_v = validate_identifier(current_chain);
                            if (is_err_result(cn_t) == 1) { current_chain = 0; }
                            if (bs_depth < 15) {
                                bs_depth = bs_depth + 1;
                                store64(&diff_bstack + bs_depth * 8, BLOCK_CHAIN);
                            }
                        } elif (opens != BLOCK_NONE) {
                            if (bs_depth < 15) {
                                bs_depth = bs_depth + 1;
                                store64(&diff_bstack + bs_depth * 8, opens);
                            }
                        } elif (current_block == BLOCK_CHAIN) {
                            if (_cstr_starts_with(trimmed, "type ") == 1) {
                                # not a rule
                            } elif (_cstr_starts_with(trimmed, "policy ") == 1) {
                                # not a rule
                            } elif (_line_is_chain_comment(trimmed) == 1) {
                                # the chain's own comment line (audit P-3)
                            } elif (load8(trimmed) == 35) {
                                # comment line
                            } elif (_quotes_unbalanced(trimmed) == 1) {
                                # untrusted (flagged above) — never a LiveRule
                            } else {
                                # Defence in depth (1.6.9): never build a LiveRule
                                # with a NULL family/table/chain — they are zeroed
                                # when the brace stack unwinds to 0 and when a
                                # header's name is unusable, and every consumer
                                # hands them to streq() -> strlen(NULL).
                                if (current_family == 0 || current_table == 0
                                  || current_chain == 0) {
                                    var sk_ds = "nein.diff: rule outside a usable table/chain — skipped";
                                    sakshi_warn(sk_ds, strlen(sk_ds));
                                } else {
                                    var bh = _strip_handle_suffix(trimmed);
                                    var lr = _live_rule_new(current_family,
                                      current_table,
                                      current_chain,
                                      load64(bh),
                                      load64(bh + 8));
                                    vec_push(rules, lr);
                                }
                            }
                        }
                    }
                }
            }
            line_start = i + 1;
        }
        i = i + 1;
    }
    # A listing that ends inside an anonymous chain is truncated: untrusted.
    if (anon_depth > 0) { store64(bad, 1); }
    return rules;
}

# Parse the live ruleset into a Vec of LiveRule tuples. Lines the parser
# cannot trust are skipped; nein_diff uses the status-reporting form above and
# refuses to act on such a listing.
fn diff_parse_live(raw_str: Str): i64 {
    var bad[8];
    return _diff_parse(raw_str, &bad);
}

# ================================================================
# Target rule extraction — walk a Firewall, yield Vec of LiveRule
# tuples (with handle=0 — target rules don't have handles).
# ================================================================

fn _family_to_cstr(fam: i64): cstring {
    if (fam == FAMILY_INET) { return "inet"; }
    if (fam == FAMILY_IP) { return "ip"; }
    if (fam == FAMILY_IP6) { return "ip6"; }
    if (fam == FAMILY_ARP) { return "arp"; }
    if (fam == FAMILY_BRIDGE) { return "bridge"; }
    if (fam == FAMILY_NETDEV) { return "netdev"; }
    return "inet";
}

fn _render_to_cstr(s: Str): cstring {
    var slen = str_len(s);
    var out = alloc(slen + 1);
    memcpy(out, str_data(s), slen);
    store8(out + slen, 0);
    return out;
}

fn diff_target_rules(fw: i64): i64 {
    var rules = vec_new();
    var tables = firewall_tables(fw);
    var tlen = vec_len(tables);
    var ti = 0;
    while (ti < tlen) {
        var t = vec_get(tables, ti);
        var family_cstr = _family_to_cstr(table_family(t));
        var table_name = table_name(t);
        var chains = table_chains(t);
        var clen = vec_len(chains);
        var ci = 0;
        while (ci < clen) {
            var ch = vec_get(chains, ci);
            var chain_name = chain_name(ch);
            var crules = chain_rules(ch);
            var rlen = vec_len(crules);
            var ri = 0;
            while (ri < rlen) {
                var cr = vec_get(crules, ri);
                # FAIL CLOSED (1.6.9). Until now this rendered straight to text
                # with no validation anywhere on the diff path, so nein_diff
                # piped un-validated rule bodies to `nft -f -` while
                # apply_firewall validated the same tree first. A rule that
                # cannot be validated is DROPPED from the target set rather
                # than emitted: refusing to add a rule is always safer than
                # adding one whose contents were never checked.
                if (is_err_result(chain_rule_validate(cr)) == 1) {
                    var sk_inv = "nein.diff: target rule failed validation — not emitted";
                    sakshi_error(sk_inv, strlen(sk_inv));
                    ri = ri + 1;
                    continue;
                }
                var rendered = chain_rule_render(cr);
                var body = _render_to_cstr(rendered);
                vec_push(rules, _live_rule_new(family_cstr, table_name,
                    chain_name, body, 0));
                ri = ri + 1;
            }
            ci = ci + 1;
        }
        ti = ti + 1;
    }
    return rules;
}

# ================================================================
# Diff computation — emit nft commands to converge live → target.
# Returns Vec<cstring>: each entry is a complete nft command line
# (including trailing newline) suitable for piping into `nft -f -`.
# ================================================================

# Match a target rule against the live ruleset. Returns 1 if any
# live rule has the same (family, table, chain, body); 0 otherwise.
fn _target_in_live(target_rule: i64, live_rules: i64): i64 {
    var fam = live_rule_family(target_rule);
    var tab = live_rule_table(target_rule);
    var chn = live_rule_chain(target_rule);
    var body = live_rule_body(target_rule);
    var n = vec_len(live_rules);
    var i = 0;
    while (i < n) {
        var lr = vec_get(live_rules, i);
        if (streq(live_rule_family(lr), fam) == 1
          && streq(live_rule_table(lr), tab) == 1
          && streq(live_rule_chain(lr), chn) == 1
          && streq(live_rule_body(lr), body) == 1) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

# Every name an op interpolates is checked (1.8.2, audit P-5). Through 1.8.1
# none was: a live chain created through `nft -j` with the name
# `A<TAB>handle<TAB>2;delete<TAB>table<TAB>inet<TAB>filter;#` produced a
# delete op that, applied, deleted nein's whole table; and a TARGET chain
# name reached `diff_compute` + `diff_apply` unvalidated (firewall_validate
# catches it only on the nein_diff path). 0 when any name is unusable.
fn _diff_names_ok(rule: i64): i64 {
    var f_t, f_v = validate_family(live_rule_family(rule));
    if (is_err_result(f_t) == 1) { return 0; }
    var t_t, t_v = validate_identifier(live_rule_table(rule));
    if (is_err_result(t_t) == 1) { return 0; }
    var c_t, c_v = validate_identifier(live_rule_chain(rule));
    if (is_err_result(c_t) == 1) { return 0; }
    return 1;
}

# Build "add rule FAM TAB CHN BODY\n", or 0 if a name is unusable.
fn _emit_add_rule(rule: i64): cstring {
    if (_diff_names_ok(rule) == 0) {
        var sk_an = "nein.diff: unusable table/chain name — add op refused";
        sakshi_error(sk_an, strlen(sk_an));
        return 0;
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "add rule ");
    str_builder_add_cstr(sb, live_rule_family(rule));
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, live_rule_table(rule));
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, live_rule_chain(rule));
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, live_rule_body(rule));
    str_builder_add_cstr(sb, "\n");
    return _render_to_cstr(str_builder_build(sb));
}

# Build "delete rule FAM TAB CHN handle N\n"
fn _emit_del_rule(rule: i64): cstring {
    # Handle 0 is not a real nft handle — it is what _strip_handle_suffix
    # returns when a line carried no `# handle N` suffix at all. Emitting
    # `delete rule ... handle 0` makes nft reject the ENTIRE batch, so a
    # single unparsed line silently discarded every add in the same
    # transaction. Refuse to build the op instead (1.6.9).
    if (live_rule_handle(rule) == 0) {
        var sk_h0 = "nein.diff: live rule has no handle — delete op suppressed";
        sakshi_error(sk_h0, strlen(sk_h0));
        return 0;
    }
    if (_diff_names_ok(rule) == 0) {
        var sk_dn = "nein.diff: unusable table/chain name — delete op refused";
        sakshi_error(sk_dn, strlen(sk_dn));
        return 0;
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "delete rule ");
    str_builder_add_cstr(sb, live_rule_family(rule));
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, live_rule_table(rule));
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, live_rule_chain(rule));
    str_builder_add_cstr(sb, " handle ");
    str_builder_add_int(sb, live_rule_handle(rule));
    str_builder_add_cstr(sb, "\n");
    return _render_to_cstr(str_builder_build(sb));
}

# Do two LiveRules belong to the same (family, table, chain)?
fn _same_chain(a: i64, b: i64): i64 {
    if (streq(live_rule_family(a), live_rule_family(b)) != 1) { return 0; }
    if (streq(live_rule_table(a), live_rule_table(b)) != 1) { return 0; }
    if (streq(live_rule_chain(a), live_rule_chain(b)) != 1) { return 0; }
    return 1;
}

# Are the two sides' rule bodies for this chain identical AND in the same
# order? Order is the whole point — see diff_compute's note.
fn _chain_in_sync(key: i64, target_rules: i64, live_rules: i64): i64 {
    var ti = 0; var li = 0;
    var tn = vec_len(target_rules); var ln = vec_len(live_rules);

    while (1 == 1) {
        while (ti < tn && _same_chain(vec_get(target_rules, ti), key) == 0) { ti = ti + 1; }
        while (li < ln && _same_chain(vec_get(live_rules, li), key) == 0) { li = li + 1; }
        if (ti >= tn && li >= ln) { return 1; }        # both exhausted together
        if (ti >= tn || li >= ln) { return 0; }        # one side has extra rules
        if (streq(live_rule_body(vec_get(target_rules, ti)),
            live_rule_body(vec_get(live_rules, li))) != 1) { return 0; }
        ti = ti + 1; li = li + 1;
    }
    return 1;
}

# Compute the diff: returns Vec<cstring> of nft commands.
# Empty vec = already in sync.
#
# ORDER-PRESERVING since 1.6.10 (audit H-5). The previous implementation
# treated each chain as an unordered SET: any target rule whose body already
# existed live was considered satisfied, and every other one became
# `add rule ...`, which nft APPENDS to the end of the chain. Rule order is
# nftables' evaluation semantics, so that could leave a chain matching neither
# the old nor the target ruleset. The concrete case: live `input` holds
# `ip saddr 10.0.0.0/8 accept`; the target prepends
# `ip saddr 10.0.0.5/32 drop` to block a compromised host. The accept already
# matched, so only the drop was emitted — and it landed AFTER the accept.
# The host stayed permitted. The old header comment called the byte-equality
# strategy "conservative but always correct"; it was not.
#
# Strategy now: compare each chain as an ORDERED sequence. A chain already in
# sync emits nothing, so the common no-op case stays free. A chain that
# differs in any way is rebuilt — every live rule deleted, every target rule
# re-added in order. That is safe because diff_apply concatenates all ops into
# a SINGLE `nft -f -`, and nftables commits a batch atomically: no packet ever
# observes a half-built chain.
#
# Fail-closed case: if a differing chain contains a live rule with no usable
# handle, it cannot be deleted — and re-adding the target rules on top would
# duplicate rather than replace. Such a chain is skipped entirely with an
# error rather than half-converged — and since 1.8.2 that is REPORTED: the
# status form returns NEIN_ERR_PARSE, and nein_diff then applies nothing
# (it used to return Ok with the chain silently left as it was; audit P-3).
#
# TARGET-SCOPED since 1.8.2 (audit P-1, HIGH). Through 1.8.1 every chain on
# EITHER side became a key, so a live chain the target never mentions was
# "out of sync" and every rule in it was deleted: with nein's `inet filter`
# fully in sync, a docker-style `ip nat POSTROUTING` masquerade was deleted
# (verified against nft 1.1.7). stiva, aegis, daimon, docker, libvirt and
# kube-proxy on one host would each have wiped the others' rules. Only the
# chains the target firewall declares are reconciled now — including an
# EMPTY target chain, which is how a caller empties one of its own chains.
# This also bounds the work by the target's chain count (audit P-6: the old
# key build was quadratic in the live chain count — 22.9 s at 8,000 chains).
# One key per chain the TARGET declares (rules or not).
fn _diff_target_keys(fw: i64): i64 {
    var keys = vec_new();
    var tables = firewall_tables(fw);
    var ti = 0;
    while (ti < vec_len(tables)) {
        var t = vec_get(tables, ti);
        var chains = table_chains(t);
        var ci = 0;
        while (ci < vec_len(chains)) {
            vec_push(keys, _live_rule_new(_family_to_cstr(table_family(t)), table_name(t),
                chain_name(vec_get(chains, ci)), 0, 0));
            ci = ci + 1;
        }
        ti = ti + 1;
    }
    return keys;
}

# The diff, with a status: `status_out` gets 0, or NEIN_ERR_PARSE when the
# live listing could not be trusted (then no ops at all are returned) or a
# target chain could not be converged (then its ops are withheld).
fn _diff_compute(target_fw: i64, live_raw: Str, status_out: i64): i64 {
    store64(status_out, 0);
    var ops = vec_new();
    var target_rules = diff_target_rules(target_fw);
    var bad[8];
    var live_rules = _diff_parse(live_raw, &bad);
    if (load64(&bad) != 0) {
        var sk_untr = "nein.diff: live listing not trusted — no ops computed";
        sakshi_error(sk_untr, strlen(sk_untr));
        store64(status_out, NEIN_ERR_PARSE);
        return ops;
    }

    var keys = _diff_target_keys(target_fw);
    var ki = 0;
    while (ki < vec_len(keys)) {
        var key = vec_get(keys, ki);

        if (_chain_in_sync(key, target_rules, live_rules) == 1) {
            ki = ki + 1;
            continue;
        }

        # Build this chain's ops on the side; they join `ops` only if every
        # one of them could be built — a chain is converged whole or not at all.
        var chain_ops = vec_new();
        var ok = 1;
        var l = 0;
        while (l < vec_len(live_rules)) {
            var lr = vec_get(live_rules, l);
            if (_same_chain(lr, key) == 1) {
                var del_op = _emit_del_rule(lr);
                if (del_op == 0) { ok = 0; } else { vec_push(chain_ops, del_op); }
            }
            l = l + 1;
        }
        var t = 0;
        while (t < vec_len(target_rules)) {
            var tr = vec_get(target_rules, t);
            if (_same_chain(tr, key) == 1) {
                var add_op = _emit_add_rule(tr);
                if (add_op == 0) { ok = 0; } else { vec_push(chain_ops, add_op); }
            }
            t = t + 1;
        }
        if (ok == 0) {
            var sk_blk = "nein.diff: chain not converged (no-handle live rule or unusable name) — untouched";
            sakshi_error(sk_blk, strlen(sk_blk));
            store64(status_out, NEIN_ERR_PARSE);
        } else {
            var oi = 0;
            while (oi < vec_len(chain_ops)) { vec_push(ops, vec_get(chain_ops, oi)); oi = oi + 1; }
        }
        ki = ki + 1;
    }

    return ops;
}

# Compute the diff: Vec<cstring> of nft commands, empty when in sync — or
# when the live listing could not be trusted, or no target chain could be
# converged. Use nein_diff (which reports those as Err) to act on it.
fn diff_compute(target_fw: i64, live_raw: Str): i64 {
    var st[8];
    return _diff_compute(target_fw, live_raw, &st);
}

# ================================================================
# Apply a diff — concatenate ops into a single `nft -f -` invocation
# so the kernel applies them atomically (transaction semantics).
# ================================================================

fn diff_apply(ops: i64): i64 {
    var n = vec_len(ops);
    if (n == 0) { return nein_ok(); }

    var sb = str_builder_new();
    var i = 0;
    while (i < n) {
        str_builder_add_cstr(sb, vec_get(ops, i));
        i = i + 1;
    }
    var combined = str_builder_build(sb);
    return apply_ruleset_str(combined);
}

# ================================================================
# Convenience: list live + compute diff + apply.
# Returns Vec<cstring> of ops that WERE applied, or Err on failure.
#
# Honors the target firewall's dry-run flag: the live ruleset is still listed
# and the op set still computed, but nothing is applied. The returned Vec is
# then the set of ops that WOULD have been applied — which is exactly what a
# dry-run caller wants to inspect. Same `!= 0` fail-safe check as
# `apply_firewall`.
# ================================================================

fn nein_diff(target_fw: i64): i64 {
    # Validate the whole target tree before anything is rendered or applied.
    # apply_firewall has always done this; the diff path did not, which made
    # nein_diff a way to reach `nft -f -` with un-validated rule text (1.6.9).
    var vr1_t, vr1_v = firewall_validate(target_fw);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }

    # `-a` is required: without it nft omits the `# handle N` suffixes and
    # every parsed live rule gets handle 0, so every delete op was emitted as
    # `delete rule ... handle 0` and nft rejected the whole batch (1.6.9).
    var live_res1_t, live_res1_v = list_ruleset_with_handles();
    if (is_err_result(live_res1_t) == 1) { return Err(live_res1_v); }
    var live_raw = live_res1_v;
    var dst[8];
    var ops = _diff_compute(target_fw, live_raw, &dst);
    # A listing nein cannot trust, or a chain it cannot converge, is an error
    # and NOTHING is applied (1.8.2, audit P-3): through 1.8.1 nein_diff
    # returned Ok with that chain silently left as it was.
    if (load64(&dst) != 0) { return nein_err(load64(&dst)); }
    if (firewall_dry_run(target_fw) != 0) {
        var sk_dry = "nein.diff: dry-run set — ops computed but not applied";
        sakshi_info(sk_dry, strlen(sk_dry));
        return Ok(ops);
    }
    var apply_res1_t, apply_res1_v = diff_apply(ops);
    if (is_err_result(apply_res1_t) == 1) { return Err(apply_res1_v); }
    return Ok(ops);
}

# ================================================================
# Comment-keyed handle lookup
#
# The live-rule parser above keys on rule BODY. This pair keys on the rule's
# nft comment instead, which is how a consumer finds "every rule I created for
# agent X" without having to reconstruct the exact rendered text. That is the
# input `add_rule_after_live` / `delete_rule_live` need: both take a handle,
# and until now nothing produced one from a comment.
#
# The needle is `comment "PREFIX` — the opening quote is part of it, so a
# prefix cannot match inside some other rule's operand text.
# ================================================================

# Substring search over cstrings. Returns 1 if haystack contains needle.
fn _cstr_contains(haystack: cstring, needle: cstring): i64 {
    var nlen = strlen(needle);
    if (nlen == 0) { return 1; }
    var hlen = strlen(haystack);
    if (nlen > hlen) { return 0; }

    var i = 0;
    while (i <= hlen - nlen) {
        var j = 0;
        while (j < nlen && load8(haystack + i + j) == load8(needle + j)) {
            j = j + 1;
        }
        if (j == nlen) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Pure function — parse `nft -a` output and keep only rules whose comment
# starts with `comment_prefix`. Separated from the subprocess call so it is
# testable against captured nft output without root. Returns Vec<LiveRule>.
fn parse_rules_with_handles(raw_str: Str, comment_prefix: cstring): i64 {
    var all = diff_parse_live(raw_str);
    var out = vec_new();

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "comment \"");
    str_builder_add_cstr(sb, comment_prefix);
    var needle = str_cstr(str_builder_build(sb));

    var n = vec_len(all);
    var i = 0;
    while (i < n) {
        var lr = vec_get(all, i);
        if (_cstr_contains(live_rule_body(lr), needle) == 1) {
            vec_push(out, lr);
        }
        i = i + 1;
    }
    return out;
}

# Find live rules in one table whose comment starts with `comment_prefix`.
# Returns Ok(Vec<LiveRule>) or Err. All three arguments are validated before
# any subprocess runs — comment_prefix goes through validate_comment because
# it is operator input that reaches an execve argv via the table listing.
fn find_rules_by_comment(family: cstring, table: cstring, comment_prefix: cstring): i64 {
    var vr1_t, vr1_v = validate_comment(comment_prefix);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }

    # list_table_with_handles validates family + table itself.
    var res1_t, res1_v = list_table_with_handles(family, table);
    if (is_err_result(res1_t) == 1) { return Err(res1_v); }

    return Ok(parse_rules_with_handles(res1_v, comment_prefix));
}
