    test_nft_name_positions();
    test_builder_composed_names();
    test_diff_canonical();
    test_validate_parseable_192();
    test_accessor_roundtrip();
    test_family_validity();

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
