fn bench_bridge_large_validate() { firewall_validate(_bench_bridge_large_fw); return 0; }
fn bench_set_1000_elements_render() { nft_set_render(_bench_set_1000); return 0; }
fn bench_table_20_defines_render() { table_render(_bench_table_20); return 0; }
fn bench_deep_protocol_render() { rule_render(_bench_deep_rule); return 0; }
fn bench_deep_protocol_validate() { rule_validate(_bench_deep_rule); return 0; }
fn bench_flowtable_render() { flowtable_render(_bench_flowtable); return 0; }
fn bench_ct_timeout_render() { ct_timeout_render(_bench_ct_timeout); return 0; }
fn bench_quota_rule_render() { rule_render(_bench_quota_rule); return 0; }
fn bench_nat_range_render() { nat_render(_bench_nat_range); return 0; }

# Large-bridge scale pair.
fn bench_bridge_large_to_firewall() { bf_to_firewall(_bench_bridge_large); return 0; }
fn bench_bridge_large_render() { firewall_render(_bench_bridge_large_fw); return 0; }

# Conversion benches — these time the BUILD step (module config -> Firewall)
# separately from rendering it, which is where an O(n^2) assembly bug would
# hide behind a linear render.
fn bench_engine_100_agents_to_firewall() { pe_to_firewall(_bench_engine_100); return 0; }
# pe_validate composes and checks each agent's chain names (1.9.1, B-8).
fn bench_pe_validate_100_agents() { pe_validate(_bench_engine_100); return 0; }
fn bench_geoip_10_countries_to_firewall() { geoip_to_firewall(_bench_geoip_10); return 0; }
fn bench_mesh_to_firewall() { mesh_to_firewall(_bench_mesh_cfg); return 0; }

# --- signed rulesets + MCP gate (1.9.0) ---
# v1 against v2 on the same body, so the replay binding's cost is on record:
# v2 signs a message that copies the body behind a 12-byte tag and its bound
# fields, and its parser checks the digest, so it hashes the body once more.
var _bench_sk = 0;
var _bench_pk = 0;
var _bench_body = 0;
var _bench_env1 = 0;
var _bench_env2 = 0;
var _bench_env2_1000 = 0;

fn _bench_gate(name: cstring, claims: i64): i64 { return NEIN_GATE_PERMIT; }

fn _bench_setup_sign() {
    _bench_sk = alloc(64);
    _bench_pk = alloc(32);
    sign_keygen(_bench_sk, _bench_pk);
    _bench_body = firewall_render(basic_host_firewall());
    var a_t, a_v = sign_ruleset_body(_bench_body, _bench_sk, "bench");
    _bench_env1 = a_v;
    var b_t, b_v = sign_ruleset_body_v2(_bench_body, _bench_sk, "bench", "host-1", 42, 0);
    _bench_env2 = b_v;
    var c_t, c_v = sign_ruleset_body_v2(firewall_render(_bench_fw_1000), _bench_sk, "bench", "host-1", 42, 0);
    _bench_env2_1000 = c_v;
    nein_mcp_set_gate(&_bench_gate);
    return 0;
}

fn bench_sign_v1() { sign_ruleset_body(_bench_body, _bench_sk, "bench"); return 0; }
fn bench_verify_v1() { verify_ruleset(_bench_env1, _bench_pk); return 0; }
fn bench_sign_v2() { sign_ruleset_body_v2(_bench_body, _bench_sk, "bench", "host-1", 42, 0); return 0; }
fn bench_verify_v2() { verify_ruleset_v2(_bench_env2, _bench_pk, "host-1", 42, 1800000000); return 0; }
fn bench_verify_v2_1000_rules() { verify_ruleset_v2(_bench_env2_1000, _bench_pk, "host-1", 42, 1800000000); return 0; }
fn bench_parse_v2() { parse_signed_ruleset_v2(_bench_env2); return 0; }
fn bench_mcp_gate_check() { _nein_gate_check("nein_validate", 0); return 0; }
fn bench_mcp_dispatch_validate() { nein_mcp_dispatch("nein_validate", "{\"protocol\":\"tcp\",\"port\":443}", 0); return 0; }

# --- diff (1.9.2) ---
# A 100-rule chain diffed against a listing of itself: the common nein_diff
# case, nothing to do. `plain` holds only rules nft lists as nein writes them
# (comparable with 1.9.1, which compared as written); `nft` holds counters
# with counted values and /32 addresses, which only compare equal since 1.9.2
# (audit P-8) — through 1.9.1 that listing rebuilt the chain.
var _bench_diff_plain_fw = 0;
var _bench_diff_plain_live = 0;
var _bench_diff_nft_fw = 0;
var _bench_diff_nft_live = 0;

fn _bench_diff_fw(mixed: i64): i64 {
    var fw = firewall_new();
    var t = table_new("filter", FAMILY_INET);
    var c = chain_base("input", CHAIN_FILTER, HOOK_INPUT, 0, POLICY_DROP);
    var i = 0;
    while (i < 100) {
        if (mixed == 1 && i % 10 == 0) { chain_add_rule(c, rule_new(verdict_counter())); }
        elif (mixed == 1 && i % 10 == 5) { chain_add_rule(c, deny_source(_b_cidr(10, 0, i, 5, 32))); }
        else { chain_add_rule(c, allow_tcp(2000 + i)); }
        i = i + 1;
    }
    table_add_chain(t, c);
    firewall_add_table(fw, t);
    return fw;
}

fn _bench_diff_live(mixed: i64): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "table inet filter { # handle 1\n\tchain input { # handle 1\n");
    str_builder_add_cstr(sb, "\t\ttype filter hook input priority filter; policy drop;\n");
    var i = 0;
    while (i < 100) {
        str_builder_add_cstr(sb, "\t\t");
        if (mixed == 1 && i % 10 == 0) { str_builder_add_cstr(sb, "counter packets 12 bytes 3456"); }
        elif (mixed == 1 && i % 10 == 5) {
            str_builder_add_cstr(sb, "ip saddr 10.0.");
            str_builder_add_int(sb, i);
            str_builder_add_cstr(sb, ".5 drop");
        } else {
            str_builder_add_cstr(sb, "tcp dport ");
            str_builder_add_int(sb, 2000 + i);
            str_builder_add_cstr(sb, " accept");
        }
        str_builder_add_cstr(sb, " # handle ");
        str_builder_add_int(sb, i + 2);
        str_builder_add_cstr(sb, "\n");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "\t}\n}\n");
    return str_builder_build(sb);
}

fn _bench_setup_diff() {
    _bench_diff_plain_fw = _bench_diff_fw(0);
    _bench_diff_plain_live = _bench_diff_live(0);
    _bench_diff_nft_fw = _bench_diff_fw(1);
    _bench_diff_nft_live = _bench_diff_live(1);
    # Both must be in sync, or the benches measure a rebuild.
    if (vec_len(diff_compute(_bench_diff_plain_fw, _bench_diff_plain_live)) != 0) { println("bench setup: plain diff not in sync"); }
    if (vec_len(diff_compute(_bench_diff_nft_fw, _bench_diff_nft_live)) != 0) { println("bench setup: nft diff not in sync"); }
    return 0;
}

fn bench_diff_compute_100_plain() { diff_compute(_bench_diff_plain_fw, _bench_diff_plain_live); return 0; }
fn bench_diff_compute_100_nft() { diff_compute(_bench_diff_nft_fw, _bench_diff_nft_live); return 0; }
fn bench_addr_canon_ipv6() { _addr_canon("2001:db8:0:0:1:0:0:1/128"); return 0; }
fn bench_diff_strip_state() { _diff_strip_state("ip daddr 127.0.0.1 counter packets 6 bytes 504 accept comment \"web\""); return 0; }

fn main() {
    alloc_init();
    _bench_setup_scale();
    _bench_setup_sign();
    _bench_setup_diff();
    var all = vec_new();
    var b = 0;

    b = bench_new("validate_identifier/short"); bench_run(b, &bench_validate_identifier_short, 100000); vec_push(all, b);
    b = bench_new("validate_identifier/long"); bench_run(b, &bench_validate_identifier_long, 100000); vec_push(all, b);
    b = bench_new("validate_addr/ipv4"); bench_run(b, &bench_validate_addr_ipv4, 100000); vec_push(all, b);
    b = bench_new("validate_addr/cidr"); bench_run(b, &bench_validate_addr_cidr, 100000); vec_push(all, b);
    b = bench_new("validate_addr/ipv6"); bench_run(b, &bench_validate_addr_ipv6, 100000); vec_push(all, b);
    b = bench_new("validate_iface"); bench_run(b, &bench_validate_iface, 100000); vec_push(all, b);
    b = bench_new("validate_comment"); bench_run(b, &bench_validate_comment, 100000); vec_push(all, b);
    b = bench_new("validate_ct_state"); bench_run(b, &bench_validate_ct_state, 100000); vec_push(all, b);
    b = bench_new("validate_family"); bench_run(b, &bench_validate_family, 100000); vec_push(all, b);
    b = bench_new("validate_nft_name/miss"); bench_run(b, &bench_validate_nft_name_miss, 100000); vec_push(all, b);
    b = bench_new("validate_nft_name/keyword"); bench_run(b, &bench_validate_nft_name_keyword, 100000); vec_push(all, b);

    b = bench_new("rule_render/simple"); bench_run(b, &bench_rule_render_simple, 100000); vec_push(all, b);
    b = bench_new("rule_render/service"); bench_run(b, &bench_rule_render_service, 100000); vec_push(all, b);
    b = bench_new("rule_render/complex"); bench_run(b, &bench_rule_render_complex, 100000); vec_push(all, b);

    b = bench_new("rule_validate/simple"); bench_run(b, &bench_rule_validate_simple, 100000); vec_push(all, b);
    b = bench_new("rule_validate/complex"); bench_run(b, &bench_rule_validate_complex, 100000); vec_push(all, b);

    b = bench_new("nein_err"); bench_run(b, &bench_nein_err, 1000000); vec_push(all, b);
    b = bench_new("nein_ok"); bench_run(b, &bench_nein_ok, 1000000); vec_push(all, b);

    b = bench_new("table_render/full"); bench_run(b, &bench_table_render, 10000); vec_push(all, b);
    b = bench_new("chain_render/base"); bench_run(b, &bench_chain_render, 100000); vec_push(all, b);
    b = bench_new("set_render"); bench_run(b, &bench_set_render, 100000); vec_push(all, b);

    b = bench_new("nat_dnat_render"); bench_run(b, &bench_nat_dnat_render, 100000); vec_push(all, b);
    b = bench_new("nat_masquerade_render"); bench_run(b, &bench_nat_masquerade_render, 100000); vec_push(all, b);
    b = bench_new("nat_validate"); bench_run(b, &bench_nat_validate, 100000); vec_push(all, b);

    b = bench_new("basic_host_firewall"); bench_run(b, &bench_basic_host_firewall, 10000); vec_push(all, b);
    b = bench_new("container_bridge"); bench_run(b, &bench_container_bridge, 10000); vec_push(all, b);
    b = bench_new("firewall_validate"); bench_run(b, &bench_firewall_validate, 10000); vec_push(all, b);

    b = bench_new("policy_to_rules"); bench_run(b, &bench_policy_to_rules, 100000); vec_push(all, b);
    b = bench_new("geoip_render"); bench_run(b, &bench_geoip_render, 10000); vec_push(all, b);
    b = bench_new("mesh_render"); bench_run(b, &bench_mesh_render, 10000); vec_push(all, b);
    b = bench_new("bridge_render"); bench_run(b, &bench_bridge_render, 10000); vec_push(all, b);
    b = bench_new("engine_10_agents_render"); bench_run(b, &bench_engine_10_agents_render, 1000); vec_push(all, b);
    b = bench_new("netns_render"); bench_run(b, &bench_netns_render, 10000); vec_push(all, b);

    # --- deep protocol + single-object renders (1.6.7) ---
    b = bench_new("deep_protocol_render"); bench_run(b, &bench_deep_protocol_render, 100000); vec_push(all, b);
    b = bench_new("deep_protocol_validate"); bench_run(b, &bench_deep_protocol_validate, 100000); vec_push(all, b);
    b = bench_new("flowtable_render"); bench_run(b, &bench_flowtable_render, 100000); vec_push(all, b);
    b = bench_new("ct_timeout_render"); bench_run(b, &bench_ct_timeout_render, 100000); vec_push(all, b);
    b = bench_new("quota_rule_render"); bench_run(b, &bench_quota_rule_render, 100000); vec_push(all, b);
    b = bench_new("nat_range_render"); bench_run(b, &bench_nat_range_render, 100000); vec_push(all, b);

    # --- scale (1.6.7) — these are the ones that catch algorithmic drift ---
    b = bench_new("table_20_defines_render"); bench_run(b, &bench_table_20_defines_render, 10000); vec_push(all, b);
    b = bench_new("set_1000_elements_render"); bench_run(b, &bench_set_1000_elements_render, 1000); vec_push(all, b);
    b = bench_new("firewall_1000_rules_render"); bench_run(b, &bench_firewall_1000_rules_render, 200); vec_push(all, b);
    b = bench_new("firewall_1000_rules_validate"); bench_run(b, &bench_firewall_1000_rules_validate, 200); vec_push(all, b);
    b = bench_new("engine_100_agents_render"); bench_run(b, &bench_engine_100_agents_render, 200); vec_push(all, b);
    b = bench_new("engine_100_agents_validate"); bench_run(b, &bench_engine_100_agents_validate, 200); vec_push(all, b);
    b = bench_new("bridge_large_render"); bench_run(b, &bench_bridge_large_render, 1000); vec_push(all, b);

    # --- conversion benches (1.6.8) — build step, timed apart from render ---
    b = bench_new("bridge_large_to_firewall"); bench_run(b, &bench_bridge_large_to_firewall, 1000); vec_push(all, b);
    b = bench_new("engine_100_agents_to_firewall"); bench_run(b, &bench_engine_100_agents_to_firewall, 200); vec_push(all, b);
    b = bench_new("pe_validate_100_agents"); bench_run(b, &bench_pe_validate_100_agents, 200); vec_push(all, b);
    b = bench_new("geoip_10_countries_to_firewall"); bench_run(b, &bench_geoip_10_countries_to_firewall, 10000); vec_push(all, b);
    b = bench_new("mesh_to_firewall"); bench_run(b, &bench_mesh_to_firewall, 10000); vec_push(all, b);

    # --- signed rulesets + MCP gate (1.9.0) ---
    b = bench_new("sign_v1"); bench_run(b, &bench_sign_v1, 500); vec_push(all, b);
    b = bench_new("verify_v1"); bench_run(b, &bench_verify_v1, 500); vec_push(all, b);
    b = bench_new("sign_v2"); bench_run(b, &bench_sign_v2, 500); vec_push(all, b);
    b = bench_new("verify_v2"); bench_run(b, &bench_verify_v2, 500); vec_push(all, b);
    b = bench_new("verify_v2_1000_rules"); bench_run(b, &bench_verify_v2_1000_rules, 200); vec_push(all, b);
    b = bench_new("parse_v2"); bench_run(b, &bench_parse_v2, 10000); vec_push(all, b);
    b = bench_new("mcp_gate_check"); bench_run(b, &bench_mcp_gate_check, 100000); vec_push(all, b);
    b = bench_new("mcp_dispatch_validate"); bench_run(b, &bench_mcp_dispatch_validate, 100000); vec_push(all, b);
    b = bench_new("bridge_large_validate"); bench_run(b, &bench_bridge_large_validate, 1000); vec_push(all, b);
    b = bench_new("diff_compute/100_plain"); bench_run(b, &bench_diff_compute_100_plain, 200); vec_push(all, b);
    b = bench_new("diff_compute/100_nft"); bench_run(b, &bench_diff_compute_100_nft, 200); vec_push(all, b);
    b = bench_new("addr_canon/ipv6"); bench_run(b, &bench_addr_canon_ipv6, 100000); vec_push(all, b);
    b = bench_new("diff_strip_state"); bench_run(b, &bench_diff_strip_state, 100000); vec_push(all, b);

    bench_report_all(all);
    return 0;
}

var r = main();
syscall(60, r);
