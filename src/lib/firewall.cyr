# nein firewall module — top-level Firewall manager
#
# Firewall struct — { tables(vec), dry_run }
# Layout: [tables:8][dry_run:8] = 16 bytes

fn firewall_new(): i64 {
    var fw = alloc(16);
    store64(fw, vec_new());
    store64(fw + 8, 0);
    return fw;
}

fn firewall_tables(fw: i64): i64 { return load64(fw); }
fn firewall_dry_run(fw: i64): i64 { return load64(fw + 8); }

fn firewall_set_dry_run(fw: i64, enabled: i64): i64 {
    store64(fw + 8, enabled);
    return fw;
}

fn firewall_add_table(fw: i64, t: i64): i64 {
    vec_push(load64(fw), t);
    return fw;
}

# --- Remove consecutive duplicate rules within each chain ---
#
# Returns the number of rules removed. Two rules are duplicates when they
# render to identical nft text — a stronger test than comparing fields, since
# it also catches rules assembled by different code paths that collapse to the
# same line (e.g. two builders both emitting `ct state { established, related }
# accept`).
#
# Only CONSECUTIVE duplicates are collapsed, matching the Rust original's
# `Vec::dedup`. This is deliberate, not a shortcut: rule order is semantic in
# nftables, and a non-terminal rule (`counter`, bare `log`) that appears twice
# with other rules between them is counted twice on purpose. Collapsing across
# a gap would silently change packet accounting. Adjacent identical rules are
# the unambiguous case — the second can never observe traffic the first did
# not — so that is the only one collapsed here.
fn firewall_deduplicate(fw: i64): i64 {
    var removed = 0;
    var tables = firewall_tables(fw);
    var tlen = vec_len(tables);
    var ti = 0;

    while (ti < tlen) {
        var chains = table_chains(vec_get(tables, ti));
        var clen = vec_len(chains);
        var ci = 0;
        while (ci < clen) {
            var rules = chain_rules(vec_get(chains, ci));
            var i = 1;
            while (i < vec_len(rules)) {
                var prev = chain_rule_render(vec_get(rules, i - 1));
                var cur = chain_rule_render(vec_get(rules, i));
                if (str_eq(prev, cur) == 1) {
                    vec_remove(rules, i);
                    removed = removed + 1;
                } else {
                    i = i + 1;
                }
            }
            ci = ci + 1;
        }
        ti = ti + 1;
    }

    return removed;
}

# --- Render: concatenate all tables with trailing newlines ---
fn firewall_render(fw: i64): Str {
    var sb = str_builder_new();
    var tables = firewall_tables(fw);
    var tlen = vec_len(tables);
    var i = 0;
    while (i < tlen) {
        var rendered = table_render(vec_get(tables, i));
        str_builder_add_cstr(sb, str_data(rendered));
        str_builder_add_cstr(sb, "\n");
        i = i + 1;
    }
    return str_builder_build(sb);
}

# --- Validate all tables, chains, and contents ---
fn firewall_validate(fw: i64): i64 {
    var tables = firewall_tables(fw);
    var tlen = vec_len(tables);
    var i = 0;
    var j = 0;
    var vec2 = 0;
    var vlen = 0;
    var vr = 0;

    while (i < tlen) {
        var t = vec_get(tables, i);

        var vr1_t, vr1_v = validate_identifier(table_name(t));
        if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }

        # Defines
        vec2 = table_defines(t);
        vlen = vec_len(vec2);
        j = 0;
        while (j < vlen) {
            var vr2_t, vr2_v = define_validate(vec_get(vec2, j));
            if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
            j = j + 1;
        }

        # Flowtables
        vec2 = table_flowtables(t);
        vlen = vec_len(vec2);
        j = 0;
        while (j < vlen) {
            var vr3_t, vr3_v = flowtable_validate(vec_get(vec2, j));
            if (is_err_result(vr3_t) == 1) { return Err(vr3_v); }
            j = j + 1;
        }

        # CT timeouts
        vec2 = table_ct_timeouts(t);
        vlen = vec_len(vec2);
        j = 0;
        while (j < vlen) {
            var vr4_t, vr4_v = ct_timeout_validate(vec_get(vec2, j));
            if (is_err_result(vr4_t) == 1) { return Err(vr4_v); }
            j = j + 1;
        }

        # Sets
        vec2 = table_sets(t);
        vlen = vec_len(vec2);
        j = 0;
        while (j < vlen) {
            var vr5_t, vr5_v = nft_set_validate(vec_get(vec2, j));
            if (is_err_result(vr5_t) == 1) { return Err(vr5_v); }
            j = j + 1;
        }

        # Maps
        vec2 = table_maps(t);
        vlen = vec_len(vec2);
        j = 0;
        while (j < vlen) {
            var vr6_t, vr6_v = nft_map_validate(vec_get(vec2, j));
            if (is_err_result(vr6_t) == 1) { return Err(vr6_v); }
            j = j + 1;
        }

        # Chains
        vec2 = table_chains(t);
        vlen = vec_len(vec2);
        j = 0;
        while (j < vlen) {
            var chain = vec_get(vec2, j);
            var vr7_t, vr7_v = validate_identifier(chain_name(chain));
            if (is_err_result(vr7_t) == 1) { return Err(vr7_v); }
            var rules = chain_rules(chain);
            var rlen = vec_len(rules);
            var k = 0;
            while (k < rlen) {
                var vr8_t, vr8_v = chain_rule_validate(vec_get(rules, k));
                if (is_err_result(vr8_t) == 1) { return Err(vr8_v); }
                k = k + 1;
            }
            j = j + 1;
        }

        i = i + 1;
    }

    return nein_ok();
}
