# ================================================================
# Error tests
# ================================================================

fn test_error() {
    test_group("error");
    assert(NEIN_ERR_NFT_FAILED != 0, "NEIN_ERR_NFT_FAILED nonzero");
    assert(NEIN_ERR_INVALID_RULE != 0, "NEIN_ERR_INVALID_RULE nonzero");
    assert(NEIN_ERR_TABLE_NOT_FOUND != 0, "NEIN_ERR_TABLE_NOT_FOUND nonzero");
    assert(NEIN_ERR_CHAIN_NOT_FOUND != 0, "NEIN_ERR_CHAIN_NOT_FOUND nonzero");
    assert(NEIN_ERR_PERMISSION_DENIED != 0, "NEIN_ERR_PERMISSION_DENIED nonzero");
    assert(NEIN_ERR_PARSE != 0, "NEIN_ERR_PARSE nonzero");
    assert(NEIN_ERR_IO != 0, "NEIN_ERR_IO nonzero");

    assert(NEIN_ERR_NFT_FAILED != NEIN_ERR_INVALID_RULE, "nft != invalid");
    assert(NEIN_ERR_INVALID_RULE != NEIN_ERR_TABLE_NOT_FOUND, "invalid != table");
    assert(NEIN_ERR_TABLE_NOT_FOUND != NEIN_ERR_CHAIN_NOT_FOUND, "table != chain");
    assert(NEIN_ERR_CHAIN_NOT_FOUND != NEIN_ERR_PERMISSION_DENIED, "chain != perm");
    assert(NEIN_ERR_PERMISSION_DENIED != NEIN_ERR_PARSE, "perm != parse");
    assert(NEIN_ERR_PARSE != NEIN_ERR_IO, "parse != io");

    var e_t, e_v = nein_err(NEIN_ERR_NFT_FAILED);
    assert(is_err_result(e_t) == 1, "nein_err returns Err");
    assert_eq(nein_err_code(e_t, e_v), NEIN_ERR_NFT_FAILED, "err_code extracts code");

    var ok_t, ok_v = nein_ok();
    assert(is_ok(ok_t) == 1, "nein_ok returns Ok");
    return 0;
}

# ================================================================
# Validate tests
# ================================================================

fn test_validate_identifier() {
    test_group("validate_identifier");
    assert(is_ok(validate_identifier("filter")) == 1, "filter ok");
    assert(is_ok(validate_identifier("my_table")) == 1, "my_table ok");
    assert(is_ok(validate_identifier("agnos-policy")) == 1, "agnos-policy ok");
    assert(is_ok(validate_identifier("0eth0")) == 1, "numeric start ok");
    assert(is_ok(validate_identifier("123")) == 1, "all numeric ok");
    assert(is_err_result(validate_identifier("")) == 1, "empty rejected");
    assert(is_err_result(validate_identifier("has space")) == 1, "space rejected");
    assert(is_err_result(validate_identifier("evil;drop")) == 1, "semicolon rejected");
    assert(is_err_result(validate_identifier("has{brace")) == 1, "brace rejected");

    var buf64[520];
    memset(&buf64, 97, 64);
    store8(&buf64 + 64, 0);
    assert(is_ok(validate_identifier(&buf64)) == 1, "64 chars ok");
    memset(&buf64, 97, 65);
    store8(&buf64 + 65, 0);
    assert(is_err_result(validate_identifier(&buf64)) == 1, "65 chars rejected");
    return 0;
}

# A fresh cstring of n copies of byte c.
fn _t_fill(n: i64, c: i64): cstring {
    var p = alloc(n + 1);
    memset(p, c, n);
    store8(p + n, 0);
    return p;
}

# 1.9.1, audit I-10: nft's grammar for a bare name, probed against nft 1.1.7.
fn test_validate_nft_name() {
    test_group("validate_nft_name");
    assert(is_ok(validate_nft_name("filter")) == 1, "filter is a name");
    assert(is_ok(validate_nft_name("nat")) == 1, "nat is a name");
    assert(is_ok(validate_nft_name("input")) == 1, "input is a name");
    assert(is_ok(validate_nft_name("postrouting")) == 1, "postrouting is a name");
    assert(is_ok(validate_nft_name("_3f2a")) == 1, "a leading underscore is a name");
    assert(is_ok(validate_nft_name("a-b")) == 1, "an inner hyphen is a name");
    assert(is_ok(validate_nft_name("FWD")) == 1, "keywords are case-sensitive: FWD is a name");
    assert(is_ok(validate_nft_name("fwd2")) == 1, "a keyword with a suffix is a name");
    assert(is_ok(validate_nft_name("xfwd")) == 1, "a keyword with a prefix is a name");
    assert(is_ok(validate_nft_name("fw")) == 1, "a keyword's prefix is a name");
    assert(is_ok(validate_nft_name("ih")) == 1, "ih is a name (probed)");
    assert(is_ok(validate_nft_name("k")) == 1, "a letter with no keywords is a name");
    assert(is_ok(validate_nft_name(_t_fill(64, 97))) == 1, "64 bytes is a name");

    # Keywords: the audit's example, common chain names, and the edges of the
    # per-letter lists (first, last, the second half of a split list).
    assert(is_err_result(validate_nft_name("fwd")) == 1, "fwd refused (I-10)");
    assert(is_err_result(validate_nft_name("log")) == 1, "log refused");
    assert(is_err_result(validate_nft_name("counter")) == 1, "counter refused");
    assert(is_err_result(validate_nft_name("ip")) == 1, "ip refused");
    assert(is_err_result(validate_nft_name("bridge")) == 1, "bridge refused");
    assert(is_err_result(validate_nft_name("dnat")) == 1, "dnat refused");
    assert(is_err_result(validate_nft_name("accept")) == 1, "accept refused (first listed)");
    assert(is_err_result(validate_nft_name("xt")) == 1, "xt refused (last letter)");
    assert(is_err_result(validate_nft_name("gc-interval")) == 1, "gc-interval refused (11 bytes, the longest)");
    assert(is_err_result(validate_nft_name("ct")) == 1, "ct refused (2 bytes, the shortest)");
    assert(is_err_result(validate_nft_name("ipsec")) == 1, "ipsec refused (second i list)");
    assert(is_err_result(validate_nft_name("ruleset")) == 1, "ruleset refused (second r list)");
    assert(is_err_result(validate_nft_name("auto-merge")) == 1, "auto-merge refused");
    # The operators spelled out: nft lists them in its errors as symbols
    # (`==`, `^`, `<<`, `>>`), so neither word source nor error harvest found
    # them; an independent review did.
    assert(is_err_result(validate_nft_name("eq")) == 1, "eq refused (==)");
    assert(is_err_result(validate_nft_name("xor")) == 1, "xor refused (^)");
    assert(is_err_result(validate_nft_name("lshift")) == 1, "lshift refused (<<)");
    assert(is_err_result(validate_nft_name("rshift")) == 1, "rshift refused (>>)");
    assert(is_ok(validate_nft_name("neq")) == 1, "neq is a name");
    # The list scope: names everywhere else, keywords to `nft list table`.
    assert(is_ok(validate_nft_name("rules")) == 1, "rules is a name");
    assert_eq(_nft_list_keyword("rules"), 1, "rules is a list-scope keyword");
    assert_eq(_nft_list_keyword("tables"), 1, "tables is a list-scope keyword");
    assert_eq(_nft_list_keyword("count"), 1, "count is a list-scope keyword");
    assert_eq(_nft_list_keyword("flowtables"), 1, "flowtables is a list-scope keyword (the longest)");
    assert_eq(_nft_list_keyword("filter"), 0, "filter is no list-scope keyword");
    assert_eq(_nft_list_keyword("rule"), 0, "rule is no list-scope keyword (it is a keyword everywhere)");

    # A leading digit or hyphen: nft reads a number or an option.
    assert(is_err_result(validate_nft_name("3f2a")) == 1, "a leading digit refused (a container id)");
    assert(is_err_result(validate_nft_name("123")) == 1, "all digits refused");
    assert(is_err_result(validate_nft_name("0")) == 1, "0 refused");
    assert(is_err_result(validate_nft_name("-x")) == 1, "a leading hyphen refused");

    # Everything validate_identifier refuses, still refused.
    assert(is_err_result(validate_nft_name(0)) == 1, "NULL refused");
    assert(is_err_result(validate_nft_name("")) == 1, "empty refused");
    assert(is_err_result(validate_nft_name("evil;drop")) == 1, "injection refused");
    assert(is_err_result(validate_nft_name(_t_fill(65, 97))) == 1, "65 bytes refused");

    # The narrower lists.
    assert_eq(_nft_ct_keyword("state"), 1, "state is a ct-scope keyword");
    assert_eq(_nft_ct_keyword("zone"), 1, "zone is a ct-scope keyword");
    assert_eq(_nft_ct_keyword("last"), 1, "last is a ct-scope keyword");
    assert_eq(_nft_ct_keyword("web"), 0, "web is no ct-scope keyword");
    assert_eq(_nft_ref_reserved("ll", 0), 1, "@ll is a raw payload base");
    assert_eq(_nft_ref_reserved("nh", 0), 1, "@nh is a raw payload base");
    assert_eq(_nft_ref_reserved("last", 0), 0, "@last is a set reference");
    assert_eq(_nft_ref_reserved("last", 1), 1, "flow offload @last is refused");
    assert_eq(_nft_ref_reserved("ft", 1), 0, "flow offload @ft is a reference");

    # Every listed word: as wide as its row says (the lookup steps by that
    # width), in strict alphabetical order within its width (the lookup stops
    # early on it; strict, so none is listed twice), an identifier nein would
    # otherwise take, and refused. The totals pin the lists to the nft 1.1.7
    # probe (160 + 28).
    var words = vec_new();
    var misfiled = 0;
    var n = 2;
    while (n <= 11) {
        var prev = 0;
        var part = 0;
        while (part < 3) {
            var row = vec_new();
            _t_split(_nft_kw_list(n, part), row);
            var r = 0;
            while (r < vec_len(row)) {
                var w = vec_get(row, r);
                if (strlen(w) != n) { misfiled = misfiled + 1; }
                if (prev != 0 && _t_before(prev, w) == 0) { misfiled = misfiled + 1; }
                prev = w;
                vec_push(words, w);
                r = r + 1;
            }
            part = part + 1;
        }
        n = n + 1;
    }
    assert_eq(vec_len(words), 160, "160 keywords listed");
    assert_eq(misfiled, 0, "every keyword is its row's width, in strict order");
    var taken = 0;
    var k = 0;
    while (k < vec_len(words)) {
        var kw = vec_get(words, k);
        if (is_ok(validate_identifier(kw)) == 0 || is_ok(validate_nft_name(kw)) == 1) { taken = taken + 1; }
        k = k + 1;
    }
    assert_eq(taken, 0, "every keyword is an identifier validate_nft_name refuses");
    var ct = vec_new();
    n = 2;
    while (n <= 11) {
        var crow = vec_new();
        _t_split(_nft_ct_kw_list(n), crow);
        var cprev = 0;
        var q = 0;
        while (q < vec_len(crow)) {
            var cw = vec_get(crow, q);
            if (strlen(cw) != n) { misfiled = misfiled + 1; }
            if (cprev != 0 && _t_before(cprev, cw) == 0) { misfiled = misfiled + 1; }
            cprev = cw;
            vec_push(ct, cw);
            q = q + 1;
        }
        n = n + 1;
    }
    assert_eq(vec_len(ct), 28, "28 ct-scope keywords listed");
    var lst = vec_new();
    n = 2;
    while (n <= 11) {
        var lrow = vec_new();
        _t_split(_nft_list_kw_list(n), lrow);
        var lprev = 0;
        var lq = 0;
        while (lq < vec_len(lrow)) {
            var lw = vec_get(lrow, lq);
            if (strlen(lw) != n) { misfiled = misfiled + 1; }
            if (lprev != 0 && _t_before(lprev, lw) == 0) { misfiled = misfiled + 1; }
            if (_nft_list_keyword(lw) == 0) { misfiled = misfiled + 1; }
            lprev = lw;
            vec_push(lst, lw);
            lq = lq + 1;
        }
        n = n + 1;
    }
    assert_eq(vec_len(lst), 16, "16 list-scope keywords listed");
    assert_eq(misfiled, 0, "every ct-scope keyword is its row's width, in strict order");
    var ct_ok = 0;
    k = 0;
    while (k < vec_len(ct)) { ct_ok = ct_ok + _nft_ct_keyword(vec_get(ct, k)); k = k + 1; }
    assert_eq(ct_ok, 28, "every ct-scope keyword is found");
    return 0;
}

# 1 when cstring a sorts strictly before b, byte by byte.
fn _t_before(a: cstring, b: cstring): i64 {
    var i = 0;
    while (load8(a + i) != 0 && load8(a + i) == load8(b + i)) { i = i + 1; }
    if (load8(a + i) < load8(b + i)) { return 1; }
    return 0;
}

# Push each space-separated word of list (0: none) onto out as a cstring.
fn _t_split(list: cstring, out: i64): i64 {
    if (list == 0) { return 0; }
    var i = 0;
    while (load8(list + i) != 0) {
        var j = i;
        while (load8(list + j) != 0 && load8(list + j) != 32) { j = j + 1; }
        var w = alloc(j - i + 1);
        memcpy(w, list + i, j - i);
        store8(w + j - i, 0);
        vec_push(out, w);
        i = j;
        if (load8(list + i) == 32) { i = i + 1; }
    }
    return 0;
}

fn test_validate_addr() {
    test_group("validate_addr");
    # A dotted quad needs "::" (1.9.1): nft has no rule for six groups and a
    # dotted quad, and refuses the batch.
    assert(is_err_result(validate_addr("1:2:3:4:5:6:1.2.3.4")) == 1, "x:x:x:x:x:x:d.d.d.d refused (nft cannot parse it)");
    assert(is_err_result(validate_addr("0:0:0:0:0:ffff:10.0.0.1/128")) == 1, "uncompressed v4-mapped refused");
    assert(is_ok(validate_addr("::ffff:10.0.0.1")) == 1, "::ffff:d.d.d.d ok");
    assert(is_ok(validate_addr("1:2:3:4:5::1.2.3.4")) == 1, "compressed with a dotted quad ok");
    assert(is_ok(validate_addr("1::4:5:6:1.2.3.4")) == 1, "compressed, three groups and a dotted quad ok");
    assert(is_ok(validate_addr("1:2:3:4:5:6:7:8")) == 1, "eight groups ok");
    assert(is_ok(validate_addr("10.0.0.1")) == 1, "10.0.0.1 ok");
    assert(is_ok(validate_addr("192.168.0.0/16")) == 1, "CIDR ok");
    assert(is_ok(validate_addr("172.17.0.2")) == 1, "172 ok");
    assert(is_ok(validate_addr("::1")) == 1, "::1 ok");
    assert(is_ok(validate_addr("fe80::/10")) == 1, "fe80 CIDR ok");
    assert(is_ok(validate_addr("2001:db8::1")) == 1, "2001:db8 ok");
    assert(is_err_result(validate_addr("")) == 1, "empty rejected");
    assert(is_err_result(validate_addr("not_an_addr")) == 1, "alpha rejected");
    assert(is_err_result(validate_addr("10.0.0.1;drop")) == 1, "semicolon rejected");
    assert(is_err_result(validate_addr("10.0.0.1|evil")) == 1, "pipe rejected");
    # 1.8.2 (audit I-9): an address must PARSE. Through 1.8.1 a hex-only DNS
    # name passed the character check and nft resolved it at apply time.
    assert(is_err_result(validate_addr("dead1.cafe")) == 1, "hex-only DNS name rejected");
    assert(is_err_result(validate_addr("256.1.1.1")) == 1, "octet > 255 rejected");
    assert(is_err_result(validate_addr("01.2.3.4")) == 1, "leading-zero octet rejected");
    assert(is_err_result(validate_addr("1.2.3")) == 1, "three octets rejected");
    assert(is_err_result(validate_addr("10.0.0.0/33")) == 1, "IPv4 prefix > 32 rejected");
    assert(is_err_result(validate_addr("2001:db8::/129")) == 1, "IPv6 prefix > 128 rejected");
    assert(is_err_result(validate_addr("1::2::3")) == 1, "two '::' rejected");
    assert(is_err_result(validate_addr("fe80::1%eth0")) == 1, "zone index rejected");
    assert(is_err_result(validate_addr("10.0.0.1 accept")) == 1, "trailing token rejected");
    assert(is_err_result(validate_addr(0)) == 1, "NULL rejected, no crash");
    assert(is_ok(validate_addr("::ffff:10.0.0.1")) == 1, "v4-mapped IPv6 ok");
    assert(is_ok(validate_addr("0.0.0.0/0")) == 1, "IPv4 default route ok");
    assert(is_ok(validate_addr("::/0")) == 1, "IPv6 default route ok");
    assert_eq(_addr_family("10.0.0.1"), 4, "family of IPv4 is 4");
    assert_eq(_addr_family("2001:db8::1"), 6, "family of IPv6 is 6");
    # ports and set-lookup selectors (I-1, I-2)
    assert_eq(_is_port_token("65535"), 1, "port 65535 ok");
    assert_eq(_is_port_token("65536"), 0, "port 65536 rejected");
    assert_eq(_is_port_token("80-90"), 1, "port range ok");
    assert_eq(_is_port_token("90-80"), 0, "reversed port range rejected");
    assert_eq(_is_port_token("22 : accept, 23"), 0, "map-key injection rejected");
    assert_eq(_is_set_lookup_field("ip saddr"), 1, "set field ip saddr ok");
    assert_eq(_is_set_lookup_field("ip saddr !="), 0, "set field with operator rejected");
    return 0;
}

fn test_validate_iface() {
    test_group("validate_iface");
    assert(is_ok(validate_iface("eth0")) == 1, "eth0 ok");
    assert(is_ok(validate_iface("br-container")) == 1, "br-container ok");
    assert(is_ok(validate_iface("veth1.2")) == 1, "veth1.2 ok");
    assert(is_ok(validate_iface("lo")) == 1, "lo ok");
    assert(is_err_result(validate_iface("")) == 1, "empty rejected");
    assert(is_err_result(validate_iface("evil;drop")) == 1, "semicolon rejected");

    var buf16[24];
    memset(&buf16, 97, 15);
    store8(&buf16 + 15, 0);
    assert(is_ok(validate_iface(&buf16)) == 1, "15 chars ok");
    memset(&buf16, 97, 16);
    store8(&buf16 + 16, 0);
    assert(is_err_result(validate_iface(&buf16)) == 1, "16 chars rejected");
    return 0;
}

fn test_validate_ct_state() {
    test_group("validate_ct_state");
    assert(is_ok(validate_ct_state("new")) == 1, "new ok");
    assert(is_ok(validate_ct_state("established")) == 1, "established ok");
    assert(is_ok(validate_ct_state("related")) == 1, "related ok");
    assert(is_ok(validate_ct_state("invalid")) == 1, "invalid ok");
    assert(is_ok(validate_ct_state("untracked")) == 1, "untracked ok");
    assert(is_err_result(validate_ct_state("bogus")) == 1, "bogus rejected");
