[package]
name = "nein"
version = "${file:VERSION}"
description = "nein — programmatic nftables firewall"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/nein"
language = "cyrius"
cyrius = "6.5.33"

[build]
entry = "src/main.cyr"
output = "build/nein"

# `[lib]` declares the modules `cyrius distlib` concatenates into
# `dist/nein.cyr` — the single-file bundle consumed by stiva / aegis
# / daimon / sutra. Order matches `src/main.cyr`'s include chain:
# error → validate → primitives → aggregator → feature modules →
# integrators. Pattern lifted from agnosys / agnostik 1.2.x.
[lib]
modules = [
    "src/lib/error.cyr",
    "src/lib/validate.cyr",
    "src/lib/rule.cyr",
    "src/lib/set.cyr",
    "src/lib/nat.cyr",
    "src/lib/chain.cyr",
    "src/lib/table.cyr",
    "src/lib/firewall.cyr",
    "src/lib/builder.cyr",
    "src/lib/policy.cyr",
    "src/lib/geoip.cyr",
    "src/lib/mesh.cyr",
    "src/lib/bridge.cyr",
    "src/lib/engine.cyr",
    "src/lib/config.cyr",
    "src/lib/netns.cyr",
    "src/lib/apply.cyr",
    "src/lib/inspect.cyr",
    "src/lib/diff.cyr",
]

# `[lib.mcp]` — opt-in bundle for hosts that want nein's MCP + signing
# surface (daimon, 1.6.2). `cyrius distlib mcp` → dist/nein-mcp.cyr adds
# sign.cyr + mcp.cyr on top of the full [lib] core. The bundle carries
# unresolved bote (jsonx / dispatcher / annotations) and sigil (ed25519 /
# hex / sha256) symbols by design — the consumer (daimon) supplies both,
# exactly as bote's [lib.core] leaves its stdlib to the consumer. The
# default dist/nein.cyr stays bote/sigil-free; consumers opt into this one.
[lib.mcp]
modules = [
    "src/lib/error.cyr",
    "src/lib/validate.cyr",
    "src/lib/rule.cyr",
    "src/lib/set.cyr",
    "src/lib/nat.cyr",
    "src/lib/chain.cyr",
    "src/lib/table.cyr",
    "src/lib/firewall.cyr",
    "src/lib/builder.cyr",
    "src/lib/policy.cyr",
    "src/lib/geoip.cyr",
    "src/lib/mesh.cyr",
    "src/lib/bridge.cyr",
    "src/lib/engine.cyr",
    "src/lib/config.cyr",
    "src/lib/netns.cyr",
    "src/lib/apply.cyr",
    "src/lib/inspect.cyr",
    "src/lib/diff.cyr",
    "src/lib/sign.cyr",
    "src/lib/mcp.cyr",
]

# Rationale for every entry below — why each stdlib module is declared, why
# the order matters, and why sigil and patra carry top-level git pins — lives
# in docs/development/dependencies.md. Comments are kept OUT of the stdlib
# array: the .cyml parser scans comment text for quoted tokens and section
# headers and mis-resolves deps when it finds them there.
[deps]
stdlib = [
    "string",
    "fmt",
    "alloc",
    "vec",
    "str",
    "syscalls",
    "io",
    "args",
    "assert",
    "tagged",
    "result",
    "hashmap",
    "bayan",
    "process",
    "bench",
    "fnptr",
    "callback",
    "freelist",
    "fs",
    "net",
    "regex",
    "chrono",
    "sakshi",
    "ct",
    "keccak",
    "random",
    "slice",
    "thread",
    "thread_local",
    "sync",
    "atomic",
]

# Build sequence is explicit — Cyrius does not auto-resolve. Run
# cyrius lib sync to copy the declared stdlib subset above into ./lib/, THEN
# cyrius deps to clone these bundles at their tags and copy each dist bundle
# into ./lib/. libro and majra are declared before bote because bote's graph
# references them and Cyrius resolves single-pass.
[deps.libro]
git = "https://github.com/MacCracken/libro.git"
tag = "2.8.8"
modules = ["dist/libro.cyr"]

[deps.majra]
git = "https://github.com/MacCracken/majra.git"
tag = "2.6.7"
modules = ["dist/majra.cyr"]

[deps.bote]
git = "https://github.com/MacCracken/bote.git"
tag = "3.3.2"
modules = ["dist/bote-core.cyr"]

# sigil crypto — explicit pin to the self-contained single-file dist bundle,
# same pattern as libro and majra. Reaches the latest bundle (the stdlib
# registry lags the toolchain snapshot) and wins over libro's transitive thin
# sigil sub-bundles, which otherwise collide with the full surface. See
# docs/development/dependencies.md.
[deps.sigil]
git = "https://github.com/MacCracken/sigil.git"
tag = "3.12.9"
modules = ["dist/sigil.cyr"]

# patra sqlite — libro's audit store links it and libro's dep sidecar pulls it
# transitively. Pinned explicitly too so the pin stays current independent of
# libro's own choice and no shadow-lib warning fires. nein calls no patra
# symbol directly.
[deps.patra]
git = "https://github.com/MacCracken/patra.git"
tag = "1.13.9"
modules = ["dist/patra.cyr"]
