# nein input validation
#
# All strings interpolated into nftables syntax pass through these
# validators to prevent injection of arbitrary nft commands.
#
# Returns: packed Result — Ok(0) on valid, Err(NEIN_ERR_INVALID_RULE) on reject.
#
# Every validator refuses a NULL pointer (1.8.2, audit B-10): through 1.8.1
# they called strlen(0) and the host SIGSEGV'd. Callers whose field is
# optional (a rule comment, a log prefix) check for 0 themselves first.

# Dangerous characters that could inject nftables commands or break syntax.
# ; { } | \n \r \0 ` $
#
# Checked by scanning each byte of the input string.

fn _is_dangerous_char(c: i64): i64 {
    if (c == 59) { return 1; }    # ;
    if (c == 123) { return 1; }   # {
    if (c == 125) { return 1; }   # }
    if (c == 124) { return 1; }   # |
    if (c == 10) { return 1; }    # \n
    if (c == 13) { return 1; }    # \r
    if (c == 0) { return 1; }     # \0 (mid-string)
    if (c == 96) { return 1; }    # `
    if (c == 36) { return 1; }    # $
    return 0;
}

fn _has_dangerous_char(s: cstring): i64 {
    var len = strlen(s);
    var i = 0;
    while (i < len) {
        if (_is_dangerous_char(load8(s + i)) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn _has_quote(s: cstring): i64 {
    var len = strlen(s);
    var i = 0;
    while (i < len) {
        if (load8(s + i) == 34) { return 1; }   # "
        i = i + 1;
    }
    return 0;
}

# Check if a character is alphanumeric or _ or -
fn _is_ident_char(c: i64): i64 {
    # a-z
    if (c >= 97 && c <= 122) { return 1; }
    # A-Z
    if (c >= 65 && c <= 90) { return 1; }
    # 0-9
    if (c >= 48 && c <= 57) { return 1; }
    # _ -
    if (c == 95) { return 1; }
    if (c == 45) { return 1; }
    return 0;
}

# Check if a character is valid for interface names (alnum, -, _, .)
fn _is_iface_char(c: i64): i64 {
    if (_is_ident_char(c) == 1) { return 1; }
    if (c == 46) { return 1; }   # .
    return 0;
}

# --- Public validators ---

# Validate an nftables identifier (table name, chain name).
# Must be non-empty, alphanumeric plus _ and -, at most 64 chars.
fn validate_identifier(s: cstring): i64 {
    if (s == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var len = strlen(s);
    if (len == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (len > 64) { return nein_err(NEIN_ERR_INVALID_RULE); }

    var i = 0;
    while (i < len) {
        if (_is_ident_char(load8(s + i)) == 0) {
            return nein_err(NEIN_ERR_INVALID_RULE);
        }
        i = i + 1;
    }
    return nein_ok();
}

# --- nft names (1.9.1, audit I-10) ----------------------------------
# validate_identifier's charset is not nft's grammar for a name. Where nein
# renders a name bare — a table, chain, set, map, flowtable, ct timeout or
# define name, a jump / goto target, an @reference — nft 1.1.7 refuses:
#   - a name that starts with a digit or '-' (`3f2a`, `1abc`, `-x`), which
#     its scanner reads as a number or an option;
#   - one of its keywords (`fwd`, `log`, `counter`, `ip`, ... 160 of them).
#     Keywords are case-sensitive: `FWD` is a name.
# Through 1.9.0 both passed validation and failed the whole batch at apply.
# The lists below were probed, not transcribed: 5,118 candidate words (every
# word of nft(8), libnftables-json(5), the shipped example rulesets and JSON
# schema, and libnftables' own strings) were each declared at twelve name
# positions under nft 1.1.7, and a word is listed where nft refused it. Then
# every lowercase name of 1 to 5 letters (12.4 million) and 12,582 wider
# candidates (each part of libnftables' symbol names, and each candidate's
# plural) were checked as names; with the list below, nft takes every one. A
# keyword a later nft adds still fails closed, at apply, as before;
# tests/integration/nft_grammar.tcyr re-checks the list against the installed nft.

# 1 when the n-byte name s is a word of row: a run of n-byte words, one
# space apart, in alphabetical order (0: no row). The fixed width steps word
# to word with no scan, and the order stops at the first word past s's first
# letter.
fn _kw_row_has(s: cstring, n: i64, row: cstring): i64 {
    if (row == 0) { return 0; }
    var c = load8(s);
    var i = 0;
    var more = 1;
    while (more == 1) {
        var r = load8(row + i);
        if (r == c) {
            if (memeq(row + i, s, n) == 1) { return 1; }
        }
        if (r > c) { return 0; }
        if (load8(row + i + n) == 0) { more = 0; }
        i = i + n + 1;
    }
    return 0;
}

# nft's keywords in every name position, as rows of n-byte words, part 0-2
# (0 past the last). 160 words of 2 to 11 bytes; the tests check the count,
# each word's width and the order. `eq`, `xor`, `lshift` and `rshift` are
# the operators `==`, `^`, `<<` and `>>` spelled out: nft lists them in its
# errors as symbols, so neither the word sources nor the error harvest found
# them, and an independent review did (1.9.1).
fn _nft_kw_list(n: i64, part: i64): cstring {
    if (n == 2) {
        if (part == 0) { return "ah ct eq ge gt ip le lt mh ne or rt th xt"; }
        return 0;
    }
    if (n == 3) {
        if (part == 0) { return "add all and arp cpu day dst dup ecn esp fib fwd get gre hbh iif ip6 log map not oif"; }
        if (part == 1) { return "osf rt0 rt2 set srh tcp udp vni xor"; }
        return 0;
    }
    if (n == 4) {
        if (part == 0) { return "comp dccp dnat drop flow frag goto hook hour icmp igmp inet jump list mark meta"; }
        if (part == 1) { return "rule sctp size snat time type vlan vmap"; }
        return 0;
    }
    if (n == 5) {
        if (part == 0) { return "chain ether flags flush index ipsec jhash limit meter queue quota reset skgid skuid"; }
        if (part == 1) { return "table vxlan"; }
        return 0;
    }
    if (n == 6) {
        if (part == 0) { return "accept bridge cgroup create define delete device exists export exthdr geneve gretap"; }
        if (part == 1) { return "handle icmpv6 import insert lshift netdev numgen policy random reject rename return"; }
        if (part == 2) { return "rshift socket tproxy tunnel typeof update"; }
        return 0;
    }
    if (n == 7) {
        if (part == 0) { return "comment counter destroy devices dynamic element expires ibrname iifname iiftype"; }
        if (part == 1) { return "include missing monitor nftrace notrack obrname offload oifname oiftype pkttype"; }
        if (part == 2) { return "replace ruleset secmark symhash timeout udplite"; }
        return 0;
    }
    if (n == 8) {
        if (part == 0) { return "constant continue describe elements ibriport iifgroup interval obriport oifgroup"; }
        if (part == 1) { return "position priority redefine redirect synproxy undefine"; }
        return 0;
    }
    if (n == 9) {
        if (part == 0) { return "flowtable rtclassid"; }
        return 0;
    }
    if (n == 10) {
        if (part == 0) { return "auto-merge masquerade"; }
        return 0;
    }
    if (n == 11) {
        if (part == 0) { return "gc-interval"; }
        return 0;
    }
    return 0;
}

# 1 when s (n bytes) is an nft keyword in every name position.
fn _nft_keyword(s: cstring, n: i64): i64 {
    if (n < 2 || n > 11) { return 0; }
    var part = 0;
    while (part < 3) {
        if (_kw_row_has(s, n, _nft_kw_list(n, part)) == 1) { return 1; }
        part = part + 1;
    }
    return 0;
}

# The keywords of nft's ct scope, which a ct timeout's NAME is read in
# (`ct timeout state { ... }` is refused; probed, nft 1.1.7), as one row of
# n-byte words per width (0: none). 28 words. Only the ct timeout
# declaration needs them.
fn _nft_ct_kw_list(n: i64): cstring {
    if (n == 2) { return "id"; }
    if (n == 4) { return "last name over zone"; }
    if (n == 5) { return "bytes count daddr dport event label reply saddr state until"; }
    if (n == 6) { return "avgpkt helper status"; }
    if (n == 7) { return "helpers l3proto packets"; }
    if (n == 8) { return "original protocol"; }
    if (n == 9) { return "direction proto-dst proto-src"; }
    if (n == 10) { return "expiration"; }
    if (n == 11) { return "expectation"; }
    return 0;
}

# 1 when s is a ct-scope keyword (see _nft_ct_kw_list).
fn _nft_ct_keyword(s: cstring): i64 {
    var n = strlen(s);
    if (n < 2 || n > 11) { return 0; }
    return _kw_row_has(s, n, _nft_ct_kw_list(n));
}

# The table names `nft list table <family> <name>` reads as keywords of its
# list scope, as one row of n-byte words per width (0: none). `tables`,
# `rules`, `count`, ... are names everywhere else, so `table inet rules` is
# declared and applied, and then cannot be listed (probed, nft 1.1.7: 12,582
# candidates as real tables in a namespace; 1.9.1). 16 words. Only
# list_table_with_handles needs them.
fn _nft_list_kw_list(n: i64): cstring {
    if (n == 4) { return "maps sets"; }
    if (n == 5) { return "count hooks rules"; }
    if (n == 6) { return "chains counts limits meters quotas tables"; }
    if (n == 7) { return "tunnels"; }
    if (n == 8) { return "counters secmarks"; }
    if (n == 9) { return "synproxys"; }
    if (n == 10) { return "flowtables"; }
    return 0;
}

# 1 when s is a list-scope keyword (see _nft_list_kw_list).
fn _nft_list_keyword(s: cstring): i64 {
    var n = strlen(s);
    if (n < 2 || n > 11) { return 0; }
    return _kw_row_has(s, n, _nft_list_kw_list(n));
}

# 1 when nft reads `@s` as something other than a reference to the set or
# flowtable s: `@ll` and `@nh` are raw payload bases (`@nh,16,8`), and after
# `flow offload` `@last` is a keyword (probed, nft 1.1.7). s already passed
# validate_nft_name.
fn _nft_ref_reserved(s: cstring, flowtable: i64): i64 {
    if (streq(s, "ll") == 1 || streq(s, "nh") == 1) { return 1; }
    if (flowtable == 1 && streq(s, "last") == 1) { return 1; }
    return 0;
}

# Validate a name nein renders bare into nft text: a table, chain, set, map,
# flowtable, ct timeout or define name, or a jump / goto target. Everything
# validate_identifier checks, and nft's grammar for a name: it starts with a
# letter or '_', and is no nft keyword (see above).
fn validate_nft_name(s: cstring): i64 {
    var vt, vv = validate_identifier(s);
    if (is_err_result(vt) == 1) { return Err(vv); }
    var c = load8(s);
    if (c == 45 || (c >= 48 && c <= 57)) { return nein_err(NEIN_ERR_INVALID_RULE); }   # '-' or a digit
    if (_nft_keyword(s, strlen(s)) == 1) { return nein_err(NEIN_ERR_INVALID_RULE); }
    return nein_ok();
}

# --- Strict address parsing (1.8.2, audit I-9) ----------------------
# Through 1.8.1 validate_addr checked only the character set (hex digits,
# '.', ':', '/') and that a '.' or ':' appeared, so "dead1.cafe" — a hex-only
# DNS name — passed, and nft resolved it at apply time: whoever controls that
# zone chose the address. An address must now PARSE as IPv4 or IPv6, with an
# optional prefix length in range for its family.

# A decimal field of 1..maxdig digits with no leading zero, value <= max.
# Returns the index just past it, or -1.
fn _parse_dec(s: cstring, i: i64, end: i64, maxdig: i64, max: i64): i64 {
    var start = i;
    var val = 0;
    while (i < end) {
        var c = load8(s + i);
        if (c < 48 || c > 57) { break; }
        val = val * 10 + (c - 48);
        i = i + 1;
        if (i - start > maxdig) { return 0 - 1; }
    }
    if (i == start) { return 0 - 1; }
    if (i - start > 1 && load8(s + start) == 48) { return 0 - 1; }   # leading zero
    if (val > max) { return 0 - 1; }
    return i;
}

# s[a..b) is exactly a dotted-quad IPv4 address.
fn _is_ipv4_span(s: cstring, a: i64, b: i64): i64 {
    var i = a;
    var parts = 0;
    while (parts < 4) {
        i = _parse_dec(s, i, b, 3, 255);
        if (i < 0) { return 0; }
        parts = parts + 1;
        if (parts < 4) {
            if (i >= b || load8(s + i) != 46) { return 0; }   # '.'
            i = i + 1;
        }
    }
    if (i != b) { return 0; }
    return 1;
}

fn _is_hex_char(c: i64): i64 {
    if (c >= 48 && c <= 57) { return 1; }
    if (c >= 97 && c <= 102) { return 1; }
    if (c >= 65 && c <= 70) { return 1; }
    return 0;
}

# s[a..b) is exactly an IPv6 address: up to eight 1-4 digit hex groups, at
# most one "::", optionally ending in a dotted-quad (which counts as two
# groups, and needs the "::" — see the end). No zone index.
fn _is_ipv6_span(s: cstring, a: i64, b: i64): i64 {
    if (b - a < 2) { return 0; }
    var i = a;
    var groups = 0;
    var compressed = 0;
    var dotted = 0;
    if (load8(s + i) == 58) {                               # leading ':'
        if (load8(s + i + 1) != 58) { return 0; }           # only as "::"
        compressed = 1;
        i = i + 2;
        if (i == b) { return 1; }                           # "::"
    }
    var done = 0;
    while (done == 0) {
        var start = i;
        while (i < b && _is_hex_char(load8(s + i)) == 1) {
            i = i + 1;
            if (i - start > 4) { return 0; }
        }
        if (i == start) { return 0; }
        if (i < b && load8(s + i) == 46) {                  # dotted-quad tail
            if (_is_ipv4_span(s, start, b) == 0) { return 0; }
            dotted = 1;
            groups = groups + 2;
            i = b;
            done = 1;
        } else {
            groups = groups + 1;
            if (i == b) {
                done = 1;
            } else {
                if (load8(s + i) != 58) { return 0; }
                i = i + 1;
                if (i < b && load8(s + i) == 58) {
                    if (compressed == 1) { return 0; }      # a second "::"
                    compressed = 1;
                    i = i + 1;
                    if (i == b) { done = 1; }
                } elif (i == b) {
                    return 0;                               # trailing single ':'
                }
            }
        }
        if (groups > 8) { return 0; }
    }
    if (compressed == 1) {
        if (groups > 7) { return 0; }
        return 1;
    }
    if (groups != 8) { return 0; }
    # Six groups and a dotted quad with no "::" (`1:2:3:4:5:6:1.2.3.4`, RFC
    # 4291's x:x:x:x:x:x:d.d.d.d) is an address nft's scanner has no rule for:
    # `ip6 saddr` with it is a syntax error and the batch fails at apply. Every
    # compressed form with a dotted quad parses (1.9.1; a differential run of
    # 2,329 spellings against nft 1.1.7 disagreed on this form and no other).
    if (dotted == 1) { return 0; }
    return 1;
}

# 4 for an IPv4 address or CIDR, 6 for IPv6, 0 for anything else.
fn _addr_family(s: cstring): i64 {
    if (s == 0) { return 0; }
    var len = strlen(s);
    if (len == 0 || len > 49) { return 0; }                 # 45-byte IPv6 text + "/128"
    var slash = memchr(s, 47, len);
    var end = len;
    if (slash >= 0) { end = slash; }
    var fam = 0;
    if (_is_ipv4_span(s, 0, end) == 1) { fam = 4; }
    elif (_is_ipv6_span(s, 0, end) == 1) { fam = 6; }
    if (fam == 0) { return 0; }
    if (slash >= 0) {
        var maxp = 32;
        if (fam == 6) { maxp = 128; }
        if (_parse_dec(s, slash + 1, len, 3, maxp) != len) { return 0; }
    }
    return fam;
}

# The address part of `s` (any /prefix ignored) as 16 canonical bytes in
# `out` — IPv4 as ::ffff:a.b.c.d, the v4-mapped form — so two spellings of one
# address ("fd00::1", "fd00:0::1", "::ffff:10.0.0.1" and "10.0.0.1") compare
# equal byte for byte (1.8.2, used by the engine's duplicate-address check).
# Returns the family (4 or 6), or 0 if `s` is not an address.
fn _addr_bytes(s: cstring, out: i64): i64 {
    var fam = _addr_family(s);
    if (fam == 0) { return 0; }
    var len = strlen(s);
    var end = memchr(s, 47, len);
    if (end < 0) { end = len; }
    var k = 0;
    while (k < 16) { store8(out + k, 0); k = k + 1; }
    if (fam == 4) {
        store8(out + 10, 255);
        store8(out + 11, 255);
        var i = 0;
        var oct = 0;
        while (oct < 4) {
            var v = 0;
            while (i < end && load8(s + i) != 46) { v = v * 10 + (load8(s + i) - 48); i = i + 1; }
            store8(out + 12 + oct, v);
            i = i + 1;
            oct = oct + 1;
        }
        return 4;
    }
    # IPv6: collect the groups before and after "::" separately, then place
    # the tail at the end. A dotted-quad tail fills the last four bytes.
    var head[16];
    var tail[16];
    var nh = 0;
    var nt = 0;
    var after = 0;
    var j = 0;
    if (load8(s) == 58) { after = 1; j = 2; }
    while (j < end) {
        var start = j;
        var g = 0;
        var isv4 = 0;
        while (j < end && load8(s + j) != 58) {
            if (load8(s + j) == 46) { isv4 = 1; }
            j = j + 1;
        }
        if (isv4 == 1) {
            var four[16];
            var vb = alloc(j - start + 1);
            memcpy(vb, s + start, j - start);
            store8(vb + j - start, 0);
            _addr_bytes(vb, &four);
            var q = 0;
            while (q < 4) {
                if (after == 1) { store8(&tail + nt, load8(&four + 12 + q)); nt = nt + 1; }
                else { store8(&head + nh, load8(&four + 12 + q)); nh = nh + 1; }
                q = q + 1;
            }
        } else {
            var h = start;
            while (h < j) {
                var c = load8(s + h);
                var d = 0;
                if (c >= 48 && c <= 57) { d = c - 48; }
                elif (c >= 97 && c <= 102) { d = c - 87; }
                else { d = c - 55; }
                g = g * 16 + d;
                h = h + 1;
            }
            if (after == 1) {
                store8(&tail + nt, g >> 8); store8(&tail + nt + 1, g & 255); nt = nt + 2;
            } else {
                store8(&head + nh, g >> 8); store8(&head + nh + 1, g & 255); nh = nh + 2;
            }
        }
        if (j < end) {
            j = j + 1;
            if (j < end && load8(s + j) == 58) { after = 1; j = j + 1; }
        }
    }
    var m = 0;
    while (m < nh) { store8(out + m, load8(&head + m)); m = m + 1; }
    m = 0;
    while (m < nt) { store8(out + 16 - nt + m, load8(&tail + m)); m = m + 1; }
    return 6;
}

# 1 when `s` names a single host: no prefix, or /32 (IPv4) / /128 (IPv6).
fn _addr_is_host(s: cstring): i64 {
    var fam = _addr_family(s);
    if (fam == 0) { return 0; }
    var len = strlen(s);
    var slash = memchr(s, 47, len);
    if (slash < 0) { return 1; }
    var p = atoi(s + slash + 1);
    if (fam == 4 && p == 32) { return 1; }
    if (fam == 6 && p == 128) { return 1; }
    return 0;
}

# Validate an IP address or CIDR string: IPv4 dotted quad or IPv6, with an
# optional /prefix in range for the family. Host names are refused.
fn validate_addr(s: cstring): i64 {
    if (_addr_family(s) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    return nein_ok();
}

# A port number 0..65535, or a range "a-b" with a <= b (1.8.2).
fn _is_port_token(s: cstring): i64 {
    if (s == 0) { return 0; }
    var len = strlen(s);
    var dash = memchr(s, 45, len);
    if (dash < 0) {
        if (_parse_dec(s, 0, len, 5, 65535) != len) { return 0; }
        return 1;
    }
    if (_parse_dec(s, 0, dash, 5, 65535) != dash) { return 0; }
    if (_parse_dec(s, dash + 1, len, 5, 65535) != len) { return 0; }
    if (atoi(s) > atoi(s + dash + 1)) { return 0; }
    return 1;
}

# The selector of a set lookup (`<field> @set`), from a closed set (1.8.2,
# audit I-2). Through 1.8.1 it only had to pass validate_nft_element, so
# "ip saddr !=" rendered `ip saddr != @trusted accept` — an allowlist
# inverted into "everyone except the trusted".
fn _is_set_lookup_field(s: cstring): i64 {
    if (s == 0) { return 0; }
    if (streq(s, "ip saddr") == 1) { return 1; }
    if (streq(s, "ip daddr") == 1) { return 1; }
    if (streq(s, "ip6 saddr") == 1) { return 1; }
    if (streq(s, "ip6 daddr") == 1) { return 1; }
    if (streq(s, "tcp dport") == 1) { return 1; }
    if (streq(s, "tcp sport") == 1) { return 1; }
    if (streq(s, "udp dport") == 1) { return 1; }
    if (streq(s, "udp sport") == 1) { return 1; }
    if (streq(s, "th dport") == 1) { return 1; }
    if (streq(s, "th sport") == 1) { return 1; }
    if (streq(s, "meta l4proto") == 1) { return 1; }
    if (streq(s, "iifname") == 1) { return 1; }
    if (streq(s, "oifname") == 1) { return 1; }
    return 0;
}

# Validate an nftables address family.
# Must be one of: inet, ip, ip6, arp, bridge, netdev.
fn validate_family(s: cstring): i64 {
    if (s == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (streq(s, "inet") == 1) { return nein_ok(); }
    if (streq(s, "ip") == 1) { return nein_ok(); }
    if (streq(s, "ip6") == 1) { return nein_ok(); }
    if (streq(s, "arp") == 1) { return nein_ok(); }
    if (streq(s, "bridge") == 1) { return nein_ok(); }
    if (streq(s, "netdev") == 1) { return nein_ok(); }
    return nein_err(NEIN_ERR_INVALID_RULE);
}

# Validate a network interface name.
# Up to 15 chars, alphanumeric plus - _ .
fn validate_iface(s: cstring): i64 {
    if (s == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var len = strlen(s);
    if (len == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (len > 15) { return nein_err(NEIN_ERR_INVALID_RULE); }

    var i = 0;
    while (i < len) {
        if (_is_iface_char(load8(s + i)) == 0) {
            return nein_err(NEIN_ERR_INVALID_RULE);
        }
        i = i + 1;
    }
    return nein_ok();
}

# Validate a connection tracking state.
# Must be: new, established, related, invalid, untracked.
fn validate_ct_state(s: cstring): i64 {
    if (s == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (streq(s, "new") == 1) { return nein_ok(); }
    if (streq(s, "established") == 1) { return nein_ok(); }
    if (streq(s, "related") == 1) { return nein_ok(); }
    if (streq(s, "invalid") == 1) { return nein_ok(); }
    if (streq(s, "untracked") == 1) { return nein_ok(); }
    return nein_err(NEIN_ERR_INVALID_RULE);
}

# Validate a ct-state LIST, as carried by MATCH_CT_STATE and rendered into
# `ct state { ... }`.
#
# `validate_ct_state` above accepts exactly one bare state, but the Match
# variant carries a comma-separated list — `match_ct_state("established,
# related")` is the shape every in-tree caller uses. So a list-aware check is
# what the render path actually needs.
#
# Added at 1.6.9 to close a real hole: `rule_validate` had NO MATCH_CT_STATE
# branch at all, so the string was interpolated straight into nft grammar
# unchecked, while threat-model T-1 listed `validate_ct_state` as the
# mitigation covering this field. That validator had zero production callers —
# the documented control did not exist.
#
# Each token is trimmed of surrounding spaces and checked against the closed
# set. Anything else — including a `}` that would close the brace and start a
# new statement — is rejected.
fn validate_ct_state_list(s: cstring): i64 {
    if (s == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var len = strlen(s);
    if (len == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (len > 128) { return nein_err(NEIN_ERR_INVALID_RULE); }

    var buf = alloc(len + 1);
    var out = 0;
    var i = 0;

    while (i <= len) {
        var c = 0;
        if (i < len) { c = load8(s + i); }

        if (i == len || c == 44) {
            # End of a token (',' = 44, or end of string). Trim trailing
            # spaces, then check the token against the closed set.
            while (out > 0 && load8(buf + out - 1) == 32) { out = out - 1; }
            store8(buf + out, 0);
            if (out == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
            var vr1_t, vr1_v = validate_ct_state(buf);
            if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
            out = 0;
        } elif (c == 32 && out == 0) {
            # Leading space before a token — skip. An INTERNAL space is copied
            # through and will fail the closed-set check, which is intended.
        } else {
            store8(buf + out, c);
            out = out + 1;
        }
        i = i + 1;
    }

    return nein_ok();
}

# Validate a comment string.
# Rejects double quotes and dangerous chars. Max 128 chars.
fn validate_comment(s: cstring): i64 {
    if (s == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var len = strlen(s);
    if (len > 128) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (_has_quote(s) == 1) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (_has_dangerous_char(s) == 1) { return nein_err(NEIN_ERR_INVALID_RULE); }
    return nein_ok();
}

# Validate a log prefix string.
# Same constraints as comments but max 64 chars (nftables limit).
fn validate_log_prefix(s: cstring): i64 {
    if (s == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var len = strlen(s);
    if (len > 64) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (_has_quote(s) == 1) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (_has_dangerous_char(s) == 1) { return nein_err(NEIN_ERR_INVALID_RULE); }
    return nein_ok();
}

# Validate a set/map element string.
# Non-empty, no dangerous chars, no quotes.
# Reject '#' (0x23). nft treats it as a comment to end-of-line, so a value
# carrying one silently truncates whatever follows it in the rendered rule.
# Verified against nftables 1.1.6:
#     add rule inet filter input ip saddr 1.2.3.4 accept # drop
# applies as an ACCEPT — the intended `drop` verdict vanishes without error.
#
# Checked HERE rather than in the shared _is_dangerous_char set (1.6.10, audit
# MEDIUM), because the contexts differ: everything validate_nft_element guards
# is interpolated UNQUOTED into nft grammar — whole rule bodies via
# add_rule_live, set/map elements, define values, tcp-flag and set-lookup
# fields — so '#' is live there. Comments and log prefixes are rendered inside
# double quotes, where '#' is an ordinary character; rejecting it there would
# break the legitimate `comment "port 80 # web"` for no security gain.
fn _has_nft_comment_char(s: cstring): i64 {
    var i = 0;
    var len = strlen(s);
    while (i < len) {
        if (load8(s + i) == 35) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn validate_nft_element(s: cstring): i64 {
    if (s == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var len = strlen(s);
    if (len == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (_has_quote(s) == 1) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (_has_dangerous_char(s) == 1) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (_has_nft_comment_char(s) == 1) { return nein_err(NEIN_ERR_INVALID_RULE); }
    return nein_ok();
}
