# Integration: what nein validates in a table of each family, nft loads (1.9.3).
#
# firewall_validate checked every rule on its own, never against its table's
# family or the chain it sits under, so a rule nft refuses there — `reject with
# icmpx ...` in an ip table, `ip saddr` in an ip6 one, `dnat` under a filter
# chain — validated, and the batch failed at apply (found probing for audit
# P-8, 1.9.2). This test has the installed nft judge it, in five parts:
#   - each table object (sets, map, flowtable, ct timeout, define) alone in a
#     table of each family (inet, ip, ip6, arp, bridge, netdev);
#   - each base-chain header (type x hook) in each family;
#   - each rule shape nein renders, and each NAT form, alone in a regular
#     chain of each family;
#   - each shape that loads in a family, under each base-chain header that
#     family takes — batched, a refused batch bisected to the shape;
#   - jumps: rules reached through jump / goto, jump depth, jumps to base
#     chains.
# It FAILs when nein's validation takes what nft refuses, naming the case and
# nft's error, and NOTEs the reverse (nein refuses what this nft takes).
#
# Every load is a real one (`nft -f` in a throwaway namespace), not `nft -c`:
# check mode skips the kernel's hook validation, and takes `dnat` in a filter
# chain that a load refuses.
#
# Runs nft as root inside a throwaway user + network namespace
# (`unshare -rn`), as tests/integration/nft_load.tcyr does; reports SKIP and
# passes where that cannot run. Run it locally before a release.

include "src/lib/error.cyr"
include "src/lib/validate.cyr"
include "src/lib/rule.cyr"
include "src/lib/set.cyr"
include "src/lib/nat.cyr"
include "src/lib/chain.cyr"
include "src/lib/table.cyr"
include "src/lib/firewall.cyr"
include "src/lib/builder.cyr"
include "src/lib/policy.cyr"
include "src/lib/geoip.cyr"
include "src/lib/mesh.cyr"
include "src/lib/bridge.cyr"
include "src/lib/engine.cyr"
include "src/lib/config.cyr"
include "src/lib/netns.cyr"
include "src/lib/apply.cyr"
include "src/lib/inspect.cyr"
include "src/lib/diff.cyr"

var _nf_nft = "/usr/sbin/nft";
var _nf_unshare = "/usr/bin/unshare";
var _nf_dir = 0;
var _nf_path = 0;
var _nf_out = 0;
var _NF_OUT_MAX = 65536;
var _nf_agree = 0;
var _nf_fail = 0;
var _nf_note = 0;

fn _nf_cat(a: cstring, b: cstring, c: cstring): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    str_builder_add_cstr(sb, c);
    return str_cstr(str_builder_build(sb));
}

fn _nf_argv(): i64 {
    var args = vec_new();
    vec_push(args, "/bin/sh");
    vec_push(args, "-c");
    vec_push(args, "exec \"$0\" -rn \"$1\" -f \"$2\" 2>&1");
    vec_push(args, _nf_unshare);
    vec_push(args, _nf_nft);
    vec_push(args, _nf_path);
    return args;
}

fn _nf_write(text: i64, len: i64): i64 {
    var fd = sys_open(_nf_path, 577, 420);   # O_WRONLY|O_CREAT|O_TRUNC, 0644
    if (fd < 0) { return 0; }
    sys_write(fd, text, len);
    sys_close(fd);
    return 1;
}

# nft's verdict on `text`: 1 when a load of it succeeds. Its output, the error
# when it does not, is left in _nf_out.
fn _nf_nft_ok(text: i64, len: i64): i64 {
    _nf_write(text, len);
    var st[16];
    var n = exec_capture_status(_nf_argv(), _nf_out, _NF_OUT_MAX - 1, &st);
    if (n < 0) { n = 0; }
    store8(_nf_out + n, 0);
    if (load64(&st) == 0) { return 1; }
    return 0;
}

fn _nf_available(): i64 {
    if (sys_access(_nf_unshare, 1) != 0) { return 0; }
    if (sys_access(_nf_nft, 1) != 0) {
        _nf_nft = "/usr/bin/nft";
        if (sys_access(_nf_nft, 1) != 0) { return 0; }
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "/tmp/nein-nft-family-");
    str_builder_add_int(sb, sys_getpid());
    _nf_dir = str_cstr(str_builder_build(sb));
    if (sys_mkdir(_nf_dir, 448) != 0) { return 0; }   # 0700
    _nf_path = _nf_cat(_nf_dir, "/t.nft", "");
    _nf_out = alloc(_NF_OUT_MAX);
    var probe = "table inet nein_family {\n}\n";
    if (_nf_nft_ok(probe, strlen(probe)) == 0) { return 0; }
    return 1;
}

fn _nf_family_name(f: i64): cstring { return _family_to_cstr(f); }

# The first line of nft's error that says what is wrong.
fn _nf_first_error(): cstring {
    var p = _nf_out;
    var len = strlen(p);
    var i = 0;
    while (i < len) {
        var start = i;
        while (i < len && load8(p + i) != 10) { i = i + 1; }
        var line = p + start;
        var e = memchr(line, 69, i - start);   # 'E' of "Error:"
        if (e >= 0 && _cstr_starts_with(line + e, "Error:") == 1) {
            store8(p + i, 0);
            return line + e;
        }
        i = i + 1;
    }
    return "(no error line)";
}

fn _nf_text(fw: i64): i64 {
    var sb = str_builder_new();
    var tables = firewall_tables(fw);
    var i = 0;
    while (i < vec_len(tables)) {
        str_builder_add(sb, table_render(vec_get(tables, i)));
        i = i + 1;
    }
    return str_builder_build(sb);
}

fn _nf_nein_ok(fw: i64): i64 {
    var vt, vv = firewall_validate(fw);
    if (is_err_result(vt) == 1) { return 0; }
    return 1;
}

fn _nf_fw_ok(fw: i64): i64 {
    var text = _nf_text(fw);
    return _nf_nft_ok(str_data(text), str_len(text));
}

# Judge one firewall: nein's verdict (firewall_validate) against nft's.
fn _nf_judge(what: cstring, fam: i64, fw: i64): i64 {
    return _nf_report(what, fam, _nf_nein_ok(fw), _nf_fw_ok(fw));
}

fn _nf_report(what: cstring, fam: i64, nein_ok: i64, nft_ok: i64): i64 {
    if (nein_ok == nft_ok) {
        _nf_agree = _nf_agree + 1;
        return 1;
    }
    if (nein_ok == 1) {
        print("  FAIL: ", 8);
        _nf_fail = _nf_fail + 1;
    } else {
        print("  NOTE: ", 8);
        _nf_note = _nf_note + 1;
    }
    var fname = _nf_family_name(fam);
    print(fname, strlen(fname));
    print(" | ", 3);
    print(what, strlen(what));
    if (nein_ok == 1) {
        print(" | ", 3);
        println(_nf_first_error());
    } else {
        println(" | nein refuses, nft takes it");
    }
    return 0;
}

# ---- rule shapes ----

var _nf_name = 0;

fn _r1(m: i64, v: i64): i64 { return rule_add_match(rule_new(v), m); }
fn _r2(m1: i64, m2: i64, v: i64): i64 { return rule_add_match(rule_add_match(rule_new(v), m1), m2); }

# Shape i as a chain rule (CR_RULE / CR_NAT), its name in _nf_name; 0 past
# the last.
fn _nf_shape(i: i64): i64 {
    var r = 0;
    var n = 0;
    if (i == 0) { _nf_name = "ip saddr"; r = _r1(match_source_addr("10.0.0.5"), verdict_accept()); }
    elif (i == 1) { _nf_name = "ip daddr cidr"; r = _r1(match_dest_addr("10.0.0.0/8"), verdict_drop()); }
    elif (i == 2) { _nf_name = "ip6 saddr"; r = _r1(match_source_addr6("2001:db8::1"), verdict_accept()); }
    elif (i == 3) { _nf_name = "ip6 daddr cidr"; r = _r1(match_dest_addr6("fd00::/8"), verdict_drop()); }
    elif (i == 4) { _nf_name = "meta l4proto tcp"; r = _r1(match_protocol(PROTO_TCP), verdict_accept()); }
    elif (i == 5) { _nf_name = "meta l4proto udp"; r = _r1(match_protocol(PROTO_UDP), verdict_accept()); }
    elif (i == 6) { _nf_name = "meta l4proto icmp"; r = _r1(match_protocol(PROTO_ICMP), verdict_accept()); }
    elif (i == 7) { _nf_name = "meta l4proto icmpv6"; r = _r1(match_protocol(PROTO_ICMPV6), verdict_accept()); }
    elif (i == 8) { _nf_name = "tcp dport"; r = allow_tcp(22); }
    elif (i == 9) { _nf_name = "udp dport"; r = allow_udp(53); }
    elif (i == 10) { _nf_name = "tcp sport"; r = _r2(match_protocol(PROTO_TCP), match_sport(1024), verdict_accept()); }
    elif (i == 11) { _nf_name = "tcp dport range"; r = _r2(match_protocol(PROTO_TCP), match_dport_range(8000, 8080), verdict_accept()); }
    elif (i == 12) { _nf_name = "th dport"; r = _r1(match_dport(53), verdict_accept()); }
    elif (i == 13) { _nf_name = "iifname"; r = _r1(match_iif("lo"), verdict_accept()); }
    elif (i == 14) { _nf_name = "oifname"; r = _r1(match_oif("eth0"), verdict_drop()); }
    elif (i == 15) { _nf_name = "ct state"; r = allow_established(); }
    elif (i == 16) { _nf_name = "limit"; r = _r1(match_limit(10, RATE_SECOND, 5), verdict_accept()); }
    elif (i == 17) { _nf_name = "ip saddr @set"; r = _r1(match_set_lookup("ip saddr", "s4"), verdict_accept()); }
    elif (i == 18) { _nf_name = "ip daddr @set"; r = _r1(match_set_lookup("ip daddr", "s4"), verdict_accept()); }
    elif (i == 19) { _nf_name = "ip6 saddr @set"; r = _r1(match_set_lookup("ip6 saddr", "s6"), verdict_accept()); }
    elif (i == 20) { _nf_name = "ip6 daddr @set"; r = _r1(match_set_lookup("ip6 daddr", "s6"), verdict_accept()); }
    elif (i == 21) { _nf_name = "tcp dport @set"; r = _r1(match_set_lookup("tcp dport", "svc"), verdict_accept()); }
    elif (i == 22) { _nf_name = "tcp sport @set"; r = _r1(match_set_lookup("tcp sport", "svc"), verdict_accept()); }
    elif (i == 23) { _nf_name = "udp dport @set"; r = _r1(match_set_lookup("udp dport", "svc"), verdict_accept()); }
    elif (i == 24) { _nf_name = "udp sport @set"; r = _r1(match_set_lookup("udp sport", "svc"), verdict_accept()); }
    elif (i == 25) { _nf_name = "th dport @set"; r = _r1(match_set_lookup("th dport", "svc"), verdict_accept()); }
    elif (i == 26) { _nf_name = "th sport @set"; r = _r1(match_set_lookup("th sport", "svc"), verdict_accept()); }
    elif (i == 27) { _nf_name = "meta l4proto @set"; r = _r1(match_set_lookup("meta l4proto", "pr"), verdict_accept()); }
    elif (i == 28) { _nf_name = "iifname @set"; r = _r1(match_set_lookup("iifname", "ifs"), verdict_accept()); }
    elif (i == 29) { _nf_name = "oifname @set"; r = _r1(match_set_lookup("oifname", "ifs"), verdict_accept()); }
    elif (i == 30) { _nf_name = "ct helper"; r = _r1(match_ct_helper("ftp"), verdict_accept()); }
    elif (i == 31) { _nf_name = "tcp flags"; r = _r1(match_tcp_flags("syn"), verdict_accept()); }
    elif (i == 32) { _nf_name = "icmp type"; r = _r1(match_icmp_type("echo-request"), verdict_accept()); }
    elif (i == 33) { _nf_name = "icmpv6 type"; r = _r1(match_icmpv6_type("echo-request"), verdict_accept()); }
    elif (i == 34) { _nf_name = "icmp type code"; r = _r1(match_icmp_type_code("destination-unreachable", 3), verdict_accept()); }
    elif (i == 35) { _nf_name = "icmpv6 type code"; r = _r1(match_icmpv6_type_code("destination-unreachable", 4), verdict_accept()); }
    elif (i == 36) { _nf_name = "meta mark"; r = _r1(match_meta_mark(5), verdict_accept()); }
    elif (i == 37) { _nf_name = "quota"; r = _r1(match_quota(QUOTA_OVER, 100, QUNIT_MBYTES), verdict_drop()); }
    elif (i == 38) { _nf_name = "flow offload"; r = _r1(match_flow_offload("ft"), verdict_accept()); }
    elif (i == 39) { _nf_name = "ct timeout set"; r = _r1(match_ct_timeout_set("cto"), verdict_none()); }
    elif (i == 40) { _nf_name = "vlan id"; r = _r1(match_vlan_id(10), verdict_accept()); }
    elif (i == 41) { _nf_name = "ip dscp"; r = _r1(match_dscp(46), verdict_accept()); }
    elif (i == 42) { _nf_name = "exthdr hbh"; r = _r1(match_ipv6_ext_hdr(EXT_HOP_BY_HOP), verdict_drop()); }
    elif (i == 43) { _nf_name = "exthdr rt"; r = _r1(match_ipv6_ext_hdr(EXT_ROUTING), verdict_drop()); }
    elif (i == 44) { _nf_name = "exthdr frag"; r = _r1(match_ipv6_ext_hdr(EXT_FRAGMENT), verdict_drop()); }
    elif (i == 45) { _nf_name = "exthdr dst"; r = _r1(match_ipv6_ext_hdr(EXT_DESTINATION), verdict_drop()); }
    elif (i == 46) { _nf_name = "exthdr mh"; r = _r1(match_ipv6_ext_hdr(EXT_MOBILITY), verdict_drop()); }
    elif (i == 47) { _nf_name = "ip frag-off"; r = _r1(match_frag_off(8191, NFT_CMP_NE, 0), verdict_drop()); }
    elif (i == 48) { _nf_name = "meta pkttype"; r = _r1(match_pkt_type(PKT_BROADCAST), verdict_drop()); }
    elif (i == 49) { _nf_name = "ct count"; r = _r1(match_conn_limit(10), verdict_drop()); }
    elif (i == 50) { _nf_name = "accept"; r = rule_new(verdict_accept()); }
    elif (i == 51) { _nf_name = "drop"; r = rule_new(verdict_drop()); }
    elif (i == 52) { _nf_name = "reject"; r = rule_new(verdict_reject()); }
    elif (i == 53) { _nf_name = "reject icmp host-unreachable"; r = rule_new(verdict_reject_with(REJECT_ICMP_HOST_UNREACH)); }
    elif (i == 54) { _nf_name = "reject icmp port-unreachable"; r = rule_new(verdict_reject_with(REJECT_ICMP_PORT_UNREACH)); }
    elif (i == 55) { _nf_name = "reject icmp net-unreachable"; r = rule_new(verdict_reject_with(REJECT_ICMP_NET_UNREACH)); }
    elif (i == 56) { _nf_name = "reject icmp admin-prohibited"; r = rule_new(verdict_reject_with(REJECT_ICMP_ADMIN_PROHIB)); }
    elif (i == 57) { _nf_name = "reject icmpx admin-prohibited"; r = rule_new(verdict_reject_with(REJECT_ICMPX_ADMIN_PROHIB)); }
    elif (i == 58) { _nf_name = "reject tcp reset"; r = _r2(match_protocol(PROTO_TCP), match_dport(23), verdict_reject_with(REJECT_TCP_RESET)); }
    elif (i == 59) { _nf_name = "reject tcp reset, no tcp match"; r = rule_new(verdict_reject_with(REJECT_TCP_RESET)); }
    elif (i == 60) { _nf_name = "jump"; r = rule_new(verdict_jump("tgt")); }
    elif (i == 61) { _nf_name = "goto"; r = rule_new(verdict_goto("tgt")); }
    elif (i == 62) { _nf_name = "return"; r = rule_new(verdict_return()); }
    elif (i == 63) { _nf_name = "log prefix"; r = rule_new(verdict_log("NEIN: ")); }
    elif (i == 64) { _nf_name = "log level"; r = rule_new(verdict_log_advanced("A: ", NFT_LOG_INFO, 0, 0)); }
    elif (i == 65) { _nf_name = "log group snaplen"; r = rule_new(verdict_log_advanced(0, 0, 2, 128)); }
    elif (i == 66) { _nf_name = "counter"; r = rule_new(verdict_counter()); }
    elif (i == 67) { _nf_name = "meta mark set"; r = rule_new(verdict_set_mark(5)); }
    elif (i == 68) { _nf_name = "ct mark set"; r = rule_new(verdict_set_ct_mark(5)); }
    elif (i == 69) { _nf_name = "allow_service v4"; r = allow_service("10.0.0.0/8", PROTO_TCP, 443); }
    elif (i == 70) { _nf_name = "allow_service v6"; r = allow_service("fd00::/8", PROTO_UDP, 443); }
    elif (i == 71) { _nf_name = "deny_source v4"; r = deny_source("192.0.2.66"); }
    elif (i == 72) { _nf_name = "deny_source v6"; r = deny_source6("2001:db8::bad"); }
    elif (i == 73) { _nf_name = "rate_limit_tcp"; r = rate_limit_tcp(22, 3, RATE_MINUTE); }
    elif (i == 74) { _nf_name = "rate_limit_quic"; r = rate_limit_quic(443, 100, RATE_SECOND); }
    elif (i == 75) { _nf_name = "comment"; r = allow_tcp(80); rule_set_comment(r, "web"); }
    elif (i == 76) { _nf_name = "nat dnat v4"; n = port_forward(8080, "172.17.0.2", 80); }
    elif (i == 77) { _nf_name = "nat dnat v6"; n = nat_dnat(PROTO_TCP, 8443, "fd00::2", 443, 0); }
    elif (i == 78) { _nf_name = "nat dnat range map v4"; n = port_range_forward(9000, 9010, "172.17.0.3", 10000); }
    elif (i == 79) { _nf_name = "nat dnat range v4"; n = port_range_forward(9000, 9010, "172.17.0.3", 9000); }
    elif (i == 80) { _nf_name = "nat dnat range map v6"; n = port_range_forward(9000, 9010, "fd00::3", 10000); }
    elif (i == 81) { _nf_name = "nat snat v4"; n = nat_snat("10.0.0.0/8", "192.0.2.1", 0); }
    elif (i == 82) { _nf_name = "nat snat v6"; n = nat_snat("fd00::/8", "fd00::1", 0); }
    elif (i == 83) { _nf_name = "nat masquerade v4"; n = container_masquerade("172.17.0.0/16", "eth0"); }
    elif (i == 84) { _nf_name = "nat masquerade v6"; n = nat_masquerade("fd00::/8", 0, 0); }
    elif (i == 85) { _nf_name = "nat redirect"; n = nat_redirect(PROTO_TCP, 80, 3128, 0); }
    elif (i == 86) { _nf_name = "nat redirect udp"; n = nat_redirect(PROTO_UDP, 53, 5353, 0); }
    else { return 0; }
    if (n != 0) { return chain_rule_new(CR_NAT, n); }
    return chain_rule_new(CR_RULE, r);
}

# The objects a shape refers to: sets s4 / s6 / svc / pr / ifs, flowtable ft,
# ct timeout cto, chain tgt. Each is probed on its own too (_nf_objects), so a
# family that refuses the object shows up there, not only as its shape.
fn _nf_context(t: i64, i: i64): i64 {
    if (i == 17 || i == 18) { table_add_set(t, nft_set_new("s4", SET_IPV4_ADDR)); }
    if (i == 19 || i == 20) { table_add_set(t, nft_set_new("s6", SET_IPV6_ADDR)); }
    if (i >= 21 && i <= 26) { table_add_set(t, nft_set_new("svc", SET_INET_SERVICE)); }
    if (i == 27) { table_add_set(t, nft_set_new("pr", SET_INET_PROTO)); }
    if (i == 28 || i == 29) { table_add_set(t, nft_set_new("ifs", SET_IFNAME)); }
    if (i == 38) {
        var devs = vec_new();
        vec_push(devs, "lo");
        table_add_flowtable(t, flowtable_new("ft", 0, devs));
    }
    if (i == 39) { table_add_ct_timeout(t, ct_timeout_new("cto", PROTO_TCP)); }
    if (i == 60 || i == 61) { table_add_chain(t, chain_regular("tgt")); }
    return 0;
}

# _nf_loads[fam * 128 + shape]: 1 when the shape loads in a regular chain of
# that family — the shapes the base-chain part tries under each header.
var _nf_loads = 0;
var _nf_headers = 0;   # [fam * 32 + ct * 8 + hook]: 1 when the header loads

fn _nf_shapes(): i64 {
    var fam = FAMILY_INET;
    while (fam <= FAMILY_NETDEV) {
        var i = 0;
        var cr = _nf_shape(i);
        while (cr != 0) {
            var fw = firewall_new();
            var t = table_new("nf", fam);
            _nf_context(t, i);
            var c = chain_regular("c");
            vec_push(chain_rules(c), cr);
            table_add_chain(t, c);
            firewall_add_table(fw, t);
            var nft_ok = _nf_fw_ok(fw);
            store8(_nf_loads + fam * 128 + i, nft_ok);
            _nf_report(_nf_name, fam, _nf_nein_ok(fw), nft_ok);
            i = i + 1;
            cr = _nf_shape(i);
        }
        fam = fam + 1;
    }
    return 0;
}

# ---- table objects ----

fn _nf_objects(): i64 {
    var fam = FAMILY_INET;
    while (fam <= FAMILY_NETDEV) {
        var k = 0;
        while (k < 9) {
            var fw = firewall_new();
            var t = table_new("nf", fam);
            var what = 0;
            if (k <= 4) {
                var st = k + 1;   # SET_IPV4_ADDR .. SET_IFNAME
                table_add_set(t, nft_set_new("s", st));
                what = _nf_cat("set ", _set_type_str(st), "");
            } elif (k == 5) {
                table_add_map(t, nft_map_new("m", SET_INET_SERVICE));
                what = "verdict map";
            } elif (k == 6) {
                var devs = vec_new();
                vec_push(devs, "lo");
                table_add_flowtable(t, flowtable_new("ft", 0, devs));
                what = "flowtable";
            } elif (k == 7) {
                table_add_ct_timeout(t, ct_timeout_new("cto", PROTO_TCP));
                what = "ct timeout";
            } else {
                table_add_define(t, define_new("lan", "10.0.0.0/8"));
                what = "define";
            }
            firewall_add_table(fw, t);
            _nf_judge(what, fam, fw);
            k = k + 1;
        }
        fam = fam + 1;
    }
    return 0;
}

# ---- base-chain headers ----

fn _nf_chains(): i64 {
    var fam = FAMILY_INET;
    while (fam <= FAMILY_NETDEV) {
        var ct = CHAIN_FILTER;
        while (ct <= CHAIN_ROUTE) {
            var h = HOOK_PREROUTING;
            while (h <= HOOK_INGRESS) {
                var fw = firewall_new();
                var t = table_new("nf", fam);
                table_add_chain(t, chain_base("c", ct, h, 0, POLICY_ACCEPT));
                firewall_add_table(fw, t);
                var hok = _nf_fw_ok(fw);
                store8(_nf_headers + fam * 32 + ct * 8 + h, hok);
                _nf_report(_nf_cat("type ", _chain_type_str(ct), _nf_cat(" hook ", _hook_str(h), "")), fam,
                  _nf_nein_ok(fw), hok);
                h = h + 1;
            }
            ct = ct + 1;
        }
        fam = fam + 1;
    }
    return 0;
}

# ---- shapes under base chains ----
#
# A table of family `fam` holding, for each shape in `idx[lo..hi)`, a base
# chain c<i> of the given header with that shape alone in it, and every
# object any shape refers to (each valid in the families whose shapes reach
# here).
fn _nf_base_fw(fam: i64, ct: i64, h: i64, idx: i64, lo: i64, hi: i64): i64 {
    var fw = firewall_new();
    var t = table_new("nf", fam);
    var used = alloc(128);
    var k = lo;
    while (k < hi) {
        var i = vec_get(idx, k);
        if (load8(used + i) == 0) {
            # one of each object: shapes 17/18, 19/20, 21-26, 28/29, 60/61 share
            if ((i == 18 && load8(used + 17) != 0) || (i == 20 && load8(used + 19) != 0)
              || (i >= 22 && i <= 26 && _nf_any(used, 21, i) == 1) || (i == 29 && load8(used + 28) != 0)
              || (i == 61 && load8(used + 60) != 0)) {
                store8(used + i, 1);
            } else {
                _nf_context(t, i);
                store8(used + i, 1);
            }
        }
        var c = chain_base(_nf_cat("c", "", _nf_itoa(i)), ct, h, 0, POLICY_ACCEPT);
        vec_push(chain_rules(c), _nf_shape(i));
        table_add_chain(t, c);
        k = k + 1;
    }
    firewall_add_table(fw, t);
    return fw;
}

fn _nf_any(used: i64, lo: i64, hi: i64): i64 {
    var i = lo;
    while (i < hi) {
        if (load8(used + i) != 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn _nf_itoa(n: i64): cstring {
    var sb = str_builder_new();
    str_builder_add_int(sb, n);
    return str_cstr(str_builder_build(sb));
}

# The shapes in idx[lo..hi) nein takes under this header all load, or bisect
# to the ones that do not and report each.
fn _nf_bisect(fam: i64, ct: i64, h: i64, idx: i64, lo: i64, hi: i64, hdr: cstring): i64 {
    if (lo >= hi) { return 0; }
    if (_nf_fw_ok(_nf_base_fw(fam, ct, h, idx, lo, hi)) == 1) {
        _nf_agree = _nf_agree + (hi - lo);
        return 0;
    }
    if (hi - lo == 1) {
        _nf_shape(vec_get(idx, lo));
        _nf_report(_nf_cat(hdr, " | ", _nf_name), fam, 1, 0);
        return 0;
    }
    var mid = lo + (hi - lo) / 2;
    _nf_bisect(fam, ct, h, idx, lo, mid, hdr);
    _nf_bisect(fam, ct, h, idx, mid, hi, hdr);
    return 0;
}

fn _nf_bases(): i64 {
    var fam = FAMILY_INET;
    while (fam <= FAMILY_NETDEV) {
        var ct = CHAIN_FILTER;
        while (ct <= CHAIN_ROUTE) {
            var h = HOOK_PREROUTING;
            while (h <= HOOK_INGRESS) {
                if (load8(_nf_headers + fam * 32 + ct * 8 + h) == 1) {
                    var hdr = _nf_cat(_chain_type_str(ct), " ", _hook_str(h));
                    var takes = vec_new();
                    var i = 0;
                    while (_nf_shape(i) != 0) {
                        if (load8(_nf_loads + fam * 128 + i) == 1) {
                            var one = vec_new();
                            vec_push(one, i);
                            var nfw = _nf_base_fw(fam, ct, h, one, 0, 1);
                            if (_nf_nein_ok(nfw) == 1) {
                                vec_push(takes, i);
                            } else {
                                # nein refuses: nft must refuse it too, alone.
                                _nf_shape(i);
                                _nf_report(_nf_cat(hdr, " | ", _nf_name), fam, 0, _nf_fw_ok(nfw));
                            }
                        }
                        i = i + 1;
                    }
                    _nf_bisect(fam, ct, h, takes, 0, vec_len(takes), hdr);
                }
                h = h + 1;
            }
            ct = ct + 1;
        }
        fam = fam + 1;
    }
    return 0;
}

# ---- jumps ----

fn _nf_chain(name: cstring, cr: i64): i64 {
    var c = chain_regular(name);
    if (cr != 0) { vec_push(chain_rules(c), cr); }
    return c;
}

fn _nf_jump(target: cstring): i64 { return chain_rule_new(CR_RULE, rule_new(verdict_jump(target))); }
fn _nf_goto(target: cstring): i64 { return chain_rule_new(CR_RULE, rule_new(verdict_goto(target))); }
fn _nf_dnat(): i64 { return chain_rule_new(CR_NAT, port_forward(8080, "172.17.0.2", 80)); }
fn _nf_masq(): i64 { return chain_rule_new(CR_NAT, container_masquerade("172.17.0.0/16", "eth0")); }
fn _nf_reject(): i64 { return chain_rule_new(CR_RULE, rule_new(verdict_reject())); }

fn _nf_base(name: cstring, ct: i64, h: i64, cr: i64): i64 {
    var c = chain_base(name, ct, h, 0, POLICY_ACCEPT);
    if (cr != 0) { vec_push(chain_rules(c), cr); }
    return c;
}

fn _nf_fw_of(chains: i64): i64 {
    var fw = firewall_new();
    var t = table_new("nf", FAMILY_IP);
    var i = 0;
    while (i < vec_len(chains)) { table_add_chain(t, vec_get(chains, i)); i = i + 1; }
    firewall_add_table(fw, t);
    return fw;
}

# Chains c1..c<n>, each jumping to the next, the last accepting, below base
# chain `b`: n jumps in all.
fn _nf_depth(n: i64): i64 {
    var cs = vec_new();
    vec_push(cs, _nf_base("b", CHAIN_FILTER, HOOK_INPUT, _nf_jump("c1")));
    var k = 1;
    while (k < n) {
        vec_push(cs, _nf_chain(_nf_cat("c", "", _nf_itoa(k)), _nf_jump(_nf_cat("c", "", _nf_itoa(k + 1)))));
        k = k + 1;
    }
    vec_push(cs, _nf_chain(_nf_cat("c", "", _nf_itoa(n)), chain_rule_new(CR_RULE, rule_new(verdict_accept()))));
    return _nf_fw_of(cs);
}

fn _nf_jumps(): i64 {
    var a = vec_new();
    vec_push(a, _nf_base("i", CHAIN_FILTER, HOOK_INPUT, _nf_jump("x")));
    vec_push(a, _nf_chain("x", _nf_dnat()));
    _nf_judge("dnat jumped to from filter input", FAMILY_IP, _nf_fw_of(a));
    var b = vec_new();
    vec_push(b, _nf_base("i", CHAIN_FILTER, HOOK_INPUT, _nf_goto("x")));
    vec_push(b, _nf_chain("x", _nf_dnat()));
    _nf_judge("dnat gone to from filter input", FAMILY_IP, _nf_fw_of(b));
    var c = vec_new();
    vec_push(c, _nf_base("p", CHAIN_NAT, HOOK_PREROUTING, _nf_jump("x")));
    vec_push(c, _nf_chain("x", _nf_jump("y")));
    vec_push(c, _nf_chain("y", _nf_dnat()));
    _nf_judge("dnat two jumps below nat prerouting", FAMILY_IP, _nf_fw_of(c));
    var d = vec_new();
    vec_push(d, _nf_base("p", CHAIN_NAT, HOOK_PREROUTING, _nf_jump("x")));
    vec_push(d, _nf_base("i", CHAIN_FILTER, HOOK_INPUT, _nf_jump("x")));
    vec_push(d, _nf_chain("x", _nf_dnat()));
    _nf_judge("dnat reached from nat prerouting and filter input", FAMILY_IP, _nf_fw_of(d));
    var e = vec_new();
    vec_push(e, _nf_base("i", CHAIN_FILTER, HOOK_INPUT, 0));
    vec_push(e, _nf_chain("x", _nf_dnat()));
    _nf_judge("dnat in a chain no base chain reaches", FAMILY_IP, _nf_fw_of(e));
    var f = vec_new();
    vec_push(f, _nf_base("o", CHAIN_NAT, HOOK_POSTROUTING, _nf_jump("x")));
    vec_push(f, _nf_chain("x", _nf_masq()));
    _nf_judge("masquerade jumped to from nat postrouting", FAMILY_IP, _nf_fw_of(f));
    var g = vec_new();
    vec_push(g, _nf_base("o", CHAIN_FILTER, HOOK_POSTROUTING, _nf_jump("x")));
    vec_push(g, _nf_chain("x", _nf_reject()));
    _nf_judge("reject jumped to from filter postrouting", FAMILY_IP, _nf_fw_of(g));
    var h = vec_new();
    vec_push(h, _nf_base("i", CHAIN_FILTER, HOOK_INPUT, _nf_jump("x")));
    vec_push(h, _nf_chain("x", _nf_jump("y")));
    vec_push(h, _nf_chain("y", _nf_jump("x")));
    _nf_judge("a cycle below a base chain", FAMILY_IP, _nf_fw_of(h));
    var u = vec_new();
    vec_push(u, _nf_chain("x", _nf_jump("y")));
    vec_push(u, _nf_chain("y", _nf_jump("x")));
    _nf_judge("a cycle no base chain reaches", FAMILY_IP, _nf_fw_of(u));
    var sj = vec_new();
    vec_push(sj, _nf_chain("x", _nf_jump("x")));
    _nf_judge("an unreached chain jumping to itself", FAMILY_IP, _nf_fw_of(sj));
    var bb = vec_new();
    vec_push(bb, _nf_base("i", CHAIN_FILTER, HOOK_INPUT, _nf_jump("o")));
    vec_push(bb, _nf_base("o", CHAIN_FILTER, HOOK_OUTPUT, 0));
    _nf_judge("a jump to a base chain", FAMILY_IP, _nf_fw_of(bb));
    var rb = vec_new();
    vec_push(rb, _nf_chain("x", _nf_goto("o")));
    vec_push(rb, _nf_base("o", CHAIN_FILTER, HOOK_OUTPUT, 0));
    _nf_judge("an unreached chain going to a base chain", FAMILY_IP, _nf_fw_of(rb));
    _nf_judge("15 jumps below a base chain", FAMILY_IP, _nf_depth(15));
    _nf_judge("16 jumps below a base chain", FAMILY_IP, _nf_depth(16));
    # A diamond 12 deep, so a walk that does not remember chains takes 2^12
    # paths; and the deep side of an uneven split decides.
    var dm = vec_new();
    vec_push(dm, _nf_base("i", CHAIN_FILTER, HOOK_INPUT, _nf_jump("d0")));
    var k = 0;
    while (k < 12) {
        var dc = _nf_chain(_nf_cat("d", "", _nf_itoa(k)), _nf_jump(_nf_cat("d", "", _nf_itoa(k + 1))));
        vec_push(chain_rules(dc), _nf_jump(_nf_cat("e", "", _nf_itoa(k + 1))));
        vec_push(dm, dc);
        vec_push(dm, _nf_chain(_nf_cat("e", "", _nf_itoa(k + 1)), _nf_jump(_nf_cat("d", "", _nf_itoa(k + 1)))));
        k = k + 1;
    }
    vec_push(dm, _nf_chain("d12", chain_rule_new(CR_RULE, rule_new(verdict_accept()))));
    _nf_judge("a diamond 12 levels, up to 24 jumps deep", FAMILY_IP, _nf_fw_of(dm));
    # x reached 1 jump down first, then 15 down through c1..c14: its own jump
    # is the 16th on the deep path.
    var dp = vec_new();
    var head = _nf_base("b", CHAIN_FILTER, HOOK_INPUT, _nf_jump("x"));
    vec_push(chain_rules(head), _nf_jump("c1"));
    vec_push(dp, head);
    var q = 1;
    while (q < 14) {
        vec_push(dp, _nf_chain(_nf_cat("c", "", _nf_itoa(q)), _nf_jump(_nf_cat("c", "", _nf_itoa(q + 1)))));
        q = q + 1;
    }
    vec_push(dp, _nf_chain("c14", _nf_jump("x")));
    vec_push(dp, _nf_chain("x", _nf_jump("y")));
    vec_push(dp, _nf_chain("y", chain_rule_new(CR_RULE, rule_new(verdict_accept()))));
    _nf_judge("a chain reached shallow first, then 16 jumps deep", FAMILY_IP, _nf_fw_of(dp));
    # The same with the shallow path one jump shorter overall: 15, loads.
    var dq = vec_new();
    var head2 = _nf_base("b", CHAIN_FILTER, HOOK_INPUT, _nf_jump("x"));
    vec_push(chain_rules(head2), _nf_jump("c1"));
    vec_push(dq, head2);
    q = 1;
    while (q < 13) {
        vec_push(dq, _nf_chain(_nf_cat("c", "", _nf_itoa(q)), _nf_jump(_nf_cat("c", "", _nf_itoa(q + 1)))));
        q = q + 1;
    }
    vec_push(dq, _nf_chain("c13", _nf_jump("x")));
    vec_push(dq, _nf_chain("x", _nf_jump("y")));
    vec_push(dq, _nf_chain("y", chain_rule_new(CR_RULE, rule_new(verdict_accept()))));
    _nf_judge("a chain reached shallow first, then 15 jumps deep", FAMILY_IP, _nf_fw_of(dq));
    return 0;
}

fn main() {
    alloc_init();
    _nf_loads = alloc(8 * 128);
    _nf_headers = alloc(8 * 32);
    if (_nf_available() == 0) {
        println("integration nft_family: SKIP — nft or unprivileged user namespaces unavailable here");
        return 0;
    }
    _nf_objects();
    _nf_chains();
    _nf_shapes();
    _nf_bases();
    _nf_jumps();
    sys_unlink(_nf_path);
    sys_rmdir(_nf_dir);
    print("integration nft_family: ", 24);
    fmt_int(_nf_agree);
    print(" agree, ", 8);
    fmt_int(_nf_fail);
    print(" failed, ", 9);
    fmt_int(_nf_note);
    println(" notes");
    if (_nf_fail != 0) { return 1; }
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
