# nein.cyr -- bundled distribution
# Version: 1.9.3
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib

# Requires (compile-verified; the leaves of dist/nein.deps):
include "lib/syscalls.cyr"

# --- error.cyr ---

# nein error types
#
# NeinError as integer enum constants.
# Uses stdlib tagged Result: Ok(value) / Err(code) from tagged.cyr.

enum NeinError {
    # ⭐ 1.7.0 — the first four carry the `NEIN_ERR_` prefix too. They were
    # bare (`ERR_NFT_FAILED` …) from 1.0 and were the only members cyrlint's
    # `lint_error_enum_namespace` rule still flagged: a bare `ERR_*` is
    # reserved for the sakshi base logger, and the flat enum-const namespace
    # lets any sibling lib in the same single-pass build clobber it. The
    # reasoning in the block below applied to them all along; only the later
    # members had ever been migrated.
    #
    # ⚠ SOURCE-breaking, ABI-compatible — hence a MINOR bump. The VALUES are
    # unchanged (1..4), so `nein_err_code()` returns exactly what it always
    # did and any consumer reading integer codes (over MCP, across a wire,
    # out of a log) is unaffected. Only a consumer naming the bare SYMBOL at
    # compile time must update, and it fails loudly at build rather than
    # silently taking a neighbour's value — which is the whole point.
    NEIN_ERR_NFT_FAILED = 1;
    NEIN_ERR_INVALID_RULE = 2;
    NEIN_ERR_TABLE_NOT_FOUND = 3;
    NEIN_ERR_CHAIN_NOT_FOUND = 4;
    # Prefixed `NEIN_ERR_` to avoid symbol collisions with sibling AGNOS
    # enums included in the same single-pass build: originally agnosys-core's
    # SysError (bare `ERR_PERMISSION_DENIED` / `ERR_IO`, dropped at 1.5.4),
    # and — from 1.6.0 — bote's `BoteErrTag`, which defines a bare
    # `ERR_PARSE` (=4) and `ERR_IO` (=11). The prefix keeps nein's values
    # fixed (last-definition-wins would otherwise clobber them), so the
    # consumer-facing nein_err_code() contract holds.
    NEIN_ERR_PERMISSION_DENIED = 5;
    NEIN_ERR_PARSE = 6;
    NEIN_ERR_IO = 7;
    # Signed-ruleset errors (1.6.1). Additive — values 1..7 unchanged, so
    # the nein_err_code() contract holds.
    NEIN_ERR_BAD_SIGNATURE = 8;       # ed25519_verify returned 0 over the body
    NEIN_ERR_SIG_MALFORMED = 9;       # envelope structure / charset invalid
    NEIN_ERR_SIG_VERSION = 10;        # nein-sig: value != v1
    NEIN_ERR_SIG_UNSUPPORTED_ALG = 11; # nein-sig-alg: value != ed25519
    NEIN_ERR_SIG_KEY_MISMATCH = 12;   # header pubkey != caller-supplied pubkey
    NEIN_ERR_SIG_KEY = 13;            # null / short key material passed to sign
    # 1.9.0. Additive — values 1..13 unchanged.
    #
    # OUTCOME_UNKNOWN (audit S-8): nft was started on a ruleset and nein cannot
    # learn whether it committed — the child was reaped elsewhere (SIGCHLD set
    # to SIG_IGN, or a host reaper won the race), was killed at the deadline,
    # or died on a signal. nft commits a batch atomically, so the firewall
    # holds either all of it or none of it, but which one is unknown. Through
    # 1.8.2 this was NFT_FAILED, and a caller that retried an additive apply
    # duplicated its rules. Re-read the live ruleset (diff) before acting again.
    NEIN_ERR_OUTCOME_UNKNOWN = 14;
    # Replay-bound (v2) signed rulesets. Returned only for an envelope whose
    # signature verified, so each names a property of an authentic envelope.
    NEIN_ERR_SIG_SCOPE = 15;          # signed for another scope (host / role)
    NEIN_ERR_SIG_STALE = 16;          # seq below the caller's floor: a replay or rollback
    NEIN_ERR_SIG_EXPIRED = 17;        # now is past the signed not-after
}

# --- Result helpers ---

# Return Ok(0)
fn nein_ok(): i64 {
    return Ok(0);
}

# Return Err(code)
fn nein_err(code: i64): i64 {
    return Err(code);
}

# Extract the error code from an Err result. Takes BOTH halves of the
# value form: the tag says whether this is an Err, the payload carries
# the code. Ok yields 0.
fn nein_err_code(t: i64, v: i64): i64 {
    if (is_err_result(t) == 0) { return 0; }
    return v;
}

# --- validate.cyr ---

# nein input validation
#
# All strings interpolated into nftables syntax pass through these
# validators to prevent injection of arbitrary nft commands.
#
# Returns: packed Result — Ok(0) on valid, Err(NEIN_ERR_INVALID_RULE) on reject.
#
# Every validator refuses a NULL pointer (1.8.2, audit B-10): through 1.8.1
# they called strlen(0) and the host SIGSEGV'd. Callers whose field is
# optional (a rule comment, a log prefix) check for 0 themselves first.

# Dangerous characters that could inject nftables commands or break syntax.
# ; { } | \n \r \0 ` $
#
# Checked by scanning each byte of the input string.

fn _is_dangerous_char(c: i64): i64 {
    if (c == 59) { return 1; }    # ;
    if (c == 123) { return 1; }   # {
    if (c == 125) { return 1; }   # }
    if (c == 124) { return 1; }   # |
    if (c == 10) { return 1; }    # \n
    if (c == 13) { return 1; }    # \r
    if (c == 0) { return 1; }     # \0 (mid-string)
    if (c == 96) { return 1; }    # `
    if (c == 36) { return 1; }    # $
    return 0;
}

fn _has_dangerous_char(s: cstring): i64 {
    var len = strlen(s);
    var i = 0;
    while (i < len) {
        if (_is_dangerous_char(load8(s + i)) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn _has_quote(s: cstring): i64 {
    var len = strlen(s);
    var i = 0;
    while (i < len) {
        if (load8(s + i) == 34) { return 1; }   # "
        i = i + 1;
    }
    return 0;
}

# Check if a character is alphanumeric or _ or -
fn _is_ident_char(c: i64): i64 {
    # a-z
    if (c >= 97 && c <= 122) { return 1; }
    # A-Z
    if (c >= 65 && c <= 90) { return 1; }
    # 0-9
    if (c >= 48 && c <= 57) { return 1; }
    # _ -
    if (c == 95) { return 1; }
    if (c == 45) { return 1; }
    return 0;
}

# Check if a character is valid for interface names (alnum, -, _, .)
fn _is_iface_char(c: i64): i64 {
    if (_is_ident_char(c) == 1) { return 1; }
    if (c == 46) { return 1; }   # .
    return 0;
}

# --- Public validators ---

# Validate an nftables identifier (table name, chain name).
# Must be non-empty, alphanumeric plus _ and -, at most 64 chars.
fn validate_identifier(s: cstring): i64 {
    if (s == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var len = strlen(s);
    if (len == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (len > 64) { return nein_err(NEIN_ERR_INVALID_RULE); }

    var i = 0;
    while (i < len) {
        if (_is_ident_char(load8(s + i)) == 0) {
            return nein_err(NEIN_ERR_INVALID_RULE);
        }
        i = i + 1;
    }
    return nein_ok();
}

# --- nft names (1.9.1, audit I-10) ----------------------------------
# validate_identifier's charset is not nft's grammar for a name. Where nein
# renders a name bare — a table, chain, set, map, flowtable, ct timeout or
# define name, a jump / goto target, an @reference — nft 1.1.7 refuses:
#   - a name that starts with a digit or '-' (`3f2a`, `1abc`, `-x`), which
#     its scanner reads as a number or an option;
#   - one of its keywords (`fwd`, `log`, `counter`, `ip`, ... 160 of them).
#     Keywords are case-sensitive: `FWD` is a name.
# Through 1.9.0 both passed validation and failed the whole batch at apply.
# The lists below were probed, not transcribed: 5,118 candidate words (every
# word of nft(8), libnftables-json(5), the shipped example rulesets and JSON
# schema, and libnftables' own strings) were each declared at twelve name
# positions under nft 1.1.7, and a word is listed where nft refused it. Then
# every lowercase name of 1 to 5 letters (12.4 million) and 12,582 wider
# candidates (each part of libnftables' symbol names, and each candidate's
# plural) were checked as names; with the list below, nft takes every one. A
# keyword a later nft adds still fails closed, at apply, as before;
# tests/integration/nft_grammar.tcyr re-checks the list against the installed nft.

# 1 when the n-byte name s is a word of row: a run of n-byte words, one
# space apart, in alphabetical order (0: no row). The fixed width steps word
# to word with no scan, and the order stops at the first word past s's first
# letter.
fn _kw_row_has(s: cstring, n: i64, row: cstring): i64 {
    if (row == 0) { return 0; }
    var c = load8(s);
    var i = 0;
    var more = 1;
    while (more == 1) {
        var r = load8(row + i);
        if (r == c) {
            if (memeq(row + i, s, n) == 1) { return 1; }
        }
        if (r > c) { return 0; }
        if (load8(row + i + n) == 0) { more = 0; }
        i = i + n + 1;
    }
    return 0;
}

# nft's keywords in every name position, as rows of n-byte words, part 0-2
# (0 past the last). 160 words of 2 to 11 bytes; the tests check the count,
# each word's width and the order. `eq`, `xor`, `lshift` and `rshift` are
# the operators `==`, `^`, `<<` and `>>` spelled out: nft lists them in its
# errors as symbols, so neither the word sources nor the error harvest found
# them, and an independent review did (1.9.1).
fn _nft_kw_list(n: i64, part: i64): cstring {
    if (n == 2) {
        if (part == 0) { return "ah ct eq ge gt ip le lt mh ne or rt th xt"; }
        return 0;
    }
    if (n == 3) {
        if (part == 0) { return "add all and arp cpu day dst dup ecn esp fib fwd get gre hbh iif ip6 log map not oif"; }
        if (part == 1) { return "osf rt0 rt2 set srh tcp udp vni xor"; }
        return 0;
    }
    if (n == 4) {
        if (part == 0) { return "comp dccp dnat drop flow frag goto hook hour icmp igmp inet jump list mark meta"; }
        if (part == 1) { return "rule sctp size snat time type vlan vmap"; }
        return 0;
    }
    if (n == 5) {
        if (part == 0) { return "chain ether flags flush index ipsec jhash limit meter queue quota reset skgid skuid"; }
        if (part == 1) { return "table vxlan"; }
        return 0;
    }
    if (n == 6) {
        if (part == 0) { return "accept bridge cgroup create define delete device exists export exthdr geneve gretap"; }
        if (part == 1) { return "handle icmpv6 import insert lshift netdev numgen policy random reject rename return"; }
        if (part == 2) { return "rshift socket tproxy tunnel typeof update"; }
        return 0;
    }
    if (n == 7) {
        if (part == 0) { return "comment counter destroy devices dynamic element expires ibrname iifname iiftype"; }
        if (part == 1) { return "include missing monitor nftrace notrack obrname offload oifname oiftype pkttype"; }
        if (part == 2) { return "replace ruleset secmark symhash timeout udplite"; }
        return 0;
    }
    if (n == 8) {
        if (part == 0) { return "constant continue describe elements ibriport iifgroup interval obriport oifgroup"; }
        if (part == 1) { return "position priority redefine redirect synproxy undefine"; }
        return 0;
    }
    if (n == 9) {
        if (part == 0) { return "flowtable rtclassid"; }
        return 0;
    }
    if (n == 10) {
        if (part == 0) { return "auto-merge masquerade"; }
        return 0;
    }
    if (n == 11) {
        if (part == 0) { return "gc-interval"; }
        return 0;
    }
    return 0;
}

# 1 when s (n bytes) is an nft keyword in every name position.
fn _nft_keyword(s: cstring, n: i64): i64 {
    if (n < 2 || n > 11) { return 0; }
    var part = 0;
    while (part < 3) {
        if (_kw_row_has(s, n, _nft_kw_list(n, part)) == 1) { return 1; }
        part = part + 1;
    }
    return 0;
}

# The keywords of nft's ct scope, which a ct timeout's NAME is read in
# (`ct timeout state { ... }` is refused; probed, nft 1.1.7), as one row of
# n-byte words per width (0: none). 28 words. Only the ct timeout
# declaration needs them.
fn _nft_ct_kw_list(n: i64): cstring {
    if (n == 2) { return "id"; }
    if (n == 4) { return "last name over zone"; }
    if (n == 5) { return "bytes count daddr dport event label reply saddr state until"; }
    if (n == 6) { return "avgpkt helper status"; }
    if (n == 7) { return "helpers l3proto packets"; }
    if (n == 8) { return "original protocol"; }
    if (n == 9) { return "direction proto-dst proto-src"; }
    if (n == 10) { return "expiration"; }
    if (n == 11) { return "expectation"; }
    return 0;
}

# 1 when s is a ct-scope keyword (see _nft_ct_kw_list).
fn _nft_ct_keyword(s: cstring): i64 {
    var n = strlen(s);
    if (n < 2 || n > 11) { return 0; }
    return _kw_row_has(s, n, _nft_ct_kw_list(n));
}

# The table names `nft list table <family> <name>` reads as keywords of its
# list scope, as one row of n-byte words per width (0: none). `tables`,
# `rules`, `count`, ... are names everywhere else, so `table inet rules` is
# declared and applied, and then cannot be listed (probed, nft 1.1.7: 12,582
# candidates as real tables in a namespace; 1.9.1). 16 words. Only
# list_table_with_handles needs them.
fn _nft_list_kw_list(n: i64): cstring {
    if (n == 4) { return "maps sets"; }
    if (n == 5) { return "count hooks rules"; }
    if (n == 6) { return "chains counts limits meters quotas tables"; }
    if (n == 7) { return "tunnels"; }
    if (n == 8) { return "counters secmarks"; }
    if (n == 9) { return "synproxys"; }
    if (n == 10) { return "flowtables"; }
    return 0;
}

# 1 when s is a list-scope keyword (see _nft_list_kw_list).
fn _nft_list_keyword(s: cstring): i64 {
    var n = strlen(s);
    if (n < 2 || n > 11) { return 0; }
    return _kw_row_has(s, n, _nft_list_kw_list(n));
}

# 1 when nft reads `@s` as something other than a reference to the set or
# flowtable s: `@ll` and `@nh` are raw payload bases (`@nh,16,8`), and after
# `flow offload` `@last` is a keyword (probed, nft 1.1.7). s already passed
# validate_nft_name.
fn _nft_ref_reserved(s: cstring, flowtable: i64): i64 {
    if (streq(s, "ll") == 1 || streq(s, "nh") == 1) { return 1; }
    if (flowtable == 1 && streq(s, "last") == 1) { return 1; }
    return 0;
}

# Validate a name nein renders bare into nft text: a table, chain, set, map,
# flowtable, ct timeout or define name, or a jump / goto target. Everything
# validate_identifier checks, and nft's grammar for a name: it starts with a
# letter or '_', and is no nft keyword (see above).
fn validate_nft_name(s: cstring): i64 {
    var vt, vv = validate_identifier(s);
    if (is_err_result(vt) == 1) { return Err(vv); }
    var c = load8(s);
    if (c == 45 || (c >= 48 && c <= 57)) { return nein_err(NEIN_ERR_INVALID_RULE); }   # '-' or a digit
    if (_nft_keyword(s, strlen(s)) == 1) { return nein_err(NEIN_ERR_INVALID_RULE); }
    return nein_ok();
}

# --- Strict address parsing (1.8.2, audit I-9) ----------------------
# Through 1.8.1 validate_addr checked only the character set (hex digits,
# '.', ':', '/') and that a '.' or ':' appeared, so "dead1.cafe" — a hex-only
# DNS name — passed, and nft resolved it at apply time: whoever controls that
# zone chose the address. An address must now PARSE as IPv4 or IPv6, with an
# optional prefix length in range for its family.

# A decimal field of 1..maxdig digits with no leading zero, value <= max.
# Returns the index just past it, or -1.
fn _parse_dec(s: cstring, i: i64, end: i64, maxdig: i64, max: i64): i64 {
    var start = i;
    var val = 0;
    while (i < end) {
        var c = load8(s + i);
        if (c < 48 || c > 57) { break; }
        val = val * 10 + (c - 48);
        i = i + 1;
        if (i - start > maxdig) { return 0 - 1; }
    }
    if (i == start) { return 0 - 1; }
    if (i - start > 1 && load8(s + start) == 48) { return 0 - 1; }   # leading zero
    if (val > max) { return 0 - 1; }
    return i;
}

# s[a..b) is exactly a dotted-quad IPv4 address.
fn _is_ipv4_span(s: cstring, a: i64, b: i64): i64 {
    var i = a;
    var parts = 0;
    while (parts < 4) {
        i = _parse_dec(s, i, b, 3, 255);
        if (i < 0) { return 0; }
        parts = parts + 1;
        if (parts < 4) {
            if (i >= b || load8(s + i) != 46) { return 0; }   # '.'
            i = i + 1;
        }
    }
    if (i != b) { return 0; }
    return 1;
}

fn _is_hex_char(c: i64): i64 {
    if (c >= 48 && c <= 57) { return 1; }
    if (c >= 97 && c <= 102) { return 1; }
    if (c >= 65 && c <= 70) { return 1; }
    return 0;
}

# s[a..b) is exactly an IPv6 address: up to eight 1-4 digit hex groups, at
# most one "::", optionally ending in a dotted-quad (which counts as two
# groups, and needs the "::" — see the end). No zone index.
fn _is_ipv6_span(s: cstring, a: i64, b: i64): i64 {
    if (b - a < 2) { return 0; }
    var i = a;
    var groups = 0;
    var compressed = 0;
    var dotted = 0;
    if (load8(s + i) == 58) {                               # leading ':'
        if (load8(s + i + 1) != 58) { return 0; }           # only as "::"
        compressed = 1;
        i = i + 2;
        if (i == b) { return 1; }                           # "::"
    }
    var done = 0;
    while (done == 0) {
        var start = i;
        while (i < b && _is_hex_char(load8(s + i)) == 1) {
            i = i + 1;
            if (i - start > 4) { return 0; }
        }
        if (i == start) { return 0; }
        if (i < b && load8(s + i) == 46) {                  # dotted-quad tail
            if (_is_ipv4_span(s, start, b) == 0) { return 0; }
            dotted = 1;
            groups = groups + 2;
            i = b;
            done = 1;
        } else {
            groups = groups + 1;
            if (i == b) {
                done = 1;
            } else {
                if (load8(s + i) != 58) { return 0; }
                i = i + 1;
                if (i < b && load8(s + i) == 58) {
                    if (compressed == 1) { return 0; }      # a second "::"
                    compressed = 1;
                    i = i + 1;
                    if (i == b) { done = 1; }
                } elif (i == b) {
                    return 0;                               # trailing single ':'
                }
            }
        }
        if (groups > 8) { return 0; }
    }
    if (compressed == 1) {
        if (groups > 7) { return 0; }
        return 1;
    }
    if (groups != 8) { return 0; }
    # Six groups and a dotted quad with no "::" (`1:2:3:4:5:6:1.2.3.4`, RFC
    # 4291's x:x:x:x:x:x:d.d.d.d) is an address nft's scanner has no rule for:
    # `ip6 saddr` with it is a syntax error and the batch fails at apply. Every
    # compressed form with a dotted quad parses (1.9.1; a differential run of
    # 2,329 spellings against nft 1.1.7 disagreed on this form and no other).
    if (dotted == 1) { return 0; }
    return 1;
}

# 4 for an IPv4 address or CIDR, 6 for IPv6, 0 for anything else.
fn _addr_family(s: cstring): i64 {
    if (s == 0) { return 0; }
    var len = strlen(s);
    if (len == 0 || len > 49) { return 0; }                 # 45-byte IPv6 text + "/128"
    var slash = memchr(s, 47, len);
    var end = len;
    if (slash >= 0) { end = slash; }
    var fam = 0;
    if (_is_ipv4_span(s, 0, end) == 1) { fam = 4; }
    elif (_is_ipv6_span(s, 0, end) == 1) { fam = 6; }
    if (fam == 0) { return 0; }
    if (slash >= 0) {
        var maxp = 32;
        if (fam == 6) { maxp = 128; }
        if (_parse_dec(s, slash + 1, len, 3, maxp) != len) { return 0; }
    }
    return fam;
}

# The address part of `s` (any /prefix ignored) as 16 canonical bytes in
# `out` — IPv4 as ::ffff:a.b.c.d, the v4-mapped form — so two spellings of one
# address ("fd00::1", "fd00:0::1", "::ffff:10.0.0.1" and "10.0.0.1") compare
# equal byte for byte (1.8.2, used by the engine's duplicate-address check).
# Returns the family (4 or 6), or 0 if `s` is not an address.
fn _addr_bytes(s: cstring, out: i64): i64 {
    var fam = _addr_family(s);
    if (fam == 0) { return 0; }
    var len = strlen(s);
    var end = memchr(s, 47, len);
    if (end < 0) { end = len; }
    var k = 0;
    while (k < 16) { store8(out + k, 0); k = k + 1; }
    if (fam == 4) {
        store8(out + 10, 255);
        store8(out + 11, 255);
        var i = 0;
        var oct = 0;
        while (oct < 4) {
            var v = 0;
            while (i < end && load8(s + i) != 46) { v = v * 10 + (load8(s + i) - 48); i = i + 1; }
            store8(out + 12 + oct, v);
            i = i + 1;
            oct = oct + 1;
        }
        return 4;
    }
    # IPv6: collect the groups before and after "::" separately, then place
    # the tail at the end. A dotted-quad tail fills the last four bytes.
    var head[16];
    var tail[16];
    var nh = 0;
    var nt = 0;
    var after = 0;
    var j = 0;
    if (load8(s) == 58) { after = 1; j = 2; }
    while (j < end) {
        var start = j;
        var g = 0;
        var isv4 = 0;
        while (j < end && load8(s + j) != 58) {
            if (load8(s + j) == 46) { isv4 = 1; }
            j = j + 1;
        }
        if (isv4 == 1) {
            var four[16];
            var vb = alloc(j - start + 1);
            memcpy(vb, s + start, j - start);
            store8(vb + j - start, 0);
            _addr_bytes(vb, &four);
            var q = 0;
            while (q < 4) {
                if (after == 1) { store8(&tail + nt, load8(&four + 12 + q)); nt = nt + 1; }
                else { store8(&head + nh, load8(&four + 12 + q)); nh = nh + 1; }
                q = q + 1;
            }
        } else {
            var h = start;
            while (h < j) {
                var c = load8(s + h);
                var d = 0;
                if (c >= 48 && c <= 57) { d = c - 48; }
                elif (c >= 97 && c <= 102) { d = c - 87; }
                else { d = c - 55; }
                g = g * 16 + d;
                h = h + 1;
            }
            if (after == 1) {
                store8(&tail + nt, g >> 8); store8(&tail + nt + 1, g & 255); nt = nt + 2;
            } else {
                store8(&head + nh, g >> 8); store8(&head + nh + 1, g & 255); nh = nh + 2;
            }
        }
        if (j < end) {
            j = j + 1;
            if (j < end && load8(s + j) == 58) { after = 1; j = j + 1; }
        }
    }
    var m = 0;
    while (m < nh) { store8(out + m, load8(&head + m)); m = m + 1; }
    m = 0;
    while (m < nt) { store8(out + 16 - nt + m, load8(&tail + m)); m = m + 1; }
    return 6;
}

# --- The address as nft lists it (1.9.2, audit P-8) ------------------
# nft does not list an address as it was written: it masks the host bits
# under a prefix (10.0.0.1/24 -> 10.0.0.0/24), drops a full-length prefix
# (/32, /128), and prints IPv6 through inet_ntop (lowercase, leading zeros
# dropped, the longest run of two or more zero groups as "::", the first on a
# tie, a dotted quad only after ::ffff: or six zero groups). nein_diff
# compares a target rule against that listing, so it needs the same spelling.
# Probed against nft 1.1.7 (tests/integration/diff_converge.tcyr).

fn _sb_add_hex_group(sb: i64, g: i64): i64 {
    var digits = "0123456789abcdef";
    var started = 0;
    var shift = 12;
    while (shift >= 0) {
        var d = (g >> shift) & 15;
        if (d != 0 || started == 1 || shift == 0) {
            str_builder_add_byte(sb, load8(digits + d));
            started = 1;
        }
        shift = shift - 4;
    }
    return 0;
}

fn _sb_add_quad(sb: i64, b: i64): i64 {
    var q = 0;
    while (q < 4) {
        if (q > 0) { str_builder_add_cstr(sb, "."); }
        str_builder_add_int(sb, load8(b + q));
        q = q + 1;
    }
    return 0;
}

# glibc inet_ntop for 16 address bytes.
fn _sb_add_ipv6(sb: i64, b: i64): i64 {
    var w[64];
    var i = 0;
    while (i < 8) {
        store64(&w + i * 8, (load8(b + i * 2) << 8) | load8(b + i * 2 + 1));
        i = i + 1;
    }
    var best = 0 - 1;
    var blen = 0;
    var cur = 0 - 1;
    var clen = 0;
    i = 0;
    while (i < 8) {
        if (load64(&w + i * 8) == 0) {
            if (cur < 0) { cur = i; clen = 1; } else { clen = clen + 1; }
        } elif (cur >= 0) {
            if (best < 0 || clen > blen) { best = cur; blen = clen; }
            cur = 0 - 1;
        }
        i = i + 1;
    }
    if (cur >= 0 && (best < 0 || clen > blen)) { best = cur; blen = clen; }
    if (best >= 0 && blen < 2) { best = 0 - 1; }
    i = 0;
    while (i < 8) {
        if (best >= 0 && i >= best && i < best + blen) {
            if (i == best) { str_builder_add_cstr(sb, ":"); }
            i = i + 1;
            continue;
        }
        if (i != 0) { str_builder_add_cstr(sb, ":"); }
        if (i == 6 && best == 0 && (blen == 6 || (blen == 5 && load64(&w + 40) == 0xFFFF))) {
            _sb_add_quad(sb, b + 12);
            return 0;
        }
        _sb_add_hex_group(sb, load64(&w + i * 8));
        i = i + 1;
    }
    if (best >= 0 && best + blen == 8) { str_builder_add_cstr(sb, ":"); }
    return 0;
}

# `s` as nft 1.1.7 lists it, or 0 when `s` is not an address validate_addr
# takes. Never changes which addresses `s` names: masking host bits under a
# prefix is what nft does to it at load.
fn _addr_canon(s: cstring): cstring {
    var b[16];
    var fam = _addr_bytes(s, &b);
    if (fam == 0) { return 0; }
    var len = strlen(s);
    var slash = memchr(s, 47, len);
    var full = 128;
    var off = 0;
    if (fam == 4) { full = 32; off = 12; }
    var p = full;
    if (slash >= 0) { p = atoi(s + slash + 1); }
    var bit = 0;
    while (bit < full) {
        if (bit >= p) {
            var at = &b + off + (bit >> 3);
            store8(at, load8(at) & (255 - (128 >> (bit & 7))));
        }
        bit = bit + 1;
    }
    var sb = str_builder_new();
    if (fam == 4) { _sb_add_quad(sb, &b + 12); } else { _sb_add_ipv6(sb, &b); }
    if (p < full) {
        str_builder_add_cstr(sb, "/");
        str_builder_add_int(sb, p);
    }
    return str_cstr(str_builder_build(sb));
}

# 1 when `s` names a single host: no prefix, or /32 (IPv4) / /128 (IPv6).
fn _addr_is_host(s: cstring): i64 {
    var fam = _addr_family(s);
    if (fam == 0) { return 0; }
    var len = strlen(s);
    var slash = memchr(s, 47, len);
    if (slash < 0) { return 1; }
    var p = atoi(s + slash + 1);
    if (fam == 4 && p == 32) { return 1; }
    if (fam == 6 && p == 128) { return 1; }
    return 0;
}

# Validate an IP address or CIDR string: IPv4 dotted quad or IPv6, with an
# optional /prefix in range for the family. Host names are refused.
fn validate_addr(s: cstring): i64 {
    if (_addr_family(s) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    return nein_ok();
}

# A port number 0..65535, or a range "a-b" with a <= b (1.8.2).
fn _is_port_token(s: cstring): i64 {
    if (s == 0) { return 0; }
    var len = strlen(s);
    var dash = memchr(s, 45, len);
    if (dash < 0) {
        if (_parse_dec(s, 0, len, 5, 65535) != len) { return 0; }
        return 1;
    }
    if (_parse_dec(s, 0, dash, 5, 65535) != dash) { return 0; }
    if (_parse_dec(s, dash + 1, len, 5, 65535) != len) { return 0; }
    if (atoi(s) > atoi(s + dash + 1)) { return 0; }
    return 1;
}

# The selector of a set lookup (`<field> @set`), from a closed set (1.8.2,
# audit I-2). Through 1.8.1 it only had to pass validate_nft_element, so
# "ip saddr !=" rendered `ip saddr != @trusted accept` — an allowlist
# inverted into "everyone except the trusted".
fn _is_set_lookup_field(s: cstring): i64 {
    if (s == 0) { return 0; }
    if (streq(s, "ip saddr") == 1) { return 1; }
    if (streq(s, "ip daddr") == 1) { return 1; }
    if (streq(s, "ip6 saddr") == 1) { return 1; }
    if (streq(s, "ip6 daddr") == 1) { return 1; }
    if (streq(s, "tcp dport") == 1) { return 1; }
    if (streq(s, "tcp sport") == 1) { return 1; }
    if (streq(s, "udp dport") == 1) { return 1; }
    if (streq(s, "udp sport") == 1) { return 1; }
    if (streq(s, "th dport") == 1) { return 1; }
    if (streq(s, "th sport") == 1) { return 1; }
    if (streq(s, "meta l4proto") == 1) { return 1; }
    if (streq(s, "iifname") == 1) { return 1; }
    if (streq(s, "oifname") == 1) { return 1; }
    return 0;
}

# Validate an nftables address family.
# Must be one of: inet, ip, ip6, arp, bridge, netdev.
fn validate_family(s: cstring): i64 {
    if (s == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (streq(s, "inet") == 1) { return nein_ok(); }
    if (streq(s, "ip") == 1) { return nein_ok(); }
    if (streq(s, "ip6") == 1) { return nein_ok(); }
    if (streq(s, "arp") == 1) { return nein_ok(); }
    if (streq(s, "bridge") == 1) { return nein_ok(); }
    if (streq(s, "netdev") == 1) { return nein_ok(); }
    return nein_err(NEIN_ERR_INVALID_RULE);
}

# Validate a network interface name.
# Up to 15 chars, alphanumeric plus - _ .
fn validate_iface(s: cstring): i64 {
    if (s == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var len = strlen(s);
    if (len == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (len > 15) { return nein_err(NEIN_ERR_INVALID_RULE); }

    var i = 0;
    while (i < len) {
        if (_is_iface_char(load8(s + i)) == 0) {
            return nein_err(NEIN_ERR_INVALID_RULE);
        }
        i = i + 1;
    }
    return nein_ok();
}

# Validate a connection tracking state.
# Must be: new, established, related, invalid, untracked.
fn validate_ct_state(s: cstring): i64 {
    if (s == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (streq(s, "new") == 1) { return nein_ok(); }
    if (streq(s, "established") == 1) { return nein_ok(); }
    if (streq(s, "related") == 1) { return nein_ok(); }
    if (streq(s, "invalid") == 1) { return nein_ok(); }
    if (streq(s, "untracked") == 1) { return nein_ok(); }
    return nein_err(NEIN_ERR_INVALID_RULE);
}

# Validate a ct-state LIST, as carried by MATCH_CT_STATE and rendered into
# `ct state { ... }`.
#
# `validate_ct_state` above accepts exactly one bare state, but the Match
# variant carries a comma-separated list — `match_ct_state("established,
# related")` is the shape every in-tree caller uses. So a list-aware check is
# what the render path actually needs.
#
# Added at 1.6.9 to close a real hole: `rule_validate` had NO MATCH_CT_STATE
# branch at all, so the string was interpolated straight into nft grammar
# unchecked, while threat-model T-1 listed `validate_ct_state` as the
# mitigation covering this field. That validator had zero production callers —
# the documented control did not exist.
#
# Each token is trimmed of surrounding spaces and checked against the closed
# set. Anything else — including a `}` that would close the brace and start a
# new statement — is rejected.
fn validate_ct_state_list(s: cstring): i64 {
    if (s == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var len = strlen(s);
    if (len == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (len > 128) { return nein_err(NEIN_ERR_INVALID_RULE); }

    var buf = alloc(len + 1);
    var out = 0;
    var i = 0;

    while (i <= len) {
        var c = 0;
        if (i < len) { c = load8(s + i); }

        if (i == len || c == 44) {
            # End of a token (',' = 44, or end of string). Trim trailing
            # spaces, then check the token against the closed set.
            while (out > 0 && load8(buf + out - 1) == 32) { out = out - 1; }
            store8(buf + out, 0);
            if (out == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
            var vr1_t, vr1_v = validate_ct_state(buf);
            if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
            out = 0;
        } elif (c == 32 && out == 0) {
            # Leading space before a token — skip. An INTERNAL space is copied
            # through and will fail the closed-set check, which is intended.
        } else {
            store8(buf + out, c);
            out = out + 1;
        }
        i = i + 1;
    }

    return nein_ok();
}

# Validate a comment string.
# Rejects double quotes and dangerous chars. Max 128 chars.
fn validate_comment(s: cstring): i64 {
    if (s == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var len = strlen(s);
    if (len > 128) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (_has_quote(s) == 1) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (_has_dangerous_char(s) == 1) { return nein_err(NEIN_ERR_INVALID_RULE); }
    return nein_ok();
}

# Validate a log prefix string.
# Same constraints as comments but max 64 chars (nftables limit).
fn validate_log_prefix(s: cstring): i64 {
    if (s == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var len = strlen(s);
    if (len > 64) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (_has_quote(s) == 1) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (_has_dangerous_char(s) == 1) { return nein_err(NEIN_ERR_INVALID_RULE); }
    return nein_ok();
}

# Validate a set/map element string.
# Non-empty, no dangerous chars, no quotes.
# Reject '#' (0x23). nft treats it as a comment to end-of-line, so a value
# carrying one silently truncates whatever follows it in the rendered rule.
# Verified against nftables 1.1.6:
#     add rule inet filter input ip saddr 1.2.3.4 accept # drop
# applies as an ACCEPT — the intended `drop` verdict vanishes without error.
#
# Checked HERE rather than in the shared _is_dangerous_char set (1.6.10, audit
# MEDIUM), because the contexts differ: everything validate_nft_element guards
# is interpolated UNQUOTED into nft grammar — whole rule bodies via
# add_rule_live, set/map elements, define values, tcp-flag and set-lookup
# fields — so '#' is live there. Comments and log prefixes are rendered inside
# double quotes, where '#' is an ordinary character; rejecting it there would
# break the legitimate `comment "port 80 # web"` for no security gain.
fn _has_nft_comment_char(s: cstring): i64 {
    var i = 0;
    var len = strlen(s);
    while (i < len) {
        if (load8(s + i) == 35) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn validate_nft_element(s: cstring): i64 {
    if (s == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var len = strlen(s);
    if (len == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (_has_quote(s) == 1) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (_has_dangerous_char(s) == 1) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (_has_nft_comment_char(s) == 1) { return nein_err(NEIN_ERR_INVALID_RULE); }
    return nein_ok();
}

# --- rule.cyr ---

# nein rule module — match expressions, verdicts, and rule rendering
#
# Core building block: Rule = matches + verdict + optional comment.
# Renders to nftables syntax string via rule_render().

# ================================================================
# Enum constants — Match types
# ================================================================

enum MatchType {
    MATCH_SOURCE_ADDR = 1;
    MATCH_DEST_ADDR = 2;
    MATCH_SOURCE_ADDR6 = 3;
    MATCH_DEST_ADDR6 = 4;
    MATCH_PROTOCOL = 5;
    MATCH_DPORT = 6;
    MATCH_SPORT = 7;
    MATCH_DPORT_RANGE = 8;
    MATCH_IIF = 9;
    MATCH_OIF = 10;
    MATCH_CT_STATE = 11;
    MATCH_LIMIT = 12;
    MATCH_SET_LOOKUP = 13;
    MATCH_CT_HELPER = 14;
    MATCH_TCP_FLAGS = 15;
    MATCH_ICMP_TYPE = 16;
    MATCH_ICMPV6_TYPE = 17;
    MATCH_META_MARK = 18;
    MATCH_QUOTA = 19;
    MATCH_FLOW_OFFLOAD = 20;
    MATCH_CT_TIMEOUT_SET = 21;
    MATCH_ICMP_TYPE_CODE = 22;
    MATCH_ICMPV6_TYPE_CODE = 23;
    MATCH_VLAN_ID = 24;
    MATCH_DSCP = 25;
    MATCH_IPV6_EXT_HDR = 26;
    MATCH_FRAG_OFF = 27;
    MATCH_PKT_TYPE = 28;
    MATCH_CONN_LIMIT = 29;
    MATCH_RAW = 30;
}

# ================================================================
# Enum constants — Verdict types
# ================================================================

enum VerdictType {
    VERDICT_ACCEPT = 1;
    VERDICT_DROP = 2;
    VERDICT_REJECT = 3;
    VERDICT_REJECT_WITH = 4;
    VERDICT_JUMP = 5;
    VERDICT_GOTO = 6;
    VERDICT_RETURN = 7;
    VERDICT_LOG = 8;
    VERDICT_COUNTER = 9;
    VERDICT_SET_MARK = 10;
    VERDICT_SET_CT_MARK = 11;
    VERDICT_LOG_ADVANCED = 12;
    VERDICT_COUNTER_NAMED = 13;
    VERDICT_NONE = 14;         # 1.8.2: no verdict word — the rule's last statement is terminal
}

# ================================================================
# Sub-enum constants
# ================================================================

enum Protocol {
    PROTO_TCP = 1;
    PROTO_UDP = 2;
    PROTO_ICMP = 3;
    PROTO_ICMPV6 = 4;
}

enum RateUnit {
    RATE_SECOND = 1;
    RATE_MINUTE = 2;
    RATE_HOUR = 3;
    RATE_DAY = 4;
}

enum QuotaMode {
    QUOTA_OVER = 1;
    QUOTA_UNTIL = 2;
}

enum QuotaUnit {
    QUNIT_BYTES = 1;
    QUNIT_KBYTES = 2;
    QUNIT_MBYTES = 3;
    QUNIT_GBYTES = 4;
}

enum PktTypeEnum {
    PKT_UNICAST = 1;
    PKT_BROADCAST = 2;
    PKT_MULTICAST = 3;
}

enum Ipv6ExtHdrEnum {
    EXT_HOP_BY_HOP = 1;
    EXT_ROUTING = 2;
    EXT_FRAGMENT = 3;
    EXT_DESTINATION = 4;
    EXT_MOBILITY = 5;
    EXT_AUTH = 6;
}

enum CmpOpEnum {
    NFT_CMP_EQ = 1;
    NFT_CMP_NE = 2;
    NFT_CMP_LT = 3;
    NFT_CMP_GT = 4;
    NFT_CMP_LE = 5;
    NFT_CMP_GE = 6;
}

enum RejectReasonEnum {
    REJECT_ICMP_HOST_UNREACH = 1;
    REJECT_ICMP_PORT_UNREACH = 2;
    REJECT_ICMP_NET_UNREACH = 3;
    REJECT_ICMP_ADMIN_PROHIB = 4;
    REJECT_ICMPX_ADMIN_PROHIB = 5;
    REJECT_TCP_RESET = 6;
}

enum LogLevelEnum {
    NFT_LOG_EMERG = 1;
    NFT_LOG_ALERT = 2;
    NFT_LOG_CRIT = 3;
    NFT_LOG_ERR = 4;
    NFT_LOG_WARN = 5;
    NFT_LOG_NOTICE = 6;
    NFT_LOG_INFO = 7;
    NFT_LOG_DEBUG = 8;
}

# ================================================================
# String renderers for enum constants
# ================================================================

fn _proto_str(p) {
    if (p == PROTO_TCP) { return "tcp"; }
    if (p == PROTO_UDP) { return "udp"; }
    if (p == PROTO_ICMP) { return "icmp"; }
    if (p == PROTO_ICMPV6) { return "icmpv6"; }
    return "unknown";
}

fn _rate_unit_str(u) {
    if (u == RATE_SECOND) { return "second"; }
    if (u == RATE_MINUTE) { return "minute"; }
    if (u == RATE_HOUR) { return "hour"; }
    if (u == RATE_DAY) { return "day"; }
    return "second";
}

fn _quota_mode_str(m) {
    if (m == QUOTA_OVER) { return "over"; }
    if (m == QUOTA_UNTIL) { return "until"; }
    return "over";
}

fn _quota_unit_str(u) {
    if (u == QUNIT_BYTES) { return "bytes"; }
    if (u == QUNIT_KBYTES) { return "kbytes"; }
    if (u == QUNIT_MBYTES) { return "mbytes"; }
    if (u == QUNIT_GBYTES) { return "gbytes"; }
    return "bytes";
}

# ================================================================
# Canonical spellings — what nft LISTS (1.9.2, audit P-8)
# ================================================================
# nein_diff compares each target rule with the body nft lists for the live
# rule, and nft lists its own spelling, not the one it was given: `meta mark
# 5` lists as `meta mark 0x00000005`, `ct state { new }` as `ct state new`.
# So the diff renders the target in nft's spelling for the COMPARISON only —
# `cf`, the table's family, is nonzero there — and emits the ruleset as
# before. Every rewrite below is one nft makes to the same rule, so none
# changes what a rule matches; each was probed against nft 1.1.7
# (tests/integration/diff_converge.tcyr). A spelling predicted wrongly costs
# what every diff cost through 1.9.1, a rebuilt chain; it cannot make two
# different rules compare equal.

# Bytes per QuotaUnit.
fn _quota_unit_bytes(u) {
    if (u == QUNIT_KBYTES) { return 1024; }
    if (u == QUNIT_MBYTES) { return 1048576; }
    if (u == QUNIT_GBYTES) { return 1073741824; }
    return 1;
}

# A quota's amount and unit. nft has no gbytes (1.9.2: `quota over 1 gbytes`
# was a syntax error, so the batch failed at apply): gbytes renders as 1024
# mbytes each. Canonical (`cf`): the byte count in the largest of bytes,
# kbytes and mbytes that divides it, as nft lists it (`2048 kbytes` lists as
# `2 mbytes`).
fn _sb_add_quota_amount(sb, amount, unit, cf) {
    if (cf == 0) {
        if (unit == QUNIT_GBYTES) {
            str_builder_add_int(sb, amount * 1024);
            str_builder_add_cstr(sb, " mbytes");
            return 0;
        }
        str_builder_add_int(sb, amount);
        str_builder_add_cstr(sb, " ");
        str_builder_add_cstr(sb, _quota_unit_str(unit));
        return 0;
    }
    var n = amount * _quota_unit_bytes(unit);
    var u = "bytes";
    if (n != 0 && n % 1024 == 0) {
        n = n / 1024;
        u = "kbytes";
        if (n % 1024 == 0) { n = n / 1024; u = "mbytes"; }
    }
    str_builder_add_int(sb, n);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, u);
    return 0;
}

# `val` as 0x and exactly `width` lowercase hex digits (marks: 8, dscp: 2).
fn _sb_add_hex_fixed(sb, val, width) {
    var digits = "0123456789abcdef";
    str_builder_add_cstr(sb, "0x");
    var shift = (width - 1) * 4;
    while (shift >= 0) {
        str_builder_add_byte(sb, load8(digits + ((val >> shift) & 15)));
        shift = shift - 4;
    }
    return 0;
}

# The DSCP names nft lists; any other value lists as 0x%02x.
fn _dscp_name(v) {
    if (v == 0) { return "cs0"; }
    if (v == 1) { return "lephb"; }
    if (v == 8) { return "cs1"; }
    if (v == 10) { return "af11"; }
    if (v == 12) { return "af12"; }
    if (v == 14) { return "af13"; }
    if (v == 16) { return "cs2"; }
    if (v == 18) { return "af21"; }
    if (v == 20) { return "af22"; }
    if (v == 22) { return "af23"; }
    if (v == 24) { return "cs3"; }
    if (v == 26) { return "af31"; }
    if (v == 28) { return "af32"; }
    if (v == 30) { return "af33"; }
    if (v == 32) { return "cs4"; }
    if (v == 34) { return "af41"; }
    if (v == 36) { return "af42"; }
    if (v == 38) { return "af43"; }
    if (v == 40) { return "cs5"; }
    if (v == 44) { return "va"; }
    if (v == 46) { return "ef"; }
    if (v == 48) { return "cs6"; }
    if (v == 56) { return "cs7"; }
    return 0;
}

# The value of a ct state word, or 0.
fn _ct_state_bit(w) {
    if (streq(w, "invalid") == 1) { return 1; }
    if (streq(w, "established") == 1) { return 2; }
    if (streq(w, "related") == 1) { return 4; }
    if (streq(w, "new") == 1) { return 8; }
    if (streq(w, "untracked") == 1) { return 64; }
    return 0;
}

fn _ct_state_word(bit) {
    if (bit == 1) { return "invalid"; }
    if (bit == 2) { return "established"; }
    if (bit == 4) { return "related"; }
    if (bit == 8) { return "new"; }
    return "untracked";
}

# The value of a tcp flag word, or 0.
fn _tcp_flag_bit(w) {
    if (streq(w, "fin") == 1) { return 1; }
    if (streq(w, "syn") == 1) { return 2; }
    if (streq(w, "rst") == 1) { return 4; }
    if (streq(w, "psh") == 1) { return 8; }
    if (streq(w, "ack") == 1) { return 16; }
    if (streq(w, "urg") == 1) { return 32; }
    if (streq(w, "ecn") == 1) { return 64; }
    if (streq(w, "cwr") == 1) { return 128; }
    return 0;
}

fn _tcp_flag_word(bit) {
    if (bit == 1) { return "fin"; }
    if (bit == 2) { return "syn"; }
    if (bit == 4) { return "rst"; }
    if (bit == 8) { return "psh"; }
    if (bit == 16) { return "ack"; }
    if (bit == 32) { return "urg"; }
    if (bit == 64) { return "ecn"; }
    return "cwr";
}

# The words of a comma-separated list as a bit mask, each word's value from
# `bitfn` (1 = ct state, 2 = tcp flags); 0 when any word is unknown.
fn _word_list_mask(s, kind) {
    if (s == 0) { return 0; }
    var len = strlen(s);
    var w = alloc(len + 1);
    var mask = 0;
    var i = 0;
    while (i <= len) {
        while (i < len && load8(s + i) == 32) { i = i + 1; }
        var n = 0;
        while (i < len && load8(s + i) != 44) {
            store8(w + n, load8(s + i));
            n = n + 1;
            i = i + 1;
        }
        while (n > 0 && load8(w + n - 1) == 32) { n = n - 1; }
        store8(w + n, 0);
        var bit = 0;
        if (kind == 1) { bit = _ct_state_bit(w); } else { bit = _tcp_flag_bit(w); }
        if (bit == 0) { return 0; }
        mask = mask | bit;
        i = i + 1;
    }
    return mask;
}

# A set of flag words as nft lists it: one word bare (`one_prefix` before
# it), several as `{ a, b }` in ascending value.
fn _sb_add_flag_set(sb, mask, kind, one_prefix) {
    var count = 0;
    var b = 1;
    while (b <= 128) {
        if ((mask & b) != 0) { count = count + 1; }
        b = b * 2;
    }
    if (count == 1) { str_builder_add_cstr(sb, one_prefix); } else { str_builder_add_cstr(sb, "{ "); }
    var k = 0;
    b = 1;
    while (b <= 128) {
        if ((mask & b) != 0) {
            if (k > 0) { str_builder_add_cstr(sb, ", "); }
            if (kind == 1) { str_builder_add_cstr(sb, _ct_state_word(b)); }
            else { str_builder_add_cstr(sb, _tcp_flag_word(b)); }
            k = k + 1;
        }
        b = b * 2;
    }
    if (count != 1) { str_builder_add_cstr(sb, " }"); }
    return 0;
}

# An address match's value: as written, or canonical under `cf`.
fn _sb_add_match_addr(sb, addr, cf) {
    if (cf != 0) {
        var c = _addr_canon(addr);
        if (c != 0) { str_builder_add_cstr(sb, c); return 0; }
    }
    str_builder_add_cstr(sb, addr);
    return 0;
}

fn _pkt_type_str(p) {
    if (p == PKT_UNICAST) { return "unicast"; }
    if (p == PKT_BROADCAST) { return "broadcast"; }
    if (p == PKT_MULTICAST) { return "multicast"; }
    return "unicast";
}

fn _ipv6_ext_hdr_str(h) {
    if (h == EXT_HOP_BY_HOP) { return "hbh"; }
    if (h == EXT_ROUTING) { return "rt"; }
    if (h == EXT_FRAGMENT) { return "frag"; }
    if (h == EXT_DESTINATION) { return "dst"; }
    if (h == EXT_MOBILITY) { return "mh"; }
    if (h == EXT_AUTH) { return "auth"; }
    return "unknown";
}

fn _cmp_op_str(op) {
    if (op == NFT_CMP_EQ) { return "=="; }
    if (op == NFT_CMP_NE) { return "!="; }
    if (op == NFT_CMP_LT) { return "<"; }
    if (op == NFT_CMP_GT) { return ">"; }
    if (op == NFT_CMP_LE) { return "<="; }
    if (op == NFT_CMP_GE) { return ">="; }
    return "==";
}

fn _reject_reason_str(r) {
    if (r == REJECT_ICMP_HOST_UNREACH) { return "icmp type host-unreachable"; }
    if (r == REJECT_ICMP_PORT_UNREACH) { return "icmp type port-unreachable"; }
    if (r == REJECT_ICMP_NET_UNREACH) { return "icmp type net-unreachable"; }
    if (r == REJECT_ICMP_ADMIN_PROHIB) { return "icmp type admin-prohibited"; }
    if (r == REJECT_ICMPX_ADMIN_PROHIB) { return "icmpx type admin-prohibited"; }
    if (r == REJECT_TCP_RESET) { return "tcp reset"; }
    return "icmp type port-unreachable";
}

fn _log_level_str(l) {
    if (l == NFT_LOG_EMERG) { return "emerg"; }
    if (l == NFT_LOG_ALERT) { return "alert"; }
    if (l == NFT_LOG_CRIT) { return "crit"; }
    if (l == NFT_LOG_ERR) { return "err"; }
    if (l == NFT_LOG_WARN) { return "warn"; }
    if (l == NFT_LOG_NOTICE) { return "notice"; }
    if (l == NFT_LOG_INFO) { return "info"; }
    if (l == NFT_LOG_DEBUG) { return "debug"; }
    return "info";
}

# ================================================================
# Match struct — tagged union: { type, val1, val2, val3 }
# Layout: [type:8][val1:8][val2:8][val3:8] = 32 bytes
#   val1/val2/val3 meaning depends on type (string ptr, int, etc.)
# ================================================================

fn match_new(mtype: i64, v1: i64, v2: i64, v3: i64): i64 {
    var m = alloc(32);
    store64(m, mtype);
    store64(m + 8, v1);
    store64(m + 16, v2);
    store64(m + 24, v3);
    return m;
}

fn match_type(m: i64): i64 { return load64(m); }
fn match_val1(m: i64): i64 { return load64(m + 8); }
fn match_val2(m: i64): i64 { return load64(m + 16); }
fn match_val3(m: i64): i64 { return load64(m + 24); }

# Match constructors

fn match_source_addr(addr: cstring): i64 { return match_new(MATCH_SOURCE_ADDR, addr, 0, 0); }
fn match_dest_addr(addr: cstring): i64 { return match_new(MATCH_DEST_ADDR, addr, 0, 0); }
fn match_source_addr6(addr: cstring): i64 { return match_new(MATCH_SOURCE_ADDR6, addr, 0, 0); }
fn match_dest_addr6(addr: cstring): i64 { return match_new(MATCH_DEST_ADDR6, addr, 0, 0); }

# An address match in the address's own family: `ip`/`ip6`, `saddr`/`daddr`
# (1.8.2). Builders that took an address and always rendered `ip saddr` made
# any IPv6 input fail the whole ruleset at apply.
fn _match_addr(addr: cstring, is_dest: i64): i64 {
    if (_addr_family(addr) == 6) {
        if (is_dest == 1) { return match_dest_addr6(addr); }
        return match_source_addr6(addr);
    }
    if (is_dest == 1) { return match_dest_addr(addr); }
    return match_source_addr(addr);
}
fn match_protocol(proto: cstring): i64 { return match_new(MATCH_PROTOCOL, proto, 0, 0); }
fn match_dport(port: i64): i64 { return match_new(MATCH_DPORT, port, 0, 0); }
fn match_sport(port: i64): i64 { return match_new(MATCH_SPORT, port, 0, 0); }
fn match_dport_range(lo: i64, hi: i64): i64 { return match_new(MATCH_DPORT_RANGE, lo, hi, 0); }
fn match_iif(iface: cstring): i64 { return match_new(MATCH_IIF, iface, 0, 0); }
fn match_oif(iface: cstring): i64 { return match_new(MATCH_OIF, iface, 0, 0); }
fn match_ct_state(states_str: cstring): i64 { return match_new(MATCH_CT_STATE, states_str, 0, 0); }
fn match_limit(rate: i64, unit: i64, burst: i64): i64 { return match_new(MATCH_LIMIT, rate, unit, burst); }
fn match_set_lookup(field: cstring, set_name: cstring): i64 { return match_new(MATCH_SET_LOOKUP, field, set_name, 0); }
fn match_ct_helper(helper: cstring): i64 { return match_new(MATCH_CT_HELPER, helper, 0, 0); }
fn match_tcp_flags(flags_str: cstring): i64 { return match_new(MATCH_TCP_FLAGS, flags_str, 0, 0); }
fn match_icmp_type(tname: cstring): i64 { return match_new(MATCH_ICMP_TYPE, tname, 0, 0); }
fn match_icmpv6_type(tname: cstring): i64 { return match_new(MATCH_ICMPV6_TYPE, tname, 0, 0); }
fn match_meta_mark(val: i64): i64 { return match_new(MATCH_META_MARK, val, 0, 0); }
fn match_quota(mode: i64, amount: i64, unit: i64): i64 { return match_new(MATCH_QUOTA, mode, amount, unit); }
fn match_flow_offload(name: cstring): i64 { return match_new(MATCH_FLOW_OFFLOAD, name, 0, 0); }
fn match_ct_timeout_set(name: cstring): i64 { return match_new(MATCH_CT_TIMEOUT_SET, name, 0, 0); }
fn match_icmp_type_code(tname: cstring, code: i64): i64 { return match_new(MATCH_ICMP_TYPE_CODE, tname, code, 0); }
fn match_icmpv6_type_code(tname: cstring, code: i64): i64 { return match_new(MATCH_ICMPV6_TYPE_CODE, tname, code, 0); }
fn match_vlan_id(id: i64): i64 { return match_new(MATCH_VLAN_ID, id, 0, 0); }
fn match_dscp(val: i64): i64 { return match_new(MATCH_DSCP, val, 0, 0); }
fn match_ipv6_ext_hdr(hdr: i64): i64 { return match_new(MATCH_IPV6_EXT_HDR, hdr, 0, 0); }
fn match_frag_off(mask: i64, op: i64, value: i64): i64 { return match_new(MATCH_FRAG_OFF, mask, op, value); }
fn match_pkt_type(pt: i64): i64 { return match_new(MATCH_PKT_TYPE, pt, 0, 0); }
fn match_conn_limit(count: i64): i64 { return match_new(MATCH_CONN_LIMIT, count, 0, 0); }
fn match_raw(expr: cstring): i64 { return match_new(MATCH_RAW, expr, 0, 0); }

# ================================================================
# Verdict struct — { type, val1, val2, val3, val4 }
# Layout: [type:8][val1:8][val2:8][val3:8][val4:8] = 40 bytes
# ================================================================

fn verdict_new(vtype: i64, v1: i64, v2: i64, v3: i64, v4: i64): i64 {
    var v = alloc(40);
    store64(v, vtype);
    store64(v + 8, v1);
    store64(v + 16, v2);
    store64(v + 24, v3);
    store64(v + 32, v4);
    return v;
}

fn verdict_type(v: i64): i64 { return load64(v); }
fn verdict_val1(v: i64): i64 { return load64(v + 8); }
fn verdict_val2(v: i64): i64 { return load64(v + 16); }
fn verdict_val3(v: i64): i64 { return load64(v + 24); }
fn verdict_val4(v: i64): i64 { return load64(v + 32); }

# Verdict constructors
fn verdict_accept(): i64 { return verdict_new(VERDICT_ACCEPT, 0, 0, 0, 0); }
fn verdict_drop(): i64 { return verdict_new(VERDICT_DROP, 0, 0, 0, 0); }
# No verdict (1.8.2, audit B-4): for a rule whose last statement already ends
# it, such as a `redirect`. nft refuses a verdict after a terminal statement
# ("Statement after terminal statement has no effect"), which is why the mesh
# ruleset, rendering `... redirect to :15001 accept`, could never load. A
# rule with matches and no verdict falls through when it does not act — it
# never accepts — and rule_validate refuses one with no matches at all.
fn verdict_none(): i64 { return verdict_new(VERDICT_NONE, 0, 0, 0, 0); }
fn verdict_reject(): i64 { return verdict_new(VERDICT_REJECT, 0, 0, 0, 0); }
fn verdict_reject_with(reason: i64): i64 { return verdict_new(VERDICT_REJECT_WITH, reason, 0, 0, 0); }
fn verdict_jump(chain: cstring): i64 { return verdict_new(VERDICT_JUMP, chain, 0, 0, 0); }
fn verdict_goto(chain: cstring): i64 { return verdict_new(VERDICT_GOTO, chain, 0, 0, 0); }
fn verdict_return(): i64 { return verdict_new(VERDICT_RETURN, 0, 0, 0, 0); }
fn verdict_log(prefix: cstring): i64 { return verdict_new(VERDICT_LOG, prefix, 0, 0, 0); }
fn verdict_counter(): i64 { return verdict_new(VERDICT_COUNTER, 0, 0, 0, 0); }
fn verdict_set_mark(val: i64): i64 { return verdict_new(VERDICT_SET_MARK, val, 0, 0, 0); }
fn verdict_set_ct_mark(val: i64): i64 { return verdict_new(VERDICT_SET_CT_MARK, val, 0, 0, 0); }
fn verdict_log_advanced(prefix: cstring, level: i64, group: i64, snaplen: i64): i64 {
    return verdict_new(VERDICT_LOG_ADVANCED, prefix, level, group, snaplen);
}
fn verdict_counter_named(name: cstring): i64 { return verdict_new(VERDICT_COUNTER_NAMED, name, 0, 0, 0); }

# ================================================================
# Rule struct — { verdict, matches (vec), comment }
# Layout: [verdict:8][matches:8][comment:8] = 24 bytes
# ================================================================

fn rule_new(verdict: i64): i64 {
    var r = alloc(24);
    store64(r, verdict);
    store64(r + 8, vec_new());
    store64(r + 16, 0);
    return r;
}

fn rule_verdict(r: i64): i64 { return load64(r); }
fn rule_matches(r: i64): i64 { return load64(r + 8); }
fn rule_comment(r: i64): i64 { return load64(r + 16); }

fn rule_add_match(r: i64, m: i64): i64 {
    vec_push(load64(r + 8), m);
    return r;
}

fn rule_set_comment(r: i64, c: cstring): i64 {
    store64(r + 16, c);
    return r;
}

# ================================================================
# Anonymous-set match helpers
#
# nftables lets a single expression carry a braced set literal —
# `tcp dport { 80, 443 }` — which renders one rule where the naive
# construction needs several. These three build that literal for the common
# cases: a port list, an IPv4 source list, an IPv6 source list.
#
# All three go through match_raw, which `rule_validate` deliberately does NOT
# inspect (ADR-0004: Raw is the caller's responsibility). That makes build-time
# validation mandatory here — it is the only point at which these inputs are
# ever checked.
#
# DELIBERATE DEVIATION FROM THE RUST ORIGINAL: `Rule::matching_addrs` filtered
# invalid addresses out and logged a warning, keeping the rest. For a deny
# rule that silently fails OPEN — the dropped address stops being denied and
# nothing in the returned value says so. These return Err(NEIN_ERR_INVALID_RULE)
# on the first bad element instead, and leave the rule UNMODIFIED: every input
# is checked before any match is pushed, so a rejected call cannot leave a
# half-built rule behind.
#
# Each takes a Vec (ports: Vec<i64>, addrs: Vec<cstring>) and returns a packed
# Result — Ok(rule) or Err(NEIN_ERR_INVALID_RULE).
# ================================================================

fn _rule_addr_set(r: i64, addrs: i64, prefix: cstring): i64 {
    var n = vec_len(addrs);
    if (n == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }

    # Validate every address BEFORE mutating the rule.
    var i = 0;
    while (i < n) {
        var vr1_t, vr1_v = validate_addr(vec_get(addrs, i));
        if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
        i = i + 1;
    }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, prefix);
    i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ", "); }
        str_builder_add_cstr(sb, vec_get(addrs, i));
        i = i + 1;
    }
    str_builder_add_cstr(sb, " }");

    rule_add_match(r, match_raw(str_cstr(str_builder_build(sb))));
    return Ok(r);
}

# `{proto} dport { p1, p2, ... }` — adds a protocol match plus the port set.
fn rule_matching_ports(r: i64, proto: i64, ports: i64): i64 {
    var n = vec_len(ports);
    if (n == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }

    # Bounds-check every port before mutating the rule.
    var i = 0;
    while (i < n) {
        var p = vec_get(ports, i);
        if (p < 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if (p > 65535) { return nein_err(NEIN_ERR_INVALID_RULE); }
        i = i + 1;
    }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "dport { ");
    i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ", "); }
        str_builder_add_int(sb, vec_get(ports, i));
        i = i + 1;
    }
    str_builder_add_cstr(sb, " }");

    rule_add_match(r, match_protocol(proto));
    rule_add_match(r, match_raw(str_cstr(str_builder_build(sb))));
    return Ok(r);
}

# `ip saddr { a1, a2, ... }`
fn rule_matching_addrs(r: i64, addrs: i64): i64 {
    return _rule_addr_set(r, addrs, "ip saddr { ");
}

# `ip6 saddr { a1, a2, ... }`
fn rule_matching_addrs6(r: i64, addrs: i64): i64 {
    return _rule_addr_set(r, addrs, "ip6 saddr { ");
}

# ================================================================
# Hex rendering helper (stdlib lacks _sb_add_hex)
# ================================================================

fn _sb_add_hex(sb, val) {
    if (val == 0) {
        str_builder_add_cstr(sb, "0");
        return 0;
    }
    var buf[20];
    var pos = 19;
    store8(&buf + pos, 0);
    var n = val;
    while (n > 0) {
        pos = pos - 1;
        var digit = n & 15;
        if (digit < 10) {
            store8(&buf + pos, 48 + digit);
        } else {
            store8(&buf + pos, 97 + digit - 10);
        }
        n = n >> 4;
    }
    str_builder_add_cstr(sb, &buf + pos);
    return 0;
}

# ================================================================
# Render — match to nftables string
# ================================================================

# `cf`: 0 to render as written, or the table's family to render as nft lists
# it (see "Canonical spellings" above).
fn _render_match(sb, m, cf) {
    var mt = match_type(m);
    var v1 = match_val1(m);
    var v2 = match_val2(m);
    var v3 = match_val3(m);

    if (mt == MATCH_SOURCE_ADDR) {
        str_builder_add_cstr(sb, "ip saddr ");
        _sb_add_match_addr(sb, v1, cf);
    } elif (mt == MATCH_DEST_ADDR) {
        str_builder_add_cstr(sb, "ip daddr ");
        _sb_add_match_addr(sb, v1, cf);
    } elif (mt == MATCH_SOURCE_ADDR6) {
        str_builder_add_cstr(sb, "ip6 saddr ");
        _sb_add_match_addr(sb, v1, cf);
    } elif (mt == MATCH_DEST_ADDR6) {
        str_builder_add_cstr(sb, "ip6 daddr ");
        _sb_add_match_addr(sb, v1, cf);
    } elif (mt == MATCH_PROTOCOL) {
        str_builder_add_cstr(sb, _proto_str(v1));
    } elif (mt == MATCH_DPORT) {
        str_builder_add_cstr(sb, "dport ");
        str_builder_add_int(sb, v1);
    } elif (mt == MATCH_SPORT) {
        str_builder_add_cstr(sb, "sport ");
        str_builder_add_int(sb, v1);
    } elif (mt == MATCH_DPORT_RANGE) {
        str_builder_add_cstr(sb, "dport ");
        str_builder_add_int(sb, v1);
        str_builder_add_cstr(sb, "-");
        str_builder_add_int(sb, v2);
    } elif (mt == MATCH_IIF) {
        # iifname, not iif (1.8.2, audit I-7/B-11): `iif` resolves the name to
        # an ifindex when the ruleset LOADS, so a rule naming a bridge that does
        # not exist yet fails the whole batch, and one naming a bridge that is
        # later recreated silently stops matching. `iifname` compares the name
        # per packet and survives both.
        str_builder_add_cstr(sb, "iifname \"");
        str_builder_add_cstr(sb, v1);
        str_builder_add_cstr(sb, "\"");
    } elif (mt == MATCH_OIF) {
        str_builder_add_cstr(sb, "oifname \"");
        str_builder_add_cstr(sb, v1);
        str_builder_add_cstr(sb, "\"");
    } elif (mt == MATCH_CT_STATE) {
        var csm = 0;
        if (cf != 0) { csm = _word_list_mask(v1, 1); }
        if (csm != 0) {
            str_builder_add_cstr(sb, "ct state ");
            _sb_add_flag_set(sb, csm, 1, "");
        } else {
            str_builder_add_cstr(sb, "ct state { ");
            str_builder_add_cstr(sb, v1);
            str_builder_add_cstr(sb, " }");
        }
    } elif (mt == MATCH_LIMIT) {
        str_builder_add_cstr(sb, "limit rate ");
        str_builder_add_int(sb, v1);
        str_builder_add_cstr(sb, "/");
        str_builder_add_cstr(sb, _rate_unit_str(v2));
        str_builder_add_cstr(sb, " burst ");
        str_builder_add_int(sb, v3);
        str_builder_add_cstr(sb, " packets");
    } elif (mt == MATCH_SET_LOOKUP) {
        str_builder_add_cstr(sb, v1);
        str_builder_add_cstr(sb, " @");
        str_builder_add_cstr(sb, v2);
    } elif (mt == MATCH_CT_HELPER) {
        str_builder_add_cstr(sb, "ct helper \"");
        str_builder_add_cstr(sb, v1);
        str_builder_add_cstr(sb, "\"");
    } elif (mt == MATCH_TCP_FLAGS) {
        # One flag in braces lists as `tcp flags == syn`: the same test, since
        # a one-element set matches exactly that value.
        var tfm = 0;
        if (cf != 0) { tfm = _word_list_mask(v1, 2); }
        if (tfm != 0) {
            str_builder_add_cstr(sb, "tcp flags ");
            _sb_add_flag_set(sb, tfm, 2, "== ");
        } else {
            str_builder_add_cstr(sb, "tcp flags { ");
            str_builder_add_cstr(sb, v1);
            str_builder_add_cstr(sb, " }");
        }
    } elif (mt == MATCH_ICMP_TYPE) {
        str_builder_add_cstr(sb, "icmp type ");
        str_builder_add_cstr(sb, v1);
    } elif (mt == MATCH_ICMPV6_TYPE) {
        str_builder_add_cstr(sb, "icmpv6 type ");
        str_builder_add_cstr(sb, v1);
    } elif (mt == MATCH_META_MARK) {
        str_builder_add_cstr(sb, "meta mark ");
        if (cf != 0) { _sb_add_hex_fixed(sb, v1, 8); } else { str_builder_add_int(sb, v1); }
    } elif (mt == MATCH_QUOTA) {
        # `until` is nft's default mode, and it lists none.
        str_builder_add_cstr(sb, "quota ");
        if (cf == 0 || v1 != QUOTA_UNTIL) {
            str_builder_add_cstr(sb, _quota_mode_str(v1));
            str_builder_add_cstr(sb, " ");
        }
        _sb_add_quota_amount(sb, v2, v3, cf);
    } elif (mt == MATCH_FLOW_OFFLOAD) {
        str_builder_add_cstr(sb, "flow offload @");
        str_builder_add_cstr(sb, v1);
    } elif (mt == MATCH_CT_TIMEOUT_SET) {
        str_builder_add_cstr(sb, "ct timeout set \"");
        str_builder_add_cstr(sb, v1);
        str_builder_add_cstr(sb, "\"");
    } elif (mt == MATCH_ICMP_TYPE_CODE) {
        str_builder_add_cstr(sb, "icmp type ");
        str_builder_add_cstr(sb, v1);
        str_builder_add_cstr(sb, " icmp code ");
        str_builder_add_int(sb, v2);
    } elif (mt == MATCH_ICMPV6_TYPE_CODE) {
        str_builder_add_cstr(sb, "icmpv6 type ");
        str_builder_add_cstr(sb, v1);
        str_builder_add_cstr(sb, " icmpv6 code ");
        str_builder_add_int(sb, v2);
    } elif (mt == MATCH_VLAN_ID) {
        str_builder_add_cstr(sb, "vlan id ");
        str_builder_add_int(sb, v1);
    } elif (mt == MATCH_DSCP) {
        str_builder_add_cstr(sb, "ip dscp ");
        if (cf != 0) {
            var dn = _dscp_name(v1);
            if (dn != 0) { str_builder_add_cstr(sb, dn); } else { _sb_add_hex_fixed(sb, v1, 2); }
        } else {
            str_builder_add_int(sb, v1);
        }
    } elif (mt == MATCH_IPV6_EXT_HDR) {
        str_builder_add_cstr(sb, "exthdr ");
        str_builder_add_cstr(sb, _ipv6_ext_hdr_str(v1));
        str_builder_add_cstr(sb, " exists");
    } elif (mt == MATCH_FRAG_OFF) {
        str_builder_add_cstr(sb, "ip frag-off & 0x");
        _sb_add_hex(sb, v1);
        str_builder_add_cstr(sb, " ");
        str_builder_add_cstr(sb, _cmp_op_str(v2));
        str_builder_add_cstr(sb, " 0x");
        _sb_add_hex(sb, v3);
    } elif (mt == MATCH_PKT_TYPE) {
        str_builder_add_cstr(sb, "meta pkttype ");
        # nft names unicast `host` (the kernel's PACKET_HOST).
        if (cf != 0 && v1 == PKT_UNICAST) { str_builder_add_cstr(sb, "host"); }
        else { str_builder_add_cstr(sb, _pkt_type_str(v1)); }
    } elif (mt == MATCH_CONN_LIMIT) {
        str_builder_add_cstr(sb, "ct count over ");
        str_builder_add_int(sb, v1);
    } elif (mt == MATCH_RAW) {
        str_builder_add_cstr(sb, v1);
    } else {
        # An unknown match type (1.8.2, audit I-3) used to render NOTHING, so a
        # rule meant to be conditional became an unconditional verdict — in a
        # policy-drop chain, a bare `accept`. rule_validate refuses it; this
        # token makes an unvalidated render fail closed too (nft: syntax error).
        str_builder_add_cstr(sb, "__nein_invalid_match__");
    }
    return 0;
}

# A reject reason as nft lists it: without the `type` keyword, and nothing at
# all for the family's default (`icmp port-unreachable` in an ip table).
fn _reject_reason_canon(r, cf) {
    if (r == REJECT_ICMP_PORT_UNREACH && cf == FAMILY_IP) { return 0; }
    if (r == REJECT_ICMP_HOST_UNREACH) { return "icmp host-unreachable"; }
    if (r == REJECT_ICMP_PORT_UNREACH) { return "icmp port-unreachable"; }
    if (r == REJECT_ICMP_NET_UNREACH) { return "icmp net-unreachable"; }
    if (r == REJECT_ICMP_ADMIN_PROHIB) { return "icmp admin-prohibited"; }
    if (r == REJECT_ICMPX_ADMIN_PROHIB) { return "icmpx admin-prohibited"; }
    return _reject_reason_str(r);
}

# `cf` as for _render_match.
fn _render_verdict(sb, v, cf) {
    var vt = verdict_type(v);
    var v1 = verdict_val1(v);
    var v2 = verdict_val2(v);
    var v3 = verdict_val3(v);
    var v4 = verdict_val4(v);

    if (vt == VERDICT_ACCEPT) {
        str_builder_add_cstr(sb, "accept");
    } elif (vt == VERDICT_DROP) {
        str_builder_add_cstr(sb, "drop");
    } elif (vt == VERDICT_REJECT) {
        str_builder_add_cstr(sb, "reject");
    } elif (vt == VERDICT_REJECT_WITH) {
        str_builder_add_cstr(sb, "reject");
        var rr = _reject_reason_str(v1);
        if (cf != 0) { rr = _reject_reason_canon(v1, cf); }
        if (rr != 0) {
            str_builder_add_cstr(sb, " with ");
            str_builder_add_cstr(sb, rr);
        }
    } elif (vt == VERDICT_JUMP) {
        str_builder_add_cstr(sb, "jump ");
        str_builder_add_cstr(sb, v1);
    } elif (vt == VERDICT_GOTO) {
        str_builder_add_cstr(sb, "goto ");
        str_builder_add_cstr(sb, v1);
    } elif (vt == VERDICT_RETURN) {
        str_builder_add_cstr(sb, "return");
    } elif (vt == VERDICT_LOG) {
        str_builder_add_cstr(sb, "log");
        if (v1 != 0) {
            str_builder_add_cstr(sb, " prefix \"");
            str_builder_add_cstr(sb, v1);
            str_builder_add_cstr(sb, "\"");
        }
    } elif (vt == VERDICT_COUNTER) {
        str_builder_add_cstr(sb, "counter");
    } elif (vt == VERDICT_SET_MARK) {
        str_builder_add_cstr(sb, "meta mark set ");
        if (cf != 0) { _sb_add_hex_fixed(sb, v1, 8); } else { str_builder_add_int(sb, v1); }
    } elif (vt == VERDICT_SET_CT_MARK) {
        str_builder_add_cstr(sb, "ct mark set ");
        if (cf != 0) { _sb_add_hex_fixed(sb, v1, 8); } else { str_builder_add_int(sb, v1); }
    } elif (vt == VERDICT_LOG_ADVANCED) {
        str_builder_add_cstr(sb, "log");
        if (v1 != 0) {
            str_builder_add_cstr(sb, " prefix \"");
            str_builder_add_cstr(sb, v1);
            str_builder_add_cstr(sb, "\"");
        }
        # warn is nft's default level, and it lists none.
        if (v2 != 0 && (cf == 0 || v2 != NFT_LOG_WARN)) {
            str_builder_add_cstr(sb, " level ");
            str_builder_add_cstr(sb, _log_level_str(v2));
        }
        if (v3 != 0) {
            str_builder_add_cstr(sb, " group ");
            str_builder_add_int(sb, v3);
        }
        if (v4 != 0) {
            str_builder_add_cstr(sb, " snaplen ");
            str_builder_add_int(sb, v4);
        }
    } elif (vt == VERDICT_COUNTER_NAMED) {
        str_builder_add_cstr(sb, "counter name \"");
        str_builder_add_cstr(sb, v1);
        str_builder_add_cstr(sb, "\"");
    } elif (vt == VERDICT_NONE) {
        # deliberately nothing
    } else {
        # Unknown verdict type (I-3): rendered nothing through 1.8.1. Fail closed.
        str_builder_add_cstr(sb, "__nein_invalid_verdict__");
    }
    return 0;
}

fn _is_port_match(mt: i64): i64 {
    if (mt == MATCH_DPORT || mt == MATCH_SPORT || mt == MATCH_DPORT_RANGE) { return 1; }
    return 0;
}

# Render a complete rule to nftables syntax string
fn rule_render(r: i64): Str { return _rule_render_cf(r, 0); }

# The rule as nft lists it in a table of family `fam` (1.9.2, audit P-8) —
# what nein_diff compares; see "Canonical spellings".
fn _rule_render_canon(r: i64, fam: i64): Str { return _rule_render_cf(r, fam); }

fn _rule_render_cf(r: i64, cf: i64): Str {
    var sb = str_builder_new();
    var matches = rule_matches(r);
    var len = vec_len(matches);
    var i = 0;
    while (i < len) {
        if (i > 0) { str_builder_add_cstr(sb, " "); }
        var m = vec_get(matches, i);
        var mt = match_type(m);
        # A protocol renders as its bare name ("tcp") only when a port match
        # follows to complete it ("tcp dport 22"); a port match renders bare
        # ("dport 22") only after one. On its own each is an nft syntax error
        # (1.8.2, audit I-7), so a protocol-only rule renders `meta l4proto tcp`
        # and a port with no protocol before it renders `th dport 22`.
        var next_is_port = 0;
        if (i + 1 < len) { next_is_port = _is_port_match(match_type(vec_get(matches, i + 1))); }
        var prev_is_proto = 0;
        if (i > 0) {
            if (match_type(vec_get(matches, i - 1)) == MATCH_PROTOCOL) { prev_is_proto = 1; }
        }
        if (mt == MATCH_PROTOCOL && next_is_port == 0) {
            str_builder_add_cstr(sb, "meta l4proto ");
            # nft lists protocol 58 by its /etc/protocols name, ipv6-icmp.
            if (cf != 0 && match_val1(m) == PROTO_ICMPV6) { str_builder_add_cstr(sb, "ipv6-icmp"); }
            else { str_builder_add_cstr(sb, _proto_str(match_val1(m))); }
        } else {
            if (_is_port_match(mt) == 1 && prev_is_proto == 0) { str_builder_add_cstr(sb, "th "); }
            _render_match(sb, m, cf);
        }
        i = i + 1;
    }

    if (len > 0 && verdict_type(rule_verdict(r)) != VERDICT_NONE) { str_builder_add_cstr(sb, " "); }
    _render_verdict(sb, rule_verdict(r), cf);

    var comment = rule_comment(r);
    if (comment != 0) {
        str_builder_add_cstr(sb, " comment \"");
        str_builder_add_cstr(sb, comment);
        str_builder_add_cstr(sb, "\"");
    }

    return str_builder_build(sb);
}

# ================================================================
# Validate — check all string fields for injection
# ================================================================

# lo <= v <= hi
fn _in_range(v: i64, lo: i64, hi: i64): i64 {
    if (v < lo || v > hi) { return 0; }
    return 1;
}

# Every numeric and enum field of a match type not checked inline in
# rule_validate (1.8.2, audit I-3 / I-8). An unknown match type is refused
# here — through 1.8.1 it rendered nothing — and every enum must be in
# range, because the string helpers fall back silently (an unknown compare
# op became "==", an unknown quota mode "over"): an out-of-range value never
# errored, it became a DIFFERENT valid rule. Numbers that nft would reject
# are refused here too, so the error names the rule instead of failing the
# whole batch at apply.
fn _rule_match_numbers_ok(m: i64): i64 {
    var mt = match_type(m);
    var v1 = match_val1(m);
    var v2 = match_val2(m);
    var v3 = match_val3(m);
    if (_in_range(mt, MATCH_SOURCE_ADDR, MATCH_RAW) == 0) { return 0; }
    if (mt == MATCH_PROTOCOL) { return _in_range(v1, PROTO_TCP, PROTO_ICMPV6); }
    if (mt == MATCH_DPORT || mt == MATCH_SPORT) { return _in_range(v1, 0, 65535); }
    if (mt == MATCH_LIMIT) {
        # nft: rate 0 is EINVAL, and "packet limit burst must be > 0".
        if (_in_range(v1, 1, 0xFFFFFFFF) == 0) { return 0; }
        if (_in_range(v2, RATE_SECOND, RATE_DAY) == 0) { return 0; }
        return _in_range(v3, 1, 0xFFFFFFFF);
    }
    if (mt == MATCH_META_MARK) { return _in_range(v1, 0, 0xFFFFFFFF); }
    if (mt == MATCH_QUOTA) {
        if (_in_range(v1, QUOTA_OVER, QUOTA_UNTIL) == 0) { return 0; }
        if (_in_range(v3, QUNIT_BYTES, QUNIT_GBYTES) == 0) { return 0; }
        # The byte count must fit: gbytes renders as amount * 1024 mbytes, and
        # the diff compares it in bytes (1.9.2).
        return _in_range(v2, 0, 0x7FFFFFFFFFFFFFFF / _quota_unit_bytes(v3));
    }
    if (mt == MATCH_ICMP_TYPE_CODE || mt == MATCH_ICMPV6_TYPE_CODE) { return _in_range(v2, 0, 255); }
    # EXT_AUTH is refused (1.9.2): nft has no exthdr for the AH header —
    # `exthdr auth exists` is a syntax error in nft 1.1.7 (it takes hbh, rt,
    # frag, dst and mh), so a rule with it failed the whole batch at apply.
    if (mt == MATCH_IPV6_EXT_HDR) { return _in_range(v1, EXT_HOP_BY_HOP, EXT_MOBILITY); }
    if (mt == MATCH_FRAG_OFF) {
        # `_sb_add_hex` renders a negative value as a bare "0x" (audit I-8).
        if (_in_range(v1, 0, 0xFFFF) == 0) { return 0; }
        if (_in_range(v2, NFT_CMP_EQ, NFT_CMP_GE) == 0) { return 0; }
        return _in_range(v3, 0, 0xFFFF);
    }
    if (mt == MATCH_PKT_TYPE) { return _in_range(v1, PKT_UNICAST, PKT_MULTICAST); }
    if (mt == MATCH_CONN_LIMIT) { return _in_range(v1, 0, 0xFFFFFFFF); }
    return 1;
}

# Verdict type and its numeric fields (1.8.2, audit I-3 / I-7 / I-8).
fn _rule_verdict_numbers_ok(v: i64): i64 {
    var vt = verdict_type(v);
    if (_in_range(vt, VERDICT_ACCEPT, VERDICT_NONE) == 0) { return 0; }
    if (vt == VERDICT_REJECT_WITH) { return _in_range(verdict_val1(v), REJECT_ICMP_HOST_UNREACH, REJECT_TCP_RESET); }
    if (vt == VERDICT_SET_MARK || vt == VERDICT_SET_CT_MARK) { return _in_range(verdict_val1(v), 0, 0xFFFFFFFF); }
    if (vt == VERDICT_LOG_ADVANCED) {
        var lvl = verdict_val2(v);
        var grp = verdict_val3(v);
        if (_in_range(lvl, 0, NFT_LOG_DEBUG) == 0) { return 0; }
        if (_in_range(grp, 0, 65535) == 0) { return 0; }
        # nft: "level and group are mutually exclusive" (audit I-7).
        if (lvl != 0 && grp != 0) { return 0; }
        return _in_range(verdict_val4(v), 0, 0xFFFFFFFF);
    }
    return 1;
}

fn rule_validate(r: i64): i64 {
    var matches = rule_matches(r);
    var len = vec_len(matches);
    # A rule with no verdict and no matches says nothing (VERDICT_NONE).
    if (len == 0 && verdict_type(rule_verdict(r)) == VERDICT_NONE) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var i = 0;
    var vr = 0;
    while (i < len) {
        var m = vec_get(matches, i);
        var mt = match_type(m);
        var v1 = match_val1(m);
        var v2 = match_val2(m);

        if (mt == MATCH_SOURCE_ADDR || mt == MATCH_DEST_ADDR ||
          mt == MATCH_SOURCE_ADDR6 || mt == MATCH_DEST_ADDR6) {
            var vr1_t, vr1_v = validate_addr(v1);
            if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
            # The address must be the match's own family (1.8.2): `ip saddr
            # 2001:db8::1` is not an address to nft but a HOSTNAME to resolve,
            # so the whole batch failed at apply ("Could not resolve hostname").
            var want = 4;
            if (mt == MATCH_SOURCE_ADDR6 || mt == MATCH_DEST_ADDR6) { want = 6; }
            if (_addr_family(v1) != want) { return nein_err(NEIN_ERR_INVALID_RULE); }
        } elif (mt == MATCH_IIF || mt == MATCH_OIF) {
            var vr2_t, vr2_v = validate_iface(v1);
            if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
        } elif (mt == MATCH_CT_HELPER || mt == MATCH_CT_TIMEOUT_SET) {
            # Rendered quoted (`ct helper "x"`), so an nft keyword is a name here.
            var vr3_t, vr3_v = validate_identifier(v1);
            if (is_err_result(vr3_t) == 1) { return Err(vr3_v); }
        } elif (mt == MATCH_FLOW_OFFLOAD) {
            # `flow offload @NAME`: a name nft can read after '@' (1.9.1, I-10).
            var vr4_t, vr4_v = validate_nft_name(v1);
            if (is_err_result(vr4_t) == 1) { return Err(vr4_v); }
            if (_nft_ref_reserved(v1, 1) == 1) { return nein_err(NEIN_ERR_INVALID_RULE); }
        } elif (mt == MATCH_SET_LOOKUP) {
            # Closed set of selectors (1.8.2, audit I-2) — see _is_set_lookup_field.
            if (_is_set_lookup_field(v1) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
            var vr5_t, vr5_v = validate_nft_name(v2);
            if (is_err_result(vr5_t) == 1) { return Err(vr5_v); }
            if (_nft_ref_reserved(v2, 0) == 1) { return nein_err(NEIN_ERR_INVALID_RULE); }
        } elif (mt == MATCH_ICMP_TYPE || mt == MATCH_ICMPV6_TYPE) {
            var vr6_t, vr6_v = validate_identifier(v1);
            if (is_err_result(vr6_t) == 1) { return Err(vr6_v); }
        } elif (mt == MATCH_ICMP_TYPE_CODE || mt == MATCH_ICMPV6_TYPE_CODE) {
            var vr7_t, vr7_v = validate_identifier(v1);
            if (is_err_result(vr7_t) == 1) { return Err(vr7_v); }
        } elif (mt == MATCH_TCP_FLAGS) {
            var vr8_t, vr8_v = validate_nft_element(v1);
            if (is_err_result(vr8_t) == 1) { return Err(vr8_v); }
        } elif (mt == MATCH_CT_STATE) {
            # Was MISSING entirely before 1.6.9 — _render_match interpolates
            # this straight into `ct state { ... }`, so an unchecked value
            # could close the brace and append arbitrary nft statements.
            var vr9_t, vr9_v = validate_ct_state_list(v1);
            if (is_err_result(vr9_t) == 1) { return Err(vr9_v); }
        } elif (mt == MATCH_DSCP) {
            if (_in_range(v1, 0, 63) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
        } elif (mt == MATCH_VLAN_ID) {
            if (_in_range(v1, 0, 4094) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
        } elif (mt == MATCH_DPORT_RANGE) {
            if (_in_range(v1, 0, 65535) == 0 || _in_range(v2, v1, 65535) == 0) {
                return nein_err(NEIN_ERR_INVALID_RULE);
            }
        } elif (mt == MATCH_RAW) {
            # Deliberately not validated — caller's responsibility
        } elif (_rule_match_numbers_ok(m) == 0) {
            return nein_err(NEIN_ERR_INVALID_RULE);
        }

        i = i + 1;
    }

    # Validate verdict strings
    var v = rule_verdict(r);
    var vt = verdict_type(v);
    if (_rule_verdict_numbers_ok(v) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (vt == VERDICT_JUMP || vt == VERDICT_GOTO) {
        var vr10_t, vr10_v = validate_nft_name(verdict_val1(v));
        if (is_err_result(vr10_t) == 1) { return Err(vr10_v); }
    } elif (vt == VERDICT_LOG) {
        if (verdict_val1(v) != 0) {
            var vr11_t, vr11_v = validate_log_prefix(verdict_val1(v));
            if (is_err_result(vr11_t) == 1) { return Err(vr11_v); }
        }
    } elif (vt == VERDICT_LOG_ADVANCED) {
        if (verdict_val1(v) != 0) {
            var vr12_t, vr12_v = validate_log_prefix(verdict_val1(v));
            if (is_err_result(vr12_t) == 1) { return Err(vr12_v); }
        }
    } elif (vt == VERDICT_COUNTER_NAMED) {
        var vr13_t, vr13_v = validate_identifier(verdict_val1(v));
        if (is_err_result(vr13_t) == 1) { return Err(vr13_v); }
    }

    # Validate comment
    var comment = rule_comment(r);
    if (comment != 0) {
        var vr14_t, vr14_v = validate_comment(comment);
        if (is_err_result(vr14_t) == 1) { return Err(vr14_v); }
    }

    return nein_ok();
}

# ================================================================
# Family — what a table of each family can hold (1.9.3)
# ================================================================
# rule_validate judges a rule on its own; nft judges it in its table's family,
# and refuses `ip saddr` in an ip6 table, conntrack in an arp or netdev one,
# `reject with icmpx` in an ip one. Through 1.9.2 such a rule validated and the
# whole batch failed at apply. firewall_validate now asks these, with the
# table's family. Every answer was probed against nft 1.1.7 (each match and
# verdict alone in a table of each family: tests/integration/nft_family.tcyr),
# not read from the man page. Families are FAMILY_* (table.cyr).

# The rule's ip payload (saddr / daddr, dscp, frag-off) can load: not in ip6
# or arp tables.
fn _fam_has_ip(fam: i64): i64 {
    if (fam == FAMILY_IP6 || fam == FAMILY_ARP) { return 0; }
    return 1;
}

# ip6 payload and extension headers: not in ip or arp tables.
fn _fam_has_ip6(fam: i64): i64 {
    if (fam == FAMILY_IP || fam == FAMILY_ARP) { return 0; }
    return 1;
}

# Transport and icmp headers (`tcp dport`, `tcp flags`, `icmp type`): not in
# arp tables. `th dport` and `meta l4proto` load everywhere.
fn _fam_has_l4(fam: i64): i64 {
    if (fam == FAMILY_ARP) { return 0; }
    return 1;
}

# Conntrack (`ct state`, `ct helper`, `ct count`, `ct mark set`, ct timeouts):
# not in arp or netdev tables (the kernel answers "Protocol error").
fn _fam_has_ct(fam: i64): i64 {
    if (fam == FAMILY_ARP || fam == FAMILY_NETDEV) { return 0; }
    return 1;
}

# Flowtables and `flow offload`: inet, ip and ip6 tables only.
fn _fam_has_flowtable(fam: i64): i64 {
    if (fam == FAMILY_INET || fam == FAMILY_IP || fam == FAMILY_IP6) { return 1; }
    return 0;
}

# A set lookup's selector (validate.cyr's closed set) in a table of family
# `fam`; `th`, `meta l4proto` and the interface names load everywhere.
fn _set_field_family_ok(field: cstring, fam: i64): i64 {
    if (streq(field, "ip saddr") == 1 || streq(field, "ip daddr") == 1) { return _fam_has_ip(fam); }
    if (streq(field, "ip6 saddr") == 1 || streq(field, "ip6 daddr") == 1) { return _fam_has_ip6(fam); }
    if (streq(field, "tcp dport") == 1 || streq(field, "tcp sport") == 1
      || streq(field, "udp dport") == 1 || streq(field, "udp sport") == 1) {
        return _fam_has_l4(fam);
    }
    return 1;
}

# Rule `r` in a table of family `fam`: -1 when nft refuses it there, else 1
# when it holds a statement only some hooks take (a reject, a flow offload:
# see chain.cyr's _chain_rule_context_ok) and 0 when it holds none. One scan
# of the matches answers both, as firewall_validate asks both of every rule.
fn _rule_family_needs(r: i64, fam: i64): i64 {
    var needs = 0;
    var matches = rule_matches(r);
    var len = vec_len(matches);
    var i = 0;
    if (fam == FAMILY_INET) {
        # An inet table takes every match and verdict nein renders (the probe
        # found no refusal there), so only the hook needs are left to find.
        while (i < len) {
            if (match_type(vec_get(matches, i)) == MATCH_FLOW_OFFLOAD) { return 1; }
            i = i + 1;
        }
        var ivt = verdict_type(rule_verdict(r));
        if (ivt == VERDICT_REJECT || ivt == VERDICT_REJECT_WITH) { return 1; }
        return 0;
    }
    while (i < len) {
        var m = vec_get(matches, i);
        var mt = match_type(m);
        var ok = 1;
        if (mt == MATCH_SOURCE_ADDR || mt == MATCH_DEST_ADDR || mt == MATCH_DSCP || mt == MATCH_FRAG_OFF) {
            ok = _fam_has_ip(fam);
        } elif (mt == MATCH_SOURCE_ADDR6 || mt == MATCH_DEST_ADDR6 || mt == MATCH_IPV6_EXT_HDR) {
            ok = _fam_has_ip6(fam);
        } elif (mt == MATCH_PROTOCOL) {
            # Bare `tcp` before a port is the transport header; alone it renders
            # `meta l4proto tcp`, which loads everywhere.
            if (i + 1 < len) {
                if (_is_port_match(match_type(vec_get(matches, i + 1))) == 1) { ok = _fam_has_l4(fam); }
            }
        } elif (mt == MATCH_TCP_FLAGS || mt == MATCH_ICMP_TYPE || mt == MATCH_ICMPV6_TYPE
          || mt == MATCH_ICMP_TYPE_CODE || mt == MATCH_ICMPV6_TYPE_CODE) {
            ok = _fam_has_l4(fam);
        } elif (mt == MATCH_CT_STATE || mt == MATCH_CT_HELPER || mt == MATCH_CONN_LIMIT
          || mt == MATCH_CT_TIMEOUT_SET) {
            ok = _fam_has_ct(fam);
        } elif (mt == MATCH_SET_LOOKUP) {
            ok = _set_field_family_ok(match_val1(m), fam);
        } elif (mt == MATCH_FLOW_OFFLOAD) {
            ok = _fam_has_flowtable(fam);
            needs = 1;
        }
        if (ok == 0) { return 0 - 1; }
        i = i + 1;
    }
    var v = rule_verdict(r);
    var vt = verdict_type(v);
    if (vt == VERDICT_REJECT || vt == VERDICT_REJECT_WITH) {
        if (fam == FAMILY_ARP) { return 0 - 1; }   # "cannot use reject with arp"
        if (vt == VERDICT_REJECT_WITH) {
            var why = verdict_val1(v);
            # icmpx is the inet / bridge / netdev abstraction: "abstracted ICMP
            # unreachable not supported" in ip and ip6 tables.
            if (why == REJECT_ICMPX_ADMIN_PROHIB && (fam == FAMILY_IP || fam == FAMILY_IP6)) { return 0 - 1; }
            # An ICMPv4 reason in an ip6 table: "conflicting protocols".
            if (why != REJECT_ICMPX_ADMIN_PROHIB && why != REJECT_TCP_RESET && fam == FAMILY_IP6) { return 0 - 1; }
        }
        needs = 1;
    }
    if (vt == VERDICT_SET_CT_MARK && _fam_has_ct(fam) == 0) { return 0 - 1; }
    return needs;
}

# ================================================================
# Convenience functions
# ================================================================

fn allow_tcp(port: i64): i64 {
    var r = rule_new(verdict_accept());
    rule_add_match(r, match_protocol(PROTO_TCP));
    rule_add_match(r, match_dport(port));
    return r;
}

fn allow_udp(port: i64): i64 {
    var r = rule_new(verdict_accept());
    rule_add_match(r, match_protocol(PROTO_UDP));
    rule_add_match(r, match_dport(port));
    return r;
}

fn allow_established(): i64 {
    var r = rule_new(verdict_accept());
    rule_add_match(r, match_ct_state("established, related"));
    return r;
}

fn deny_source(cidr: cstring): i64 {
    var r = rule_new(verdict_drop());
    rule_add_match(r, _match_addr(cidr, 0));
    return r;
}

fn deny_source6(cidr: cstring): i64 {
    var r = rule_new(verdict_drop());
    rule_add_match(r, match_source_addr6(cidr));
    return r;
}

fn allow_service(source_cidr: cstring, protocol: i64, port: i64): i64 {
    var r = rule_new(verdict_accept());
    rule_add_match(r, _match_addr(source_cidr, 0));
    rule_add_match(r, match_protocol(protocol));
    rule_add_match(r, match_dport(port));
    return r;
}

fn rate_limit_tcp(port: i64, rate: i64, unit: i64): i64 {
    var r = rule_new(verdict_accept());
    rule_add_match(r, match_protocol(PROTO_TCP));
    rule_add_match(r, match_dport(port));
    rule_add_match(r, match_limit(rate, unit, rate));
    return r;
}

fn rate_limit_udp(port: i64, rate: i64, unit: i64): i64 {
    var r = rule_new(verdict_accept());
    rule_add_match(r, match_protocol(PROTO_UDP));
    rule_add_match(r, match_dport(port));
    rule_add_match(r, match_limit(rate, unit, rate));
    return r;
}

fn rate_limit_quic(port: i64, rate: i64, unit: i64): i64 {
    var r = rule_new(verdict_accept());
    rule_add_match(r, match_protocol(PROTO_UDP));
    rule_add_match(r, match_dport(port));
    rule_add_match(r, match_limit(rate, unit, rate * 2));
    rule_set_comment(r, "quic rate limit");
    return r;
}

# --- set.cyr ---

# nein set module — named sets and verdict maps

# ================================================================
# Enums
# ================================================================

enum SetTypeEnum {
    SET_IPV4_ADDR = 1;
    SET_IPV6_ADDR = 2;
    SET_INET_SERVICE = 3;
    SET_INET_PROTO = 4;
    SET_IFNAME = 5;
}

enum SetFlagEnum {
    SETFLAG_CONSTANT = 1;
    SETFLAG_INTERVAL = 2;
    SETFLAG_TIMEOUT = 3;
}

enum MapVerdictEnum {
    MAPV_ACCEPT = 1;
    MAPV_DROP = 2;
    MAPV_JUMP = 3;
}

fn _set_type_str(t: i64): cstring {
    if (t == SET_IPV4_ADDR) { return "ipv4_addr"; }
    if (t == SET_IPV6_ADDR) { return "ipv6_addr"; }
    if (t == SET_INET_SERVICE) { return "inet_service"; }
    if (t == SET_INET_PROTO) { return "inet_proto"; }
    if (t == SET_IFNAME) { return "ifname"; }
    # Unknown types rendered as "ipv4_addr" through 1.8.1 — a silent default
    # (audit I-3). Validation refuses them; an unvalidated render fails closed.
    return "__nein_invalid_set_type__";
}

fn _set_flag_str(f: i64): cstring {
    if (f == SETFLAG_CONSTANT) { return "constant"; }
    if (f == SETFLAG_INTERVAL) { return "interval"; }
    if (f == SETFLAG_TIMEOUT) { return "timeout"; }
    return "__nein_invalid_set_flag__";
}

# One set element or map key, checked against the set's KEY TYPE (1.8.2,
# audit I-1). Through 1.8.1 elements and keys only had to pass
# validate_nft_element, which allows ',' ':' and spaces, so one map key
# "22 : accept, 23" rendered `elements = { 22 : accept, 23 : drop }` — a
# key that carried its own extra entries and verdicts, applied by nft. Each
# check below admits exactly one value of the key type and nothing else.
fn _set_value_ok(stype: i64, v: cstring): i64 {
    if (v == 0) { return 0; }
    var len = strlen(v);
    if (len == 0 || len > 100) { return 0; }
    if (stype == SET_IPV4_ADDR || stype == SET_IPV6_ADDR) {
        var want = 4;
        if (stype == SET_IPV6_ADDR) { want = 6; }
        var dash = memchr(v, 45, len);
        if (dash < 0) {
            if (_addr_family(v) == want) { return 1; }
            return 0;
        }
        # An address range "a-b" (interval sets): each end one address.
        var lo = alloc(dash + 1);
        memcpy(lo, v, dash);
        store8(lo + dash, 0);
        if (_addr_family(lo) != want) { return 0; }
        if (_addr_family(v + dash + 1) != want) { return 0; }
        if (memchr(lo, 47, dash) >= 0) { return 0; }        # no prefix inside a range
        return 1;
    }
    if (stype == SET_INET_SERVICE) {
        if (_is_port_token(v) == 1) { return 1; }
        # or a service name nft resolves from /etc/services ("ssh")
        var c = load8(v);
        if (c < 97 || c > 122) { return 0; }
        var vs_t, vs_v = validate_identifier(v);
        if (is_err_result(vs_t) == 1) { return 0; }
        return 1;
    }
    if (stype == SET_INET_PROTO) {
        if (_parse_dec(v, 0, len, 3, 255) == len) { return 1; }
        var c2 = load8(v);
        if (c2 < 97 || c2 > 122) { return 0; }
        var vp_t, vp_v = validate_identifier(v);
        if (is_err_result(vp_t) == 1) { return 0; }
        return 1;
    }
    if (stype == SET_IFNAME) {
        var vi_t, vi_v = validate_iface(v);
        if (is_err_result(vi_t) == 1) { return 0; }
        return 1;
    }
    return 0;
}

# ================================================================
# NftSet — { name, set_type, flags(vec), elements(vec) }
# Layout: [name:8][set_type:8][flags:8][elements:8] = 32 bytes
# ================================================================

fn nft_set_new(name: cstring, stype: i64): i64 {
    var s = alloc(32);
    store64(s, name);
    store64(s + 8, stype);
    store64(s + 16, vec_new());
    store64(s + 24, vec_new());
    return s;
}

fn nft_set_name(s: i64): i64 { return load64(s); }
fn nft_set_type(s: i64): i64 { return load64(s + 8); }
fn nft_set_flags(s: i64): i64 { return load64(s + 16); }
fn nft_set_elements(s: i64): i64 { return load64(s + 24); }

fn nft_set_add_flag(s: i64, flag: i64): i64 {
    vec_push(load64(s + 16), flag);
    return s;
}

fn nft_set_add_element(s: i64, elem: cstring): i64 {
    vec_push(load64(s + 24), elem);
    return s;
}

fn nft_set_add_elements(s: i64, elems: i64): i64 {
    var elen = vec_len(elems);
    var i = 0;
    while (i < elen) {
        vec_push(load64(s + 24), vec_get(elems, i));
        i = i + 1;
    }
    return s;
}

fn nft_set_validate(s: i64): i64 {
    var vr1_t, vr1_v = validate_nft_name(nft_set_name(s));
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    var stype = nft_set_type(s);
    if (stype < SET_IPV4_ADDR || stype > SET_IFNAME) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var flags = nft_set_flags(s);
    var fi = 0;
    while (fi < vec_len(flags)) {
        var f = vec_get(flags, fi);
        if (f < SETFLAG_CONSTANT || f > SETFLAG_TIMEOUT) { return nein_err(NEIN_ERR_INVALID_RULE); }
        fi = fi + 1;
    }
    var elems = nft_set_elements(s);
    var elen = vec_len(elems);
    var i = 0;
    while (i < elen) {
        if (_set_value_ok(stype, vec_get(elems, i)) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
        i = i + 1;
    }
    return nein_ok();
}

# An element or map key of type `stype`. An interface name is quoted (1.9.1):
# bare, nft reads `vxlan`, `bridge`, `gre` or `3eth` as a keyword or a number
# and refuses the batch; quoted it is the name. _set_value_ok has already held
# it to validate_iface, which keeps quotes out.
fn _set_add_value(sb: i64, stype: i64, v: cstring): i64 {
    if (stype == SET_IFNAME) {
        str_builder_add_cstr(sb, "\"");
        str_builder_add_cstr(sb, v);
        str_builder_add_cstr(sb, "\"");
        return 0;
    }
    str_builder_add_cstr(sb, v);
    return 0;
}

fn nft_set_render(s: i64): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "  set ");
    str_builder_add_cstr(sb, nft_set_name(s));
    str_builder_add_cstr(sb, " {\n");
    str_builder_add_cstr(sb, "    type ");
    str_builder_add_cstr(sb, _set_type_str(nft_set_type(s)));
    str_builder_add_cstr(sb, ";\n");

    var flags = nft_set_flags(s);
    var flen = vec_len(flags);
    if (flen > 0) {
        str_builder_add_cstr(sb, "    flags ");
        var i = 0;
        while (i < flen) {
            if (i > 0) { str_builder_add_cstr(sb, ", "); }
            str_builder_add_cstr(sb, _set_flag_str(vec_get(flags, i)));
            i = i + 1;
        }
        str_builder_add_cstr(sb, ";\n");
    }

    var elems = nft_set_elements(s);
    var elen = vec_len(elems);
    if (elen > 0) {
        str_builder_add_cstr(sb, "    elements = { ");
        var i = 0;
        while (i < elen) {
            if (i > 0) { str_builder_add_cstr(sb, ", "); }
            _set_add_value(sb, nft_set_type(s), vec_get(elems, i));
            i = i + 1;
        }
        str_builder_add_cstr(sb, " };\n");
    }

    str_builder_add_cstr(sb, "  }\n");
    return str_builder_build(sb);
}

# ================================================================
# NftMap — { name, key_type, entries(vec of key/verdict pairs) }
# Entry: [key:8][verdict_type:8][verdict_val:8] = 24 bytes
# ================================================================

fn _map_entry_new(key: cstring, vtype: i64, vval: i64): i64 {
    var e = alloc(24);
    store64(e, key);
    store64(e + 8, vtype);
    store64(e + 16, vval);
    return e;
}

fn nft_map_new(name: cstring, ktype: i64): i64 {
    var m = alloc(24);
    store64(m, name);
    store64(m + 8, ktype);
    store64(m + 16, vec_new());
    return m;
}

fn nft_map_name(m: i64): i64 { return load64(m); }
fn nft_map_key_type(m: i64): i64 { return load64(m + 8); }
fn nft_map_entries(m: i64): i64 { return load64(m + 16); }

fn nft_map_add_entry(m: i64, key: cstring, vtype: i64, vval: i64): i64 {
    vec_push(load64(m + 16), _map_entry_new(key, vtype, vval));
    return m;
}

fn nft_map_validate(m: i64): i64 {
    var vr1_t, vr1_v = validate_nft_name(nft_map_name(m));
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    var ktype = nft_map_key_type(m);
    if (ktype < SET_IPV4_ADDR || ktype > SET_IFNAME) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var entries = nft_map_entries(m);
    var elen = vec_len(entries);
    var i = 0;
    while (i < elen) {
        var e = vec_get(entries, i);
        if (_set_value_ok(ktype, load64(e)) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
        var mv = load64(e + 8);
        if (mv < MAPV_ACCEPT || mv > MAPV_JUMP) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if (mv == MAPV_JUMP) {
            var vr3_t, vr3_v = validate_nft_name(load64(e + 16));
            if (is_err_result(vr3_t) == 1) { return Err(vr3_v); }
        }
        i = i + 1;
    }
    return nein_ok();
}

fn nft_map_render(m: i64): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "  map ");
    str_builder_add_cstr(sb, nft_map_name(m));
    str_builder_add_cstr(sb, " {\n");
    str_builder_add_cstr(sb, "    type ");
    str_builder_add_cstr(sb, _set_type_str(nft_map_key_type(m)));
    str_builder_add_cstr(sb, " : verdict;\n");

    var entries = nft_map_entries(m);
    var elen = vec_len(entries);
    if (elen > 0) {
        str_builder_add_cstr(sb, "    elements = { ");
        var i = 0;
        while (i < elen) {
            if (i > 0) { str_builder_add_cstr(sb, ", "); }
            var e = vec_get(entries, i);
            _set_add_value(sb, nft_map_key_type(m), load64(e));
            str_builder_add_cstr(sb, " : ");
            var vt = load64(e + 8);
            if (vt == MAPV_ACCEPT) { str_builder_add_cstr(sb, "accept"); }
            elif (vt == MAPV_DROP) { str_builder_add_cstr(sb, "drop"); }
            elif (vt == MAPV_JUMP) {
                str_builder_add_cstr(sb, "jump ");
                str_builder_add_cstr(sb, load64(e + 16));
            }
            i = i + 1;
        }
        str_builder_add_cstr(sb, " };\n");
    }

    str_builder_add_cstr(sb, "  }\n");
    return str_builder_build(sb);
}

# --- nat.cyr ---

# nein nat module — NAT rules (DNAT, SNAT, masquerade, redirect)
#
# NatRule as tagged union struct — 5 variants share same layout:
# { type, val1..val6 } — 56 bytes total.

enum NatType {
    NAT_DNAT = 1;
    NAT_SNAT = 2;
    NAT_MASQUERADE = 3;
    NAT_REDIRECT = 4;
    NAT_DNAT_RANGE = 5;
}

# NatRule layout (56 bytes):
#   [type:8][v1:8][v2:8][v3:8][v4:8][v5:8][v6:8]
#
# DNAT:           type=NAT_DNAT, v1=protocol, v2=dest_port, v3=to_addr, v4=to_port, v5=comment, v6=0
# SNAT:           type=NAT_SNAT, v1=source_cidr, v2=to_addr, v3=comment, v4=0, v5=0, v6=0
# MASQUERADE:     type=NAT_MASQUERADE, v1=source_cidr, v2=oif (0 if none), v3=comment, v4=0, v5=0, v6=0
# REDIRECT:       type=NAT_REDIRECT, v1=protocol, v2=dest_port, v3=to_port, v4=comment, v5=0, v6=0
# DNAT_RANGE:     type=NAT_DNAT_RANGE, v1=protocol, v2=dest_port_start, v3=dest_port_end,
#                 v4=to_addr, v5=to_port_start, v6=to_port_end (comment stored in v7 needs extra field)
#
# DNAT_RANGE needs 7 fields; we'll allocate 64 bytes for all for simplicity.

fn nat_new(ntype: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64): i64 {
    var n = alloc(64);
    store64(n, ntype);
    store64(n + 8, v1);
    store64(n + 16, v2);
    store64(n + 24, v3);
    store64(n + 32, v4);
    store64(n + 40, v5);
    store64(n + 48, v6);
    store64(n + 56, 0);
    return n;
}

fn nat_type(n: i64): i64 { return load64(n); }
fn nat_v1(n: i64): i64 { return load64(n + 8); }
fn nat_v2(n: i64): i64 { return load64(n + 16); }
fn nat_v3(n: i64): i64 { return load64(n + 24); }
fn nat_v4(n: i64): i64 { return load64(n + 32); }
fn nat_v5(n: i64): i64 { return load64(n + 40); }
fn nat_v6(n: i64): i64 { return load64(n + 48); }
fn nat_v7(n: i64): i64 { return load64(n + 56); }
fn nat_set_v7(n: i64, val: i64): i64 { store64(n + 56, val); return n; }

# --- Constructors ---

fn nat_dnat(protocol: i64, dest_port: i64, to_addr: cstring, to_port: i64, comment: cstring): i64 {
    return nat_new(NAT_DNAT, protocol, dest_port, to_addr, to_port, comment, 0);
}

fn nat_snat(source_cidr: cstring, to_addr: cstring, comment: cstring): i64 {
    return nat_new(NAT_SNAT, source_cidr, to_addr, comment, 0, 0, 0);
}

fn nat_masquerade(source_cidr: cstring, oif: cstring, comment: cstring): i64 {
    return nat_new(NAT_MASQUERADE, source_cidr, oif, comment, 0, 0, 0);
}

fn nat_redirect(protocol: i64, dest_port: i64, to_port: i64, comment: cstring): i64 {
    return nat_new(NAT_REDIRECT, protocol, dest_port, to_port, comment, 0, 0);
}

fn nat_dnat_range(protocol: i64, dest_port_start: i64, dest_port_end: i64,
  to_addr: cstring, to_port_start: i64, to_port_end: i64,
  comment: cstring): i64 {
    var n = nat_new(NAT_DNAT_RANGE, protocol, dest_port_start, dest_port_end, to_addr, to_port_start, to_port_end);
    nat_set_v7(n, comment);
    return n;
}

# --- Helper: check if an address contains ':' (IPv6) ---
fn _addr_has_colon(s: cstring): i64 {
    var len = strlen(s);
    var i = 0;
    while (i < len) {
        if (load8(s + i) == 58) { return 1; }   # ':'
        i = i + 1;
    }
    return 0;
}

# The network-layer keyword for an address: "ip6" for IPv6, "ip" otherwise.
fn _nat_l3(addr: cstring): cstring {
    if (_addr_has_colon(addr) == 1) { return "ip6"; }
    return "ip";
}

# --- Render ---
#
# Three 1.8.2 changes (docs/audit/2026-11-03-audit.md):
#
#   B-1 (HIGH)  Every DNAT is scoped with `fib daddr type local`. A host port
#               mapping rendered `tcp dport 80 dnat to 172.17.1.2:80` with no
#               destination scope, so in prerouting it rewrote EVERY routed
#               packet to port 80, whatever its real destination — verified
#               live: a LAN client fetching an external site got the container,
#               and other containers' own outbound port-80 traffic broke. Docker
#               scopes the same rule with `-m addrtype --dst-type LOCAL`.
#   I-4         A port range that SHIFTS (host 8000-8010 -> container 9000-9010)
#               renders an explicit `tcp dport map`. `dnat to A:9000-9010`
#               without the kernel's offset flag picks the first free port in
#               the range for every connection — verified by packet test: 8000,
#               8005 and 8010 all reached 9000. nft 1.1.7 has no port-shift
#               syntax, so the map is the only correct form. An unshifted range
#               renders `dnat ... to A`, which keeps each packet's own port.
#   I-7         `dnat` / `snat` name their family (`dnat ip to`, `dnat ip6 to`),
#               which an `inet` table requires; SNAT and masquerade match
#               `ip6 saddr` for an IPv6 source (both hardcoded `ip saddr`); and
#               masquerade matches `oifname` (load-time `oif` fails on an absent
#               interface).

fn _nat_comment(sb: i64, c: cstring): i64 {
    if (c != 0) {
        str_builder_add_cstr(sb, " comment \"");
        str_builder_add_cstr(sb, c);
        str_builder_add_cstr(sb, "\"");
    }
    return 0;
}

fn nat_render(n: i64): Str { return _nat_render_cf(n, 0); }

# The NAT rule as nft lists it in a table of family `fam` (1.9.2, audit P-8):
# what nein_diff compares. nft drops the `ip` / `ip6` after dnat / snat in a
# table of one family (`dnat to`), lists addresses in canonical form, brackets
# an IPv6 target only when a port or a map follows it, and joins the map to the
# address (`172.17.0.3:tcp dport map { ... }`). See rule.cyr's "Canonical
# spellings".
fn _nat_render_canon(n: i64, fam: i64): Str { return _nat_render_cf(n, fam); }

# The `ip` / `ip6` after dnat / snat: kept as written, and under `cf` only in
# a table that holds both families.
fn _nat_l3_cf(sb: i64, addr: cstring, cf: i64): i64 {
    if (cf == FAMILY_IP || cf == FAMILY_IP6) { return 0; }
    str_builder_add_cstr(sb, _nat_l3(addr));
    str_builder_add_cstr(sb, " ");
    return 0;
}

# A NAT address: as written, or canonical under `cf`; an IPv6 one bracketed
# when `bracket` (a port or map follows).
fn _sb_add_nat_addr(sb: i64, addr: cstring, cf: i64, bracket: i64): i64 {
    var a = addr;
    if (cf != 0) {
        var c = _addr_canon(addr);
        if (c != 0) { a = c; }
    }
    if (bracket == 1 && _addr_has_colon(a) == 1) {
        str_builder_add_cstr(sb, "[");
        str_builder_add_cstr(sb, a);
        str_builder_add_cstr(sb, "]");
    } else {
        str_builder_add_cstr(sb, a);
    }
    return 0;
}

fn _nat_render_cf(n: i64, cf: i64): Str {
    var sb = str_builder_new();
    var nt = nat_type(n);

    if (nt == NAT_DNAT) {
        str_builder_add_cstr(sb, "fib daddr type local ");
        str_builder_add_cstr(sb, _proto_str(nat_v1(n)));
        str_builder_add_cstr(sb, " dport ");
        str_builder_add_int(sb, nat_v2(n));
        str_builder_add_cstr(sb, " dnat ");
        _nat_l3_cf(sb, nat_v3(n), cf);
        str_builder_add_cstr(sb, "to ");
        _sb_add_nat_addr(sb, nat_v3(n), cf, 1);
        str_builder_add_cstr(sb, ":");
        str_builder_add_int(sb, nat_v4(n));
        _nat_comment(sb, nat_v5(n));
    } elif (nt == NAT_SNAT) {
        str_builder_add_cstr(sb, _nat_l3(nat_v1(n)));
        str_builder_add_cstr(sb, " saddr ");
        _sb_add_nat_addr(sb, nat_v1(n), cf, 0);
        str_builder_add_cstr(sb, " snat ");
        _nat_l3_cf(sb, nat_v2(n), cf);
        str_builder_add_cstr(sb, "to ");
        _sb_add_nat_addr(sb, nat_v2(n), cf, 0);
        _nat_comment(sb, nat_v3(n));
    } elif (nt == NAT_MASQUERADE) {
        str_builder_add_cstr(sb, _nat_l3(nat_v1(n)));
        str_builder_add_cstr(sb, " saddr ");
        _sb_add_nat_addr(sb, nat_v1(n), cf, 0);
        if (nat_v2(n) != 0) {
            str_builder_add_cstr(sb, " oifname \"");
            str_builder_add_cstr(sb, nat_v2(n));
            str_builder_add_cstr(sb, "\"");
        }
        str_builder_add_cstr(sb, " masquerade");
        _nat_comment(sb, nat_v3(n));
    } elif (nt == NAT_REDIRECT) {
        str_builder_add_cstr(sb, _proto_str(nat_v1(n)));
        str_builder_add_cstr(sb, " dport ");
        str_builder_add_int(sb, nat_v2(n));
        str_builder_add_cstr(sb, " redirect to :");
        str_builder_add_int(sb, nat_v3(n));
        _nat_comment(sb, nat_v4(n));
    } elif (nt == NAT_DNAT_RANGE) {
        var proto = _proto_str(nat_v1(n));
        var dps = nat_v2(n);
        var dpe = nat_v3(n);
        var tps = nat_v5(n);
        str_builder_add_cstr(sb, "fib daddr type local ");
        str_builder_add_cstr(sb, proto);
        str_builder_add_cstr(sb, " dport ");
        str_builder_add_int(sb, dps);
        str_builder_add_cstr(sb, "-");
        str_builder_add_int(sb, dpe);
        str_builder_add_cstr(sb, " dnat ");
        _nat_l3_cf(sb, nat_v4(n), cf);
        str_builder_add_cstr(sb, "to ");
        # As written, an IPv6 target is always bracketed; canonical, only
        # when the map follows (nft lists `dnat to fd00::4` with no port).
        var br = 1;
        if (cf != 0 && tps == dps) { br = 0; }
        _sb_add_nat_addr(sb, nat_v4(n), cf, br);
        if (tps != dps) {
            if (cf != 0) { str_builder_add_cstr(sb, ":"); } else { str_builder_add_cstr(sb, " : "); }
            str_builder_add_cstr(sb, proto);
            str_builder_add_cstr(sb, " dport map { ");
            var p = dps;
            while (p <= dpe) {
                if (p > dps) { str_builder_add_cstr(sb, ", "); }
                str_builder_add_int(sb, p);
                str_builder_add_cstr(sb, " : ");
                str_builder_add_int(sb, tps + (p - dps));
                p = p + 1;
            }
            str_builder_add_cstr(sb, " }");
        }
        _nat_comment(sb, nat_v7(n));
    } else {
        # Unknown NAT type: rendered nothing through 1.8.1. Fail closed.
        str_builder_add_cstr(sb, "__nein_invalid_nat__");
    }

    return str_builder_build(sb);
}

# --- Validate ---

fn _nat_port_ok(p: i64): i64 {
    if (p < 1 || p > 65535) { return 0; }
    return 1;
}

# NAT ports need a transport protocol with ports: tcp or udp.
fn _nat_proto_ok(proto: i64): i64 {
    if (proto == PROTO_TCP || proto == PROTO_UDP) { return 1; }
    return 0;
}

fn nat_validate(n: i64): i64 {
    var nt = nat_type(n);
    var vr = 0;

    if (nt == NAT_DNAT) {
        var vr1_t, vr1_v = validate_addr(nat_v3(n));
        if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
        # Ports and protocol were never checked through 1.8.1 (audit B-7 / I-8):
        # `dnat to A:0` was accepted, 70000 failed the whole batch at apply.
        if (_nat_proto_ok(nat_v1(n)) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if (_nat_port_ok(nat_v2(n)) == 0 || _nat_port_ok(nat_v4(n)) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if (nat_v5(n) != 0) {
            var vr2_t, vr2_v = validate_comment(nat_v5(n));
            if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
        }
    } elif (nt == NAT_SNAT) {
        var vr3_t, vr3_v = validate_addr(nat_v1(n));
        if (is_err_result(vr3_t) == 1) { return Err(vr3_v); }
        var vr4_t, vr4_v = validate_addr(nat_v2(n));
        if (is_err_result(vr4_t) == 1) { return Err(vr4_v); }
        # Source and translated address must be one family (nft refuses a mix).
        if (_addr_family(nat_v1(n)) != _addr_family(nat_v2(n))) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if (nat_v3(n) != 0) {
            var vr5_t, vr5_v = validate_comment(nat_v3(n));
            if (is_err_result(vr5_t) == 1) { return Err(vr5_v); }
        }
    } elif (nt == NAT_MASQUERADE) {
        var vr6_t, vr6_v = validate_addr(nat_v1(n));
        if (is_err_result(vr6_t) == 1) { return Err(vr6_v); }
        if (nat_v2(n) != 0) {
            var vr7_t, vr7_v = validate_iface(nat_v2(n));
            if (is_err_result(vr7_t) == 1) { return Err(vr7_v); }
        }
        if (nat_v3(n) != 0) {
            var vr8_t, vr8_v = validate_comment(nat_v3(n));
            if (is_err_result(vr8_t) == 1) { return Err(vr8_v); }
        }
    } elif (nt == NAT_REDIRECT) {
        if (_nat_proto_ok(nat_v1(n)) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if (_nat_port_ok(nat_v2(n)) == 0 || _nat_port_ok(nat_v3(n)) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if (nat_v4(n) != 0) {
            var vr9_t, vr9_v = validate_comment(nat_v4(n));
            if (is_err_result(vr9_t) == 1) { return Err(vr9_v); }
        }
    } elif (nt == NAT_DNAT_RANGE) {
        var vr10_t, vr10_v = validate_addr(nat_v4(n));
        if (is_err_result(vr10_t) == 1) { return Err(vr10_v); }
        var dps = nat_v2(n);
        var dpe = nat_v3(n);
        var tps = nat_v5(n);
        var tpe = nat_v6(n);
        if (_nat_proto_ok(nat_v1(n)) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if (_nat_port_ok(dps) == 0 || _nat_port_ok(dpe) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if (_nat_port_ok(tps) == 0 || _nat_port_ok(tpe) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if (dps > dpe) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if (tps > tpe) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if ((dpe - dps) != (tpe - tps)) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if (nat_v7(n) != 0) {
            var vr11_t, vr11_v = validate_comment(nat_v7(n));
            if (is_err_result(vr11_t) == 1) { return Err(vr11_v); }
        }
    } else {
        return nein_err(NEIN_ERR_INVALID_RULE);    # unknown NAT type (audit I-3)
    }

    return nein_ok();
}

# NAT in a table of family `fam` (1.9.3, probed against nft 1.1.7): inet, ip
# and ip6 only ("NAT is only supported for IPv4/IPv6"), and in an ip or ip6
# table every address the rule names must be that family's — nft refuses an
# IPv6 target in an ip table and an IPv4 one in an ip6 table. See rule.cyr's
# "Family".
fn _nat_addr_family_ok(addr: cstring, fam: i64): i64 {
    if (addr == 0) { return 1; }
    var v6 = _addr_has_colon(addr);
    if (fam == FAMILY_IP && v6 == 1) { return 0; }
    if (fam == FAMILY_IP6 && v6 == 0) { return 0; }
    return 1;
}

fn _nat_family_ok(n: i64, fam: i64): i64 {
    if (fam != FAMILY_INET && fam != FAMILY_IP && fam != FAMILY_IP6) { return 0; }
    var nt = nat_type(n);
    if (nt == NAT_DNAT) { return _nat_addr_family_ok(nat_v3(n), fam); }
    if (nt == NAT_DNAT_RANGE) { return _nat_addr_family_ok(nat_v4(n), fam); }
    # snat's target needs no check of its own: nat_validate holds it to its
    # source's family.
    if (nt == NAT_MASQUERADE || nt == NAT_SNAT) { return _nat_addr_family_ok(nat_v1(n), fam); }
    return 1;   # redirect names no address
}

# Where the kernel takes a NAT rule: dnat (and its port ranges) and redirect
# only in a nat chain on prerouting or output, snat only in one on postrouting
# or input, masquerade only on postrouting ("Operation not supported" anywhere
# else, at load — `nft -c` does not check it). 1 when chain type `ctype` at
# hook `hook` takes it.
fn _nat_hook_ok(n: i64, ctype: i64, hook: i64): i64 {
    if (ctype != CHAIN_NAT) { return 0; }
    var nt = nat_type(n);
    if (nt == NAT_MASQUERADE) {
        if (hook == HOOK_POSTROUTING) { return 1; }
        return 0;
    }
    if (nt == NAT_SNAT) {
        if (hook == HOOK_POSTROUTING || hook == HOOK_INPUT) { return 1; }
        return 0;
    }
    if (hook == HOOK_PREROUTING || hook == HOOK_OUTPUT) { return 1; }
    return 0;
}

# --- Convenience ---

fn port_forward(host_port: i64, container_addr: cstring, container_port: i64): i64 {
    return nat_dnat(PROTO_TCP, host_port, container_addr, container_port, "container port fwd");
}

fn port_range_forward(host_start: i64, host_end: i64, container_addr: cstring, container_start: i64): i64 {
    var range_size = host_end - host_start;
    var container_end = container_start + range_size;
    return nat_dnat_range(PROTO_TCP, host_start, host_end, container_addr,
      container_start, container_end, "container port range fwd");
}

fn container_masquerade(subnet: cstring, outbound_iface: cstring): i64 {
    return nat_masquerade(subnet, outbound_iface, "container outbound NAT");
}

# --- chain.cyr ---

# nein chain module — chain types, hooks, policies, and chain rendering

# ================================================================
# Enums
# ================================================================

enum ChainTypeEnum {
    CHAIN_FILTER = 1;
    CHAIN_NAT = 2;
    CHAIN_ROUTE = 3;
}

enum HookEnum {
    HOOK_PREROUTING = 1;
    HOOK_INPUT = 2;
    HOOK_FORWARD = 3;
    HOOK_OUTPUT = 4;
    HOOK_POSTROUTING = 5;
    HOOK_INGRESS = 6;
}

enum PolicyEnum {
    POLICY_ACCEPT = 1;
    POLICY_DROP = 2;
}

fn _chain_type_str(t: i64): cstring {
    if (t == CHAIN_FILTER) { return "filter"; }
    if (t == CHAIN_NAT) { return "nat"; }
    if (t == CHAIN_ROUTE) { return "route"; }
    return "__nein_invalid_chain_type__";
}

fn _hook_str(h: i64): cstring {
    if (h == HOOK_PREROUTING) { return "prerouting"; }
    if (h == HOOK_INPUT) { return "input"; }
    if (h == HOOK_FORWARD) { return "forward"; }
    if (h == HOOK_OUTPUT) { return "output"; }
    if (h == HOOK_POSTROUTING) { return "postrouting"; }
    if (h == HOOK_INGRESS) { return "ingress"; }
    return "__nein_invalid_hook__";
}

fn _policy_str(p: i64): cstring {
    if (p == POLICY_ACCEPT) { return "accept"; }
    if (p == POLICY_DROP) { return "drop"; }
    # Through 1.8.1 an unknown policy rendered "accept" and an unknown hook
    # "input" (audit I-3): `cfg_parse_hook("Forward")` / `cfg_parse_policy("DROP")`
    # — a capitalisation slip in operator config — return -1, and the chain
    # applied as `hook input ... policy accept`, an open input chain. Now
    # chain_header_validate refuses them and an unvalidated render fails closed.
    return "__nein_invalid_policy__";
}

# A base chain's header is in range (1.8.2, audit I-3): a known type, hook
# and policy, and a priority that fits nft's signed 32-bit field. A regular
# chain (type 0) carries no header.
fn chain_header_validate(c: i64): i64 {
    var ct = chain_type_val(c);
    if (ct == 0) { return nein_ok(); }
    if (ct < CHAIN_FILTER || ct > CHAIN_ROUTE) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var h = chain_hook(c);
    if (h < HOOK_PREROUTING || h > HOOK_INGRESS) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var p = chain_policy(c);
    if (p < POLICY_ACCEPT || p > POLICY_DROP) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var pr = chain_priority(c);
    if (pr < 0 - 2147483648 || pr > 2147483647) { return nein_err(NEIN_ERR_INVALID_RULE); }
    return nein_ok();
}

# A base chain's type and hook in a table of family `fam` (1.9.3, probed
# against nft 1.1.7 on Linux 7.2). inet, ip and ip6: filter on any hook but
# ingress, which only inet has; nat on prerouting, input, output and
# postrouting; route on output. arp: filter on input and output. bridge: filter
# on any hook but ingress. netdev: filter on ingress. Anything else nft refuses
# ("does not support this hook", "Chain of type ... is not supported"). A
# regular chain (type 0) carries no header.
fn _chain_header_family_ok(c: i64, fam: i64): i64 {
    var ct = chain_type_val(c);
    if (ct == 0) { return 1; }
    var h = chain_hook(c);
    if (fam == FAMILY_INET || fam == FAMILY_IP || fam == FAMILY_IP6) {
        if (ct == CHAIN_FILTER) {
            if (h == HOOK_INGRESS && fam != FAMILY_INET) { return 0; }
            return 1;
        }
        if (ct == CHAIN_NAT) {
            if (h == HOOK_FORWARD || h == HOOK_INGRESS) { return 0; }
            return 1;
        }
        if (h == HOOK_OUTPUT) { return 1; }   # route
        return 0;
    }
    if (ct != CHAIN_FILTER) { return 0; }
    if (fam == FAMILY_ARP) {
        if (h == HOOK_INPUT || h == HOOK_OUTPUT) { return 1; }
        return 0;
    }
    if (fam == FAMILY_BRIDGE) {
        if (h == HOOK_INGRESS) { return 0; }
        return 1;
    }
    if (fam == FAMILY_NETDEV && h == HOOK_INGRESS) { return 1; }
    return 0;
}

# ================================================================
# ChainRule — tagged wrapper: { type, inner }
# Layout: [type:8][inner:8] = 16 bytes
# type: CR_RULE=1 (standard rule) or CR_NAT=2 (NAT rule)
# ================================================================

enum ChainRuleType {
    CR_RULE = 1;
    CR_NAT = 2;
}

fn chain_rule_new(ctype: i64, inner: i64): i64 {
    var cr = alloc(16);
    store64(cr, ctype);
    store64(cr + 8, inner);
    return cr;
}

fn chain_rule_render(cr: i64): Str {
    var ct = load64(cr);
    var inner = load64(cr + 8);
    if (ct == CR_NAT) { return nat_render(inner); }
    return rule_render(inner);
}

# The rule as nft lists it in a table of family `fam` — what nein_diff
# compares (1.9.2, audit P-8; rule.cyr's "Canonical spellings").
fn _chain_rule_render_canon(cr: i64, fam: i64): Str {
    var ct = load64(cr);
    var inner = load64(cr + 8);
    if (ct == CR_NAT) { return _nat_render_canon(inner, fam); }
    return _rule_render_canon(inner, fam);
}

fn chain_rule_validate(cr: i64): i64 {
    var ct = load64(cr);
    var inner = load64(cr + 8);
    if (ct == CR_NAT) { return nat_validate(inner); }
    return rule_validate(inner);
}

# The chain rule in a table of family `fam`: -1 when nft refuses it there,
# else 1 when only some hooks take it (any NAT; see _rule_family_needs) and 0
# when every hook does.
fn _chain_rule_family_needs(cr: i64, fam: i64): i64 {
    var inner = load64(cr + 8);
    if (load64(cr) == CR_NAT) {
        if (_nat_family_ok(inner, fam) == 0) { return 0 - 1; }
        return 1;
    }
    return _rule_family_needs(inner, fam);
}

# 1 when the kernel takes the chain rule below a base chain of type `ctype` at
# hook `hook`, in a table of family `fam` (1.9.3; `nft -c` does not check
# this, only a load does). NAT: _nat_hook_ok. `reject`: not at postrouting,
# and in a bridge table only at prerouting or input. `flow offload`: only at
# forward. Everything else loads at every hook its chain type has.
fn _chain_rule_context_ok(cr: i64, fam: i64, ctype: i64, hook: i64): i64 {
    var inner = load64(cr + 8);
    if (load64(cr) == CR_NAT) { return _nat_hook_ok(inner, ctype, hook); }
    var vt = verdict_type(rule_verdict(inner));
    if (vt == VERDICT_REJECT || vt == VERDICT_REJECT_WITH) {
        if (hook == HOOK_POSTROUTING) { return 0; }
        if (fam == FAMILY_BRIDGE && hook != HOOK_PREROUTING && hook != HOOK_INPUT) { return 0; }
    }
    if (hook != HOOK_FORWARD) {
        var matches = rule_matches(inner);
        var i = 0;
        while (i < vec_len(matches)) {
            if (match_type(vec_get(matches, i)) == MATCH_FLOW_OFFLOAD) { return 0; }
            i = i + 1;
        }
    }
    return 1;
}

# The chain a rule jumps or goes to, or 0.
fn _chain_rule_jump_target(cr: i64): cstring {
    if (load64(cr) != CR_RULE) { return 0; }
    var v = rule_verdict(load64(cr + 8));
    var vt = verdict_type(v);
    if (vt == VERDICT_JUMP || vt == VERDICT_GOTO) { return verdict_val1(v); }
    return 0;
}

# ================================================================
# Chain — { name, chain_type, hook, priority, policy, rules(vec) }
# Layout: [name:8][chain_type:8][hook:8][priority:8][policy:8][rules:8] = 48 bytes
# chain_type/hook/policy = 0 means "not set" (regular chain)
# ================================================================

fn chain_base(name: cstring, ctype: i64, hook: i64, priority: i64, policy: i64): i64 {
    var c = alloc(48);
    store64(c, name);
    store64(c + 8, ctype);
    store64(c + 16, hook);
    store64(c + 24, priority);
    store64(c + 32, policy);
    store64(c + 40, vec_new());
    return c;
}

fn chain_regular(name: cstring): i64 {
    var c = alloc(48);
    store64(c, name);
    store64(c + 8, 0);
    store64(c + 16, 0);
    store64(c + 24, 0);
    store64(c + 32, 0);
    store64(c + 40, vec_new());
    return c;
}

fn chain_name(c: i64): i64 { return load64(c); }
fn chain_type_val(c: i64): i64 { return load64(c + 8); }
fn chain_hook(c: i64): i64 { return load64(c + 16); }
fn chain_priority(c: i64): i64 { return load64(c + 24); }
fn chain_policy(c: i64): i64 { return load64(c + 32); }
fn chain_rules(c: i64): i64 { return load64(c + 40); }

fn chain_add_rule(c: i64, rule: i64): i64 {
    vec_push(load64(c + 40), chain_rule_new(CR_RULE, rule));
    return c;
}

fn chain_add_nat_rule(c: i64, natrule: i64): i64 {
    vec_push(load64(c + 40), chain_rule_new(CR_NAT, natrule));
    return c;
}

fn chain_render(c: i64): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "  chain ");
    str_builder_add_cstr(sb, chain_name(c));
    str_builder_add_cstr(sb, " {\n");

    # Base chain header
    if (chain_type_val(c) != 0) {
        str_builder_add_cstr(sb, "    type ");
        str_builder_add_cstr(sb, _chain_type_str(chain_type_val(c)));
        str_builder_add_cstr(sb, " hook ");
        str_builder_add_cstr(sb, _hook_str(chain_hook(c)));
        str_builder_add_cstr(sb, " priority ");
        str_builder_add_int(sb, chain_priority(c));
        str_builder_add_cstr(sb, "; policy ");
        str_builder_add_cstr(sb, _policy_str(chain_policy(c)));
        str_builder_add_cstr(sb, ";\n");
    }

    # Rules
    var rules = chain_rules(c);
    var rlen = vec_len(rules);
    var i = 0;
    while (i < rlen) {
        str_builder_add_cstr(sb, "    ");
        var rendered = chain_rule_render(vec_get(rules, i));
        str_builder_add_cstr(sb, str_data(rendered));
        str_builder_add_cstr(sb, "\n");
        i = i + 1;
    }

    str_builder_add_cstr(sb, "  }\n");
    return str_builder_build(sb);
}

# --- table.cyr ---

# nein table module — tables, families, defines, flowtables, ct timeouts

# ================================================================
# Family enum
# ================================================================

enum FamilyEnum {
    FAMILY_INET = 1;
    FAMILY_IP = 2;
    FAMILY_IP6 = 3;
    FAMILY_ARP = 4;
    FAMILY_BRIDGE = 5;
    FAMILY_NETDEV = 6;
}

fn _family_str(f: i64): cstring {
    if (f == FAMILY_INET) { return "inet"; }
    if (f == FAMILY_IP) { return "ip"; }
    if (f == FAMILY_IP6) { return "ip6"; }
    if (f == FAMILY_ARP) { return "arp"; }
    if (f == FAMILY_BRIDGE) { return "bridge"; }
    if (f == FAMILY_NETDEV) { return "netdev"; }
    return "__nein_invalid_family__";   # was a silent "inet" (audit I-3)
}

# ================================================================
# Define — { name, value }
# Layout: [name:8][value:8] = 16 bytes
# ================================================================

fn define_new(name: cstring, value: cstring): i64 {
    var d = alloc(16);
    store64(d, name);
    store64(d + 8, value);
    return d;
}

fn define_name(d: i64): i64 { return load64(d); }
fn define_value(d: i64): i64 { return load64(d + 8); }

fn define_validate(d: i64): i64 {
    var vr1_t, vr1_v = validate_nft_name(define_name(d));
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    var vr2_t, vr2_v = validate_nft_element(define_value(d));
    if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
    return nein_ok();
}

fn define_render(d: i64): Str {
    var sb = str_builder_new();
    # `define NAME = VALUE`, no '$' (1.8.2, audit I-6): the '$' belongs only
    # to a REFERENCE (`ip saddr $lan`). Through 1.8.1 this rendered
    # `define $lan = ...`, which nft rejects ("syntax error, unexpected '$'"),
    # so any firewall with a define failed to apply as a whole.
    str_builder_add_cstr(sb, "  define ");
    str_builder_add_cstr(sb, define_name(d));
    str_builder_add_cstr(sb, " = ");
    str_builder_add_cstr(sb, define_value(d));
    str_builder_add_cstr(sb, ";\n");
    return str_builder_build(sb);
}

# ================================================================
# Flowtable — { name, hook, priority, devices(vec) }
# Layout: [name:8][hook:8][priority:8][devices:8] = 32 bytes
# ================================================================

fn flowtable_new(name: cstring, priority: i64, devices: i64): i64 {
    var ft = alloc(32);
    store64(ft, name);
    store64(ft + 8, HOOK_INGRESS);
    store64(ft + 16, priority);
    store64(ft + 24, devices);
    return ft;
}

fn flowtable_name(ft: i64): i64 { return load64(ft); }
fn flowtable_hook(ft: i64): i64 { return load64(ft + 8); }
fn flowtable_priority(ft: i64): i64 { return load64(ft + 16); }
fn flowtable_devices(ft: i64): i64 { return load64(ft + 24); }

fn flowtable_validate(ft: i64): i64 {
    var vr1_t, vr1_v = validate_nft_name(flowtable_name(ft));
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    if (flowtable_hook(ft) != HOOK_INGRESS) {
        return nein_err(NEIN_ERR_INVALID_RULE);
    }
    var devs = flowtable_devices(ft);
    var dlen = vec_len(devs);
    if (dlen == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var i = 0;
    while (i < dlen) {
        var vr2_t, vr2_v = validate_iface(vec_get(devs, i));
        if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
        i = i + 1;
    }
    return nein_ok();
}

fn flowtable_render(ft: i64): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "  flowtable ");
    str_builder_add_cstr(sb, flowtable_name(ft));
    str_builder_add_cstr(sb, " {\n");
    str_builder_add_cstr(sb, "    hook ");
    str_builder_add_cstr(sb, _hook_str(flowtable_hook(ft)));
    str_builder_add_cstr(sb, " priority ");
    str_builder_add_int(sb, flowtable_priority(ft));
    str_builder_add_cstr(sb, ";\n");

    var devs = flowtable_devices(ft);
    var dlen = vec_len(devs);
    if (dlen > 0) {
        str_builder_add_cstr(sb, "    devices = { ");
        var i = 0;
        while (i < dlen) {
            if (i > 0) { str_builder_add_cstr(sb, ", "); }
            # Quoted (1.9.1): bare, nft reads `vxlan`, `bridge`, `ip` or
            # `3eth` as a keyword or a number and refuses the batch. Linux
            # allows each as an interface name; validate_iface keeps quotes out.
            str_builder_add_cstr(sb, "\"");
            str_builder_add_cstr(sb, vec_get(devs, i));
            str_builder_add_cstr(sb, "\"");
            i = i + 1;
        }
        str_builder_add_cstr(sb, " };\n");
    }

    str_builder_add_cstr(sb, "  }\n");
    return str_builder_build(sb);
}

# ================================================================
# CtTimeout — { name, protocol, l3proto, policy(vec of state/secs pairs) }
# Layout: [name:8][protocol:8][l3proto:8][policy:8] = 32 bytes
# Policy entries: [state_name:8][seconds:8] = 16 bytes each
# ================================================================

fn ct_timeout_new(name: cstring, protocol: i64): i64 {
    var ct = alloc(32);
    store64(ct, name);
    store64(ct + 8, protocol);
    store64(ct + 16, 0);
    store64(ct + 24, vec_new());
    return ct;
}

fn ct_timeout_name(ct: i64): i64 { return load64(ct); }
fn ct_timeout_protocol(ct: i64): i64 { return load64(ct + 8); }
fn ct_timeout_l3proto(ct: i64): i64 { return load64(ct + 16); }
fn ct_timeout_policy(ct: i64): i64 { return load64(ct + 24); }

fn ct_timeout_set_l3proto(ct: i64, family: i64): i64 {
    store64(ct + 16, family);
    return ct;
}

fn ct_timeout_add_timeout(ct: i64, state: cstring, seconds: i64): i64 {
    var e = alloc(16);
    store64(e, state);
    store64(e + 8, seconds);
    vec_push(load64(ct + 24), e);
    return ct;
}

fn ct_timeout_validate(ct: i64): i64 {
    var vr1_t, vr1_v = validate_nft_name(ct_timeout_name(ct));
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    # nft reads this name in its ct scope, which has keywords of its own
    # (`ct timeout state { ... }` is refused; 1.9.1, audit I-10).
    if (_nft_ct_keyword(ct_timeout_name(ct)) == 1) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var proto = ct_timeout_protocol(ct);
    if (proto != PROTO_TCP && proto != PROTO_UDP) {
        return nein_err(NEIN_ERR_INVALID_RULE);
    }
    var l3 = ct_timeout_l3proto(ct);
    if (l3 != 0 && l3 != FAMILY_IP && l3 != FAMILY_IP6) {
        return nein_err(NEIN_ERR_INVALID_RULE);
    }
    var pol = ct_timeout_policy(ct);
    var plen = vec_len(pol);
    var i = 0;
    while (i < plen) {
        var e = vec_get(pol, i);
        var vr2_t, vr2_v = validate_identifier(load64(e));
        if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
        i = i + 1;
    }
    return nein_ok();
}

fn ct_timeout_render(ct: i64): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "  ct timeout ");
    str_builder_add_cstr(sb, ct_timeout_name(ct));
    str_builder_add_cstr(sb, " {\n");
    str_builder_add_cstr(sb, "    protocol ");
    str_builder_add_cstr(sb, _proto_str(ct_timeout_protocol(ct)));
    str_builder_add_cstr(sb, ";\n");

    var l3 = ct_timeout_l3proto(ct);
    if (l3 != 0) {
        str_builder_add_cstr(sb, "    l3proto ");
        str_builder_add_cstr(sb, _family_str(l3));
        str_builder_add_cstr(sb, ";\n");
    }

    var pol = ct_timeout_policy(ct);
    var plen = vec_len(pol);
    if (plen > 0) {
        str_builder_add_cstr(sb, "    policy = { ");
        var i = 0;
        while (i < plen) {
            if (i > 0) { str_builder_add_cstr(sb, ", "); }
            var e = vec_get(pol, i);
            str_builder_add_cstr(sb, load64(e));
            str_builder_add_cstr(sb, ": ");
            str_builder_add_int(sb, load64(e + 8));
            i = i + 1;
        }
        str_builder_add_cstr(sb, " };\n");
    }

    str_builder_add_cstr(sb, "  }\n");
    return str_builder_build(sb);
}

# ================================================================
# Table — { name, family, defines, flowtables, ct_timeouts, sets, maps, chains }
# Layout: [name:8][family:8][defines:8][flowtables:8][ct_timeouts:8]
#         [sets:8][maps:8][chains:8] = 64 bytes
# ================================================================

fn table_new(name: cstring, family: i64): i64 {
    var t = alloc(64);
    store64(t, name);
    store64(t + 8, family);
    store64(t + 16, vec_new());
    store64(t + 24, vec_new());
    store64(t + 32, vec_new());
    store64(t + 40, vec_new());
    store64(t + 48, vec_new());
    store64(t + 56, vec_new());
    return t;
}

fn table_name(t: i64): i64 { return load64(t); }
fn table_family(t: i64): i64 { return load64(t + 8); }
fn table_defines(t: i64): i64 { return load64(t + 16); }
fn table_flowtables(t: i64): i64 { return load64(t + 24); }
fn table_ct_timeouts(t: i64): i64 { return load64(t + 32); }
fn table_sets(t: i64): i64 { return load64(t + 40); }
fn table_maps(t: i64): i64 { return load64(t + 48); }
fn table_chains(t: i64): i64 { return load64(t + 56); }

fn table_add_define(t: i64, d: i64): i64 { vec_push(load64(t + 16), d); return t; }
fn table_add_flowtable(t: i64, ft: i64): i64 { vec_push(load64(t + 24), ft); return t; }
fn table_add_ct_timeout(t: i64, ct: i64): i64 { vec_push(load64(t + 32), ct); return t; }
fn table_add_set(t: i64, s: i64): i64 { vec_push(load64(t + 40), s); return t; }
fn table_add_map(t: i64, m: i64): i64 { vec_push(load64(t + 48), m); return t; }
fn table_add_chain(t: i64, c: i64): i64 { vec_push(load64(t + 56), c); return t; }

fn table_render(t: i64): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "table ");
    str_builder_add_cstr(sb, _family_str(table_family(t)));
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, table_name(t));
    str_builder_add_cstr(sb, " {\n");

    # Render order: defines -> flowtables -> ct_timeouts -> sets -> maps -> chains
    var v = 0;
    var vlen = 0;
    var i = 0;

    v = table_defines(t);
    vlen = vec_len(v);
    i = 0;
    while (i < vlen) {
        var rendered = define_render(vec_get(v, i));
        str_builder_add_cstr(sb, str_data(rendered));
        i = i + 1;
    }

    v = table_flowtables(t);
    vlen = vec_len(v);
    i = 0;
    while (i < vlen) {
        var rendered = flowtable_render(vec_get(v, i));
        str_builder_add_cstr(sb, str_data(rendered));
        i = i + 1;
    }

    v = table_ct_timeouts(t);
    vlen = vec_len(v);
    i = 0;
    while (i < vlen) {
        var rendered = ct_timeout_render(vec_get(v, i));
        str_builder_add_cstr(sb, str_data(rendered));
        i = i + 1;
    }

    v = table_sets(t);
    vlen = vec_len(v);
    i = 0;
    while (i < vlen) {
        var rendered = nft_set_render(vec_get(v, i));
        str_builder_add_cstr(sb, str_data(rendered));
        i = i + 1;
    }

    v = table_maps(t);
    vlen = vec_len(v);
    i = 0;
    while (i < vlen) {
        var rendered = nft_map_render(vec_get(v, i));
        str_builder_add_cstr(sb, str_data(rendered));
        i = i + 1;
    }

    v = table_chains(t);
    vlen = vec_len(v);
    i = 0;
    while (i < vlen) {
        var rendered = chain_render(vec_get(v, i));
        str_builder_add_cstr(sb, str_data(rendered));
        i = i + 1;
    }

    str_builder_add_cstr(sb, "}\n");
    return str_builder_build(sb);
}

# --- firewall.cyr ---

# nein firewall module — top-level Firewall manager
#
# Firewall struct — { tables(vec), dry_run }
# Layout: [tables:8][dry_run:8] = 16 bytes

fn firewall_new(): i64 {
    var fw = alloc(16);
    store64(fw, vec_new());
    store64(fw + 8, 0);
    return fw;
}

fn firewall_tables(fw: i64): i64 { return load64(fw); }
fn firewall_dry_run(fw: i64): i64 { return load64(fw + 8); }

fn firewall_set_dry_run(fw: i64, enabled: i64): i64 {
    store64(fw + 8, enabled);
    return fw;
}

fn firewall_add_table(fw: i64, t: i64): i64 {
    vec_push(load64(fw), t);
    return fw;
}

# --- Remove consecutive duplicate rules within each chain ---
#
# Returns the number of rules removed. Two rules are duplicates when they
# render to identical nft text — a stronger test than comparing fields, since
# it also catches rules assembled by different code paths that collapse to the
# same line (e.g. two builders both emitting `ct state { established, related }
# accept`).
#
# Only CONSECUTIVE duplicates are collapsed, matching the Rust original's
# `Vec::dedup`. This is deliberate, not a shortcut: rule order is semantic in
# nftables, and a non-terminal rule (`counter`, bare `log`) that appears twice
# with other rules between them is counted twice on purpose. Collapsing across
# a gap would silently change packet accounting. Adjacent identical rules are
# the unambiguous case — the second can never observe traffic the first did
# not — so that is the only one collapsed here.
fn firewall_deduplicate(fw: i64): i64 {
    var removed = 0;
    var tables = firewall_tables(fw);
    var tlen = vec_len(tables);
    var ti = 0;

    while (ti < tlen) {
        var chains = table_chains(vec_get(tables, ti));
        var clen = vec_len(chains);
        var ci = 0;
        while (ci < clen) {
            var rules = chain_rules(vec_get(chains, ci));
            var i = 1;
            while (i < vec_len(rules)) {
                var prev = chain_rule_render(vec_get(rules, i - 1));
                var cur = chain_rule_render(vec_get(rules, i));
                if (str_eq(prev, cur) == 1) {
                    vec_remove(rules, i);
                    removed = removed + 1;
                } else {
                    i = i + 1;
                }
            }
            ci = ci + 1;
        }
        ti = ti + 1;
    }

    return removed;
}

# --- Render: concatenate all tables with trailing newlines ---
fn firewall_render(fw: i64): Str {
    var sb = str_builder_new();
    var tables = firewall_tables(fw);
    var tlen = vec_len(tables);
    var i = 0;
    while (i < tlen) {
        var rendered = table_render(vec_get(tables, i));
        str_builder_add_cstr(sb, str_data(rendered));
        str_builder_add_cstr(sb, "\n");
        i = i + 1;
    }
    return str_builder_build(sb);
}

# --- Validate all tables, chains, and contents ---
# Validate, then render (1.8.2, audit I-5 / S-7). `firewall_render` does not
# validate: it is the raw renderer `apply_firewall` calls AFTER its own
# `firewall_validate`. A consumer that renders for a path nein does not
# control — agnodrm's `netns_apply_nftables_ruleset`, a file handed to
# `nft -f` — skipped that step in every example nein documented, so an agent
# name like `agent7" accept ; flush ruleset ; #` reached nft text (the
# validator rejects it). This is the safe form in one call: Ok(Str) with the
# rendered ruleset, or the validation Err. Bind both halves:
#     var t, v = firewall_render_checked(fw);
fn firewall_render_checked(fw: i64): i64 {
    var vt, vv = firewall_validate(fw);
    if (is_err_result(vt) == 1) { return Err(vv); }
    return Ok(firewall_render(fw));
}

# ---- What the kernel checks when it binds chains (1.9.3) ----
#
# A rule is held to the type and hook of every base chain that can reach it
# through jump / goto, not to its own chain's: `dnat` in a regular chain loads
# only if every base chain that reaches it is a nat chain on prerouting or
# output. A path of more than 15 jumps below a base chain is refused ("Too
# many links") — a reachable cycle is one — and so is any jump to a base
# chain. A regular chain no base chain reaches is not checked, by the kernel
# or here. All probed against nft 1.1.7 on Linux 7.2 with real loads: `nft -c`
# checks none of it (tests/integration/nft_family.tcyr).
var _NFT_JUMP_MAX = 15;

# Chain names to indices, open addressing on a djb2 hash, so each jump
# resolves in O(1): the engine's 100-agent firewall has 200 jumps over 203
# chains, and a scan per jump made its validation 4x slower. Local, not the
# stdlib hashmap, which would add a stdlib leaf to dist/nein.cyr's sidecar.
# Layout: [mask:8][slots: (mask + 1) * 8], a slot 0 or a chain index + 1.
fn _fw_name_hash(s: cstring): i64 {
    var h = 5381;
    var i = 0;
    var c = load8(s);
    while (c != 0) {
        h = (h << 5) + h + c;
        i = i + 1;
        c = load8(s + i);
    }
    return h;
}

fn _fw_index_new(chains: i64): i64 {
    var n = vec_len(chains);
    var cap = 8;
    while (cap < n * 2) { cap = cap * 2; }
    var ix = alloc(cap * 8 + 8);
    store64(ix, cap - 1);
    var z = 0;
    while (z < cap) { store64(ix + 8 + z * 8, 0); z = z + 1; }
    var i = 0;
    while (i < n) {
        var h = _fw_name_hash(chain_name(vec_get(chains, i))) & (cap - 1);
        while (load64(ix + 8 + h * 8) != 0) { h = (h + 1) & (cap - 1); }
        store64(ix + 8 + h * 8, i + 1);
        i = i + 1;
    }
    return ix;
}

# Index of the chain named `name`, or -1.
fn _fw_index_get(ix: i64, chains: i64, name: cstring): i64 {
    var mask = load64(ix);
    var h = _fw_name_hash(name) & mask;
    var v = load64(ix + 8 + h * 8);
    while (v != 0) {
        if (streq(chain_name(vec_get(chains, v - 1)), name) == 1) { return v - 1; }
        h = (h + 1) & mask;
        v = load64(ix + 8 + h * 8);
    }
    return 0 - 1;
}

# Walk chain `ci`, reached `depth` jumps below a base chain of type `ctype` at
# hook `hook`. `tg[i]` holds chain i's jump targets (a Vec of indices, or 0)
# and `nd[i]` is 1 when chain i holds a statement only some hooks take, so a
# chain without one is never scanned. `seen[i]` is 0, or 1 + the deepest
# depth chain i was explored at: each chain's rules are checked once per base
# chain, and a chain is only walked again from deeper, so the work is bounded
# by 15 walks a chain.
fn _fw_walk(chains: i64, tg: i64, nd: i64, fam: i64, ctype: i64, hook: i64, ci: i64, depth: i64, seen: i64): i64 {
    if (depth > _NFT_JUMP_MAX) { return 0; }
    var prev = load64(seen + ci * 8);
    if (prev != 0 && prev - 1 >= depth) { return 1; }
    store64(seen + ci * 8, depth + 1);
    if (prev == 0 && load64(nd + ci * 8) == 1) {
        var rules = chain_rules(vec_get(chains, ci));
        var k = 0;
        while (k < vec_len(rules)) {
            if (_chain_rule_context_ok(vec_get(rules, k), fam, ctype, hook) == 0) { return 0; }
            k = k + 1;
        }
    }
    var tv = load64(tg + ci * 8);
    if (tv != 0) {
        var e = 0;
        while (e < vec_len(tv)) {
            if (_fw_walk(chains, tg, nd, fam, ctype, hook, vec_get(tv, e), depth + 1, seen) == 0) { return 0; }
            e = e + 1;
        }
    }
    return 1;
}

# Walk from each base chain of table `t` (tg / nd as _fw_walk takes them):
# 1 when every rule each one reaches is one the kernel takes there.
fn _fw_bases_ok(t: i64, tg: i64, nd: i64): i64 {
    var chains = table_chains(t);
    var n = vec_len(chains);
    var fam = table_family(t);
    var seen = 0;
    var j = 0;
    while (j < n) {
        var b = vec_get(chains, j);
        if (chain_type_val(b) != 0) {
            if (seen == 0) { seen = alloc(n * 8); }
            var z = 0;
            while (z < n) { store64(seen + z * 8, 0); z = z + 1; }
            if (_fw_walk(chains, tg, nd, fam, chain_type_val(b), chain_hook(b), j, 0, seen) == 0) { return 0; }
        }
        j = j + 1;
    }
    return 1;
}

fn firewall_validate(fw: i64): i64 {
    var tables = firewall_tables(fw);
    var tlen = vec_len(tables);
    var i = 0;
    var j = 0;
    var vec2 = 0;
    var vlen = 0;
    var vr = 0;

    while (i < tlen) {
        var t = vec_get(tables, i);

        var vr1_t, vr1_v = validate_nft_name(table_name(t));
        if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
        var fam = table_family(t);
        if (fam < FAMILY_INET || fam > FAMILY_NETDEV) { return nein_err(NEIN_ERR_INVALID_RULE); }

        # Defines
        vec2 = table_defines(t);
        vlen = vec_len(vec2);
        j = 0;
        while (j < vlen) {
            var vr2_t, vr2_v = define_validate(vec_get(vec2, j));
            if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
            j = j + 1;
        }

        # Flowtables
        vec2 = table_flowtables(t);
        vlen = vec_len(vec2);
        j = 0;
        while (j < vlen) {
            var vr3_t, vr3_v = flowtable_validate(vec_get(vec2, j));
            if (is_err_result(vr3_t) == 1) { return Err(vr3_v); }
            if (_fam_has_flowtable(fam) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
            j = j + 1;
        }

        # CT timeouts
        vec2 = table_ct_timeouts(t);
        vlen = vec_len(vec2);
        j = 0;
        while (j < vlen) {
            var vr4_t, vr4_v = ct_timeout_validate(vec_get(vec2, j));
            if (is_err_result(vr4_t) == 1) { return Err(vr4_v); }
            if (_fam_has_ct(fam) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
            j = j + 1;
        }

        # Sets
        vec2 = table_sets(t);
        vlen = vec_len(vec2);
        j = 0;
        while (j < vlen) {
            var vr5_t, vr5_v = nft_set_validate(vec_get(vec2, j));
            if (is_err_result(vr5_t) == 1) { return Err(vr5_v); }
            j = j + 1;
        }

        # Maps
        vec2 = table_maps(t);
        vlen = vec_len(vec2);
        j = 0;
        while (j < vlen) {
            var vr6_t, vr6_v = nft_map_validate(vec_get(vec2, j));
            if (is_err_result(vr6_t) == 1) { return Err(vr6_v); }
            j = j + 1;
        }

        # Chains. Each rule's family is checked here, and its jump target and
        # whether it holds a hook-restricted statement are recorded for the
        # walk below (one scan of each rule; 1.9.3).
        vec2 = table_chains(t);
        vlen = vec_len(vec2);
        var ix = _fw_index_new(vec2);
        var tg = alloc(vlen * 8 + 8);
        var nd = alloc(vlen * 8 + 8);
        j = 0;
        while (j < vlen) {
            var chain = vec_get(vec2, j);
            var vr7_t, vr7_v = validate_nft_name(chain_name(chain));
            if (is_err_result(vr7_t) == 1) { return Err(vr7_v); }
            var vh_t, vh_v = chain_header_validate(chain);
            if (is_err_result(vh_t) == 1) { return Err(vh_v); }
            # The table's family (1.9.3): its chain types and hooks, and what
            # its rules can match. See rule.cyr's "Family".
            if (_chain_header_family_ok(chain, fam) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
            var rules = chain_rules(chain);
            var rlen = vec_len(rules);
            var tv = 0;
            var need = 0;
            var k = 0;
            while (k < rlen) {
                var cr = vec_get(rules, k);
                var vr8_t, vr8_v = chain_rule_validate(cr);
                if (is_err_result(vr8_t) == 1) { return Err(vr8_v); }
                var fneeds = _chain_rule_family_needs(cr, fam);
                if (fneeds < 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
                if (fneeds > 0) { need = 1; }
                var tgt = _chain_rule_jump_target(cr);
                if (tgt != 0) {
                    var ti = _fw_index_get(ix, vec2, tgt);
                    if (ti >= 0) {
                        # A jump or goto to a base chain: refused, reached or not.
                        if (chain_type_val(vec_get(vec2, ti)) != 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
                        if (tv == 0) { tv = vec_new(); }
                        vec_push(tv, ti);
                    }
                }
                k = k + 1;
            }
            store64(tg + j * 8, tv);
            store64(nd + j * 8, need);
            j = j + 1;
        }
        if (_fw_bases_ok(t, tg, nd) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }

        i = i + 1;
    }

    return nein_ok();
}

# --- builder.cyr ---

# nein builder module — pre-built firewall configurations

# --- Build a basic host firewall (allow established, lo, SSH, drop rest) ---
fn basic_host_firewall(): i64 {
    var fw = firewall_new();
    var table = table_new("filter", FAMILY_INET);

    var input = chain_base("input", CHAIN_FILTER, HOOK_INPUT, 0, POLICY_DROP);
    chain_add_rule(input, allow_established());

    # rule: iif lo accept
    var lo_rule = rule_new(verdict_accept());
    rule_add_match(lo_rule, match_iif("lo"));
    chain_add_rule(input, lo_rule);

    # SSH with comment
    var ssh_rule = allow_tcp(22);
    rule_set_comment(ssh_rule, "SSH");
    chain_add_rule(input, ssh_rule);

    # output chain (permissive)
    var output = chain_base("output", CHAIN_FILTER, HOOK_OUTPUT, 0, POLICY_ACCEPT);

    table_add_chain(table, input);
    table_add_chain(table, output);
    firewall_add_table(fw, table);
    return fw;
}

# --- Build container bridge networking rules ---
fn container_bridge(bridge_name: cstring, subnet: cstring, outbound_iface: cstring): i64 {
    var fw = firewall_new();

    # filter table: forward chain
    var filter = table_new("filter", FAMILY_INET);
    var forward = chain_base("forward", CHAIN_FILTER, HOOK_FORWARD, 0, POLICY_DROP);

    chain_add_rule(forward, allow_established());

    # container -> internet
    var r1 = rule_new(verdict_accept());
    rule_add_match(r1, match_iif(bridge_name));
    rule_add_match(r1, match_oif(outbound_iface));
    rule_set_comment(r1, "container to internet");
    chain_add_rule(forward, r1);

    # container -> container
    var r2 = rule_new(verdict_accept());
    rule_add_match(r2, match_iif(bridge_name));
    rule_add_match(r2, match_oif(bridge_name));
    rule_set_comment(r2, "container to container");
    chain_add_rule(forward, r2);

    table_add_chain(filter, forward);
    firewall_add_table(fw, filter);

    # nat table: postrouting masquerade
    var nat_table = table_new("nat", FAMILY_IP);
    var postrouting = chain_base("postrouting", CHAIN_NAT, HOOK_POSTROUTING, 100, POLICY_ACCEPT);
    chain_add_nat_rule(postrouting, container_masquerade(subnet, outbound_iface));
    table_add_chain(nat_table, postrouting);
    firewall_add_table(fw, nat_table);

    return fw;
}

# --- Build agent-to-agent service policy rules ---
# ports_vec: vec of { protocol, port } pair structs (16 bytes each)
fn _port_pair_new(protocol: i64, port: i64): i64 {
    var p = alloc(16);
    store64(p, protocol);
    store64(p + 8, port);
    return p;
}

fn service_policy(agent_source: cstring, ports_vec: i64): i64 {
    var fw = firewall_new();
    var table = table_new("agnos_policy", FAMILY_INET);
    var chain = chain_regular("agent_access");

    var plen = vec_len(ports_vec);
    var i = 0;
    while (i < plen) {
        var pair = vec_get(ports_vec, i);
        chain_add_rule(chain, allow_service(agent_source, load64(pair), load64(pair + 8)));
        i = i + 1;
    }

    table_add_chain(table, chain);
    firewall_add_table(fw, table);
    return fw;
}

# --- policy.cyr ---

# nein policy module — network policies (K8s-style)

enum PolicyActionEnum {
    PACT_ALLOW = 1;
    PACT_DENY = 2;
}

# ================================================================
# PolicyPort — { protocol, port }
# Layout: [protocol:8][port:8] = 16 bytes
# ================================================================

fn policy_port_new(protocol: i64, port: i64): i64 {
    var p = alloc(16);
    store64(p, protocol);
    store64(p + 8, port);
    return p;
}

fn policy_port_protocol(p: i64): i64 { return load64(p); }
fn policy_port_port(p: i64): i64 { return load64(p + 8); }

# ================================================================
# PolicyRule — { peer(str), ports(vec of PolicyPort) }
# Layout: [peer:8][ports:8] = 16 bytes
# ================================================================

fn policy_rule_new(peer: cstring): i64 {
    var pr = alloc(16);
    store64(pr, peer);
    store64(pr + 8, vec_new());
    return pr;
}

fn policy_rule_peer(pr: i64): i64 { return load64(pr); }
fn policy_rule_ports(pr: i64): i64 { return load64(pr + 8); }

fn policy_rule_add_port(pr: i64, protocol: i64, port: i64): i64 {
    vec_push(load64(pr + 8), policy_port_new(protocol, port));
    return pr;
}

# ================================================================
# NetworkPolicy — { name, target, ingress(vec), egress(vec), default_action }
# Layout: [name:8][target:8][ingress:8][egress:8][default_action:8] = 40 bytes
# ================================================================

fn nein_network_policy_new(name: cstring, target: cstring, default_action: i64): i64 {
    var np = alloc(40);
    store64(np, name);
    store64(np + 8, target);
    store64(np + 16, vec_new());
    store64(np + 24, vec_new());
    store64(np + 32, default_action);
    return np;
}

fn policy_name(np: i64): i64 { return load64(np); }
fn policy_target(np: i64): i64 { return load64(np + 8); }
fn policy_ingress(np: i64): i64 { return load64(np + 16); }
fn policy_egress(np: i64): i64 { return load64(np + 24); }
fn policy_default_action(np: i64): i64 { return load64(np + 32); }

fn policy_add_ingress(np: i64, pr: i64): i64 {
    vec_push(load64(np + 16), pr);
    return np;
}

fn policy_add_egress(np: i64, pr: i64): i64 {
    vec_push(load64(np + 24), pr);
    return np;
}

# ================================================================
# Validate
# ================================================================

fn _validate_policy_rules(rules: i64): i64 {
    var rlen = vec_len(rules);
    var i = 0;
    var vr = 0;
    while (i < rlen) {
        var pr = vec_get(rules, i);
        var peer = policy_rule_peer(pr);
        # "any" peer is allowed without validation
        if (streq(peer, "any") == 0) {
            var vr1_t, vr1_v = validate_addr(peer);
            if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
        }
        # Each port as firewall_validate will hold it: a protocol nft has, a
        # port 0-65535. Through 1.9.0 a port of 70000 passed here and the
        # firewall built from the policy failed (1.9.1, the audit B-8 class).
        var ports = policy_rule_ports(pr);
        var j = 0;
        while (j < vec_len(ports)) {
            var pp = vec_get(ports, j);
            if (_in_range(policy_port_protocol(pp), PROTO_TCP, PROTO_ICMPV6) == 0) {
                return nein_err(NEIN_ERR_INVALID_RULE);
            }
            if (_in_range(policy_port_port(pp), 0, 65535) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
            j = j + 1;
        }
        i = i + 1;
    }
    return nein_ok();
}

# Build the comment string "policy:NAME direction from/to PEER"
fn _policy_comment(name: cstring, direction: cstring, preposition: cstring, peer: cstring): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "policy:");
    str_builder_add_cstr(sb, name);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, direction);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, preposition);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, peer);
    var s = str_builder_build(sb);
    # Need null-terminated cstr for rule_set_comment
    var out = alloc(str_len(s) + 1);
    memcpy(out, str_data(s), str_len(s));
    store8(out + str_len(s), 0);
    return out;
}

# Ok when every comment the build gives a rule list's rules fits
# validate_comment: `policy:<name> ingress from <peer>`, one per rule with
# ports. Through 1.9.0 a 64-byte name with a long IPv6 peer composed 134 bytes
# and the firewall failed validation, after this policy had passed (1.9.1,
# the audit B-8 class).
fn _policy_comments_ok(name: cstring, rules: i64, direction: cstring, preposition: cstring): i64 {
    var rlen = vec_len(rules);
    var i = 0;
    while (i < rlen) {
        var pr = vec_get(rules, i);
        if (vec_len(policy_rule_ports(pr)) > 0) {
            var c = _policy_comment(name, direction, preposition, policy_rule_peer(pr));
            var vc_t, vc_v = validate_comment(c);
            if (is_err_result(vc_t) == 1) { return Err(vc_v); }
        }
        i = i + 1;
    }
    return nein_ok();
}

fn policy_validate(np: i64): i64 {
    var vr1_t, vr1_v = validate_identifier(policy_name(np));
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    # The target (1.8.2, audit B-6): an address — matched on every rule — or a
    # selector label / "any", which names the workload whose own chain the
    # consumer places the rules in. A label is never rendered; it is checked
    # as an identifier for hygiene.
    var tgt = policy_target(np);
    if (tgt == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (streq(tgt, "any") == 0 && _addr_family(tgt) == 0) {
        var vt_t, vt_v = validate_identifier(tgt);
        if (is_err_result(vt_t) == 1) { return Err(vt_v); }
    }
    var da = policy_default_action(np);
    if (da != PACT_ALLOW && da != PACT_DENY) { return nein_err(NEIN_ERR_INVALID_RULE); }

    var vr2_t, vr2_v = _validate_policy_rules(policy_ingress(np));
    if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }

    var vr3_t, vr3_v = _validate_policy_rules(policy_egress(np));
    if (is_err_result(vr3_t) == 1) { return Err(vr3_v); }

    var vc1_t, vc1_v = _policy_comments_ok(policy_name(np), policy_ingress(np), "ingress", "from");
    if (is_err_result(vc1_t) == 1) { return Err(vc1_v); }
    var vc2_t, vc2_v = _policy_comments_ok(policy_name(np), policy_egress(np), "egress", "to");
    if (is_err_result(vc2_t) == 1) { return Err(vc2_v); }

    return nein_ok();
}

# ================================================================
# Convert policy to rules
# ================================================================

# The policy's own endpoint, matched on every rule it renders (1.8.2,
# audit B-6): through 1.8.1 neither `target` nor `default_action` was read
# anywhere, so `agent_to_agent(.., "10.0.0.1", "10.0.0.2", TCP, 8090)`
# rendered `tcp dport 8090 ip saddr 10.0.0.1 accept` — in a forward or shared
# input chain the source reached that port on EVERY destination — and a
# PACT_DENY policy rendered exactly what a PACT_ALLOW one did.
#
# Only an ADDRESS target is matched. A label target ("webserver") names the
# workload whose dedicated chain the consumer puts these rules in, so it adds
# no match — and no default drop, because an unscoped `drop` placed in a
# shared chain would drop everything after it.
fn _policy_has_target(np: i64): i64 {
    var tgt = policy_target(np);
    if (tgt == 0) { return 0; }
    if (_addr_family(tgt) == 0) { return 0; }
    return 1;
}

fn _policy_deny_rule(np: i64, is_ingress: i64): i64 {
    var r = rule_new(verdict_drop());
    if (_policy_has_target(np) == 1) { rule_add_match(r, _match_addr(policy_target(np), is_ingress)); }
    if (is_ingress == 1) { rule_set_comment(r, _policy_comment(policy_name(np), "ingress", "default", "deny")); }
    else { rule_set_comment(r, _policy_comment(policy_name(np), "egress", "default", "deny")); }
    return r;
}

fn policy_to_rules(np: i64): i64 {
    var rules = vec_new();
    var name = policy_name(np);

    # Ingress: accept on dport with optional source addr
    var ing = policy_ingress(np);
    var ilen = vec_len(ing);
    var i = 0;
    while (i < ilen) {
        var pr = vec_get(ing, i);
        var peer = policy_rule_peer(pr);
        var ports = policy_rule_ports(pr);
        var plen = vec_len(ports);
        var j = 0;
        while (j < plen) {
            var pp = vec_get(ports, j);
            var r = rule_new(verdict_accept());
            if (_policy_has_target(np) == 1) { rule_add_match(r, _match_addr(policy_target(np), 1)); }
            if (streq(peer, "any") == 0) {
                rule_add_match(r, _match_addr(peer, 0));
            }
            rule_add_match(r, match_protocol(policy_port_protocol(pp)));
            rule_add_match(r, match_dport(policy_port_port(pp)));
            rule_set_comment(r, _policy_comment(name, "ingress", "from", peer));
            vec_push(rules, r);
            j = j + 1;
        }
        i = i + 1;
    }

    # Egress: accept on dport with optional dest addr
    var eg = policy_egress(np);
    var elen = vec_len(eg);
    i = 0;
    while (i < elen) {
        var pr = vec_get(eg, i);
        var peer = policy_rule_peer(pr);
        var ports = policy_rule_ports(pr);
        var plen = vec_len(ports);
        var j = 0;
        while (j < plen) {
            var pp = vec_get(ports, j);
            var r = rule_new(verdict_accept());
            if (_policy_has_target(np) == 1) { rule_add_match(r, _match_addr(policy_target(np), 0)); }
            if (streq(peer, "any") == 0) {
                rule_add_match(r, _match_addr(peer, 1));
            }
            rule_add_match(r, match_protocol(policy_port_protocol(pp)));
            rule_add_match(r, match_dport(policy_port_port(pp)));
            rule_set_comment(r, _policy_comment(name, "egress", "to", peer));
            vec_push(rules, r);
            j = j + 1;
        }
        i = i + 1;
    }

    # PACT_DENY closes each direction that has rules: whatever the allows above
    # did not match, for this target, is dropped. PACT_ALLOW leaves the rest to
    # the chain's policy.
    if (policy_default_action(np) == PACT_DENY && _policy_has_target(np) == 1) {
        if (ilen > 0) { vec_push(rules, _policy_deny_rule(np, 1)); }
        if (elen > 0) { vec_push(rules, _policy_deny_rule(np, 0)); }
    }

    return rules;
}

# ================================================================
# Convenience: agent-to-agent policy
# ================================================================

fn agent_to_agent(name: cstring, source: cstring, dest: cstring, protocol: i64, port: i64): i64 {
    var np = nein_network_policy_new(name, dest, PACT_DENY);
    var pr = policy_rule_new(source);
    policy_rule_add_port(pr, protocol, port);
    policy_add_ingress(np, pr);
    return np;
}

# --- geoip.cyr ---

# nein geoip module — country-based traffic blocking via nftables sets

# ================================================================
# CountryBlock — { code, cidrs_v4(vec), cidrs_v6(vec) }
# Layout: [code:8][v4:8][v6:8] = 24 bytes
# ================================================================

# Uppercase a C string (in-place on a new copy)
fn _upper_copy(s: cstring): cstring {
    var len = strlen(s);
    var out = alloc(len + 1);
    var i = 0;
    while (i < len) {
        var c = load8(s + i);
        if (c >= 97 && c <= 122) { c = c - 32; }
        store8(out + i, c);
        i = i + 1;
    }
    store8(out + len, 0);
    return out;
}

fn country_block_v4(code: cstring, cidrs: i64): i64 {
    var cb = alloc(24);
    store64(cb, _upper_copy(code));
    store64(cb + 8, cidrs);
    store64(cb + 16, vec_new());
    return cb;
}

fn country_block_dual(code: cstring, cidrs_v4: i64, cidrs_v6: i64): i64 {
    var cb = alloc(24);
    store64(cb, _upper_copy(code));
    store64(cb + 8, cidrs_v4);
    store64(cb + 16, cidrs_v6);
    return cb;
}

fn country_code(cb: i64): i64 { return load64(cb); }
fn country_cidrs_v4(cb: i64): i64 { return load64(cb + 8); }
fn country_cidrs_v6(cb: i64): i64 { return load64(cb + 16); }

# ================================================================
# GeoIpBlocklist — { countries(vec), table_name, hook }
# Layout: [countries:8][table_name:8][hook:8] = 24 bytes
# ================================================================

# The default hook is prerouting (1.9.0, audit B-9). Through 1.8.2 it was
# input, which sees only packets addressed to this host: traffic forwarded to
# a container, or DNAT'd to one (stiva's port maps), never passed the block.
# Prerouting sees every inbound packet before routing decides, and at
# priority -10 runs after conntrack (-200) and DNAT (-100), neither of which
# rewrites the source the block matches. `geoip_set_hook(bl, HOOK_INPUT)`
# restores the old scope.
fn geoip_new(): i64 {
    var bl = alloc(24);
    store64(bl, vec_new());
    store64(bl + 8, "nein_geoip");
    store64(bl + 16, HOOK_PREROUTING);
    return bl;
}

fn geoip_countries(bl: i64): i64 { return load64(bl); }
fn geoip_table_name(bl: i64): i64 { return load64(bl + 8); }
fn geoip_hook(bl: i64): i64 { return load64(bl + 16); }

fn geoip_set_table_name(bl: i64, name: cstring): i64 { store64(bl + 8, name); return bl; }
fn geoip_set_hook(bl: i64, hook: i64): i64 { store64(bl + 16, hook); return bl; }

fn geoip_block_country(bl: i64, cb: i64): i64 {
    vec_push(load64(bl), cb);
    return bl;
}

# ================================================================
# Validate
# ================================================================

# Check country code: exactly 2 ASCII uppercase letters
fn _is_valid_country_code(code: cstring): i64 {
    if (strlen(code) != 2) { return 0; }
    var c0 = load8(code);
    var c1 = load8(code + 1);
    if (c0 < 65 || c0 > 90) { return 0; }
    if (c1 < 65 || c1 > 90) { return 0; }
    return 1;
}

fn _validate_cidr_list(cidrs: i64): i64 {
    var clen = vec_len(cidrs);
    var i = 0;
    var vr = 0;
    while (i < clen) {
        var vr1_t, vr1_v = validate_addr(vec_get(cidrs, i));
        if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
        i = i + 1;
    }
    return nein_ok();
}

# Concat "table_name" + optional suffix
fn _table_name_with_suffix(base: cstring, suffix: cstring): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, base);
    str_builder_add_cstr(sb, suffix);
    var s = str_builder_build(sb);
    var out = alloc(str_len(s) + 1);
    memcpy(out, str_data(s), str_len(s));
    store8(out + str_len(s), 0);
    return out;
}

# 1 when any country carries CIDRs of the family (v6 = 1: IPv6), which the
# build gives a table of its own.
fn _any_has_cidrs(countries: i64, v6: i64): i64 {
    var clen = vec_len(countries);
    var i = 0;
    while (i < clen) {
        var cb = vec_get(countries, i);
        var cidrs = country_cidrs_v4(cb);
        if (v6 == 1) { cidrs = country_cidrs_v6(cb); }
        if (vec_len(cidrs) > 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn geoip_validate(bl: i64): i64 {
    var vr1_t, vr1_v = validate_nft_name(geoip_table_name(bl));
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    # With IPv6 CIDRs the build adds the table `<name>_v6`: a name of 62-64
    # bytes passed through 1.9.0 and composed one past firewall_validate's
    # limit (1.9.1, audit B-8).
    if (_any_has_cidrs(geoip_countries(bl), 1) == 1) {
        var v6_t, v6_v = validate_nft_name(_table_name_with_suffix(geoip_table_name(bl), "_v6"));
        if (is_err_result(v6_t) == 1) { return Err(v6_v); }
    }
    # The block matches SOURCE addresses, so the hook must see inbound packets
    # (1.8.2, audit B-9): `geoip_set_hook(HOOK_OUTPUT)` validated and rendered
    # an `ip saddr @geo_xx drop` that can never match a locally sent packet.
    var h = geoip_hook(bl);
    if (h != HOOK_PREROUTING && h != HOOK_INPUT && h != HOOK_FORWARD) { return nein_err(NEIN_ERR_INVALID_RULE); }

    var countries = geoip_countries(bl);
    var clen = vec_len(countries);
    var i = 0;
    while (i < clen) {
        var cb = vec_get(countries, i);
        if (_is_valid_country_code(country_code(cb)) == 0) {
            return nein_err(NEIN_ERR_INVALID_RULE);
        }
        var vr2_t, vr2_v = _validate_cidr_list(country_cidrs_v4(cb));
        if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
        var vr3_t, vr3_v = _validate_cidr_list(country_cidrs_v6(cb));
        if (is_err_result(vr3_t) == 1) { return Err(vr3_v); }
        i = i + 1;
    }

    return nein_ok();
}

# ================================================================
# Build firewall
# ================================================================

# Lowercase copy
fn _lower_copy(s: cstring): cstring {
    var len = strlen(s);
    var out = alloc(len + 1);
    var i = 0;
    while (i < len) {
        var c = load8(s + i);
        if (c >= 65 && c <= 90) { c = c + 32; }
        store8(out + i, c);
        i = i + 1;
    }
    store8(out + len, 0);
    return out;
}

# Concat "geo_" + lowercase(code)
fn _geo_set_name(code: cstring): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "geo_");
    str_builder_add_cstr(sb, _lower_copy(code));
    var s = str_builder_build(sb);
    var out = alloc(str_len(s) + 1);
    memcpy(out, str_data(s), str_len(s));
    store8(out + str_len(s), 0);
    return out;
}

# Concat "geoblock CODE"
fn _geoblock_comment(code: cstring): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "geoblock ");
    str_builder_add_cstr(sb, code);
    var s = str_builder_build(sb);
    var out = alloc(str_len(s) + 1);
    memcpy(out, str_data(s), str_len(s));
    store8(out + str_len(s), 0);
    return out;
}

# Check if any country has non-empty cidrs in the given family
fn _build_table(bl: i64, family: i64, v6: i64): i64 {
    var suffix = "";
    if (v6 == 1) { suffix = "_v6"; }
    var tname = _table_name_with_suffix(geoip_table_name(bl), suffix);
    var table = table_new(tname, family);

    var chain = chain_base("geoblock", CHAIN_FILTER, geoip_hook(bl), 0 - 10, POLICY_ACCEPT);

    var countries = geoip_countries(bl);
    var clen = vec_len(countries);
    var i = 0;
    while (i < clen) {
        var cb = vec_get(countries, i);
        var cidrs = country_cidrs_v4(cb);
        var stype = SET_IPV4_ADDR;
        var field = "ip saddr";
        if (v6 == 1) {
            cidrs = country_cidrs_v6(cb);
            stype = SET_IPV6_ADDR;
            field = "ip6 saddr";
        }
        var cidrs_len = vec_len(cidrs);
        if (cidrs_len > 0) {
            var set_name = _geo_set_name(country_code(cb));
            var set = nft_set_new(set_name, stype);
            nft_set_add_flag(set, SETFLAG_INTERVAL);
            var j = 0;
            while (j < cidrs_len) {
                nft_set_add_element(set, vec_get(cidrs, j));
                j = j + 1;
            }
            table_add_set(table, set);

            var r = rule_new(verdict_drop());
            rule_add_match(r, match_set_lookup(field, set_name));
            rule_set_comment(r, _geoblock_comment(country_code(cb)));
            chain_add_rule(chain, r);
        }
        i = i + 1;
    }

    table_add_chain(table, chain);
    return table;
}

fn geoip_to_firewall(bl: i64): i64 {
    var fw = firewall_new();
    var countries = geoip_countries(bl);
    if (vec_len(countries) == 0) { return fw; }

    if (_any_has_cidrs(countries, 0) == 1) {
        firewall_add_table(fw, _build_table(bl, FAMILY_IP, 0));
    }
    if (_any_has_cidrs(countries, 1) == 1) {
        firewall_add_table(fw, _build_table(bl, FAMILY_IP6, 1));
    }

    return fw;
}

# --- mesh.cyr ---

# nein mesh module — service mesh sidecar proxy rules

# ================================================================
# SidecarConfig — { inbound_port, outbound_port, proxy_uid,
#   excl_out_cidrs(vec), excl_out_ports(vec), excl_in_ports(vec), table_name }
# Layout: 7 fields * 8 = 56 bytes
# ================================================================

fn mesh_envoy(): i64 {
    var m = alloc(56);
    store64(m, 15006);                           # inbound_port
    store64(m + 8, 15001);                       # outbound_port
    store64(m + 16, 1337);                       # proxy_uid
    store64(m + 24, vec_new());                  # exclude_outbound_cidrs
    store64(m + 32, vec_new());                  # exclude_outbound_ports
    store64(m + 40, vec_new());                  # exclude_inbound_ports
    store64(m + 48, "nein_mesh");                # table_name
    vec_push(load64(m + 24), "127.0.0.0/8");
    return m;
}

fn mesh_inbound_port(m: i64): i64 { return load64(m); }
fn mesh_outbound_port(m: i64): i64 { return load64(m + 8); }
fn mesh_proxy_uid(m: i64): i64 { return load64(m + 16); }
fn mesh_excl_out_cidrs(m: i64): i64 { return load64(m + 24); }
fn mesh_excl_out_ports(m: i64): i64 { return load64(m + 32); }
fn mesh_excl_in_ports(m: i64): i64 { return load64(m + 40); }
fn mesh_table_name(m: i64): i64 { return load64(m + 48); }

fn mesh_set_inbound_port(m: i64, p: i64): i64 { store64(m, p); return m; }
fn mesh_set_outbound_port(m: i64, p: i64): i64 { store64(m + 8, p); return m; }
fn mesh_set_proxy_uid(m: i64, uid: i64): i64 { store64(m + 16, uid); return m; }
fn mesh_set_table_name(m: i64, name: cstring): i64 { store64(m + 48, name); return m; }

fn mesh_exclude_outbound_cidr(m: i64, cidr: cstring): i64 { vec_push(load64(m + 24), cidr); return m; }
fn mesh_exclude_outbound_port(m: i64, port: i64): i64 { vec_push(load64(m + 32), port); return m; }
fn mesh_exclude_inbound_port(m: i64, port: i64): i64 { vec_push(load64(m + 40), port); return m; }

fn mesh_clear_excl_out_cidrs(m: i64): i64 {
    store64(m + 24, vec_new());
    return m;
}

# ================================================================
# Validate
# ================================================================

fn mesh_validate(m: i64): i64 {
    var vr1_t, vr1_v = validate_nft_name(mesh_table_name(m));
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    var cidrs = mesh_excl_out_cidrs(m);
    var clen = vec_len(cidrs);
    var i = 0;
    while (i < clen) {
        var vr2_t, vr2_v = validate_addr(vec_get(cidrs, i));
        if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
        i = i + 1;
    }
    return nein_ok();
}

# ================================================================
# Render helpers — build comment strings
# ================================================================

fn _mesh_cstr_concat(a: cstring, b: cstring): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    var s = str_builder_build(sb);
    var out = alloc(str_len(s) + 1);
    memcpy(out, str_data(s), str_len(s));
    store8(out + str_len(s), 0);
    return out;
}

# Build "meta skuid N" raw match string
fn _raw_meta_skuid(uid: i64): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "meta skuid ");
    str_builder_add_int(sb, uid);
    var s = str_builder_build(sb);
    var out = alloc(str_len(s) + 1);
    memcpy(out, str_data(s), str_len(s));
    store8(out + str_len(s), 0);
    return out;
}

# Build "tcp dport != PORT redirect to :PORT" raw match string
fn _raw_redirect(port: i64): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "tcp dport != ");
    str_builder_add_int(sb, port);
    str_builder_add_cstr(sb, " redirect to :");
    str_builder_add_int(sb, port);
    var s = str_builder_build(sb);
    var out = alloc(str_len(s) + 1);
    memcpy(out, str_data(s), str_len(s));
    store8(out + str_len(s), 0);
    return out;
}

# Build "skip outbound port N" or "skip inbound port N"
fn _skip_port_comment(direction: cstring, port: i64): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "skip ");
    str_builder_add_cstr(sb, direction);
    str_builder_add_cstr(sb, " port ");
    str_builder_add_int(sb, port);
    var s = str_builder_build(sb);
    var out = alloc(str_len(s) + 1);
    memcpy(out, str_data(s), str_len(s));
    store8(out + str_len(s), 0);
    return out;
}

# ================================================================
# Build chains
# ================================================================

fn _mesh_outbound_chain(m: i64): i64 {
    var c = chain_base("mesh_outbound", CHAIN_NAT, HOOK_OUTPUT, 0 - 100, POLICY_ACCEPT);

    # Skip proxy's own traffic
    var r = rule_new(verdict_return());
    rule_add_match(r, match_raw(_raw_meta_skuid(mesh_proxy_uid(m))));
    rule_set_comment(r, "skip proxy traffic");
    chain_add_rule(c, r);

    # Skip excluded CIDRs
    var cidrs = mesh_excl_out_cidrs(m);
    var clen = vec_len(cidrs);
    var i = 0;
    while (i < clen) {
        var cidr = vec_get(cidrs, i);
        r = rule_new(verdict_return());
        rule_add_match(r, match_dest_addr(cidr));
        rule_set_comment(r, _mesh_cstr_concat("skip outbound ", cidr));
        chain_add_rule(c, r);
        i = i + 1;
    }

    # Skip excluded ports
    var ports = mesh_excl_out_ports(m);
    var plen = vec_len(ports);
    i = 0;
    while (i < plen) {
        var port = vec_get(ports, i);
        r = rule_new(verdict_return());
        rule_add_match(r, match_protocol(PROTO_TCP));
        rule_add_match(r, match_dport(port));
        rule_set_comment(r, _skip_port_comment("outbound", port));
        chain_add_rule(c, r);
        i = i + 1;
    }

    # Redirect outbound TCP to proxy. No verdict after it: `redirect` is
    # terminal, and the old trailing `accept` made nft refuse the whole mesh
    # ruleset (1.8.2, audit B-4) — sidecar interception never installed.
    r = rule_new(verdict_none());
    rule_add_match(r, match_raw(_raw_redirect(mesh_outbound_port(m))));
    rule_set_comment(r, "redirect outbound to proxy");
    chain_add_rule(c, r);

    return c;
}

fn _mesh_inbound_chain(m: i64): i64 {
    var c = chain_base("mesh_inbound", CHAIN_NAT, HOOK_PREROUTING, 0 - 100, POLICY_ACCEPT);

    var ports = mesh_excl_in_ports(m);
    var plen = vec_len(ports);
    var i = 0;
    while (i < plen) {
        var port = vec_get(ports, i);
        var r = rule_new(verdict_return());
        rule_add_match(r, match_protocol(PROTO_TCP));
        rule_add_match(r, match_dport(port));
        rule_set_comment(r, _skip_port_comment("inbound", port));
        chain_add_rule(c, r);
        i = i + 1;
    }

    var r = rule_new(verdict_none());
    rule_add_match(r, match_raw(_raw_redirect(mesh_inbound_port(m))));
    rule_set_comment(r, "redirect inbound to proxy");
    chain_add_rule(c, r);

    return c;
}

fn mesh_to_firewall(m: i64): i64 {
    var fw = firewall_new();
    var t = table_new(mesh_table_name(m), FAMILY_IP);
    table_add_chain(t, _mesh_outbound_chain(m));
    table_add_chain(t, _mesh_inbound_chain(m));
    firewall_add_table(fw, t);
    return fw;
}

# --- bridge.cyr ---

# nein bridge module — container bridge firewall management

# ================================================================
# Names the build composes (defined first: the validators check them)
# ================================================================

# "PREFIX_SUFFIX" table name
fn _bf_table_name(prefix: cstring, suffix: cstring): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, prefix);
    str_builder_add_cstr(sb, suffix);
    var s = str_builder_build(sb);
    var out = alloc(str_len(s) + 1);
    memcpy(out, str_data(s), str_len(s));
    store8(out + str_len(s), 0);
    return out;
}

# "iso_NAME" set name
fn _iso_set_name(name: cstring): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "iso_");
    str_builder_add_cstr(sb, name);
    var s = str_builder_build(sb);
    var out = alloc(str_len(s) + 1);
    memcpy(out, str_data(s), str_len(s));
    store8(out + str_len(s), 0);
    return out;
}

# ================================================================
# BridgeConfig — { bridge_name, subnet, outbound_iface, table_prefix }
# Layout: 4 fields * 8 = 32 bytes
# ================================================================

fn bridge_config_new(bridge_name: cstring, subnet: cstring, outbound_iface: cstring): i64 {
    var cfg = alloc(32);
    store64(cfg, bridge_name);
    store64(cfg + 8, subnet);
    store64(cfg + 16, outbound_iface);
    store64(cfg + 24, "nein");
    return cfg;
}

fn bridge_name(cfg: i64): i64 { return load64(cfg); }
fn bridge_subnet(cfg: i64): i64 { return load64(cfg + 8); }
fn bridge_outbound_iface(cfg: i64): i64 { return load64(cfg + 16); }
fn bridge_table_prefix(cfg: i64): i64 { return load64(cfg + 24); }

fn bridge_set_table_prefix(cfg: i64, prefix: cstring): i64 {
    store64(cfg + 24, prefix);
    return cfg;
}

fn bridge_config_validate(cfg: i64): i64 {
    var vr1_t, vr1_v = validate_iface(bridge_name(cfg));
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    var vr2_t, vr2_v = validate_addr(bridge_subnet(cfg));
    if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
    var vr3_t, vr3_v = validate_iface(bridge_outbound_iface(cfg));
    if (is_err_result(vr3_t) == 1) { return Err(vr3_v); }
    var vr4_t, vr4_v = validate_identifier(bridge_table_prefix(cfg));
    if (is_err_result(vr4_t) == 1) { return Err(vr4_v); }
    # The prefix is never rendered alone: the build names its tables
    # `<prefix>_filter`, `<prefix>_nat` and, with isolation groups,
    # `<prefix>_iso`. Each must be a name nft reads, or the firewall fails
    # validation: through 1.9.0 a prefix of 58-64 bytes, or one starting with a
    # digit, passed here (1.9.1, audit B-8). All three are checked whether or
    # not the build makes them, so a config valid here is valid in any build.
    var vf_t, vf_v = validate_nft_name(_bf_table_name(bridge_table_prefix(cfg), "_filter"));
    if (is_err_result(vf_t) == 1) { return Err(vf_v); }
    var vn_t, vn_v = validate_nft_name(_bf_table_name(bridge_table_prefix(cfg), "_nat"));
    if (is_err_result(vn_t) == 1) { return Err(vn_v); }
    var vi_t, vi_v = validate_nft_name(_bf_table_name(bridge_table_prefix(cfg), "_iso"));
    if (is_err_result(vi_t) == 1) { return Err(vi_v); }
    return nein_ok();
}

# ================================================================
# PortMapping — { host_port, container_addr, container_port, protocol }
# Layout: 4 * 8 = 32 bytes
# ================================================================

fn port_mapping_new(host_port: i64, container_addr: cstring, container_port: i64, protocol: i64): i64 {
    var pm = alloc(32);
    store64(pm, host_port);
    store64(pm + 8, container_addr);
    store64(pm + 16, container_port);
    store64(pm + 24, protocol);
    return pm;
}

fn pm_tcp(host_port: i64, container_addr: cstring, container_port: i64): i64 {
    return port_mapping_new(host_port, container_addr, container_port, PROTO_TCP);
}

fn pm_udp(host_port: i64, container_addr: cstring, container_port: i64): i64 {
    return port_mapping_new(host_port, container_addr, container_port, PROTO_UDP);
}

fn pm_host_port(pm: i64): i64 { return load64(pm); }
fn pm_container_addr(pm: i64): i64 { return load64(pm + 8); }
fn pm_container_port(pm: i64): i64 { return load64(pm + 16); }
fn pm_protocol(pm: i64): i64 { return load64(pm + 24); }

fn pm_validate(pm: i64): i64 {
    # Ports and protocol were never checked through 1.8.1 (audit B-7).
    var proto = pm_protocol(pm);
    if (proto != PROTO_TCP && proto != PROTO_UDP) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var hp = pm_host_port(pm);
    var cp = pm_container_port(pm);
    if (hp < 1 || hp > 65535 || cp < 1 || cp > 65535) { return nein_err(NEIN_ERR_INVALID_RULE); }
    return validate_addr(pm_container_addr(pm));
}

# Build "portmap PROTO:HPORT -> ADDR:CPORT"
fn _pm_comment(pm: i64): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "portmap ");
    str_builder_add_cstr(sb, _proto_str(pm_protocol(pm)));
    str_builder_add_cstr(sb, ":");
    str_builder_add_int(sb, pm_host_port(pm));
    str_builder_add_cstr(sb, " -> ");
    str_builder_add_cstr(sb, pm_container_addr(pm));
    str_builder_add_cstr(sb, ":");
    str_builder_add_int(sb, pm_container_port(pm));
    var s = str_builder_build(sb);
    var out = alloc(str_len(s) + 1);
    memcpy(out, str_data(s), str_len(s));
    store8(out + str_len(s), 0);
    return out;
}

# Build "allow portmap -> ADDR:CPORT"
fn _pm_forward_comment(pm: i64): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "allow portmap -> ");
    str_builder_add_cstr(sb, pm_container_addr(pm));
    str_builder_add_cstr(sb, ":");
    str_builder_add_int(sb, pm_container_port(pm));
    var s = str_builder_build(sb);
    var out = alloc(str_len(s) + 1);
    memcpy(out, str_data(s), str_len(s));
    store8(out + str_len(s), 0);
    return out;
}

fn _pm_to_nat_rule(pm: i64): i64 {
    return nat_dnat(pm_protocol(pm), pm_host_port(pm), pm_container_addr(pm),
      pm_container_port(pm), _pm_comment(pm));
}

fn _pm_to_forward_rule(pm: i64): i64 {
    var r = rule_new(verdict_accept());
    rule_add_match(r, _match_addr(pm_container_addr(pm), 1));
    # Only traffic that came in through the published host port (1.8.2, audit
    # B-1): without `ct status dnat` the container port was also reachable by
    # routing straight to the container's address — verified live, a LAN
    # client reached 172.17.1.2:80 with no DNAT involved. Docker 28 closed the
    # same direct-routing path. A constant string, so MATCH_RAW is safe here.
    rule_add_match(r, match_raw("ct status dnat"));
    rule_add_match(r, match_protocol(pm_protocol(pm)));
    rule_add_match(r, match_dport(pm_container_port(pm)));
    rule_set_comment(r, _pm_forward_comment(pm));
    return r;
}

# ================================================================
# IsolationGroup — { name, cidrs(vec) }
# Layout: [name:8][cidrs:8] = 16 bytes
# ================================================================

fn isolation_group_new(name: cstring, cidrs: i64): i64 {
    var g = alloc(16);
    store64(g, name);
    store64(g + 8, cidrs);
    return g;
}

fn iso_name(g: i64): i64 { return load64(g); }
fn iso_cidrs(g: i64): i64 { return load64(g + 8); }

fn iso_validate(g: i64): i64 {
    var vr1_t, vr1_v = validate_identifier(iso_name(g));
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    # Rendered as the set `iso_<name>`: a name of 61-64 bytes passed through
    # 1.9.0 and composed one past firewall_validate's limit (1.9.1, B-8).
    var vs_t, vs_v = validate_nft_name(_iso_set_name(iso_name(g)));
    if (is_err_result(vs_t) == 1) { return Err(vs_v); }
    var cidrs = iso_cidrs(g);
    var clen = vec_len(cidrs);
    var i = 0;
    while (i < clen) {
        var vr2_t, vr2_v = validate_addr(vec_get(cidrs, i));
        if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
        i = i + 1;
    }
    return nein_ok();
}

# ================================================================
# BridgeFirewall — { config, port_mappings(vec), isolation_groups(vec) }
# Layout: [config:8][pms:8][groups:8] = 24 bytes
# ================================================================

fn bridge_firewall_new(cfg: i64): i64 {
    var bf = alloc(24);
    store64(bf, cfg);
    store64(bf + 8, vec_new());
    store64(bf + 16, vec_new());
    return bf;
}

fn bf_config(bf: i64): i64 { return load64(bf); }
fn bf_port_mappings(bf: i64): i64 { return load64(bf + 8); }
fn bf_isolation_groups(bf: i64): i64 { return load64(bf + 16); }

# Returns the index of the new mapping, or Err on duplicate
fn bf_add_port_mapping(bf: i64, pm: i64): i64 {
    var pms = load64(bf + 8);
    var plen = vec_len(pms);
    var i = 0;
    while (i < plen) {
        var existing = vec_get(pms, i);
        if (pm_host_port(existing) == pm_host_port(pm)) {
            if (pm_protocol(existing) == pm_protocol(pm)) {
                return nein_err(NEIN_ERR_INVALID_RULE);
            }
        }
        i = i + 1;
    }
    vec_push(pms, pm);
    return Ok(plen);
}

# Remove by host port + protocol; returns Some(pm) or None()
fn bf_remove_port_mapping(bf: i64, host_port: i64, protocol: i64): i64 {
    var pms = load64(bf + 8);
    var plen = vec_len(pms);
    var i = 0;
    while (i < plen) {
        var existing = vec_get(pms, i);
        if (pm_host_port(existing) == host_port) {
            if (pm_protocol(existing) == protocol) {
                # Rebuild vec without index i
                var new_pms = vec_new();
                var j = 0;
                while (j < plen) {
                    if (j != i) { vec_push(new_pms, vec_get(pms, j)); }
                    j = j + 1;
                }
                store64(bf + 8, new_pms);
                return Some(existing);
            }
        }
        i = i + 1;
    }
    return None();
}

fn bf_add_isolation_group(bf: i64, g: i64): i64 {
    vec_push(load64(bf + 16), g);
    return bf;
}

fn bf_validate(bf: i64): i64 {
    var vr1_t, vr1_v = bridge_config_validate(bf_config(bf));
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }

    var pms = bf_port_mappings(bf);
    var plen = vec_len(pms);
    var i = 0;
    while (i < plen) {
        var vr2_t, vr2_v = pm_validate(vec_get(pms, i));
        if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
        i = i + 1;
    }

    var groups = bf_isolation_groups(bf);
    var glen = vec_len(groups);
    i = 0;
    while (i < glen) {
        var vr3_t, vr3_v = iso_validate(vec_get(groups, i));
        if (is_err_result(vr3_t) == 1) { return Err(vr3_v); }
        i = i + 1;
    }

    return nein_ok();
}

# --- Build helpers ---

# "intra-group: NAME"
fn _iso_comment(name: cstring): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "intra-group: ");
    str_builder_add_cstr(sb, name);
    var s = str_builder_build(sb);
    var out = alloc(str_len(s) + 1);
    memcpy(out, str_data(s), str_len(s));
    store8(out + str_len(s), 0);
    return out;
}

fn _bf_build_filter(bf: i64): i64 {
    var cfg = bf_config(bf);
    var t = table_new(_bf_table_name(bridge_table_prefix(cfg), "_filter"), FAMILY_INET);

    var forward = chain_base("forward", CHAIN_FILTER, HOOK_FORWARD, 0, POLICY_DROP);

    # Allow established/related
    chain_add_rule(forward, allow_established());

    # Port mapping forward allows
    var pms = bf_port_mappings(bf);
    var plen = vec_len(pms);
    var i = 0;
    while (i < plen) {
        chain_add_rule(forward, _pm_to_forward_rule(vec_get(pms, i)));
        i = i + 1;
    }

    var groups = bf_isolation_groups(bf);
    var glen = vec_len(groups);

    if (glen == 0) {
        # No isolation: allow all bridge traffic
        var r1 = rule_new(verdict_accept());
        rule_add_match(r1, match_iif(bridge_name(cfg)));
        rule_add_match(r1, match_oif(bridge_outbound_iface(cfg)));
        rule_set_comment(r1, "bridge to outbound");
        chain_add_rule(forward, r1);

        var r2 = rule_new(verdict_accept());
        rule_add_match(r2, match_iif(bridge_name(cfg)));
        rule_add_match(r2, match_oif(bridge_name(cfg)));
        rule_set_comment(r2, "intra-bridge");
        chain_add_rule(forward, r2);
    } else {
        # With isolation: bridge -> outbound for all groups, then per-group set lookups
        var rb = rule_new(verdict_accept());
        rule_add_match(rb, match_iif(bridge_name(cfg)));
        rule_add_match(rb, match_oif(bridge_outbound_iface(cfg)));
        rule_set_comment(rb, "bridge to outbound");
        chain_add_rule(forward, rb);

        i = 0;
        while (i < glen) {
            var g = vec_get(groups, i);
            var cidrs = iso_cidrs(g);
            var clen = vec_len(cidrs);
            if (clen > 0) {
                var sname = _iso_set_name(iso_name(g));
                var set = nft_set_new(sname, SET_IPV4_ADDR);
                nft_set_add_flag(set, SETFLAG_INTERVAL);
                var j = 0;
                while (j < clen) {
                    nft_set_add_element(set, vec_get(cidrs, j));
                    j = j + 1;
                }
                table_add_set(t, set);

                var r = rule_new(verdict_accept());
                rule_add_match(r, match_set_lookup("ip saddr", sname));
                rule_add_match(r, match_set_lookup("ip daddr", sname));
                rule_set_comment(r, _iso_comment(iso_name(g)));
                chain_add_rule(forward, r);
            }
            i = i + 1;
        }
    }

    table_add_chain(t, forward);
    return t;
}

fn _bf_build_nat(bf: i64): i64 {
    var cfg = bf_config(bf);
    var t = table_new(_bf_table_name(bridge_table_prefix(cfg), "_nat"), FAMILY_IP);

    var pms = bf_port_mappings(bf);
    var plen = vec_len(pms);

    # Prerouting only if there are port mappings
    if (plen > 0) {
        var prerouting = chain_base("prerouting", CHAIN_NAT, HOOK_PREROUTING, 0 - 100, POLICY_ACCEPT);
        var i = 0;
        while (i < plen) {
            chain_add_nat_rule(prerouting, _pm_to_nat_rule(vec_get(pms, i)));
            i = i + 1;
        }
        table_add_chain(t, prerouting);
    }

    # Postrouting: masquerade
    var postrouting = chain_base("postrouting", CHAIN_NAT, HOOK_POSTROUTING, 100, POLICY_ACCEPT);
    chain_add_nat_rule(postrouting, container_masquerade(bridge_subnet(cfg), bridge_outbound_iface(cfg)));
    table_add_chain(t, postrouting);

    return t;
}

# Isolation at layer 2 (1.8.2, audit B-5). The inet forward chain above only
# sees ROUTED traffic. Containers on the same bridge reach each other by L2
# switching, which never enters the inet forward hook unless br_netfilter is
# loaded — so through 1.8.1 isolation groups did nothing on a single bridge
# (verified live: tenantB reached an unmapped tenantA port). This table sits
# on the bridge's own forward hook, which sees every frame switched between
# its ports: IPv4 within a group is accepted, every other IPv4 or IPv6 frame
# between ports of this bridge is dropped — the same intra-group-only policy
# the inet chain states, enforced where the traffic actually flows. ARP,
# traffic to the host and routed traffic (published ports) are untouched.
fn _bf_bridge_match(cfg: i64): cstring {
    var name = bridge_name(cfg);
    var vn_t, vn_v = validate_iface(name);
    # MATCH_RAW is not re-validated, so the name is checked here; an invalid
    # one renders a token nft refuses rather than reaching nft text.
    if (is_err_result(vn_t) == 1) { return "__nein_invalid_bridge__"; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "meta ibrname \"");
    str_builder_add_cstr(sb, name);
    str_builder_add_cstr(sb, "\"");
    var s = str_builder_build(sb);
    var out = alloc(str_len(s) + 1);
    memcpy(out, str_data(s), str_len(s));
    store8(out + str_len(s), 0);
    return out;
}

fn _bf_build_iso(bf: i64): i64 {
    var cfg = bf_config(bf);
    var t = table_new(_bf_table_name(bridge_table_prefix(cfg), "_iso"), FAMILY_BRIDGE);
    var forward = chain_base("forward", CHAIN_FILTER, HOOK_FORWARD, 0, POLICY_ACCEPT);
    var br = _bf_bridge_match(cfg);
    var groups = bf_isolation_groups(bf);
    var glen = vec_len(groups);
    var i = 0;
    while (i < glen) {
        var g = vec_get(groups, i);
        var cidrs = iso_cidrs(g);
        var clen = vec_len(cidrs);
        if (clen > 0) {
            var sname = _iso_set_name(iso_name(g));
            var set = nft_set_new(sname, SET_IPV4_ADDR);
            nft_set_add_flag(set, SETFLAG_INTERVAL);
            var j = 0;
            while (j < clen) {
                nft_set_add_element(set, vec_get(cidrs, j));
                j = j + 1;
            }
            table_add_set(t, set);
            var r = rule_new(verdict_accept());
            rule_add_match(r, match_raw(br));
            rule_add_match(r, match_set_lookup("ip saddr", sname));
            rule_add_match(r, match_set_lookup("ip daddr", sname));
            rule_set_comment(r, _iso_comment(iso_name(g)));
            chain_add_rule(forward, r);
        }
        i = i + 1;
    }
    var d4 = rule_new(verdict_drop());
    rule_add_match(d4, match_raw(br));
    rule_add_match(d4, match_raw("ether type ip"));
    rule_set_comment(d4, "isolation: no IPv4 between groups");
    chain_add_rule(forward, d4);
    var d6 = rule_new(verdict_drop());
    rule_add_match(d6, match_raw(br));
    rule_add_match(d6, match_raw("ether type ip6"));
    rule_set_comment(d6, "isolation: no IPv6 between containers");
    chain_add_rule(forward, d6);
    table_add_chain(t, forward);
    return t;
}

fn bf_to_firewall(bf: i64): i64 {
    var fw = firewall_new();
    firewall_add_table(fw, _bf_build_filter(bf));
    firewall_add_table(fw, _bf_build_nat(bf));
    if (vec_len(bf_isolation_groups(bf)) > 0) { firewall_add_table(fw, _bf_build_iso(bf)); }
    return fw;
}

# --- engine.cyr ---

# nein engine module — multi-agent policy engine
#
# Manages network policies across multiple agents, generating a coherent
# nftables firewall from all active policies.

# ================================================================
# Transport enum — distinguishes TCP, UDP, and QUIC (QUIC maps to UDP protocol)
# ================================================================

enum TransportEnum {
    TRANS_TCP = 1;
    TRANS_UDP = 2;
    TRANS_QUIC = 3;
}

fn transport_protocol(t: i64): i64 {
    if (t == TRANS_TCP) { return PROTO_TCP; }
    return PROTO_UDP;
}

fn transport_label(t: i64): cstring {
    if (t == TRANS_TCP) { return "tcp"; }
    if (t == TRANS_UDP) { return "udp"; }
    if (t == TRANS_QUIC) { return "quic"; }
    return "tcp";
}

# ================================================================
# PortSpec — { protocol, port, transport }
# Layout: [protocol:8][port:8][transport:8] = 24 bytes
# ================================================================

fn port_spec_new(protocol: i64, port: i64, transport: i64): i64 {
    var ps = alloc(24);
    store64(ps, protocol);
    store64(ps + 8, port);
    store64(ps + 16, transport);
    return ps;
}

fn ps_tcp(port: i64): i64 { return port_spec_new(PROTO_TCP, port, TRANS_TCP); }
fn ps_udp(port: i64): i64 { return port_spec_new(PROTO_UDP, port, TRANS_UDP); }
fn ps_quic(port: i64): i64 { return port_spec_new(PROTO_UDP, port, TRANS_QUIC); }

fn ps_protocol(ps: i64): i64 { return load64(ps); }
fn ps_port(ps: i64): i64 { return load64(ps + 8); }
fn ps_transport(ps: i64): i64 { return load64(ps + 16); }

# ================================================================
# AgentPolicy — { agent_id, agent_addr, allowed_inbound(vec),
#   allowed_outbound(vec), allowed_outbound_hosts(vec),
#   allow_established, allow_loopback }
# Layout: 7 fields * 8 = 56 bytes
# ================================================================

fn agent_policy_new(agent_id: cstring, agent_addr: cstring): i64 {
    var ap = alloc(56);
    store64(ap, agent_id);
    store64(ap + 8, agent_addr);
    store64(ap + 16, vec_new());
    store64(ap + 24, vec_new());
    store64(ap + 32, vec_new());
    store64(ap + 40, 1);       # allow_established default true
    store64(ap + 48, 1);       # allow_loopback default true
    return ap;
}

fn ap_agent_id(ap: i64): i64 { return load64(ap); }
fn ap_agent_addr(ap: i64): i64 { return load64(ap + 8); }
fn ap_allowed_inbound(ap: i64): i64 { return load64(ap + 16); }
fn ap_allowed_outbound(ap: i64): i64 { return load64(ap + 24); }
fn ap_allowed_outbound_hosts(ap: i64): i64 { return load64(ap + 32); }
fn ap_allow_established(ap: i64): i64 { return load64(ap + 40); }
fn ap_allow_loopback(ap: i64): i64 { return load64(ap + 48); }

fn ap_allow_inbound(ap: i64, ps: i64): i64 { vec_push(load64(ap + 16), ps); return ap; }
fn ap_allow_outbound(ap: i64, ps: i64): i64 { vec_push(load64(ap + 24), ps); return ap; }
fn ap_allow_outbound_host(ap: i64, cidr: cstring): i64 { vec_push(load64(ap + 32), cidr); return ap; }
fn ap_set_allow_established(ap: i64, flag: i64): i64 { store64(ap + 40, flag); return ap; }
fn ap_set_allow_loopback(ap: i64, flag: i64): i64 { store64(ap + 48, flag); return ap; }

# ================================================================
# Names the build composes from an agent id (defined here, ahead of
# ap_validate, which checks them)
# ================================================================

fn _cstr_from_sb(sb: i64): cstring {
    var s = str_builder_build(sb);
    var out = alloc(str_len(s) + 1);
    memcpy(out, str_data(s), str_len(s));
    store8(out + str_len(s), 0);
    return out;
}

# "AGENT_ID_in" or "AGENT_ID_out"
fn _chain_name(agent_id: cstring, suffix: cstring): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, agent_id);
    str_builder_add_cstr(sb, suffix);
    return _cstr_from_sb(sb);
}

# "AGENT_ID_hosts" — set name for host restrictions
fn _host_set_name(agent_id: cstring): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, agent_id);
    str_builder_add_cstr(sb, "_hosts");
    return _cstr_from_sb(sb);
}

# Ok when every port spec in specs holds the numbers firewall_validate will
# (rule.cyr, _rule_match_numbers_ok): a protocol nft has and a port 0-65535.
# Through 1.9.0 `ps_tcp(70000)` passed ap_validate and the firewall built from
# it failed validation (1.9.1, the audit B-8 class).
fn _ap_ports_ok(specs: i64): i64 {
    var n = vec_len(specs);
    var i = 0;
    while (i < n) {
        var ps = vec_get(specs, i);
        if (_in_range(ps_protocol(ps), PROTO_TCP, PROTO_ICMPV6) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if (_in_range(ps_port(ps), 0, 65535) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
        i = i + 1;
    }
    return nein_ok();
}

fn ap_validate(ap: i64): i64 {
    var vr1_t, vr1_v = validate_identifier(ap_agent_id(ap));
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    # The names the build composes from the id (1.9.1, audit B-8): chains
    # `<id>_in` and `<id>_out`, and with outbound hosts the set `<id>_hosts`.
    # Each must be a name nft reads, or the firewall this agent builds fails
    # validation: through 1.9.0 an id of 61-64 bytes passed here and composed
    # a chain name past firewall_validate's 64 bytes, and an id starting with
    # a digit (`3f2a`, a container id) composed `3f2a_in`, which nft refuses.
    var vi_t, vi_v = validate_nft_name(_chain_name(ap_agent_id(ap), "_in"));
    if (is_err_result(vi_t) == 1) { return Err(vi_v); }
    var vo_t, vo_v = validate_nft_name(_chain_name(ap_agent_id(ap), "_out"));
    if (is_err_result(vo_t) == 1) { return Err(vo_v); }
    if (vec_len(ap_allowed_outbound_hosts(ap)) > 0) {
        var vs_t, vs_v = validate_nft_name(_host_set_name(ap_agent_id(ap)));
        if (is_err_result(vs_t) == 1) { return Err(vs_v); }
    }
    var pi_t, pi_v = _ap_ports_ok(ap_allowed_inbound(ap));
    if (is_err_result(pi_t) == 1) { return Err(pi_v); }
    var po_t, po_v = _ap_ports_ok(ap_allowed_outbound(ap));
    if (is_err_result(po_t) == 1) { return Err(po_v); }
    var vr2_t, vr2_v = validate_addr(ap_agent_addr(ap));
    if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
    # An agent is ONE host (1.8.2, audit B-3). Dispatch jumps on the agent's
    # address and every agent chain ends in a terminal drop, so an agent whose
    # address was a CIDR — `0.0.0.0/0`, a `/24` — captured every other agent in
    # that range, and whichever sorted first by name decided their traffic.
    # Verified live: an "admin" agent at 10.0.0.0/24 allowing tcp/22 let a
    # remote host reach svc-a's port 22, which svc-a's own policy denies.
    if (_addr_is_host(ap_agent_addr(ap)) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var hosts = ap_allowed_outbound_hosts(ap);
    var hlen = vec_len(hosts);
    var i = 0;
    while (i < hlen) {
        var vr3_t, vr3_v = validate_addr(vec_get(hosts, i));
        if (is_err_result(vr3_t) == 1) { return Err(vr3_v); }
        # Same family as the agent (see _ap_build_outbound_rules).
        var hfam = _addr_family(vec_get(hosts, i));
        if (hfam != _addr_family(ap_agent_addr(ap))) { return nein_err(NEIN_ERR_INVALID_RULE); }
        i = i + 1;
    }
    return nein_ok();
}

# ================================================================
# Comment builders for engine rules
# ================================================================

# "AGENT_ID loopback"
fn _loopback_comment(agent_id: cstring): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, agent_id);
    str_builder_add_cstr(sb, " loopback");
    return _cstr_from_sb(sb);
}

# "AGENT_ID loopback out"
fn _loopback_out_comment(agent_id: cstring): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, agent_id);
    str_builder_add_cstr(sb, " loopback out");
    return _cstr_from_sb(sb);
}

# "AGENT_ID DIR LABEL:PORT"
fn _port_comment(agent_id: cstring, direction: cstring, label: cstring, port: i64): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, agent_id);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, direction);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, label);
    str_builder_add_cstr(sb, ":");
    str_builder_add_int(sb, port);
    return _cstr_from_sb(sb);
}

# "AGENT_ID outbound LABEL:PORT restricted"
fn _port_restricted_comment(agent_id: cstring, label: cstring, port: i64): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, agent_id);
    str_builder_add_cstr(sb, " outbound ");
    str_builder_add_cstr(sb, label);
    str_builder_add_cstr(sb, ":");
    str_builder_add_int(sb, port);
    str_builder_add_cstr(sb, " restricted");
    return _cstr_from_sb(sb);
}

# "AGENT_ID default deny DIR"
fn _default_deny_comment(agent_id: cstring, direction: cstring): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, agent_id);
    str_builder_add_cstr(sb, " default deny ");
    str_builder_add_cstr(sb, direction);
    return _cstr_from_sb(sb);
}

# "dispatch DIR to/from AGENT_ID"
fn _dispatch_comment(direction: cstring, preposition: cstring, agent_id: cstring): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "dispatch ");
    str_builder_add_cstr(sb, direction);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, preposition);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, agent_id);
    return _cstr_from_sb(sb);
}

# ================================================================
# Build rules for an agent
# ================================================================

fn _ap_build_inbound_rules(ap: i64): i64 {
    var rules = vec_new();
    var agent_id = ap_agent_id(ap);

    if (ap_allow_established(ap) == 1) {
        vec_push(rules, allow_established());
    }

    if (ap_allow_loopback(ap) == 1) {
        # Loopback FROM THE AGENT ITSELF only (1.8.2, audit B-2). Traffic
        # between two local addresses always crosses `lo`, so a bare
        # `iif "lo" accept` in every agent chain accepted ALL agent-to-agent
        # traffic on the host and cancelled each agent's inbound policy —
        # verified live: svc-b reached svc-a:22 though svc-a allows only 8080.
        # The agent can still reach itself; other agents now meet its policy.
        var r = rule_new(verdict_accept());
        rule_add_match(r, match_iif("lo"));
        rule_add_match(r, _match_addr(ap_agent_addr(ap), 0));
        rule_set_comment(r, _loopback_comment(agent_id));
        vec_push(rules, r);
    }

    var specs = ap_allowed_inbound(ap);
    var slen = vec_len(specs);
    var i = 0;
    while (i < slen) {
        var ps = vec_get(specs, i);
        var r = rule_new(verdict_accept());
        rule_add_match(r, match_protocol(ps_protocol(ps)));
        rule_add_match(r, match_dport(ps_port(ps)));
        rule_set_comment(r, _port_comment(agent_id, "inbound", transport_label(ps_transport(ps)), ps_port(ps)));
        vec_push(rules, r);
        i = i + 1;
    }

    return rules;
}

# Returns [rules_vec, host_set_or_0]
# Stored as 16 bytes: [rules:8][set:8]
fn _ap_build_outbound_rules(ap: i64): i64 {
    var result = alloc(16);
    var rules = vec_new();
    var agent_id = ap_agent_id(ap);

    if (ap_allow_established(ap) == 1) {
        vec_push(rules, allow_established());
    }

    if (ap_allow_loopback(ap) == 1) {
        # Mirror of the inbound rule (B-2): loopback TO the agent itself only.
        var r = rule_new(verdict_accept());
        rule_add_match(r, match_oif("lo"));
        rule_add_match(r, _match_addr(ap_agent_addr(ap), 1));
        rule_set_comment(r, _loopback_out_comment(agent_id));
        vec_push(rules, r);
    }

    # Build host restriction set if there are any
    var host_set = 0;
    var hosts = ap_allowed_outbound_hosts(ap);
    var hlen = vec_len(hosts);
    # The set is the AGENT's family (1.8.2): its packets carry its own address,
    # so every allowed host is that family too. It was always ipv4_addr, so an
    # IPv6 agent's host list could never load.
    var host_field = "ip daddr";
    var host_stype = SET_IPV4_ADDR;
    if (_addr_family(ap_agent_addr(ap)) == 6) {
        host_field = "ip6 daddr";
        host_stype = SET_IPV6_ADDR;
    }
    if (hlen > 0) {
        var set_name = _host_set_name(agent_id);
        host_set = nft_set_new(set_name, host_stype);
        nft_set_add_flag(host_set, SETFLAG_INTERVAL);
        var i = 0;
        while (i < hlen) {
            nft_set_add_element(host_set, vec_get(hosts, i));
            i = i + 1;
        }
    }

    var specs = ap_allowed_outbound(ap);
    var slen = vec_len(specs);
    var i = 0;
    while (i < slen) {
        var ps = vec_get(specs, i);
        var r = rule_new(verdict_accept());
        rule_add_match(r, match_protocol(ps_protocol(ps)));
        rule_add_match(r, match_dport(ps_port(ps)));
        if (host_set != 0) {
            rule_add_match(r, match_set_lookup(host_field, nft_set_name(host_set)));
            rule_set_comment(r, _port_restricted_comment(agent_id, transport_label(ps_transport(ps)), ps_port(ps)));
        } else {
            rule_set_comment(r, _port_comment(agent_id, "outbound", transport_label(ps_transport(ps)), ps_port(ps)));
        }
        vec_push(rules, r);
        i = i + 1;
    }

    store64(result, rules);
    store64(result + 8, host_set);
    return result;
}

# ================================================================
# PolicyEngine — { agents(vec of AgentPolicy, ordered by agent_id),
#   table_name }
# Layout: [agents:8][table_name:8] = 16 bytes
# ================================================================

fn policy_engine_new(): i64 {
    var pe = alloc(16);
    store64(pe, vec_new());
    store64(pe + 8, "nein_agents");
    return pe;
}

fn pe_agents(pe: i64): i64 { return load64(pe); }
fn pe_table_name(pe: i64): i64 { return load64(pe + 8); }

fn pe_set_table_name(pe: i64, name: cstring): i64 {
    store64(pe + 8, name);
    return pe;
}

fn pe_agent_count(pe: i64): i64 { return vec_len(load64(pe)); }

# Agent ids in registration order — Vec<cstring>. The ids are borrowed from
# the AgentPolicy objects, not copied, so they stay valid exactly as long as
# the engine does.
fn pe_agent_ids(pe: i64): i64 {
    var out = vec_new();
    var agents = pe_agents(pe);
    var n = vec_len(agents);
    var i = 0;
    while (i < n) {
        vec_push(out, ap_agent_id(vec_get(agents, i)));
        i = i + 1;
    }
    return out;
}

# Find agent index by id (returns 0-based index or -1)
fn _pe_find_index(pe: i64, agent_id: cstring): i64 {
    var agents = load64(pe);
    var alen = vec_len(agents);
    var i = 0;
    while (i < alen) {
        if (streq(ap_agent_id(vec_get(agents, i)), agent_id) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Byte-wise C-string comparison: returns -1, 0, or 1
fn _strcmp_cstr(a: cstring, b: cstring): i64 {
    var i = 0;
    while (1) {
        var ca = load8(a + i);
        var cb = load8(b + i);
        if (ca != cb) {
            if (ca < cb) { return 0 - 1; }
            return 1;
        }
        if (ca == 0) { return 0; }
        i = i + 1;
    }
    return 0;
}

# Insert while maintaining sorted-by-agent_id order
fn _pe_insert_sorted(pe: i64, policy: i64): i64 {
    var agents = load64(pe);
    var alen = vec_len(agents);
    var new_agents = vec_new();
    var aid = ap_agent_id(policy);
    var inserted = 0;
    var i = 0;
    while (i < alen) {
        var existing = vec_get(agents, i);
        if (inserted == 0) {
            if (_strcmp_cstr(ap_agent_id(existing), aid) > 0) {
                vec_push(new_agents, policy);
                inserted = 1;
            }
        }
        vec_push(new_agents, existing);
        i = i + 1;
    }
    if (inserted == 0) { vec_push(new_agents, policy); }
    store64(pe, new_agents);
    return 0;
}

# Add or update an agent. Returns Some(prev_policy) on update, None on new.
fn pe_add_agent(pe: i64, policy: i64): i64 {
    var idx = _pe_find_index(pe, ap_agent_id(policy));
    if (idx >= 0) {
        var agents = load64(pe);
        var prev = vec_get(agents, idx);
        # Replace in place: rebuild vec with policy substituted
        var new_agents = vec_new();
        var alen = vec_len(agents);
        var i = 0;
        while (i < alen) {
            if (i == idx) { vec_push(new_agents, policy); }
            else { vec_push(new_agents, vec_get(agents, i)); }
            i = i + 1;
        }
        store64(pe, new_agents);
        return Some(prev);
    }
    _pe_insert_sorted(pe, policy);
    return None();
}

fn pe_remove_agent(pe: i64, agent_id: cstring): i64 {
    var idx = _pe_find_index(pe, agent_id);
    if (idx < 0) { return None(); }
    var agents = load64(pe);
    var removed = vec_get(agents, idx);
    var new_agents = vec_new();
    var alen = vec_len(agents);
    var i = 0;
    while (i < alen) {
        if (i != idx) { vec_push(new_agents, vec_get(agents, i)); }
        i = i + 1;
    }
    store64(pe, new_agents);
    return Some(removed);
}

fn pe_get_agent(pe: i64, agent_id: cstring): i64 {
    var idx = _pe_find_index(pe, agent_id);
    if (idx < 0) { return None(); }
    return Some(vec_get(load64(pe), idx));
}

fn pe_validate(pe: i64): i64 {
    var vr1_t, vr1_v = validate_nft_name(pe_table_name(pe));
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    var agents = pe_agents(pe);
    var alen = vec_len(agents);
    var i = 0;
    while (i < alen) {
        var vr2_t, vr2_v = ap_validate(vec_get(agents, i));
        if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
        i = i + 1;
    }
    # No two agents on one address (B-3): the second's chain would never be
    # reached, its policy silently replaced by the first's. Compared as
    # canonical bytes, so "fd00::1" and "fd00:0::1" are one address. Each
    # address is parsed once, into its own 16 bytes of `canon` (alen * 16
    # bytes): through 1.9.0 the inner loop re-parsed every later address for
    # every agent, n^2/2 parses (1.1 ms at 100 agents; 1.9.1).
    if (alen < 2) { return nein_ok(); }
    var canon = alloc(alen * 16);
    i = 0;
    while (i < alen) {
        _addr_bytes(ap_agent_addr(vec_get(agents, i)), canon + i * 16);
        i = i + 1;
    }
    i = 0;
    while (i < alen) {
        var j = i + 1;
        while (j < alen) {
            if (memeq(canon + i * 16, canon + j * 16, 16) == 1) { return nein_err(NEIN_ERR_INVALID_RULE); }
            j = j + 1;
        }
        i = i + 1;
    }
    return nein_ok();
}

# ================================================================
# Build the full firewall
# ================================================================

fn pe_to_firewall(pe: i64): i64 {
    var fw = firewall_new();
    var agents = pe_agents(pe);
    var alen = vec_len(agents);
    if (alen == 0) { return fw; }

    var t = table_new(pe_table_name(pe), FAMILY_INET);

    var input = chain_base("input", CHAIN_FILTER, HOOK_INPUT, 0, POLICY_DROP);
    var output = chain_base("output", CHAIN_FILTER, HOOK_OUTPUT, 0, POLICY_DROP);

    var i = 0;
    while (i < alen) {
        var policy = vec_get(agents, i);
        var agent_id = ap_agent_id(policy);
        var agent_addr = ap_agent_addr(policy);

        # Dispatch inbound
        var in_name = _chain_name(agent_id, "_in");
        var out_name = _chain_name(agent_id, "_out");

        var disp_in = rule_new(verdict_jump(in_name));
        rule_add_match(disp_in, _match_addr(agent_addr, 1));
        rule_set_comment(disp_in, _dispatch_comment("inbound", "to", agent_id));
        chain_add_rule(input, disp_in);

        var disp_out = rule_new(verdict_jump(out_name));
        rule_add_match(disp_out, _match_addr(agent_addr, 0));
        rule_set_comment(disp_out, _dispatch_comment("outbound", "from", agent_id));
        chain_add_rule(output, disp_out);

        # Per-agent inbound chain
        var in_chain = chain_regular(in_name);
        var in_rules = _ap_build_inbound_rules(policy);
        var irlen = vec_len(in_rules);
        var j = 0;
        while (j < irlen) {
            chain_add_rule(in_chain, vec_get(in_rules, j));
            j = j + 1;
        }
        var deny_in = rule_new(verdict_drop());
        rule_set_comment(deny_in, _default_deny_comment(agent_id, "inbound"));
        chain_add_rule(in_chain, deny_in);
        table_add_chain(t, in_chain);

        # Per-agent outbound chain
        var out_chain = chain_regular(out_name);
        var out_result = _ap_build_outbound_rules(policy);
        var host_set = load64(out_result + 8);
        if (host_set != 0) {
            table_add_set(t, host_set);
        }
        var out_rules = load64(out_result);
        var orlen = vec_len(out_rules);
        j = 0;
        while (j < orlen) {
            chain_add_rule(out_chain, vec_get(out_rules, j));
            j = j + 1;
        }
        var deny_out = rule_new(verdict_drop());
        rule_set_comment(deny_out, _default_deny_comment(agent_id, "outbound"));
        chain_add_rule(out_chain, deny_out);
        table_add_chain(t, out_chain);

        i = i + 1;
    }

    table_add_chain(t, input);
    table_add_chain(t, output);
    firewall_add_table(fw, t);
    return fw;
}

# --- config.cyr ---

# nein config module — string to enum dispatch helpers
#
# Parse string values from config sources (TOML/JSON/CLI) into nein enum
# constants. Returns the enum value on success or -1 on error.
# Consumers (sutra, CLI tools) layer TOML/JSON/etc. on top.
#
# The scope here is intentionally narrow: the enum dispatch layer.
# Full TOML struct parsing awaits sutra's port.

# -1 is the sentinel for "unknown value". All nein enum constants start at 1.
fn _cfg_unknown(): i64 { return 0 - 1; }

# --- Family ---
fn cfg_parse_family(s: cstring): i64 {
    if (s == 0) { return _cfg_unknown(); }   # NULL (1.8.2, audit B-10: was strlen(0))
    if (streq(s, "inet") == 1) { return FAMILY_INET; }
    if (streq(s, "ip") == 1) { return FAMILY_IP; }
    if (streq(s, "ip6") == 1) { return FAMILY_IP6; }
    if (streq(s, "arp") == 1) { return FAMILY_ARP; }
    if (streq(s, "bridge") == 1) { return FAMILY_BRIDGE; }
    if (streq(s, "netdev") == 1) { return FAMILY_NETDEV; }
    return _cfg_unknown();
}

# --- ChainType ---
fn cfg_parse_chain_type(s: cstring): i64 {
    if (s == 0) { return _cfg_unknown(); }   # NULL (1.8.2, audit B-10: was strlen(0))
    if (streq(s, "filter") == 1) { return CHAIN_FILTER; }
    if (streq(s, "nat") == 1) { return CHAIN_NAT; }
    if (streq(s, "route") == 1) { return CHAIN_ROUTE; }
    return _cfg_unknown();
}

# --- Hook ---
fn cfg_parse_hook(s: cstring): i64 {
    if (s == 0) { return _cfg_unknown(); }   # NULL (1.8.2, audit B-10: was strlen(0))
    if (streq(s, "prerouting") == 1) { return HOOK_PREROUTING; }
    if (streq(s, "input") == 1) { return HOOK_INPUT; }
    if (streq(s, "forward") == 1) { return HOOK_FORWARD; }
    if (streq(s, "output") == 1) { return HOOK_OUTPUT; }
    if (streq(s, "postrouting") == 1) { return HOOK_POSTROUTING; }
    if (streq(s, "ingress") == 1) { return HOOK_INGRESS; }
    return _cfg_unknown();
}

# --- Policy ---
fn cfg_parse_policy(s: cstring): i64 {
    if (s == 0) { return _cfg_unknown(); }   # NULL (1.8.2, audit B-10: was strlen(0))
    if (streq(s, "accept") == 1) { return POLICY_ACCEPT; }
    if (streq(s, "drop") == 1) { return POLICY_DROP; }
    return _cfg_unknown();
}

# --- Protocol ---
fn cfg_parse_protocol(s: cstring): i64 {
    if (s == 0) { return _cfg_unknown(); }   # NULL (1.8.2, audit B-10: was strlen(0))
    if (streq(s, "tcp") == 1) { return PROTO_TCP; }
    if (streq(s, "udp") == 1) { return PROTO_UDP; }
    if (streq(s, "icmp") == 1) { return PROTO_ICMP; }
    if (streq(s, "icmpv6") == 1) { return PROTO_ICMPV6; }
    return _cfg_unknown();
}

# --- RateUnit ---
fn cfg_parse_rate_unit(s: cstring): i64 {
    if (s == 0) { return _cfg_unknown(); }   # NULL (1.8.2, audit B-10: was strlen(0))
    if (streq(s, "second") == 1) { return RATE_SECOND; }
    if (streq(s, "minute") == 1) { return RATE_MINUTE; }
    if (streq(s, "hour") == 1) { return RATE_HOUR; }
    if (streq(s, "day") == 1) { return RATE_DAY; }
    return _cfg_unknown();
}

# --- QuotaMode ---
fn cfg_parse_quota_mode(s: cstring): i64 {
    if (s == 0) { return _cfg_unknown(); }   # NULL (1.8.2, audit B-10: was strlen(0))
    if (streq(s, "over") == 1) { return QUOTA_OVER; }
    if (streq(s, "until") == 1) { return QUOTA_UNTIL; }
    return _cfg_unknown();
}

# --- QuotaUnit ---
fn cfg_parse_quota_unit(s: cstring): i64 {
    if (s == 0) { return _cfg_unknown(); }   # NULL (1.8.2, audit B-10: was strlen(0))
    if (streq(s, "bytes") == 1) { return QUNIT_BYTES; }
    if (streq(s, "kbytes") == 1) { return QUNIT_KBYTES; }
    if (streq(s, "mbytes") == 1) { return QUNIT_MBYTES; }
