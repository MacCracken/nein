# Integration: a ruleset nein applied diffs as IN SYNC against itself (1.9.2).
#
# Audit P-8 (docs/audit/2026-11-03-audit.md). nein_diff compares each target
# rule's rendered body against the body nft LISTS for the live rule, byte for
# byte. nft does not list what it was given: it prints its own canonical
# spelling (`ip saddr 10.0.0.5/32` lists as `ip saddr 10.0.0.5`, `meta mark 5`
# as `meta mark 0x00000005`). A chain holding such a rule never compares equal,
# so every nein_diff deleted and re-added the whole chain: churn, counters
# reset, handles moved — on a ruleset already exactly in place.
#
# This test has real nft judge it. Each ruleset — every builder, and one chain
# per match and verdict shape nein renders — is loaded into a fresh namespace,
# listed back with handles (what nein_diff reads), and diffed against itself.
# Any op is a FAIL naming the target body and the live body nft printed for it.
#
# Then convergence: the same ruleset with one rule dropped and a stray rule
# added, diffed toward the target; the ops are applied on top of that state in
# a second fresh namespace (handles are allocated in load order, so they are
# the same), listed again, and that listing must diff as in sync.
#
# Runs nft as root inside a throwaway user + network namespace
# (`unshare -rn`), as tests/integration/nft_load.tcyr does; reports SKIP and
# passes where that cannot run. Run it locally before a release.

include "src/lib/error.cyr"
include "src/lib/validate.cyr"
include "src/lib/rule.cyr"
include "src/lib/set.cyr"
include "src/lib/nat.cyr"
include "src/lib/chain.cyr"
include "src/lib/table.cyr"
include "src/lib/firewall.cyr"
include "src/lib/builder.cyr"
include "src/lib/policy.cyr"
include "src/lib/geoip.cyr"
include "src/lib/mesh.cyr"
include "src/lib/bridge.cyr"
include "src/lib/engine.cyr"
include "src/lib/config.cyr"
include "src/lib/netns.cyr"
include "src/lib/apply.cyr"
include "src/lib/inspect.cyr"
include "src/lib/diff.cyr"

var _dc_nft = "/usr/sbin/nft";
var _dc_unshare = "/usr/bin/unshare";
var _dc_dir = 0;
var _dc_script = 0;
var _dc_out = 0;
var _DC_OUT_MAX = 1048576;
var _dc_passed = 0;
var _dc_failed = 0;
var _dc_files = 0;   # every path written, removed at the end

fn _dc_cat(a: cstring, b: cstring, c: cstring): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    str_builder_add_cstr(sb, c);
    return str_cstr(str_builder_build(sb));
}

fn _dc_write(path: cstring, text: i64, len: i64): i64 {
    var fd = sys_open(path, 577, 420);   # O_WRONLY|O_CREAT|O_TRUNC, 0644
    if (fd < 0) { return 0; }
    if (_dc_files != 0) { vec_push(_dc_files, path); }
    sys_write(fd, text, len);
    sys_close(fd);
    return 1;
}

# Load each file of `files` in order into ONE fresh namespace, then list the
# ruleset with handles. The listing as a Str, or 0 when a load failed.
fn _dc_load_list(files: i64): i64 {
    var args = vec_new();
    vec_push(args, _dc_unshare);
    vec_push(args, "-rn");
    vec_push(args, "/bin/sh");
    vec_push(args, _dc_script);
    vec_push(args, _dc_nft);
    var i = 0;
    while (i < vec_len(files)) { vec_push(args, vec_get(files, i)); i = i + 1; }
    var st[16];
    var n = exec_capture_status(args, _dc_out, _DC_OUT_MAX - 1, &st);
    if (n < 0 || load64(&st) != 0) { return 0; }
    store8(_dc_out + n, 0);
    return str_from(_dc_out);
}

fn _dc_available(): i64 {
    if (sys_access(_dc_unshare, 1) != 0) { return 0; }
    if (sys_access(_dc_nft, 1) != 0) {
        _dc_nft = "/usr/bin/nft";
        if (sys_access(_dc_nft, 1) != 0) { return 0; }
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "/tmp/nein-diff-converge-");
    str_builder_add_int(sb, sys_getpid());
    _dc_dir = str_cstr(str_builder_build(sb));
    if (sys_mkdir(_dc_dir, 448) != 0) { return 0; }   # 0700
    _dc_files = vec_new();
    _dc_out = alloc(_DC_OUT_MAX);
    # $1 = nft, then the files to load in order; nft's errors go to stdout's
    # caller as a nonzero exit (exec_capture_status drops stderr).
    _dc_script = _dc_cat(_dc_dir, "/load-list.sh", "");
    var body = "nft=\"$1\"; shift\nfor f in \"$@\"; do \"$nft\" -f \"$f\" || exit 3; done\nexec \"$nft\" -a list ruleset\n";
    if (_dc_write(_dc_script, body, strlen(body)) == 0) { return 0; }
    var empty = _dc_cat(_dc_dir, "/empty.nft", "");
    var et = "table inet nein_probe {\n}\n";
    _dc_write(empty, et, strlen(et));
    var files = vec_new();
    vec_push(files, empty);
    if (_dc_load_list(files) == 0) { return 0; }
    return 1;
}

# Write fw's checked render to <dir>/<name>.nft; the path, or 0.
fn _dc_file(name: cstring, fw: i64): cstring {
    var rt, rv = firewall_render_checked(fw);
    if (is_err_result(rt) == 1) { return 0; }
    var path = _dc_cat(_dc_dir, "/", _dc_cat(name, ".nft", ""));
    if (_dc_write(path, str_data(rv), str_len(rv)) == 0) { return 0; }
    return path;
}

fn _dc_fail(name: cstring, why: cstring): i64 {
    print("  FAIL: ", 8); print(name, strlen(name)); print(" — ", 5); println(why);
    _dc_failed = _dc_failed + 1;
    return 0;
}

# Name every target rule that has no byte-equal live rule in its chain, and
# the live bodies nft printed in that chain.
fn _dc_explain(fw: i64, live: i64): i64 {
    var tr = diff_target_rules(fw);
    var bad[8];
    var lr = _diff_parse(live, &bad);
    _diff_live_cmp(lr);
    var i = 0;
    while (i < vec_len(tr)) {
        var t = vec_get(tr, i);
        if (_target_in_live(t, lr) == 0) {
            print("      chain ", 12);
            print(live_rule_chain(t), strlen(live_rule_chain(t)));
            println("");
            print("        nein: ", 14); println(_live_rule_cmp(t));
            var j = 0;
            while (j < vec_len(lr)) {
                var l = vec_get(lr, j);
                if (_same_chain(l, t) == 1) {
                    print("        nft:  ", 14); println(_live_rule_cmp(l));
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

# Applied, listed, and diffed against itself: in sync, no ops.
fn _dc_idempotent(name: cstring, fw: i64): i64 {
    var path = _dc_file(name, fw);
    if (path == 0) { return _dc_fail(name, "did not validate"); }
    var files = vec_new();
    vec_push(files, path);
    var live = _dc_load_list(files);
    if (live == 0) { return _dc_fail(name, "nft refused the ruleset"); }
    var st[8];
    var ops = _diff_compute(fw, live, &st);
    if (load64(&st) != 0) { return _dc_fail(name, "the listing was not trusted"); }
    if (vec_len(ops) != 0) {
        _dc_fail(name, "diff of an applied ruleset against itself is not empty");
        _dc_explain(fw, live);
        return 0;
    }
    _dc_passed = _dc_passed + 1;
    return 1;
}

# A stray counter rule at the head and the tail of each table's first chain:
# rules the diff must remove, putting the chain back in order.
fn _dc_perturb_text(fw: i64): cstring {
    var sb = str_builder_new();
    var tables = firewall_tables(fw);
    var i = 0;
    while (i < vec_len(tables)) {
        var t = vec_get(tables, i);
        var chains = table_chains(t);
        if (vec_len(chains) > 0) {
            var where = _dc_cat(_family_to_cstr(table_family(t)), " ", _dc_cat(table_name(t), " ",
                chain_name(vec_get(chains, 0))));
            str_builder_add_cstr(sb, _dc_cat("add rule ", where, " counter comment \"nein-stray-tail\"\n"));
            str_builder_add_cstr(sb, _dc_cat("insert rule ", where, " counter comment \"nein-stray-head\"\n"));
        }
        i = i + 1;
    }
    return str_cstr(str_builder_build(sb));
}

# Applied, perturbed, diffed toward the target, and the ops applied: the
# result diffs as in sync. Handles are allocated in load order, so replaying
# the same loads in a second fresh namespace gives the ops' handles back.
fn _dc_converges(name: cstring, fw: i64): i64 {
    var path = _dc_file(name, fw);
    if (path == 0) { return _dc_fail(name, "did not validate"); }
    var pt = _dc_perturb_text(fw);
    var ppath = _dc_cat(_dc_dir, "/", _dc_cat(name, "-perturb.nft", ""));
    _dc_write(ppath, pt, strlen(pt));
    var files = vec_new();
    vec_push(files, path);
    vec_push(files, ppath);
    var live = _dc_load_list(files);
    if (live == 0) { return _dc_fail(name, "nft refused the perturbed ruleset"); }
    var st[8];
    var ops = _diff_compute(fw, live, &st);
    if (load64(&st) != 0) { return _dc_fail(name, "the perturbed listing was not trusted"); }
    if (vec_len(ops) == 0) { return _dc_fail(name, "no ops for a perturbed ruleset"); }
    var osb = str_builder_new();
    var i = 0;
    while (i < vec_len(ops)) { str_builder_add_cstr(osb, vec_get(ops, i)); i = i + 1; }
    var ot = str_cstr(str_builder_build(osb));
    var opath = _dc_cat(_dc_dir, "/", _dc_cat(name, "-ops.nft", ""));
    _dc_write(opath, ot, strlen(ot));
    vec_push(files, opath);
    var after = _dc_load_list(files);
    if (after == 0) { return _dc_fail(name, "nft refused the diff's ops"); }
    var st2[8];
    var ops2 = _diff_compute(fw, after, &st2);
    if (load64(&st2) != 0 || vec_len(ops2) != 0) {
        _dc_fail(name, "not in sync after applying the diff's ops");
        _dc_explain(fw, after);
        return 0;
    }
    _dc_passed = _dc_passed + 1;
    return 1;
}

# ---- the builders (as tests/integration/nft_load.tcyr builds them) ----

fn _dc_bridge(): i64 {
    var bf = bridge_firewall_new(bridge_config_new("br0", "172.17.0.0/16", "eth0"));
    bf_add_port_mapping(bf, pm_tcp(8080, "172.17.1.5", 80));
    var a = vec_new(); vec_push(a, "172.17.1.0/24");
    var b = vec_new(); vec_push(b, "172.17.2.0/24");
    bf_add_isolation_group(bf, isolation_group_new("tenantA", a));
    bf_add_isolation_group(bf, isolation_group_new("tenantB", b));
    return bf_to_firewall(bf);
}

fn _dc_engine(): i64 {
    var pe = policy_engine_new();
    var a = agent_policy_new("svc-a", "10.0.0.1");
    ap_allow_inbound(a, ps_tcp(8080));
    ap_allow_outbound_host(a, "192.0.2.7");
    var b = agent_policy_new("svc-6", "fd00::6");
    ap_allow_outbound(b, ps_tcp(443));
    ap_allow_outbound_host(b, "2001:db8::/32");
    pe_add_agent(pe, a);
    pe_add_agent(pe, b);
    return pe_to_firewall(pe);
}

fn _dc_geoip(): i64 {
    var bl = geoip_new();
    var xx = vec_new(); vec_push(xx, "198.51.100.0/24"); vec_push(xx, "203.0.113.9");
    geoip_block_country(bl, country_block_v4("XX", xx));
    var y4 = vec_new(); vec_push(y4, "192.0.2.0/24");
    var y6 = vec_new(); vec_push(y6, "2001:db8::/32");
    geoip_block_country(bl, country_block_dual("YY", y4, y6));
    return geoip_to_firewall(bl);
}

fn _dc_policy(): i64 {
    var fw = firewall_new();
    var t = table_new("pol", FAMILY_INET);
    var c = chain_base("input", CHAIN_FILTER, HOOK_INPUT, 0, POLICY_ACCEPT);
    var rules = policy_to_rules(agent_to_agent("a-to-b", "10.0.0.1", "10.0.0.2", PROTO_TCP, 8090));
    var i = 0;
    while (i < vec_len(rules)) { chain_add_rule(c, vec_get(rules, i)); i = i + 1; }
    table_add_chain(t, c);
    firewall_add_table(fw, t);
    return fw;
}

fn _dc_netns(): i64 {
    var nsf = namespace_firewall_new("agent1");
    nsf_allow_inbound(nsf, ps_tcp(8080));
    nsf_allow_outbound(nsf, ps_tcp(443));
    return nsf_build(nsf);
}

fn _dc_nat(): i64 {
    var fw = firewall_new();
    var t = table_new("natx", FAMILY_INET);
    var pre = chain_base("prerouting", CHAIN_NAT, HOOK_PREROUTING, 0 - 100, POLICY_ACCEPT);
    chain_add_nat_rule(pre, port_forward(8080, "172.17.0.2", 80));
    chain_add_nat_rule(pre, port_range_forward(9000, 9010, "172.17.0.3", 10000));
    chain_add_nat_rule(pre, nat_dnat(PROTO_TCP, 8443, "fd00::2", 443, 0));
    chain_add_nat_rule(pre, nat_redirect(PROTO_TCP, 80, 3128, 0));
    var post = chain_base("postrouting", CHAIN_NAT, HOOK_POSTROUTING, 100, POLICY_ACCEPT);
    chain_add_nat_rule(post, nat_snat("10.0.0.0/8", "192.0.2.1", 0));
    chain_add_nat_rule(post, nat_snat("10.1.0.5/32", "192.0.2.2", "one host"));
    chain_add_nat_rule(post, container_masquerade("172.17.0.0/16", "eth0"));
    table_add_chain(t, pre);
    table_add_chain(t, post);
    firewall_add_table(fw, t);
    return fw;
}

# ---- one chain per rule shape ----
#
# Each shape is the only rule of a regular chain s<N>, so a shape nft re-spells
# is named by its chain alone.

var _dc_t = 0;
var _dc_n = 0;

fn _dc_s(rule: i64): i64 {
    _dc_n = _dc_n + 1;
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "s");
    str_builder_add_int(sb, _dc_n);
    var c = chain_regular(str_cstr(str_builder_build(sb)));
    chain_add_rule(c, rule);
    table_add_chain(_dc_t, c);
    return 0;
}

fn _dc_m(m: i64, v: i64): i64 {
    var r = rule_new(v);
    rule_add_match(r, m);
    return _dc_s(r);
}

fn _dc_m2(m1: i64, m2: i64, v: i64): i64 {
    var r = rule_new(v);
    rule_add_match(r, m1);
    rule_add_match(r, m2);
    return _dc_s(r);
}

fn _dc_shapes(): i64 {
    var fw = firewall_new();
    var t = table_new("shapes", FAMILY_INET);
    _dc_t = t;
    _dc_n = 0;
    var hs = nft_set_new("hosts4", SET_IPV4_ADDR);
    nft_set_add_element(hs, "10.0.0.1");
    nft_set_add_element(hs, "10.0.0.2");
    table_add_set(t, hs);
    var cto = ct_timeout_new("cto", PROTO_TCP);
    ct_timeout_add_timeout(cto, "established", 600);
    table_add_ct_timeout(t, cto);
    table_add_chain(t, chain_regular("tgt"));

    # addresses
    _dc_m(match_source_addr("10.0.0.5/32"), verdict_accept());
    _dc_m(match_source_addr("10.0.0.0/8"), verdict_accept());
    _dc_m(match_dest_addr("192.0.2.1"), verdict_drop());
    _dc_m(match_source_addr6("2001:db8::1/128"), verdict_accept());
    _dc_m(match_dest_addr6("fd00::/8"), verdict_drop());
    _dc_m(match_source_addr6("2001:DB8::A"), verdict_accept());
    _dc_m(match_source_addr6("2001:db8:0:0:0:0:0:1"), verdict_accept());
    _dc_m(match_source_addr6("::ffff:192.0.2.1"), verdict_accept());
    _dc_m(match_source_addr("0.0.0.0/0"), verdict_accept());
    # protocols and ports
    _dc_s(allow_tcp(22));
    _dc_s(allow_udp(53));
    _dc_m2(match_protocol(PROTO_TCP), match_sport(1024), verdict_accept());
    _dc_m2(match_protocol(PROTO_TCP), match_dport_range(8000, 8080), verdict_accept());
    _dc_m(match_protocol(PROTO_ICMP), verdict_accept());
    _dc_m(match_protocol(PROTO_ICMPV6), verdict_accept());
    _dc_m(match_dport(53), verdict_accept());
    _dc_s(allow_service("10.0.0.0/8", PROTO_TCP, 443));
    _dc_s(allow_service("fd00::/8", PROTO_UDP, 443));
    _dc_s(deny_source("192.0.2.66"));
    _dc_s(deny_source6("2001:db8::bad"));
    # interfaces
    _dc_m(match_iif("lo"), verdict_accept());
    _dc_m(match_oif("eth0"), verdict_drop());
    # conntrack
    _dc_s(allow_established());
    _dc_m(match_ct_state("new"), verdict_accept());
    _dc_m(match_ct_state("invalid"), verdict_drop());
    _dc_m(match_ct_helper("ftp"), verdict_accept());
    _dc_m(match_ct_timeout_set("cto"), verdict_none());
    _dc_m(match_conn_limit(10), verdict_drop());
    # rate limits and quotas
    _dc_m(match_limit(10, RATE_SECOND, 5), verdict_accept());
    _dc_m(match_limit(10, RATE_MINUTE, 20), verdict_accept());
    _dc_m(match_limit(1, RATE_HOUR, 1), verdict_accept());
    _dc_s(rate_limit_tcp(22, 3, RATE_MINUTE));
    _dc_s(rate_limit_quic(443, 100, RATE_SECOND));
    _dc_m(match_quota(QUOTA_OVER, 100, QUNIT_MBYTES), verdict_drop());
    _dc_m(match_quota(QUOTA_UNTIL, 2048, QUNIT_KBYTES), verdict_accept());
    _dc_m(match_quota(QUOTA_OVER, 1, QUNIT_GBYTES), verdict_drop());
    _dc_m(match_quota(QUOTA_OVER, 512, QUNIT_BYTES), verdict_drop());
    # sets
    _dc_m(match_set_lookup("ip saddr", "hosts4"), verdict_accept());
    # tcp, icmp
    _dc_m(match_tcp_flags("syn"), verdict_accept());
    _dc_m(match_tcp_flags("syn,ack"), verdict_accept());
    _dc_m(match_icmp_type("echo-request"), verdict_accept());
    _dc_m(match_icmpv6_type("echo-request"), verdict_accept());
    _dc_m(match_icmp_type_code("destination-unreachable", 3), verdict_accept());
    _dc_m(match_icmpv6_type_code("destination-unreachable", 4), verdict_accept());
    # meta, payload
    _dc_m(match_meta_mark(5), verdict_accept());
    _dc_m(match_meta_mark(0), verdict_accept());
    _dc_m(match_dscp(46), verdict_accept());
    _dc_m(match_dscp(0), verdict_accept());
    _dc_m(match_dscp(1), verdict_accept());
    _dc_m(match_ipv6_ext_hdr(EXT_HOP_BY_HOP), verdict_drop());
    _dc_m(match_ipv6_ext_hdr(EXT_ROUTING), verdict_drop());
    _dc_m(match_ipv6_ext_hdr(EXT_FRAGMENT), verdict_drop());
    _dc_m(match_ipv6_ext_hdr(EXT_DESTINATION), verdict_drop());
    _dc_m(match_ipv6_ext_hdr(EXT_MOBILITY), verdict_drop());
    _dc_m(match_frag_off(8191, NFT_CMP_NE, 0), verdict_drop());
    _dc_m(match_frag_off(16384, NFT_CMP_EQ, 16384), verdict_accept());
    _dc_m(match_pkt_type(PKT_UNICAST), verdict_accept());
    _dc_m(match_pkt_type(PKT_BROADCAST), verdict_drop());
    _dc_m(match_pkt_type(PKT_MULTICAST), verdict_drop());
    _dc_m(match_raw("meta l4proto tcp"), verdict_accept());
    # verdicts
    _dc_s(rule_new(verdict_accept()));
    _dc_s(rule_new(verdict_drop()));
    _dc_s(rule_new(verdict_reject()));
    _dc_s(rule_new(verdict_reject_with(REJECT_ICMPX_ADMIN_PROHIB)));
    _dc_m2(match_protocol(PROTO_TCP), match_dport(23), verdict_reject_with(REJECT_TCP_RESET));
    _dc_s(rule_new(verdict_jump("tgt")));
    _dc_s(rule_new(verdict_goto("tgt")));
    _dc_s(rule_new(verdict_return()));
    _dc_s(rule_new(verdict_log(0)));
    _dc_s(rule_new(verdict_log("NEIN: ")));
    _dc_s(rule_new(verdict_counter()));
    _dc_s(rule_new(verdict_set_mark(5)));
    _dc_s(rule_new(verdict_set_ct_mark(5)));
    _dc_s(rule_new(verdict_log_advanced("ADV: ", NFT_LOG_WARN, 0, 0)));
    _dc_s(rule_new(verdict_log_advanced(0, 0, 2, 128)));
    _dc_s(rule_new(verdict_log_advanced("I: ", NFT_LOG_INFO, 0, 0)));
    # comments
    var rc = allow_tcp(80);
    rule_set_comment(rc, "web: allow 80");
    _dc_s(rc);
    table_add_chain(t, chain_regular("empty"));
    firewall_add_table(fw, t);

    # icmp reject reasons need an ip table (inet would add an nfproto test)
    var t4 = table_new("shapes4", FAMILY_IP);
    _dc_t = t4;
    _dc_s(rule_new(verdict_reject_with(REJECT_ICMP_HOST_UNREACH)));
    _dc_s(rule_new(verdict_reject_with(REJECT_ICMP_PORT_UNREACH)));
    _dc_s(rule_new(verdict_reject_with(REJECT_ICMP_NET_UNREACH)));
    _dc_s(rule_new(verdict_reject_with(REJECT_ICMP_ADMIN_PROHIB)));
    _dc_s(allow_tcp(22));
    _dc_m(match_source_addr("10.0.0.5/32"), verdict_accept());
    firewall_add_table(fw, t4);

    var t6 = table_new("shapes6", FAMILY_IP6);
    _dc_t = t6;
    _dc_s(allow_tcp(22));
    _dc_m(match_source_addr6("2001:db8::1/128"), verdict_accept());
    _dc_m(match_icmpv6_type("nd-neighbor-solicit"), verdict_accept());
    firewall_add_table(fw, t6);

    var tb = table_new("shapesbr", FAMILY_BRIDGE);
    _dc_t = tb;
    _dc_m(match_vlan_id(10), verdict_accept());
    firewall_add_table(fw, tb);
    return fw;
}

# ---- addresses, judged against nft's own listing ----
#
# nft lists an IPv6 address through inet_ntop, which picks one "::" among
# several zero runs, and masks host bits under a prefix. Generated spellings
# bias toward zero groups — ties between runs, a "::" written at the shorter
# run, single zero groups, dotted-quad tails, upper case, zero padding, a
# prefix over host bits — and each sits alone in a chain of an `addrs` table
# that must diff as in sync. Seeded, so every run checks the same spellings.

var _dc_seed = 88172645463325252;
fn _dc_rnd(n: i64): i64 {
    _dc_seed = _dc_seed * 6364136223846793005 + 1442695040888963407;
    return ((_dc_seed >> 33) & 2147483647) % n;
}

fn _dc_hex(sb: i64, v: i64): i64 {
    var lower = "0123456789abcdef";
    var upper = "0123456789ABCDEF";
    var digits = lower;
    if (_dc_rnd(4) == 0) { digits = upper; }
    var width = 1;
    if (v > 15) { width = 2; }
    if (v > 255) { width = 3; }
    if (v > 4095) { width = 4; }
    if (_dc_rnd(4) == 0) { width = 4; }
    var k = width - 1;
    while (k >= 0) {
        str_builder_add_byte(sb, load8(digits + ((v >> (k * 4)) & 15)));
        k = k - 1;
    }
    return 0;
}

fn _dc_v6(): cstring {
    var w[64];
    var i = 0;
    while (i < 8) {
        var r = _dc_rnd(8);
        var v = 0;
        if (r == 0) { v = _dc_rnd(65536); }
        elif (r == 1) { v = _dc_rnd(16); }
        elif (r == 2) { v = 65535; }
        store64(&w + i * 8, v);
        i = i + 1;
    }
    # A zero run to write as "::", or none.
    var zs = 0 - 1;
    var ze = 0 - 1;
    if (_dc_rnd(3) != 0) {
        var z = _dc_rnd(8);
        var tries = 0;
        while (tries < 8 && load64(&w + z * 8) != 0) { z = (z + 1) % 8; tries = tries + 1; }
        if (load64(&w + z * 8) == 0) {
            zs = z;
            ze = z;
            while (ze < 8 && load64(&w + ze * 8) == 0) { ze = ze + 1; }
        }
    }
    var dotted = 0;
    if (zs >= 0 && ze <= 6 && _dc_rnd(4) == 0) { dotted = 1; }
    var last = 6;
    if (dotted == 0) { last = 8; }
    var sb = str_builder_new();
    i = 0;
    var need = 0;   # a ':' before the next group
    while (i < last) {
        if (i == zs) {
            str_builder_add_cstr(sb, "::");
            need = 0;
            i = ze;
            continue;
        }
        if (need == 1) { str_builder_add_cstr(sb, ":"); }
        _dc_hex(sb, load64(&w + i * 8));
        need = 1;
        i = i + 1;
    }
    if (dotted == 1) {
        if (need == 1) { str_builder_add_cstr(sb, ":"); }
        var hi = load64(&w + 48);
        var lo = load64(&w + 56);
        str_builder_add_int(sb, hi >> 8); str_builder_add_cstr(sb, ".");
        str_builder_add_int(sb, hi & 255); str_builder_add_cstr(sb, ".");
        str_builder_add_int(sb, lo >> 8); str_builder_add_cstr(sb, ".");
        str_builder_add_int(sb, lo & 255);
    }
    if (_dc_rnd(4) == 0) {
        str_builder_add_cstr(sb, "/");
        str_builder_add_int(sb, _dc_rnd(129));
    }
    return str_cstr(str_builder_build(sb));
}

fn _dc_v4(): cstring {
    var sb = str_builder_new();
    var q = 0;
    while (q < 4) {
        if (q > 0) { str_builder_add_cstr(sb, "."); }
        str_builder_add_int(sb, _dc_rnd(256));
        q = q + 1;
    }
    if (_dc_rnd(2) == 0) {
        str_builder_add_cstr(sb, "/");
        str_builder_add_int(sb, _dc_rnd(33));
    }
    return str_cstr(str_builder_build(sb));
}

var _dc_addr_count = 0;

fn _dc_addrs(): i64 {
    var fw = firewall_new();
    var t = table_new("addrs", FAMILY_INET);
    _dc_t = t;
    _dc_n = 0;
    _dc_addr_count = 0;
    var i = 0;
    while (i < 400) {
        var a = 0;
        var m = 0;
        if (i < 300) { a = _dc_v6(); m = match_source_addr6(a); }
        else { a = _dc_v4(); m = match_dest_addr(a); }
        var vt, vv = validate_addr(a);
        if (is_err_result(vt) == 0) {
            _dc_m(m, verdict_accept());
            _dc_addr_count = _dc_addr_count + 1;
        }
        i = i + 1;
    }
    firewall_add_table(fw, t);
    return fw;
}

# Remove every file written, then the directory. A path written twice is
# unlinked twice; the second unlink fails and is ignored.
fn _dc_cleanup(): i64 {
    if (_dc_files == 0) { return 0; }
    var i = 0;
    while (i < vec_len(_dc_files)) { sys_unlink(vec_get(_dc_files, i)); i = i + 1; }
    return sys_rmdir(_dc_dir);
}

fn main() {
    alloc_init();
    if (_dc_available() == 0) {
        _dc_cleanup();
        println("integration diff_converge: SKIP — nft or unprivileged user namespaces unavailable here");
        return 0;
    }
    _dc_idempotent("basic_host", basic_host_firewall());
    _dc_idempotent("bridge", _dc_bridge());
    _dc_idempotent("engine", _dc_engine());
    _dc_idempotent("mesh", mesh_to_firewall(mesh_envoy()));
    _dc_idempotent("geoip", _dc_geoip());
    _dc_idempotent("policy", _dc_policy());
    _dc_idempotent("netns", _dc_netns());
    _dc_idempotent("nat", _dc_nat());
    _dc_idempotent("shapes", _dc_shapes());
    _dc_idempotent("addrs", _dc_addrs());
    _dc_converges("basic_host", basic_host_firewall());
    _dc_converges("bridge", _dc_bridge());
    _dc_converges("engine", _dc_engine());
    _dc_converges("mesh", mesh_to_firewall(mesh_envoy()));
    _dc_converges("geoip", _dc_geoip());
    _dc_converges("policy", _dc_policy());
    _dc_converges("netns", _dc_netns());
    _dc_converges("nat", _dc_nat());
    _dc_converges("shapes", _dc_shapes());
    print("integration diff_converge: ", 27);
    fmt_int(_dc_passed);
    print(" converged, ", 12);
    fmt_int(_dc_failed);
    print(" failed (", 9);
    fmt_int(_dc_addr_count);
    println(" generated addresses)");
    if (_dc_cleanup() != 0) {
        print("  FAIL: scratch dir not removed: ", 33);
        println(_dc_dir);
        _dc_failed = _dc_failed + 1;
    }
    if (_dc_failed != 0) { return 1; }
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
