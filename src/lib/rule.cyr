# nein rule module — match expressions, verdicts, and rule rendering
#
# Core building block: Rule = matches + verdict + optional comment.
# Renders to nftables syntax string via rule_render().

# ================================================================
# Enum constants — Match types
# ================================================================

enum MatchType {
    MATCH_SOURCE_ADDR = 1;
    MATCH_DEST_ADDR = 2;
    MATCH_SOURCE_ADDR6 = 3;
    MATCH_DEST_ADDR6 = 4;
    MATCH_PROTOCOL = 5;
    MATCH_DPORT = 6;
    MATCH_SPORT = 7;
    MATCH_DPORT_RANGE = 8;
    MATCH_IIF = 9;
    MATCH_OIF = 10;
    MATCH_CT_STATE = 11;
    MATCH_LIMIT = 12;
    MATCH_SET_LOOKUP = 13;
    MATCH_CT_HELPER = 14;
    MATCH_TCP_FLAGS = 15;
    MATCH_ICMP_TYPE = 16;
    MATCH_ICMPV6_TYPE = 17;
    MATCH_META_MARK = 18;
    MATCH_QUOTA = 19;
    MATCH_FLOW_OFFLOAD = 20;
    MATCH_CT_TIMEOUT_SET = 21;
    MATCH_ICMP_TYPE_CODE = 22;
    MATCH_ICMPV6_TYPE_CODE = 23;
    MATCH_VLAN_ID = 24;
    MATCH_DSCP = 25;
    MATCH_IPV6_EXT_HDR = 26;
    MATCH_FRAG_OFF = 27;
    MATCH_PKT_TYPE = 28;
    MATCH_CONN_LIMIT = 29;
    MATCH_RAW = 30;
}

# ================================================================
# Enum constants — Verdict types
# ================================================================

enum VerdictType {
    VERDICT_ACCEPT = 1;
    VERDICT_DROP = 2;
    VERDICT_REJECT = 3;
    VERDICT_REJECT_WITH = 4;
    VERDICT_JUMP = 5;
    VERDICT_GOTO = 6;
    VERDICT_RETURN = 7;
    VERDICT_LOG = 8;
    VERDICT_COUNTER = 9;
    VERDICT_SET_MARK = 10;
    VERDICT_SET_CT_MARK = 11;
    VERDICT_LOG_ADVANCED = 12;
    VERDICT_COUNTER_NAMED = 13;
    VERDICT_NONE = 14;         # 1.8.2: no verdict word — the rule's last statement is terminal
}

# ================================================================
# Sub-enum constants
# ================================================================

enum Protocol {
    PROTO_TCP = 1;
    PROTO_UDP = 2;
    PROTO_ICMP = 3;
    PROTO_ICMPV6 = 4;
}

enum RateUnit {
    RATE_SECOND = 1;
    RATE_MINUTE = 2;
    RATE_HOUR = 3;
    RATE_DAY = 4;
}

enum QuotaMode {
    QUOTA_OVER = 1;
    QUOTA_UNTIL = 2;
}

enum QuotaUnit {
    QUNIT_BYTES = 1;
    QUNIT_KBYTES = 2;
    QUNIT_MBYTES = 3;
    QUNIT_GBYTES = 4;
}

enum PktTypeEnum {
    PKT_UNICAST = 1;
    PKT_BROADCAST = 2;
    PKT_MULTICAST = 3;
}

enum Ipv6ExtHdrEnum {
    EXT_HOP_BY_HOP = 1;
    EXT_ROUTING = 2;
    EXT_FRAGMENT = 3;
    EXT_DESTINATION = 4;
    EXT_MOBILITY = 5;
    EXT_AUTH = 6;
}

enum CmpOpEnum {
    NFT_CMP_EQ = 1;
    NFT_CMP_NE = 2;
    NFT_CMP_LT = 3;
    NFT_CMP_GT = 4;
    NFT_CMP_LE = 5;
    NFT_CMP_GE = 6;
}

enum RejectReasonEnum {
    REJECT_ICMP_HOST_UNREACH = 1;
    REJECT_ICMP_PORT_UNREACH = 2;
    REJECT_ICMP_NET_UNREACH = 3;
    REJECT_ICMP_ADMIN_PROHIB = 4;
    REJECT_ICMPX_ADMIN_PROHIB = 5;
    REJECT_TCP_RESET = 6;
}

enum LogLevelEnum {
    NFT_LOG_EMERG = 1;
    NFT_LOG_ALERT = 2;
    NFT_LOG_CRIT = 3;
    NFT_LOG_ERR = 4;
    NFT_LOG_WARN = 5;
    NFT_LOG_NOTICE = 6;
    NFT_LOG_INFO = 7;
    NFT_LOG_DEBUG = 8;
}

# ================================================================
# String renderers for enum constants
# ================================================================

fn _proto_str(p) {
    if (p == PROTO_TCP) { return "tcp"; }
    if (p == PROTO_UDP) { return "udp"; }
    if (p == PROTO_ICMP) { return "icmp"; }
    if (p == PROTO_ICMPV6) { return "icmpv6"; }
    return "unknown";
}

fn _rate_unit_str(u) {
    if (u == RATE_SECOND) { return "second"; }
    if (u == RATE_MINUTE) { return "minute"; }
    if (u == RATE_HOUR) { return "hour"; }
    if (u == RATE_DAY) { return "day"; }
    return "second";
}

fn _quota_mode_str(m) {
    if (m == QUOTA_OVER) { return "over"; }
    if (m == QUOTA_UNTIL) { return "until"; }
    return "over";
}

fn _quota_unit_str(u) {
    if (u == QUNIT_BYTES) { return "bytes"; }
    if (u == QUNIT_KBYTES) { return "kbytes"; }
    if (u == QUNIT_MBYTES) { return "mbytes"; }
    if (u == QUNIT_GBYTES) { return "gbytes"; }
    return "bytes";
}

# ================================================================
# Canonical spellings — what nft LISTS (1.9.2, audit P-8)
# ================================================================
# nein_diff compares each target rule with the body nft lists for the live
# rule, and nft lists its own spelling, not the one it was given: `meta mark
# 5` lists as `meta mark 0x00000005`, `ct state { new }` as `ct state new`.
# So the diff renders the target in nft's spelling for the COMPARISON only —
# `cf`, the table's family, is nonzero there — and emits the ruleset as
# before. Every rewrite below is one nft makes to the same rule, so none
# changes what a rule matches; each was probed against nft 1.1.7
# (tests/integration/diff_converge.tcyr). A spelling predicted wrongly costs
# what every diff cost through 1.9.1, a rebuilt chain; it cannot make two
# different rules compare equal.

# Bytes per QuotaUnit.
fn _quota_unit_bytes(u) {
    if (u == QUNIT_KBYTES) { return 1024; }
    if (u == QUNIT_MBYTES) { return 1048576; }
    if (u == QUNIT_GBYTES) { return 1073741824; }
    return 1;
}

# A quota's amount and unit. nft has no gbytes (1.9.2: `quota over 1 gbytes`
# was a syntax error, so the batch failed at apply): gbytes renders as 1024
# mbytes each. Canonical (`cf`): the byte count in the largest of bytes,
# kbytes and mbytes that divides it, as nft lists it (`2048 kbytes` lists as
# `2 mbytes`).
fn _sb_add_quota_amount(sb, amount, unit, cf) {
    if (cf == 0) {
        if (unit == QUNIT_GBYTES) {
            str_builder_add_int(sb, amount * 1024);
            str_builder_add_cstr(sb, " mbytes");
            return 0;
        }
        str_builder_add_int(sb, amount);
        str_builder_add_cstr(sb, " ");
        str_builder_add_cstr(sb, _quota_unit_str(unit));
        return 0;
    }
    var n = amount * _quota_unit_bytes(unit);
    var u = "bytes";
    if (n != 0 && n % 1024 == 0) {
        n = n / 1024;
        u = "kbytes";
        if (n % 1024 == 0) { n = n / 1024; u = "mbytes"; }
    }
    str_builder_add_int(sb, n);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, u);
    return 0;
}

# `val` as 0x and exactly `width` lowercase hex digits (marks: 8, dscp: 2).
fn _sb_add_hex_fixed(sb, val, width) {
    var digits = "0123456789abcdef";
    str_builder_add_cstr(sb, "0x");
    var shift = (width - 1) * 4;
    while (shift >= 0) {
        str_builder_add_byte(sb, load8(digits + ((val >> shift) & 15)));
        shift = shift - 4;
    }
    return 0;
}

# The DSCP names nft lists; any other value lists as 0x%02x.
fn _dscp_name(v) {
    if (v == 0) { return "cs0"; }
    if (v == 1) { return "lephb"; }
    if (v == 8) { return "cs1"; }
    if (v == 10) { return "af11"; }
    if (v == 12) { return "af12"; }
    if (v == 14) { return "af13"; }
    if (v == 16) { return "cs2"; }
    if (v == 18) { return "af21"; }
    if (v == 20) { return "af22"; }
    if (v == 22) { return "af23"; }
    if (v == 24) { return "cs3"; }
    if (v == 26) { return "af31"; }
    if (v == 28) { return "af32"; }
    if (v == 30) { return "af33"; }
    if (v == 32) { return "cs4"; }
    if (v == 34) { return "af41"; }
    if (v == 36) { return "af42"; }
    if (v == 38) { return "af43"; }
    if (v == 40) { return "cs5"; }
    if (v == 44) { return "va"; }
    if (v == 46) { return "ef"; }
    if (v == 48) { return "cs6"; }
    if (v == 56) { return "cs7"; }
    return 0;
}

# The value of a ct state word, or 0.
fn _ct_state_bit(w) {
    if (streq(w, "invalid") == 1) { return 1; }
    if (streq(w, "established") == 1) { return 2; }
    if (streq(w, "related") == 1) { return 4; }
    if (streq(w, "new") == 1) { return 8; }
    if (streq(w, "untracked") == 1) { return 64; }
    return 0;
}

fn _ct_state_word(bit) {
    if (bit == 1) { return "invalid"; }
    if (bit == 2) { return "established"; }
    if (bit == 4) { return "related"; }
    if (bit == 8) { return "new"; }
    return "untracked";
}

# The value of a tcp flag word, or 0.
fn _tcp_flag_bit(w) {
    if (streq(w, "fin") == 1) { return 1; }
    if (streq(w, "syn") == 1) { return 2; }
    if (streq(w, "rst") == 1) { return 4; }
    if (streq(w, "psh") == 1) { return 8; }
    if (streq(w, "ack") == 1) { return 16; }
    if (streq(w, "urg") == 1) { return 32; }
    if (streq(w, "ecn") == 1) { return 64; }
    if (streq(w, "cwr") == 1) { return 128; }
    return 0;
}

fn _tcp_flag_word(bit) {
    if (bit == 1) { return "fin"; }
    if (bit == 2) { return "syn"; }
    if (bit == 4) { return "rst"; }
    if (bit == 8) { return "psh"; }
    if (bit == 16) { return "ack"; }
    if (bit == 32) { return "urg"; }
    if (bit == 64) { return "ecn"; }
    return "cwr";
}

# The words of a comma-separated list as a bit mask, each word's value from
# `bitfn` (1 = ct state, 2 = tcp flags); 0 when any word is unknown.
fn _word_list_mask(s, kind) {
    if (s == 0) { return 0; }
    var len = strlen(s);
    var w = alloc(len + 1);
    var mask = 0;
    var i = 0;
    while (i <= len) {
        while (i < len && load8(s + i) == 32) { i = i + 1; }
        var n = 0;
        while (i < len && load8(s + i) != 44) {
            store8(w + n, load8(s + i));
            n = n + 1;
            i = i + 1;
        }
        while (n > 0 && load8(w + n - 1) == 32) { n = n - 1; }
        store8(w + n, 0);
        var bit = 0;
        if (kind == 1) { bit = _ct_state_bit(w); } else { bit = _tcp_flag_bit(w); }
        if (bit == 0) { return 0; }
        mask = mask | bit;
        i = i + 1;
    }
    return mask;
}

# A set of flag words as nft lists it: one word bare (`one_prefix` before
# it), several as `{ a, b }` in ascending value.
fn _sb_add_flag_set(sb, mask, kind, one_prefix) {
    var count = 0;
    var b = 1;
    while (b <= 128) {
        if ((mask & b) != 0) { count = count + 1; }
        b = b * 2;
    }
    if (count == 1) { str_builder_add_cstr(sb, one_prefix); } else { str_builder_add_cstr(sb, "{ "); }
    var k = 0;
    b = 1;
    while (b <= 128) {
        if ((mask & b) != 0) {
            if (k > 0) { str_builder_add_cstr(sb, ", "); }
            if (kind == 1) { str_builder_add_cstr(sb, _ct_state_word(b)); }
            else { str_builder_add_cstr(sb, _tcp_flag_word(b)); }
            k = k + 1;
        }
        b = b * 2;
    }
    if (count != 1) { str_builder_add_cstr(sb, " }"); }
    return 0;
}

# An address match's value: as written, or canonical under `cf`.
fn _sb_add_match_addr(sb, addr, cf) {
    if (cf != 0) {
        var c = _addr_canon(addr);
        if (c != 0) { str_builder_add_cstr(sb, c); return 0; }
    }
    str_builder_add_cstr(sb, addr);
    return 0;
}

fn _pkt_type_str(p) {
    if (p == PKT_UNICAST) { return "unicast"; }
    if (p == PKT_BROADCAST) { return "broadcast"; }
    if (p == PKT_MULTICAST) { return "multicast"; }
    return "unicast";
}

fn _ipv6_ext_hdr_str(h) {
    if (h == EXT_HOP_BY_HOP) { return "hbh"; }
    if (h == EXT_ROUTING) { return "rt"; }
    if (h == EXT_FRAGMENT) { return "frag"; }
    if (h == EXT_DESTINATION) { return "dst"; }
    if (h == EXT_MOBILITY) { return "mh"; }
    if (h == EXT_AUTH) { return "auth"; }
    return "unknown";
}

fn _cmp_op_str(op) {
    if (op == NFT_CMP_EQ) { return "=="; }
    if (op == NFT_CMP_NE) { return "!="; }
    if (op == NFT_CMP_LT) { return "<"; }
    if (op == NFT_CMP_GT) { return ">"; }
    if (op == NFT_CMP_LE) { return "<="; }
    if (op == NFT_CMP_GE) { return ">="; }
    return "==";
}

fn _reject_reason_str(r) {
    if (r == REJECT_ICMP_HOST_UNREACH) { return "icmp type host-unreachable"; }
    if (r == REJECT_ICMP_PORT_UNREACH) { return "icmp type port-unreachable"; }
    if (r == REJECT_ICMP_NET_UNREACH) { return "icmp type net-unreachable"; }
    if (r == REJECT_ICMP_ADMIN_PROHIB) { return "icmp type admin-prohibited"; }
    if (r == REJECT_ICMPX_ADMIN_PROHIB) { return "icmpx type admin-prohibited"; }
    if (r == REJECT_TCP_RESET) { return "tcp reset"; }
    return "icmp type port-unreachable";
}

fn _log_level_str(l) {
    if (l == NFT_LOG_EMERG) { return "emerg"; }
    if (l == NFT_LOG_ALERT) { return "alert"; }
    if (l == NFT_LOG_CRIT) { return "crit"; }
    if (l == NFT_LOG_ERR) { return "err"; }
    if (l == NFT_LOG_WARN) { return "warn"; }
    if (l == NFT_LOG_NOTICE) { return "notice"; }
    if (l == NFT_LOG_INFO) { return "info"; }
    if (l == NFT_LOG_DEBUG) { return "debug"; }
    return "info";
}

# ================================================================
# Match struct — tagged union: { type, val1, val2, val3 }
# Layout: [type:8][val1:8][val2:8][val3:8] = 32 bytes
#   val1/val2/val3 meaning depends on type (string ptr, int, etc.)
# ================================================================

fn match_new(mtype: i64, v1: i64, v2: i64, v3: i64): i64 {
    var m = alloc(32);
    store64(m, mtype);
    store64(m + 8, v1);
    store64(m + 16, v2);
    store64(m + 24, v3);
    return m;
}

fn match_type(m: i64): i64 { return load64(m); }
fn match_val1(m: i64): i64 { return load64(m + 8); }
fn match_val2(m: i64): i64 { return load64(m + 16); }
fn match_val3(m: i64): i64 { return load64(m + 24); }

# Match constructors

fn match_source_addr(addr: cstring): i64 { return match_new(MATCH_SOURCE_ADDR, addr, 0, 0); }
fn match_dest_addr(addr: cstring): i64 { return match_new(MATCH_DEST_ADDR, addr, 0, 0); }
fn match_source_addr6(addr: cstring): i64 { return match_new(MATCH_SOURCE_ADDR6, addr, 0, 0); }
fn match_dest_addr6(addr: cstring): i64 { return match_new(MATCH_DEST_ADDR6, addr, 0, 0); }

# An address match in the address's own family: `ip`/`ip6`, `saddr`/`daddr`
# (1.8.2). Builders that took an address and always rendered `ip saddr` made
# any IPv6 input fail the whole ruleset at apply.
fn _match_addr(addr: cstring, is_dest: i64): i64 {
    if (_addr_family(addr) == 6) {
        if (is_dest == 1) { return match_dest_addr6(addr); }
        return match_source_addr6(addr);
    }
    if (is_dest == 1) { return match_dest_addr(addr); }
    return match_source_addr(addr);
}
fn match_protocol(proto: cstring): i64 { return match_new(MATCH_PROTOCOL, proto, 0, 0); }
fn match_dport(port: i64): i64 { return match_new(MATCH_DPORT, port, 0, 0); }
fn match_sport(port: i64): i64 { return match_new(MATCH_SPORT, port, 0, 0); }
fn match_dport_range(lo: i64, hi: i64): i64 { return match_new(MATCH_DPORT_RANGE, lo, hi, 0); }
fn match_iif(iface: cstring): i64 { return match_new(MATCH_IIF, iface, 0, 0); }
fn match_oif(iface: cstring): i64 { return match_new(MATCH_OIF, iface, 0, 0); }
fn match_ct_state(states_str: cstring): i64 { return match_new(MATCH_CT_STATE, states_str, 0, 0); }
fn match_limit(rate: i64, unit: i64, burst: i64): i64 { return match_new(MATCH_LIMIT, rate, unit, burst); }
fn match_set_lookup(field: cstring, set_name: cstring): i64 { return match_new(MATCH_SET_LOOKUP, field, set_name, 0); }
fn match_ct_helper(helper: cstring): i64 { return match_new(MATCH_CT_HELPER, helper, 0, 0); }
fn match_tcp_flags(flags_str: cstring): i64 { return match_new(MATCH_TCP_FLAGS, flags_str, 0, 0); }
fn match_icmp_type(tname: cstring): i64 { return match_new(MATCH_ICMP_TYPE, tname, 0, 0); }
fn match_icmpv6_type(tname: cstring): i64 { return match_new(MATCH_ICMPV6_TYPE, tname, 0, 0); }
fn match_meta_mark(val: i64): i64 { return match_new(MATCH_META_MARK, val, 0, 0); }
fn match_quota(mode: i64, amount: i64, unit: i64): i64 { return match_new(MATCH_QUOTA, mode, amount, unit); }
fn match_flow_offload(name: cstring): i64 { return match_new(MATCH_FLOW_OFFLOAD, name, 0, 0); }
fn match_ct_timeout_set(name: cstring): i64 { return match_new(MATCH_CT_TIMEOUT_SET, name, 0, 0); }
fn match_icmp_type_code(tname: cstring, code: i64): i64 { return match_new(MATCH_ICMP_TYPE_CODE, tname, code, 0); }
fn match_icmpv6_type_code(tname: cstring, code: i64): i64 { return match_new(MATCH_ICMPV6_TYPE_CODE, tname, code, 0); }
fn match_vlan_id(id: i64): i64 { return match_new(MATCH_VLAN_ID, id, 0, 0); }
fn match_dscp(val: i64): i64 { return match_new(MATCH_DSCP, val, 0, 0); }
fn match_ipv6_ext_hdr(hdr: i64): i64 { return match_new(MATCH_IPV6_EXT_HDR, hdr, 0, 0); }
fn match_frag_off(mask: i64, op: i64, value: i64): i64 { return match_new(MATCH_FRAG_OFF, mask, op, value); }
fn match_pkt_type(pt: i64): i64 { return match_new(MATCH_PKT_TYPE, pt, 0, 0); }
fn match_conn_limit(count: i64): i64 { return match_new(MATCH_CONN_LIMIT, count, 0, 0); }
fn match_raw(expr: cstring): i64 { return match_new(MATCH_RAW, expr, 0, 0); }

# ================================================================
# Verdict struct — { type, val1, val2, val3, val4 }
# Layout: [type:8][val1:8][val2:8][val3:8][val4:8] = 40 bytes
# ================================================================

fn verdict_new(vtype: i64, v1: i64, v2: i64, v3: i64, v4: i64): i64 {
    var v = alloc(40);
    store64(v, vtype);
    store64(v + 8, v1);
    store64(v + 16, v2);
    store64(v + 24, v3);
    store64(v + 32, v4);
    return v;
}

fn verdict_type(v: i64): i64 { return load64(v); }
fn verdict_val1(v: i64): i64 { return load64(v + 8); }
fn verdict_val2(v: i64): i64 { return load64(v + 16); }
fn verdict_val3(v: i64): i64 { return load64(v + 24); }
fn verdict_val4(v: i64): i64 { return load64(v + 32); }

# Verdict constructors
fn verdict_accept(): i64 { return verdict_new(VERDICT_ACCEPT, 0, 0, 0, 0); }
fn verdict_drop(): i64 { return verdict_new(VERDICT_DROP, 0, 0, 0, 0); }
# No verdict (1.8.2, audit B-4): for a rule whose last statement already ends
# it, such as a `redirect`. nft refuses a verdict after a terminal statement
# ("Statement after terminal statement has no effect"), which is why the mesh
# ruleset, rendering `... redirect to :15001 accept`, could never load. A
# rule with matches and no verdict falls through when it does not act — it
# never accepts — and rule_validate refuses one with no matches at all.
fn verdict_none(): i64 { return verdict_new(VERDICT_NONE, 0, 0, 0, 0); }
fn verdict_reject(): i64 { return verdict_new(VERDICT_REJECT, 0, 0, 0, 0); }
fn verdict_reject_with(reason: i64): i64 { return verdict_new(VERDICT_REJECT_WITH, reason, 0, 0, 0); }
fn verdict_jump(chain: cstring): i64 { return verdict_new(VERDICT_JUMP, chain, 0, 0, 0); }
fn verdict_goto(chain: cstring): i64 { return verdict_new(VERDICT_GOTO, chain, 0, 0, 0); }
fn verdict_return(): i64 { return verdict_new(VERDICT_RETURN, 0, 0, 0, 0); }
fn verdict_log(prefix: cstring): i64 { return verdict_new(VERDICT_LOG, prefix, 0, 0, 0); }
fn verdict_counter(): i64 { return verdict_new(VERDICT_COUNTER, 0, 0, 0, 0); }
fn verdict_set_mark(val: i64): i64 { return verdict_new(VERDICT_SET_MARK, val, 0, 0, 0); }
fn verdict_set_ct_mark(val: i64): i64 { return verdict_new(VERDICT_SET_CT_MARK, val, 0, 0, 0); }
fn verdict_log_advanced(prefix: cstring, level: i64, group: i64, snaplen: i64): i64 {
    return verdict_new(VERDICT_LOG_ADVANCED, prefix, level, group, snaplen);
}
fn verdict_counter_named(name: cstring): i64 { return verdict_new(VERDICT_COUNTER_NAMED, name, 0, 0, 0); }

# ================================================================
# Rule struct — { verdict, matches (vec), comment }
# Layout: [verdict:8][matches:8][comment:8] = 24 bytes
# ================================================================

fn rule_new(verdict: i64): i64 {
    var r = alloc(24);
    store64(r, verdict);
    store64(r + 8, vec_new());
    store64(r + 16, 0);
    return r;
}

fn rule_verdict(r: i64): i64 { return load64(r); }
fn rule_matches(r: i64): i64 { return load64(r + 8); }
fn rule_comment(r: i64): i64 { return load64(r + 16); }

fn rule_add_match(r: i64, m: i64): i64 {
    vec_push(load64(r + 8), m);
    return r;
}

fn rule_set_comment(r: i64, c: cstring): i64 {
    store64(r + 16, c);
    return r;
}

# ================================================================
# Anonymous-set match helpers
#
# nftables lets a single expression carry a braced set literal —
# `tcp dport { 80, 443 }` — which renders one rule where the naive
# construction needs several. These three build that literal for the common
# cases: a port list, an IPv4 source list, an IPv6 source list.
#
# All three go through match_raw, which `rule_validate` deliberately does NOT
# inspect (ADR-0004: Raw is the caller's responsibility). That makes build-time
# validation mandatory here — it is the only point at which these inputs are
# ever checked.
#
# DELIBERATE DEVIATION FROM THE RUST ORIGINAL: `Rule::matching_addrs` filtered
# invalid addresses out and logged a warning, keeping the rest. For a deny
# rule that silently fails OPEN — the dropped address stops being denied and
# nothing in the returned value says so. These return Err(NEIN_ERR_INVALID_RULE)
# on the first bad element instead, and leave the rule UNMODIFIED: every input
# is checked before any match is pushed, so a rejected call cannot leave a
# half-built rule behind.
#
# Each takes a Vec (ports: Vec<i64>, addrs: Vec<cstring>) and returns a packed
# Result — Ok(rule) or Err(NEIN_ERR_INVALID_RULE).
# ================================================================

fn _rule_addr_set(r: i64, addrs: i64, prefix: cstring): i64 {
    var n = vec_len(addrs);
    if (n == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }

    # Validate every address BEFORE mutating the rule.
    var i = 0;
    while (i < n) {
        var vr1_t, vr1_v = validate_addr(vec_get(addrs, i));
        if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
        i = i + 1;
    }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, prefix);
    i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ", "); }
        str_builder_add_cstr(sb, vec_get(addrs, i));
        i = i + 1;
    }
    str_builder_add_cstr(sb, " }");

    rule_add_match(r, match_raw(str_cstr(str_builder_build(sb))));
    return Ok(r);
}

# `{proto} dport { p1, p2, ... }` — adds a protocol match plus the port set.
fn rule_matching_ports(r: i64, proto: i64, ports: i64): i64 {
    var n = vec_len(ports);
    if (n == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }

    # Bounds-check every port before mutating the rule.
    var i = 0;
    while (i < n) {
        var p = vec_get(ports, i);
        if (p < 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
        if (p > 65535) { return nein_err(NEIN_ERR_INVALID_RULE); }
        i = i + 1;
    }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "dport { ");
    i = 0;
    while (i < n) {
        if (i > 0) { str_builder_add_cstr(sb, ", "); }
        str_builder_add_int(sb, vec_get(ports, i));
        i = i + 1;
    }
    str_builder_add_cstr(sb, " }");

    rule_add_match(r, match_protocol(proto));
    rule_add_match(r, match_raw(str_cstr(str_builder_build(sb))));
    return Ok(r);
}

# `ip saddr { a1, a2, ... }`
fn rule_matching_addrs(r: i64, addrs: i64): i64 {
    return _rule_addr_set(r, addrs, "ip saddr { ");
}

# `ip6 saddr { a1, a2, ... }`
fn rule_matching_addrs6(r: i64, addrs: i64): i64 {
    return _rule_addr_set(r, addrs, "ip6 saddr { ");
}

# ================================================================
# Hex rendering helper (stdlib lacks _sb_add_hex)
# ================================================================

fn _sb_add_hex(sb, val) {
    if (val == 0) {
        str_builder_add_cstr(sb, "0");
        return 0;
    }
    var buf[20];
    var pos = 19;
    store8(&buf + pos, 0);
    var n = val;
    while (n > 0) {
        pos = pos - 1;
        var digit = n & 15;
        if (digit < 10) {
            store8(&buf + pos, 48 + digit);
        } else {
            store8(&buf + pos, 97 + digit - 10);
        }
        n = n >> 4;
    }
    str_builder_add_cstr(sb, &buf + pos);
    return 0;
}

# ================================================================
# Render — match to nftables string
# ================================================================

# `cf`: 0 to render as written, or the table's family to render as nft lists
# it (see "Canonical spellings" above).
fn _render_match(sb, m, cf) {
    var mt = match_type(m);
    var v1 = match_val1(m);
    var v2 = match_val2(m);
    var v3 = match_val3(m);

    if (mt == MATCH_SOURCE_ADDR) {
        str_builder_add_cstr(sb, "ip saddr ");
        _sb_add_match_addr(sb, v1, cf);
    } elif (mt == MATCH_DEST_ADDR) {
        str_builder_add_cstr(sb, "ip daddr ");
        _sb_add_match_addr(sb, v1, cf);
    } elif (mt == MATCH_SOURCE_ADDR6) {
        str_builder_add_cstr(sb, "ip6 saddr ");
        _sb_add_match_addr(sb, v1, cf);
    } elif (mt == MATCH_DEST_ADDR6) {
        str_builder_add_cstr(sb, "ip6 daddr ");
        _sb_add_match_addr(sb, v1, cf);
    } elif (mt == MATCH_PROTOCOL) {
        str_builder_add_cstr(sb, _proto_str(v1));
    } elif (mt == MATCH_DPORT) {
        str_builder_add_cstr(sb, "dport ");
        str_builder_add_int(sb, v1);
    } elif (mt == MATCH_SPORT) {
        str_builder_add_cstr(sb, "sport ");
        str_builder_add_int(sb, v1);
    } elif (mt == MATCH_DPORT_RANGE) {
        str_builder_add_cstr(sb, "dport ");
        str_builder_add_int(sb, v1);
        str_builder_add_cstr(sb, "-");
        str_builder_add_int(sb, v2);
    } elif (mt == MATCH_IIF) {
        # iifname, not iif (1.8.2, audit I-7/B-11): `iif` resolves the name to
        # an ifindex when the ruleset LOADS, so a rule naming a bridge that does
        # not exist yet fails the whole batch, and one naming a bridge that is
        # later recreated silently stops matching. `iifname` compares the name
        # per packet and survives both.
        str_builder_add_cstr(sb, "iifname \"");
        str_builder_add_cstr(sb, v1);
        str_builder_add_cstr(sb, "\"");
    } elif (mt == MATCH_OIF) {
        str_builder_add_cstr(sb, "oifname \"");
        str_builder_add_cstr(sb, v1);
        str_builder_add_cstr(sb, "\"");
    } elif (mt == MATCH_CT_STATE) {
        var csm = 0;
        if (cf != 0) { csm = _word_list_mask(v1, 1); }
        if (csm != 0) {
            str_builder_add_cstr(sb, "ct state ");
            _sb_add_flag_set(sb, csm, 1, "");
        } else {
            str_builder_add_cstr(sb, "ct state { ");
            str_builder_add_cstr(sb, v1);
            str_builder_add_cstr(sb, " }");
        }
    } elif (mt == MATCH_LIMIT) {
        str_builder_add_cstr(sb, "limit rate ");
        str_builder_add_int(sb, v1);
        str_builder_add_cstr(sb, "/");
        str_builder_add_cstr(sb, _rate_unit_str(v2));
        str_builder_add_cstr(sb, " burst ");
        str_builder_add_int(sb, v3);
        str_builder_add_cstr(sb, " packets");
    } elif (mt == MATCH_SET_LOOKUP) {
        str_builder_add_cstr(sb, v1);
        str_builder_add_cstr(sb, " @");
        str_builder_add_cstr(sb, v2);
    } elif (mt == MATCH_CT_HELPER) {
        str_builder_add_cstr(sb, "ct helper \"");
        str_builder_add_cstr(sb, v1);
        str_builder_add_cstr(sb, "\"");
    } elif (mt == MATCH_TCP_FLAGS) {
        # One flag in braces lists as `tcp flags == syn`: the same test, since
        # a one-element set matches exactly that value.
        var tfm = 0;
        if (cf != 0) { tfm = _word_list_mask(v1, 2); }
        if (tfm != 0) {
            str_builder_add_cstr(sb, "tcp flags ");
            _sb_add_flag_set(sb, tfm, 2, "== ");
        } else {
            str_builder_add_cstr(sb, "tcp flags { ");
            str_builder_add_cstr(sb, v1);
            str_builder_add_cstr(sb, " }");
        }
    } elif (mt == MATCH_ICMP_TYPE) {
        str_builder_add_cstr(sb, "icmp type ");
        str_builder_add_cstr(sb, v1);
    } elif (mt == MATCH_ICMPV6_TYPE) {
        str_builder_add_cstr(sb, "icmpv6 type ");
        str_builder_add_cstr(sb, v1);
    } elif (mt == MATCH_META_MARK) {
        str_builder_add_cstr(sb, "meta mark ");
        if (cf != 0) { _sb_add_hex_fixed(sb, v1, 8); } else { str_builder_add_int(sb, v1); }
    } elif (mt == MATCH_QUOTA) {
        # `until` is nft's default mode, and it lists none.
        str_builder_add_cstr(sb, "quota ");
        if (cf == 0 || v1 != QUOTA_UNTIL) {
            str_builder_add_cstr(sb, _quota_mode_str(v1));
            str_builder_add_cstr(sb, " ");
        }
        _sb_add_quota_amount(sb, v2, v3, cf);
    } elif (mt == MATCH_FLOW_OFFLOAD) {
        str_builder_add_cstr(sb, "flow offload @");
        str_builder_add_cstr(sb, v1);
    } elif (mt == MATCH_CT_TIMEOUT_SET) {
        str_builder_add_cstr(sb, "ct timeout set \"");
        str_builder_add_cstr(sb, v1);
        str_builder_add_cstr(sb, "\"");
    } elif (mt == MATCH_ICMP_TYPE_CODE) {
        str_builder_add_cstr(sb, "icmp type ");
        str_builder_add_cstr(sb, v1);
        str_builder_add_cstr(sb, " icmp code ");
        str_builder_add_int(sb, v2);
    } elif (mt == MATCH_ICMPV6_TYPE_CODE) {
        str_builder_add_cstr(sb, "icmpv6 type ");
        str_builder_add_cstr(sb, v1);
        str_builder_add_cstr(sb, " icmpv6 code ");
        str_builder_add_int(sb, v2);
    } elif (mt == MATCH_VLAN_ID) {
        str_builder_add_cstr(sb, "vlan id ");
        str_builder_add_int(sb, v1);
    } elif (mt == MATCH_DSCP) {
        str_builder_add_cstr(sb, "ip dscp ");
        if (cf != 0) {
            var dn = _dscp_name(v1);
            if (dn != 0) { str_builder_add_cstr(sb, dn); } else { _sb_add_hex_fixed(sb, v1, 2); }
        } else {
            str_builder_add_int(sb, v1);
        }
    } elif (mt == MATCH_IPV6_EXT_HDR) {
        str_builder_add_cstr(sb, "exthdr ");
        str_builder_add_cstr(sb, _ipv6_ext_hdr_str(v1));
        str_builder_add_cstr(sb, " exists");
    } elif (mt == MATCH_FRAG_OFF) {
        str_builder_add_cstr(sb, "ip frag-off & 0x");
        _sb_add_hex(sb, v1);
        str_builder_add_cstr(sb, " ");
        str_builder_add_cstr(sb, _cmp_op_str(v2));
        str_builder_add_cstr(sb, " 0x");
        _sb_add_hex(sb, v3);
    } elif (mt == MATCH_PKT_TYPE) {
        str_builder_add_cstr(sb, "meta pkttype ");
        # nft names unicast `host` (the kernel's PACKET_HOST).
        if (cf != 0 && v1 == PKT_UNICAST) { str_builder_add_cstr(sb, "host"); }
        else { str_builder_add_cstr(sb, _pkt_type_str(v1)); }
    } elif (mt == MATCH_CONN_LIMIT) {
        str_builder_add_cstr(sb, "ct count over ");
        str_builder_add_int(sb, v1);
    } elif (mt == MATCH_RAW) {
        str_builder_add_cstr(sb, v1);
    } else {
        # An unknown match type (1.8.2, audit I-3) used to render NOTHING, so a
        # rule meant to be conditional became an unconditional verdict — in a
        # policy-drop chain, a bare `accept`. rule_validate refuses it; this
        # token makes an unvalidated render fail closed too (nft: syntax error).
        str_builder_add_cstr(sb, "__nein_invalid_match__");
    }
    return 0;
}

# A reject reason as nft lists it: without the `type` keyword, and nothing at
# all for the family's default (`icmp port-unreachable` in an ip table).
fn _reject_reason_canon(r, cf) {
    if (r == REJECT_ICMP_PORT_UNREACH && cf == FAMILY_IP) { return 0; }
    if (r == REJECT_ICMP_HOST_UNREACH) { return "icmp host-unreachable"; }
    if (r == REJECT_ICMP_PORT_UNREACH) { return "icmp port-unreachable"; }
    if (r == REJECT_ICMP_NET_UNREACH) { return "icmp net-unreachable"; }
    if (r == REJECT_ICMP_ADMIN_PROHIB) { return "icmp admin-prohibited"; }
    if (r == REJECT_ICMPX_ADMIN_PROHIB) { return "icmpx admin-prohibited"; }
    return _reject_reason_str(r);
}

# `cf` as for _render_match.
fn _render_verdict(sb, v, cf) {
    var vt = verdict_type(v);
    var v1 = verdict_val1(v);
    var v2 = verdict_val2(v);
    var v3 = verdict_val3(v);
    var v4 = verdict_val4(v);

    if (vt == VERDICT_ACCEPT) {
        str_builder_add_cstr(sb, "accept");
    } elif (vt == VERDICT_DROP) {
        str_builder_add_cstr(sb, "drop");
    } elif (vt == VERDICT_REJECT) {
        str_builder_add_cstr(sb, "reject");
    } elif (vt == VERDICT_REJECT_WITH) {
        str_builder_add_cstr(sb, "reject");
        var rr = _reject_reason_str(v1);
        if (cf != 0) { rr = _reject_reason_canon(v1, cf); }
        if (rr != 0) {
            str_builder_add_cstr(sb, " with ");
            str_builder_add_cstr(sb, rr);
        }
    } elif (vt == VERDICT_JUMP) {
        str_builder_add_cstr(sb, "jump ");
        str_builder_add_cstr(sb, v1);
    } elif (vt == VERDICT_GOTO) {
        str_builder_add_cstr(sb, "goto ");
        str_builder_add_cstr(sb, v1);
    } elif (vt == VERDICT_RETURN) {
        str_builder_add_cstr(sb, "return");
    } elif (vt == VERDICT_LOG) {
        str_builder_add_cstr(sb, "log");
        if (v1 != 0) {
            str_builder_add_cstr(sb, " prefix \"");
            str_builder_add_cstr(sb, v1);
            str_builder_add_cstr(sb, "\"");
        }
    } elif (vt == VERDICT_COUNTER) {
        str_builder_add_cstr(sb, "counter");
    } elif (vt == VERDICT_SET_MARK) {
        str_builder_add_cstr(sb, "meta mark set ");
        if (cf != 0) { _sb_add_hex_fixed(sb, v1, 8); } else { str_builder_add_int(sb, v1); }
    } elif (vt == VERDICT_SET_CT_MARK) {
        str_builder_add_cstr(sb, "ct mark set ");
        if (cf != 0) { _sb_add_hex_fixed(sb, v1, 8); } else { str_builder_add_int(sb, v1); }
    } elif (vt == VERDICT_LOG_ADVANCED) {
        str_builder_add_cstr(sb, "log");
        if (v1 != 0) {
            str_builder_add_cstr(sb, " prefix \"");
            str_builder_add_cstr(sb, v1);
            str_builder_add_cstr(sb, "\"");
        }
        # warn is nft's default level, and it lists none.
        if (v2 != 0 && (cf == 0 || v2 != NFT_LOG_WARN)) {
            str_builder_add_cstr(sb, " level ");
            str_builder_add_cstr(sb, _log_level_str(v2));
        }
        if (v3 != 0) {
            str_builder_add_cstr(sb, " group ");
            str_builder_add_int(sb, v3);
        }
        if (v4 != 0) {
            str_builder_add_cstr(sb, " snaplen ");
            str_builder_add_int(sb, v4);
        }
    } elif (vt == VERDICT_COUNTER_NAMED) {
        str_builder_add_cstr(sb, "counter name \"");
        str_builder_add_cstr(sb, v1);
        str_builder_add_cstr(sb, "\"");
    } elif (vt == VERDICT_NONE) {
        # deliberately nothing
    } else {
        # Unknown verdict type (I-3): rendered nothing through 1.8.1. Fail closed.
        str_builder_add_cstr(sb, "__nein_invalid_verdict__");
    }
    return 0;
}

fn _is_port_match(mt: i64): i64 {
    if (mt == MATCH_DPORT || mt == MATCH_SPORT || mt == MATCH_DPORT_RANGE) { return 1; }
    return 0;
}

# Render a complete rule to nftables syntax string
fn rule_render(r: i64): Str { return _rule_render_cf(r, 0); }

# The rule as nft lists it in a table of family `fam` (1.9.2, audit P-8) —
# what nein_diff compares; see "Canonical spellings".
fn _rule_render_canon(r: i64, fam: i64): Str { return _rule_render_cf(r, fam); }

fn _rule_render_cf(r: i64, cf: i64): Str {
    var sb = str_builder_new();
    var matches = rule_matches(r);
    var len = vec_len(matches);
    var i = 0;
    while (i < len) {
        if (i > 0) { str_builder_add_cstr(sb, " "); }
        var m = vec_get(matches, i);
        var mt = match_type(m);
        # A protocol renders as its bare name ("tcp") only when a port match
        # follows to complete it ("tcp dport 22"); a port match renders bare
        # ("dport 22") only after one. On its own each is an nft syntax error
        # (1.8.2, audit I-7), so a protocol-only rule renders `meta l4proto tcp`
        # and a port with no protocol before it renders `th dport 22`.
        var next_is_port = 0;
        if (i + 1 < len) { next_is_port = _is_port_match(match_type(vec_get(matches, i + 1))); }
        var prev_is_proto = 0;
        if (i > 0) {
            if (match_type(vec_get(matches, i - 1)) == MATCH_PROTOCOL) { prev_is_proto = 1; }
        }
        if (mt == MATCH_PROTOCOL && next_is_port == 0) {
            str_builder_add_cstr(sb, "meta l4proto ");
            # nft lists protocol 58 by its /etc/protocols name, ipv6-icmp.
            if (cf != 0 && match_val1(m) == PROTO_ICMPV6) { str_builder_add_cstr(sb, "ipv6-icmp"); }
            else { str_builder_add_cstr(sb, _proto_str(match_val1(m))); }
        } else {
            if (_is_port_match(mt) == 1 && prev_is_proto == 0) { str_builder_add_cstr(sb, "th "); }
            _render_match(sb, m, cf);
        }
        i = i + 1;
    }

    if (len > 0 && verdict_type(rule_verdict(r)) != VERDICT_NONE) { str_builder_add_cstr(sb, " "); }
    _render_verdict(sb, rule_verdict(r), cf);

    var comment = rule_comment(r);
    if (comment != 0) {
        str_builder_add_cstr(sb, " comment \"");
        str_builder_add_cstr(sb, comment);
        str_builder_add_cstr(sb, "\"");
    }

    return str_builder_build(sb);
}

# ================================================================
# Validate — check all string fields for injection
# ================================================================

# lo <= v <= hi
fn _in_range(v: i64, lo: i64, hi: i64): i64 {
    if (v < lo || v > hi) { return 0; }
    return 1;
}

# Every numeric and enum field of a match type not checked inline in
# rule_validate (1.8.2, audit I-3 / I-8). An unknown match type is refused
# here — through 1.8.1 it rendered nothing — and every enum must be in
# range, because the string helpers fall back silently (an unknown compare
# op became "==", an unknown quota mode "over"): an out-of-range value never
# errored, it became a DIFFERENT valid rule. Numbers that nft would reject
# are refused here too, so the error names the rule instead of failing the
# whole batch at apply.
fn _rule_match_numbers_ok(m: i64): i64 {
    var mt = match_type(m);
    var v1 = match_val1(m);
    var v2 = match_val2(m);
    var v3 = match_val3(m);
    if (_in_range(mt, MATCH_SOURCE_ADDR, MATCH_RAW) == 0) { return 0; }
    if (mt == MATCH_PROTOCOL) { return _in_range(v1, PROTO_TCP, PROTO_ICMPV6); }
    if (mt == MATCH_DPORT || mt == MATCH_SPORT) { return _in_range(v1, 0, 65535); }
    if (mt == MATCH_LIMIT) {
        # nft: rate 0 is EINVAL, and "packet limit burst must be > 0".
        if (_in_range(v1, 1, 0xFFFFFFFF) == 0) { return 0; }
        if (_in_range(v2, RATE_SECOND, RATE_DAY) == 0) { return 0; }
        return _in_range(v3, 1, 0xFFFFFFFF);
    }
    if (mt == MATCH_META_MARK) { return _in_range(v1, 0, 0xFFFFFFFF); }
    if (mt == MATCH_QUOTA) {
        if (_in_range(v1, QUOTA_OVER, QUOTA_UNTIL) == 0) { return 0; }
        if (_in_range(v3, QUNIT_BYTES, QUNIT_GBYTES) == 0) { return 0; }
        # The byte count must fit: gbytes renders as amount * 1024 mbytes, and
        # the diff compares it in bytes (1.9.2).
        return _in_range(v2, 0, 0x7FFFFFFFFFFFFFFF / _quota_unit_bytes(v3));
    }
    if (mt == MATCH_ICMP_TYPE_CODE || mt == MATCH_ICMPV6_TYPE_CODE) { return _in_range(v2, 0, 255); }
    # EXT_AUTH is refused (1.9.2): nft has no exthdr for the AH header —
    # `exthdr auth exists` is a syntax error in nft 1.1.7 (it takes hbh, rt,
    # frag, dst and mh), so a rule with it failed the whole batch at apply.
    if (mt == MATCH_IPV6_EXT_HDR) { return _in_range(v1, EXT_HOP_BY_HOP, EXT_MOBILITY); }
    if (mt == MATCH_FRAG_OFF) {
        # `_sb_add_hex` renders a negative value as a bare "0x" (audit I-8).
        if (_in_range(v1, 0, 0xFFFF) == 0) { return 0; }
        if (_in_range(v2, NFT_CMP_EQ, NFT_CMP_GE) == 0) { return 0; }
        return _in_range(v3, 0, 0xFFFF);
    }
    if (mt == MATCH_PKT_TYPE) { return _in_range(v1, PKT_UNICAST, PKT_MULTICAST); }
    if (mt == MATCH_CONN_LIMIT) { return _in_range(v1, 0, 0xFFFFFFFF); }
    return 1;
}

# Verdict type and its numeric fields (1.8.2, audit I-3 / I-7 / I-8).
fn _rule_verdict_numbers_ok(v: i64): i64 {
    var vt = verdict_type(v);
    if (_in_range(vt, VERDICT_ACCEPT, VERDICT_NONE) == 0) { return 0; }
    if (vt == VERDICT_REJECT_WITH) { return _in_range(verdict_val1(v), REJECT_ICMP_HOST_UNREACH, REJECT_TCP_RESET); }
    if (vt == VERDICT_SET_MARK || vt == VERDICT_SET_CT_MARK) { return _in_range(verdict_val1(v), 0, 0xFFFFFFFF); }
    if (vt == VERDICT_LOG_ADVANCED) {
        var lvl = verdict_val2(v);
        var grp = verdict_val3(v);
        if (_in_range(lvl, 0, NFT_LOG_DEBUG) == 0) { return 0; }
        if (_in_range(grp, 0, 65535) == 0) { return 0; }
        # nft: "level and group are mutually exclusive" (audit I-7).
        if (lvl != 0 && grp != 0) { return 0; }
        return _in_range(verdict_val4(v), 0, 0xFFFFFFFF);
    }
    return 1;
}

fn rule_validate(r: i64): i64 {
    var matches = rule_matches(r);
    var len = vec_len(matches);
    # A rule with no verdict and no matches says nothing (VERDICT_NONE).
    if (len == 0 && verdict_type(rule_verdict(r)) == VERDICT_NONE) { return nein_err(NEIN_ERR_INVALID_RULE); }
    var i = 0;
    var vr = 0;
    while (i < len) {
        var m = vec_get(matches, i);
        var mt = match_type(m);
        var v1 = match_val1(m);
        var v2 = match_val2(m);

        if (mt == MATCH_SOURCE_ADDR || mt == MATCH_DEST_ADDR ||
          mt == MATCH_SOURCE_ADDR6 || mt == MATCH_DEST_ADDR6) {
            var vr1_t, vr1_v = validate_addr(v1);
            if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
            # The address must be the match's own family (1.8.2): `ip saddr
            # 2001:db8::1` is not an address to nft but a HOSTNAME to resolve,
            # so the whole batch failed at apply ("Could not resolve hostname").
            var want = 4;
            if (mt == MATCH_SOURCE_ADDR6 || mt == MATCH_DEST_ADDR6) { want = 6; }
            if (_addr_family(v1) != want) { return nein_err(NEIN_ERR_INVALID_RULE); }
        } elif (mt == MATCH_IIF || mt == MATCH_OIF) {
            var vr2_t, vr2_v = validate_iface(v1);
            if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
        } elif (mt == MATCH_CT_HELPER || mt == MATCH_CT_TIMEOUT_SET) {
            # Rendered quoted (`ct helper "x"`), so an nft keyword is a name here.
            var vr3_t, vr3_v = validate_identifier(v1);
            if (is_err_result(vr3_t) == 1) { return Err(vr3_v); }
        } elif (mt == MATCH_FLOW_OFFLOAD) {
            # `flow offload @NAME`: a name nft can read after '@' (1.9.1, I-10).
            var vr4_t, vr4_v = validate_nft_name(v1);
            if (is_err_result(vr4_t) == 1) { return Err(vr4_v); }
            if (_nft_ref_reserved(v1, 1) == 1) { return nein_err(NEIN_ERR_INVALID_RULE); }
        } elif (mt == MATCH_SET_LOOKUP) {
            # Closed set of selectors (1.8.2, audit I-2) — see _is_set_lookup_field.
            if (_is_set_lookup_field(v1) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
            var vr5_t, vr5_v = validate_nft_name(v2);
            if (is_err_result(vr5_t) == 1) { return Err(vr5_v); }
            if (_nft_ref_reserved(v2, 0) == 1) { return nein_err(NEIN_ERR_INVALID_RULE); }
        } elif (mt == MATCH_ICMP_TYPE || mt == MATCH_ICMPV6_TYPE) {
            var vr6_t, vr6_v = validate_identifier(v1);
            if (is_err_result(vr6_t) == 1) { return Err(vr6_v); }
        } elif (mt == MATCH_ICMP_TYPE_CODE || mt == MATCH_ICMPV6_TYPE_CODE) {
            var vr7_t, vr7_v = validate_identifier(v1);
            if (is_err_result(vr7_t) == 1) { return Err(vr7_v); }
        } elif (mt == MATCH_TCP_FLAGS) {
            var vr8_t, vr8_v = validate_nft_element(v1);
            if (is_err_result(vr8_t) == 1) { return Err(vr8_v); }
        } elif (mt == MATCH_CT_STATE) {
            # Was MISSING entirely before 1.6.9 — _render_match interpolates
            # this straight into `ct state { ... }`, so an unchecked value
            # could close the brace and append arbitrary nft statements.
            var vr9_t, vr9_v = validate_ct_state_list(v1);
            if (is_err_result(vr9_t) == 1) { return Err(vr9_v); }
        } elif (mt == MATCH_DSCP) {
            if (_in_range(v1, 0, 63) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
        } elif (mt == MATCH_VLAN_ID) {
            if (_in_range(v1, 0, 4094) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
        } elif (mt == MATCH_DPORT_RANGE) {
            if (_in_range(v1, 0, 65535) == 0 || _in_range(v2, v1, 65535) == 0) {
                return nein_err(NEIN_ERR_INVALID_RULE);
            }
        } elif (mt == MATCH_RAW) {
            # Deliberately not validated — caller's responsibility
        } elif (_rule_match_numbers_ok(m) == 0) {
            return nein_err(NEIN_ERR_INVALID_RULE);
        }

        i = i + 1;
    }

    # Validate verdict strings
    var v = rule_verdict(r);
    var vt = verdict_type(v);
    if (_rule_verdict_numbers_ok(v) == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (vt == VERDICT_JUMP || vt == VERDICT_GOTO) {
        var vr10_t, vr10_v = validate_nft_name(verdict_val1(v));
        if (is_err_result(vr10_t) == 1) { return Err(vr10_v); }
    } elif (vt == VERDICT_LOG) {
        if (verdict_val1(v) != 0) {
            var vr11_t, vr11_v = validate_log_prefix(verdict_val1(v));
            if (is_err_result(vr11_t) == 1) { return Err(vr11_v); }
        }
    } elif (vt == VERDICT_LOG_ADVANCED) {
        if (verdict_val1(v) != 0) {
            var vr12_t, vr12_v = validate_log_prefix(verdict_val1(v));
            if (is_err_result(vr12_t) == 1) { return Err(vr12_v); }
        }
    } elif (vt == VERDICT_COUNTER_NAMED) {
        var vr13_t, vr13_v = validate_identifier(verdict_val1(v));
        if (is_err_result(vr13_t) == 1) { return Err(vr13_v); }
    }

    # Validate comment
    var comment = rule_comment(r);
    if (comment != 0) {
        var vr14_t, vr14_v = validate_comment(comment);
        if (is_err_result(vr14_t) == 1) { return Err(vr14_v); }
    }

    return nein_ok();
}

# ================================================================
# Family — what a table of each family can hold (1.9.3)
# ================================================================
# rule_validate judges a rule on its own; nft judges it in its table's family,
# and refuses `ip saddr` in an ip6 table, conntrack in an arp or netdev one,
# `reject with icmpx` in an ip one. Through 1.9.2 such a rule validated and the
# whole batch failed at apply. firewall_validate now asks these, with the
# table's family. Every answer was probed against nft 1.1.7 (each match and
# verdict alone in a table of each family: tests/integration/nft_family.tcyr),
# not read from the man page. Families are FAMILY_* (table.cyr).

# The rule's ip payload (saddr / daddr, dscp, frag-off) can load: not in ip6
# or arp tables.
fn _fam_has_ip(fam: i64): i64 {
    if (fam == FAMILY_IP6 || fam == FAMILY_ARP) { return 0; }
    return 1;
}

# ip6 payload and extension headers: not in ip or arp tables.
fn _fam_has_ip6(fam: i64): i64 {
    if (fam == FAMILY_IP || fam == FAMILY_ARP) { return 0; }
    return 1;
}

# Transport and icmp headers (`tcp dport`, `tcp flags`, `icmp type`): not in
# arp tables. `th dport` and `meta l4proto` load everywhere.
fn _fam_has_l4(fam: i64): i64 {
    if (fam == FAMILY_ARP) { return 0; }
    return 1;
}

# Conntrack (`ct state`, `ct helper`, `ct count`, `ct mark set`, ct timeouts):
# not in arp or netdev tables (the kernel answers "Protocol error").
fn _fam_has_ct(fam: i64): i64 {
    if (fam == FAMILY_ARP || fam == FAMILY_NETDEV) { return 0; }
    return 1;
}

# Flowtables and `flow offload`: inet, ip and ip6 tables only.
fn _fam_has_flowtable(fam: i64): i64 {
    if (fam == FAMILY_INET || fam == FAMILY_IP || fam == FAMILY_IP6) { return 1; }
    return 0;
}

# A set lookup's selector (validate.cyr's closed set) in a table of family
# `fam`; `th`, `meta l4proto` and the interface names load everywhere.
fn _set_field_family_ok(field: cstring, fam: i64): i64 {
    if (streq(field, "ip saddr") == 1 || streq(field, "ip daddr") == 1) { return _fam_has_ip(fam); }
    if (streq(field, "ip6 saddr") == 1 || streq(field, "ip6 daddr") == 1) { return _fam_has_ip6(fam); }
    if (streq(field, "tcp dport") == 1 || streq(field, "tcp sport") == 1
      || streq(field, "udp dport") == 1 || streq(field, "udp sport") == 1) {
        return _fam_has_l4(fam);
    }
    return 1;
}

# Rule `r` in a table of family `fam`: -1 when nft refuses it there, else 1
# when it holds a statement only some hooks take (a reject, a flow offload:
# see chain.cyr's _chain_rule_context_ok) and 0 when it holds none. One scan
# of the matches answers both, as firewall_validate asks both of every rule.
fn _rule_family_needs(r: i64, fam: i64): i64 {
    var needs = 0;
    var matches = rule_matches(r);
    var len = vec_len(matches);
    var i = 0;
    if (fam == FAMILY_INET) {
        # An inet table takes every match and verdict nein renders (the probe
        # found no refusal there), so only the hook needs are left to find.
        while (i < len) {
            if (match_type(vec_get(matches, i)) == MATCH_FLOW_OFFLOAD) { return 1; }
            i = i + 1;
        }
        var ivt = verdict_type(rule_verdict(r));
        if (ivt == VERDICT_REJECT || ivt == VERDICT_REJECT_WITH) { return 1; }
        return 0;
    }
    while (i < len) {
        var m = vec_get(matches, i);
        var mt = match_type(m);
        var ok = 1;
        if (mt == MATCH_SOURCE_ADDR || mt == MATCH_DEST_ADDR || mt == MATCH_DSCP || mt == MATCH_FRAG_OFF) {
            ok = _fam_has_ip(fam);
        } elif (mt == MATCH_SOURCE_ADDR6 || mt == MATCH_DEST_ADDR6 || mt == MATCH_IPV6_EXT_HDR) {
            ok = _fam_has_ip6(fam);
        } elif (mt == MATCH_PROTOCOL) {
            # Bare `tcp` before a port is the transport header; alone it renders
            # `meta l4proto tcp`, which loads everywhere.
            if (i + 1 < len) {
                if (_is_port_match(match_type(vec_get(matches, i + 1))) == 1) { ok = _fam_has_l4(fam); }
            }
        } elif (mt == MATCH_TCP_FLAGS || mt == MATCH_ICMP_TYPE || mt == MATCH_ICMPV6_TYPE
          || mt == MATCH_ICMP_TYPE_CODE || mt == MATCH_ICMPV6_TYPE_CODE) {
            ok = _fam_has_l4(fam);
        } elif (mt == MATCH_CT_STATE || mt == MATCH_CT_HELPER || mt == MATCH_CONN_LIMIT
          || mt == MATCH_CT_TIMEOUT_SET) {
            ok = _fam_has_ct(fam);
        } elif (mt == MATCH_SET_LOOKUP) {
            ok = _set_field_family_ok(match_val1(m), fam);
        } elif (mt == MATCH_FLOW_OFFLOAD) {
            ok = _fam_has_flowtable(fam);
            needs = 1;
        }
        if (ok == 0) { return 0 - 1; }
        i = i + 1;
    }
    var v = rule_verdict(r);
    var vt = verdict_type(v);
    if (vt == VERDICT_REJECT || vt == VERDICT_REJECT_WITH) {
        if (fam == FAMILY_ARP) { return 0 - 1; }   # "cannot use reject with arp"
        if (vt == VERDICT_REJECT_WITH) {
            var why = verdict_val1(v);
            # icmpx is the inet / bridge / netdev abstraction: "abstracted ICMP
            # unreachable not supported" in ip and ip6 tables.
            if (why == REJECT_ICMPX_ADMIN_PROHIB && (fam == FAMILY_IP || fam == FAMILY_IP6)) { return 0 - 1; }
            # An ICMPv4 reason in an ip6 table: "conflicting protocols".
            if (why != REJECT_ICMPX_ADMIN_PROHIB && why != REJECT_TCP_RESET && fam == FAMILY_IP6) { return 0 - 1; }
        }
        needs = 1;
    }
    if (vt == VERDICT_SET_CT_MARK && _fam_has_ct(fam) == 0) { return 0 - 1; }
    return needs;
}

# ================================================================
# Convenience functions
# ================================================================

fn allow_tcp(port: i64): i64 {
    var r = rule_new(verdict_accept());
    rule_add_match(r, match_protocol(PROTO_TCP));
    rule_add_match(r, match_dport(port));
    return r;
}

fn allow_udp(port: i64): i64 {
    var r = rule_new(verdict_accept());
    rule_add_match(r, match_protocol(PROTO_UDP));
    rule_add_match(r, match_dport(port));
    return r;
}

fn allow_established(): i64 {
    var r = rule_new(verdict_accept());
    rule_add_match(r, match_ct_state("established, related"));
    return r;
}

fn deny_source(cidr: cstring): i64 {
    var r = rule_new(verdict_drop());
    rule_add_match(r, _match_addr(cidr, 0));
    return r;
}

fn deny_source6(cidr: cstring): i64 {
    var r = rule_new(verdict_drop());
    rule_add_match(r, match_source_addr6(cidr));
    return r;
}

fn allow_service(source_cidr: cstring, protocol: i64, port: i64): i64 {
    var r = rule_new(verdict_accept());
    rule_add_match(r, _match_addr(source_cidr, 0));
    rule_add_match(r, match_protocol(protocol));
    rule_add_match(r, match_dport(port));
    return r;
}

fn rate_limit_tcp(port: i64, rate: i64, unit: i64): i64 {
    var r = rule_new(verdict_accept());
    rule_add_match(r, match_protocol(PROTO_TCP));
    rule_add_match(r, match_dport(port));
    rule_add_match(r, match_limit(rate, unit, rate));
    return r;
}

fn rate_limit_udp(port: i64, rate: i64, unit: i64): i64 {
    var r = rule_new(verdict_accept());
    rule_add_match(r, match_protocol(PROTO_UDP));
    rule_add_match(r, match_dport(port));
    rule_add_match(r, match_limit(rate, unit, rate));
    return r;
}

fn rate_limit_quic(port: i64, rate: i64, unit: i64): i64 {
    var r = rule_new(verdict_accept());
    rule_add_match(r, match_protocol(PROTO_UDP));
    rule_add_match(r, match_dport(port));
    rule_add_match(r, match_limit(rate, unit, rate * 2));
    rule_set_comment(r, "quic rate limit");
    return r;
}
