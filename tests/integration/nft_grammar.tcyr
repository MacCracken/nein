# Integration: nein's validators agree with the installed nft's grammar
# (1.9.1, audit I-10 and B-8, and an address spelling found alongside them).
#
# Names. validate_nft_name refuses what nft 1.1.7 refuses as a bare name: a
# leading digit or '-', and 160 keywords (28 more for a ct timeout's name, 16
# more for `list table`'s, and `@ll`, `@nh`, `flow offload @last` as
# references). Those lists were found by probing nft, so this file asks the nft
# installed here.
#
# Addresses. validate_addr took `1:2:3:4:5:6:1.2.3.4` (six groups and a dotted
# quad, no "::"), which nft cannot parse. A few hundred IPv6 spellings,
# generated the same way every run, go to both.
#
#   - FAIL when nein takes what nft refuses. That is the defect class: the
#     batch fails at apply. Besides fixed near-misses, every token nft lists
#     in its own "expected any of" errors is tried as a name, so a keyword a
#     later nft adds shows here as a failure, naming the word to add.
#   - NOTE when nein refuses what this nft takes. The keyword lists are nft
#     1.1.7's and an older nft has fewer; refusing one it would take costs a
#     name, not a batch.
#   - Every builder at the B-8 length limits renders a ruleset nft loads, and
#     so do interface names nft would otherwise read as keywords.
#
# Exhaustively, every 1-3 character name validate_nft_name takes is a chain
# name to nft (bisecting any batch nft refuses), and every table name
# list_table_with_handles takes can be listed.
#
# Runs nft as root inside a throwaway user + network namespace
# (`unshare -rn`), as tests/integration/nft_load.tcyr does; reports SKIP and
# passes where that cannot run. Run it locally before a release.

include "src/lib/error.cyr"
include "src/lib/validate.cyr"
include "src/lib/rule.cyr"
include "src/lib/set.cyr"
include "src/lib/nat.cyr"
include "src/lib/chain.cyr"
include "src/lib/table.cyr"
include "src/lib/firewall.cyr"
include "src/lib/builder.cyr"
include "src/lib/policy.cyr"
include "src/lib/geoip.cyr"
include "src/lib/mesh.cyr"
include "src/lib/bridge.cyr"
include "src/lib/engine.cyr"
include "src/lib/config.cyr"
include "src/lib/netns.cyr"
include "src/lib/apply.cyr"
include "src/lib/inspect.cyr"
include "src/lib/diff.cyr"

var _nn_nft = "/usr/sbin/nft";
var _nn_unshare = "/usr/bin/unshare";
var _nn_dir = 0;
var _nn_path = 0;
var _nn_agree = 0;
var _nn_fail = 0;
var _nn_note = 0;
var _nn_out = 0;
var _NN_OUT_MAX = 65536;

fn _nn_cat(a: cstring, b: cstring, c: cstring): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    str_builder_add_cstr(sb, c);
    return str_cstr(str_builder_build(sb));
}

# argv for `unshare -rn nft -c -f <file>` through /bin/sh, which sends nft's
# output where `redirect` says (exec_vec passes no environment, so every
# path is absolute).
fn _nn_argv(redirect: cstring): i64 {
    var args = vec_new();
    vec_push(args, "/bin/sh");
    vec_push(args, "-c");
    vec_push(args, _nn_cat("exec \"$0\" -rn \"$1\" -c -f \"$2\" ", redirect, ""));
    vec_push(args, _nn_unshare);
    vec_push(args, _nn_nft);
    vec_push(args, _nn_path);
    return args;
}

fn _nn_write(text: cstring): i64 {
    var fd = sys_open(_nn_path, 577, 420);   # O_WRONLY|O_CREAT|O_TRUNC, 0644
    if (fd < 0) { return 0; }
    sys_write(fd, text, strlen(text));
    sys_close(fd);
    return 1;
}

# 1 when `nft -c` accepts text.
fn _nn_nft_ok(text: cstring): i64 {
    _nn_write(text);
    if (exec_vec(_nn_argv(">/dev/null 2>&1")) == 0) { return 1; }
    return 0;
}

# nft's error output for text, as a cstring in _nn_out.
fn _nn_nft_errors(text: cstring): cstring {
    _nn_write(text);
    var st[16];
    var n = exec_capture_status(_nn_argv("2>&1"), _nn_out, _NN_OUT_MAX - 1, &st);
    if (n < 0) { n = 0; }
    store8(_nn_out + n, 0);
    return _nn_out;
}

fn _nn_available(): i64 {
    if (sys_access(_nn_unshare, 1) != 0) { return 0; }
    if (sys_access(_nn_nft, 1) != 0) {
        _nn_nft = "/usr/bin/nft";
        if (sys_access(_nn_nft, 1) != 0) { return 0; }
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "/tmp/nein-nft-grammar-");
    str_builder_add_int(sb, sys_getpid());
    _nn_dir = str_cstr(str_builder_build(sb));
    if (sys_mkdir(_nn_dir, 448) != 0) { return 0; }   # 0700
    _nn_path = _nn_cat(_nn_dir, "/t.nft", "");
    _nn_out = alloc(_NN_OUT_MAX);
    if (_nn_nft_ok("table inet nein_grammar {\n}\n") == 0) { return 0; }
    return 1;
}

fn _nn_say(tag: cstring, what: cstring, word: cstring): i64 {
    print(tag, strlen(tag));
    print(what, strlen(what));
    print(": ", 2);
    println(word);
    return 0;
}

# Compare nein's verdict on `word` (nein_ok: 1 takes, 0 refuses) with nft's on
# `text`, which declares or references `word` at the position under test.
fn _nn_judge(what: cstring, word: cstring, nein_ok: i64, text: cstring): i64 {
    var nft_ok = _nn_nft_ok(text);
    if (nein_ok == nft_ok) { _nn_agree = _nn_agree + 1; return 1; }
    if (nein_ok == 1) {
        _nn_say("  FAIL: nein takes, nft refuses — ", what, word);
        _nn_fail = _nn_fail + 1;
        return 0;
    }
    _nn_say("  NOTE: nein refuses, this nft takes — ", what, word);
    _nn_note = _nn_note + 1;
    return 0;
}

fn _nn_ok(t: i64, v: i64): i64 {
    if (is_err_result(t) == 1) { return 0; }
    return 1;
}

fn _nn_name_ok(w: cstring): i64 {
    var t, v = validate_nft_name(w);
    return _nn_ok(t, v);
}

fn _nn_chain_text(w: cstring): cstring {
    return _nn_cat("table inet nein_grammar {\n\tchain ", w, " {\n\t}\n}\n");
}

fn _nn_ct_text(w: cstring): cstring {
    return _nn_cat("table inet nein_grammar {\n\tct timeout ", w,
      " {\n\t\tprotocol tcp;\n\t\tl3proto ip;\n\t\tpolicy = { established: 100 };\n\t}\n}\n");
}

fn _nn_setref_text(w: cstring): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "table inet nein_grammar {\n\tset ");
    str_builder_add_cstr(sb, w);
    str_builder_add_cstr(sb, " {\n\t\ttype ipv4_addr\n\t}\n\tchain c {\n\t\tip saddr @");
    str_builder_add_cstr(sb, w);
    str_builder_add_cstr(sb, " accept\n\t}\n}\n");
    return str_cstr(str_builder_build(sb));
}

fn _nn_offload_text(w: cstring): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "table inet nein_grammar {\n\tflowtable ");
    str_builder_add_cstr(sb, w);
    str_builder_add_cstr(sb, " {\n\t\thook ingress priority 0\n\t\tdevices = { lo }\n\t}\n");
    str_builder_add_cstr(sb, "\tchain c {\n\t\ttype filter hook forward priority 0;\n");
    str_builder_add_cstr(sb, "\t\tmeta l4proto tcp flow offload @");
    str_builder_add_cstr(sb, w);
    str_builder_add_cstr(sb, "\n\t}\n}\n");
    return str_cstr(str_builder_build(sb));
}

# Push each space-separated word of list (0: none) onto out.
fn _nn_split(list: cstring, out: i64): i64 {
    if (list == 0) { return 0; }
    var i = 0;
    while (load8(list + i) != 0) {
        var j = i;
        while (load8(list + j) != 0 && load8(list + j) != 32) { j = j + 1; }
        var w = alloc(j - i + 1);
        memcpy(w, list + i, j - i);
        store8(w + j - i, 0);
        vec_push(out, w);
        i = j;
        if (load8(list + i) == 32) { i = i + 1; }
    }
    return 0;
}

# The tokens of every "expected any of: a, b, ..." list in nft's errors for
# text that are plain words (no `<string>`, no quoted punctuation).
fn _nn_harvest(text: cstring, out: i64): i64 {
    var e = _nn_nft_errors(text);
    var key = "expected any of: ";
    var klen = strlen(key);
    var i = 0;
    while (load8(e + i) != 0) {
        if (memeq(e + i, key, klen) == 1) {
            i = i + klen;
            while (load8(e + i) != 0 && load8(e + i) != 10) {
                var j = i;
                while (load8(e + j) != 0 && load8(e + j) != 10 && load8(e + j) != 44) { j = j + 1; }
                var a = i;
                while (a < j && load8(e + a) == 32) { a = a + 1; }
                var n = j - a;
                if (n > 0 && n <= 64) {
                    var w = alloc(n + 1);
                    memcpy(w, e + a, n);
                    store8(w + n, 0);
                    var vt, vv = validate_identifier(w);
                    if (is_err_result(vt) == 0) { vec_push(out, w); }
                }
                i = j;
                if (load8(e + i) == 44) { i = i + 1; }
            }
        } else {
            i = i + 1;
        }
    }
    return 0;
}

fn _nn_render_loads(what: cstring, fw: i64): i64 {
    var rt, rv = firewall_render_checked(fw);
    if (is_err_result(rt) == 1) {
        _nn_say("  FAIL: did not validate — ", what, "");
        _nn_fail = _nn_fail + 1;
        return 0;
    }
    if (_nn_nft_ok(str_cstr(rv)) == 0) {
        _nn_say("  FAIL: nft refused the build — ", what, "");
        _nn_fail = _nn_fail + 1;
        return 0;
    }
    _nn_agree = _nn_agree + 1;
    return 1;
}

fn _nn_fill(n: i64, c: i64): cstring {
    var p = alloc(n + 1);
    memset(p, c, n);
    store8(p + n, 0);
    return p;
}

fn test_keywords(): i64 {
    var words = vec_new();
    var n = 2;
    while (n <= 11) {
        _nn_split(_nft_kw_list(n, 0), words);
        _nn_split(_nft_kw_list(n, 1), words);
        _nn_split(_nft_kw_list(n, 2), words);
        n = n + 1;
    }
    var k = 0;
    while (k < vec_len(words)) {
        var w = vec_get(words, k);
        _nn_judge("keyword as a chain name", w, _nn_name_ok(w), _nn_chain_text(w));
        k = k + 1;
    }
    # The ct-scope words: refused as a ct timeout's name, names elsewhere.
    var ct = vec_new();
    n = 2;
    while (n <= 11) { _nn_split(_nft_ct_kw_list(n), ct); n = n + 1; }
    k = 0;
    while (k < vec_len(ct)) {
        var cw = vec_get(ct, k);
        var ct_ok = 1;
        if (_nn_name_ok(cw) == 0 || _nft_ct_keyword(cw) == 1) { ct_ok = 0; }
        _nn_judge("ct-scope word as a ct timeout name", cw, ct_ok, _nn_ct_text(cw));
        _nn_judge("ct-scope word as a chain name", cw, _nn_name_ok(cw), _nn_chain_text(cw));
        k = k + 1;
    }
    return 0;
}

fn test_harvested(): i64 {
    # Statement, table-body, command, and ct / meta / tcp scopes: every word
    # nft says it expects there. One that nein takes must be a name to nft.
    var toks = vec_new();
    _nn_harvest("table inet t {\n\tchain x {\n\t\t@@@\n\t}\n}\n", toks);
    _nn_harvest("table inet t {\n\t@@@\n}\n", toks);
    _nn_harvest("@@@\n", toks);
    _nn_harvest("table inet t {\n\tchain x {\n\t\tct @@@\n\t}\n}\n", toks);
    _nn_harvest("table inet t {\n\tchain x {\n\t\tmeta @@@\n\t}\n}\n", toks);
    _nn_harvest("table inet t {\n\tchain x {\n\t\ttcp @@@\n\t}\n}\n", toks);
    _nn_harvest("table inet t {\n\tchain x {\n\t\tip @@@\n\t}\n}\n", toks);
    if (vec_len(toks) < 100) {
        _nn_say("  FAIL: ", "too few tokens harvested from nft's errors", "");
        _nn_fail = _nn_fail + 1;
        return 0;
    }
    var k = 0;
    while (k < vec_len(toks)) {
        var w = vec_get(toks, k);
        if (_nn_name_ok(w) == 1) {
            _nn_judge("a word nft expects, as a chain name", w, 1, _nn_chain_text(w));
        }
        k = k + 1;
    }
    return 0;
}

fn test_shapes(): i64 {
    var takes = vec_new();
    vec_push(takes, "FWD"); vec_push(takes, "fwd2"); vec_push(takes, "xfwd"); vec_push(takes, "_3f2a");
    vec_push(takes, "a-b"); vec_push(takes, "ih"); vec_push(takes, "nat"); vec_push(takes, "filter");
    vec_push(takes, "log_in"); vec_push(takes, "fwd_filter"); vec_push(takes, "iso_3f"); vec_push(takes, "k");
    vec_push(takes, _nn_fill(64, 97));
    vec_push(takes, "3f2a"); vec_push(takes, "1abc"); vec_push(takes, "-x"); vec_push(takes, "0");
    var k = 0;
    while (k < vec_len(takes)) {
        var w = vec_get(takes, k);
        _nn_judge("shape as a chain name", w, _nn_name_ok(w), _nn_chain_text(w));
        k = k + 1;
    }
    # References after '@'.
    _nn_judge("set reference", "ll", 0, _nn_setref_text("ll"));
    _nn_judge("set reference", "nh", 0, _nn_setref_text("nh"));
    _nn_judge("set reference", "last", 1, _nn_setref_text("last"));
    _nn_judge("flow offload reference", "last", 0, _nn_offload_text("last"));
    _nn_judge("flow offload reference", "ft", 1, _nn_offload_text("ft"));
    return 0;
}

# A deterministic stream of IPv6 spellings: 0-8 groups (0-6 before a dotted
# quad), compressed where short and sometimes where not, hex in mixed widths,
# sometimes a prefix — the shapes of the 1.9.1 differential run.
var _ng_s = 88172645463325252;
fn _ng_rnd(n: i64): i64 {
    _ng_s = _ng_s * 6364136223846793005 + 1442695040888963407;
    return ((_ng_s >> 33) & 2147483647) % n;
}

fn _ng_group(sb: i64): i64 {
    var v = _ng_rnd(65536);
    if (_ng_rnd(4) == 0) { v = _ng_rnd(16); }
    var digits = "0123456789abcdef";
    var width = 1;
    if (v > 15) { width = 2; }
    if (v > 255) { width = 3; }
    if (v > 4095) { width = 4; }
    if (_ng_rnd(3) == 0) { width = 4; }   # zero-padded
    var k = width - 1;
    while (k >= 0) {
        str_builder_add_byte(sb, load8(digits + ((v >> (k * 4)) & 15)));
        k = k - 1;
    }
    return 0;
}

fn _ng_addr(): cstring {
    var v4 = 0;
    if (_ng_rnd(5) < 2) { v4 = 1; }
    var total = 8;
    if (v4 == 1) { total = 6; }
    var n = _ng_rnd(total + 1);
    var k = n + 1;   # no "::"
    if (n < total || _ng_rnd(7) == 0) { k = _ng_rnd(n + 1); }
    var sb = str_builder_new();
    var i = 0;
    var last = 0;    # 1 when the text so far ends with ':'
    while (i <= n) {
        if (i == k) {
            str_builder_add_cstr(sb, "::");
            last = 1;
        }
        if (i < n) {
            if (i > 0 && i != k) { str_builder_add_cstr(sb, ":"); }
            _ng_group(sb);
            last = 0;
        }
        i = i + 1;
    }
    if (v4 == 1) {
        if (last == 0 && n > 0) { str_builder_add_cstr(sb, ":"); }
        var q = 0;
        while (q < 4) {
            if (q > 0) { str_builder_add_cstr(sb, "."); }
            str_builder_add_int(sb, _ng_rnd(256));
            q = q + 1;
        }
    }
    if (_ng_rnd(5) == 0) {
        str_builder_add_cstr(sb, "/");
        var prefixes = vec_new();
        vec_push(prefixes, 0); vec_push(prefixes, 1); vec_push(prefixes, 32);
        vec_push(prefixes, 64); vec_push(prefixes, 127); vec_push(prefixes, 128);
        str_builder_add_int(sb, vec_get(prefixes, _ng_rnd(6)));
    }
    return str_cstr(str_builder_build(sb));
}

fn _ng_addr_text(field: cstring, a: cstring): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "table inet nein_grammar {\n\tchain c {\n\t\t");
    str_builder_add_cstr(sb, field);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, " accept\n\t}\n}\n");
    return str_cstr(str_builder_build(sb));
}

fn _ng_addr_ok(a: cstring): i64 {
    var t, v = validate_addr(a);
    return _nn_ok(t, v);
}

fn test_addresses(): i64 {
    # The forms the differential run found, and their neighbours.
    _nn_judge("IPv6 address", "1:2:3:4:5:6:1.2.3.4", _ng_addr_ok("1:2:3:4:5:6:1.2.3.4"),
      _ng_addr_text("ip6 saddr", "1:2:3:4:5:6:1.2.3.4"));
    _nn_judge("IPv6 address", "::ffff:10.0.0.1", _ng_addr_ok("::ffff:10.0.0.1"),
      _ng_addr_text("ip6 saddr", "::ffff:10.0.0.1"));
    _nn_judge("IPv6 address", "1:2:3:4:5::1.2.3.4", _ng_addr_ok("1:2:3:4:5::1.2.3.4"),
      _ng_addr_text("ip6 saddr", "1:2:3:4:5::1.2.3.4"));
    var i = 0;
    while (i < 400) {
        var a = _ng_addr();
        _nn_judge("IPv6 address", a, _ng_addr_ok(a), _ng_addr_text("ip6 saddr", a));
        i = i + 1;
    }
    return 0;
}

# Every name of 1 to 3 characters from [a-z0-9_-] that validate_nft_name
# takes, as chains: 4,000 to a batch, a refused batch bisected to the words nft
# refuses. Exhaustive where a word list is not: `eq` and `xor` (nft prints
# them in its errors as `==` and `^`) escaped both the word sources and the
# error harvest until an independent review found them.
fn _nn_chains_text(words: i64, lo: i64, hi: i64): cstring {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "table inet nein_grammar {\n");
    var i = lo;
    while (i < hi) {
        str_builder_add_cstr(sb, "\tchain ");
        str_builder_add_cstr(sb, vec_get(words, i));
        str_builder_add_cstr(sb, " {\n\t}\n");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "}\n");
    return str_cstr(str_builder_build(sb));
}

fn _nn_bisect(words: i64, lo: i64, hi: i64): i64 {
    if (hi <= lo) { return 0; }
    if (_nn_nft_ok(_nn_chains_text(words, lo, hi)) == 1) {
        _nn_agree = _nn_agree + 1;
        return 0;
    }
    if (hi - lo == 1) {
        _nn_say("  FAIL: nein takes, nft refuses — ", "short name, exhaustive", vec_get(words, lo));
        _nn_fail = _nn_fail + 1;
        return 0;
    }
    var mid = lo + (hi - lo) / 2;
    _nn_bisect(words, lo, mid);
    _nn_bisect(words, mid, hi);
    return 0;
}

fn test_short_names(): i64 {
    var alpha = "abcdefghijklmnopqrstuvwxyz0123456789_-";
    var na = strlen(alpha);
    var words = vec_new();
    var len = 1;
    while (len <= 3) {
        var total = 1;
        var k = 0;
        while (k < len) { total = total * na; k = k + 1; }
        var idx = 0;
        while (idx < total) {
            var w = alloc(len + 1);
            var v = idx;
            var p = len - 1;
            while (p >= 0) {
                store8(w + p, load8(alpha + (v % na)));
                v = v / na;
                p = p - 1;
            }
            store8(w + len, 0);
            if (_nn_name_ok(w) == 1) { vec_push(words, w); }
            idx = idx + 1;
        }
        len = len + 1;
    }
    var lo = 0;
    while (lo < vec_len(words)) {
        var hi = lo + 4000;
        if (hi > vec_len(words)) { hi = vec_len(words); }
        _nn_bisect(words, lo, hi);
        lo = hi;
    }
    return 0;
}

# `nft list table inet <w>` on a table that exists: a script in the scratch
# directory creates it and lists it, inside the namespace.
fn _nn_list_ok(w: cstring): i64 {
    var script = _nn_cat(_nn_dir, "/list.sh", "");
    var fd = sys_open(script, 577, 448);   # O_WRONLY|O_CREAT|O_TRUNC, 0700
    if (fd < 0) { return 0; }
    var body = "\"$1\" add table inet \"$2\" && exec \"$1\" -a list table inet \"$2\"\n";
    sys_write(fd, body, strlen(body));
    sys_close(fd);
    var args = vec_new();
    vec_push(args, "/bin/sh");
    vec_push(args, "-c");
    vec_push(args, "exec \"$0\" -rn /bin/sh \"$1\" \"$2\" \"$3\" >/dev/null 2>&1");
    vec_push(args, _nn_unshare);
    vec_push(args, script);
    vec_push(args, _nn_nft);
    vec_push(args, w);
    var rc = exec_vec(args);
    sys_unlink(script);
    if (rc == 0) { return 1; }
    return 0;
}

fn _nn_listed_ok(w: cstring): i64 {
    var t, v = list_table_with_handles("inet", w);
    if (is_err_result(t) == 1 && nein_err_code(t, v) == NEIN_ERR_INVALID_RULE) { return 0; }
    return 1;
}

# 1 when cstring w is in vec v.
fn _nn_has(v: i64, w: cstring): i64 {
    var i = 0;
    while (i < vec_len(v)) {
        if (streq(vec_get(v, i), w) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn test_list_scope(): i64 {
    # Candidates nft supplies, independent of nein's list: every word it
    # expects after `list`, `reset`, `list ct`, `monitor`, `flush` and
    # `delete`, and each one's plural — then nein's own list and controls.
    var raw = vec_new();
    _nn_harvest("list @@@\n", raw);
    _nn_harvest("reset @@@\n", raw);
    _nn_harvest("list ct @@@\n", raw);
    _nn_harvest("monitor @@@\n", raw);
    _nn_harvest("flush @@@\n", raw);
    _nn_harvest("delete @@@\n", raw);
    var words = vec_new();
    var r = 0;
    while (r < vec_len(raw)) {
        var hw = vec_get(raw, r);
        if (_nn_has(words, hw) == 0) { vec_push(words, hw); }
        var pl = _nn_cat(hw, "s", "");
        if (_nn_has(words, pl) == 0) { vec_push(words, pl); }
        r = r + 1;
    }
    if (vec_len(words) < 40) {
        _nn_say("  FAIL: ", "too few list-scope words harvested from nft's errors", "");
        _nn_fail = _nn_fail + 1;
    }
    var n = 2;
    while (n <= 11) {
        var row = vec_new();
        _nn_split(_nft_list_kw_list(n), row);
        var q = 0;
        while (q < vec_len(row)) {
            if (_nn_has(words, vec_get(row, q)) == 0) { vec_push(words, vec_get(row, q)); }
            q = q + 1;
        }
        n = n + 1;
    }
    vec_push(words, "filter");
    vec_push(words, "nat");
    vec_push(words, "agnos_policy");
    vec_push(words, "counte");
    vec_push(words, "tablez");
    var k = 0;
    while (k < vec_len(words)) {
        var w = vec_get(words, k);
        k = k + 1;
        if (_nn_name_ok(w) == 0) { continue; }   # refused as a name already
        var nft_ok = _nn_list_ok(w);
        var nein_ok = 1;
        if (_nft_list_keyword(w) == 1) { nein_ok = 0; }
        if (nein_ok == nft_ok) {
            _nn_agree = _nn_agree + 1;
        } elif (nein_ok == 1) {
            _nn_say("  FAIL: nein takes, nft refuses — ", "list table name", w);
            _nn_fail = _nn_fail + 1;
        } else {
            _nn_say("  NOTE: nein refuses, this nft takes — ", "list table name", w);
            _nn_note = _nn_note + 1;
        }
    }
    return 0;
}

fn test_builder_limits(): i64 {
    # Engine: a 60-byte id (`<id>_out` 64), a 58-byte id with hosts (`<id>_hosts` 64).
    var pe = policy_engine_new();
    var a = agent_policy_new(_nn_fill(60, 97), "10.0.0.5");
    ap_allow_inbound(a, ps_tcp(8080));
    pe_add_agent(pe, a);
    var b = agent_policy_new(_nn_fill(58, 98), "10.0.0.6");
    ap_allow_outbound(b, ps_tcp(443));
    ap_allow_outbound_host(b, "10.0.0.9");
    pe_add_agent(pe, b);
    var pt, pv = pe_validate(pe);
    if (is_err_result(pt) == 1) {
        _nn_say("  FAIL: ", "engine at the limit did not validate", "");
        _nn_fail = _nn_fail + 1;
    }
    _nn_render_loads("engine, 60- and 58-byte agent ids", pe_to_firewall(pe));

    # Bridge: a 57-byte prefix (`<prefix>_filter` 64), a 60-byte group (`iso_<group>` 64).
    var cfg = bridge_config_new("br0", "172.17.0.0/16", "eth0");
    bridge_set_table_prefix(cfg, _nn_fill(57, 99));
    var bf = bridge_firewall_new(cfg);
    var g = vec_new();
    vec_push(g, "172.17.1.0/24");
    bf_add_isolation_group(bf, isolation_group_new(_nn_fill(60, 100), g));
    var bt, bv = bf_validate(bf);
    if (is_err_result(bt) == 1) {
        _nn_say("  FAIL: ", "bridge at the limit did not validate", "");
        _nn_fail = _nn_fail + 1;
    }
    _nn_render_loads("bridge, 57-byte prefix and 60-byte group", bf_to_firewall(bf));

    # GeoIP: a 61-byte name with IPv6 (`<name>_v6` 64).
    var bl = geoip_new();
    geoip_set_table_name(bl, _nn_fill(61, 101));
    var v4 = vec_new();
    vec_push(v4, "198.51.100.0/24");
    var v6 = vec_new();
    vec_push(v6, "2001:db8::/32");
    geoip_block_country(bl, country_block_dual("XX", v4, v6));
    var gt, gv = geoip_validate(bl);
    if (is_err_result(gt) == 1) {
        _nn_say("  FAIL: ", "geoip at the limit did not validate", "");
        _nn_fail = _nn_fail + 1;
    }
    _nn_render_loads("geoip, 61-byte name with IPv6", geoip_to_firewall(bl));

    # Policy: a 62-byte name with a 45-byte peer (a 128-byte comment).
    var np = nein_network_policy_new(_nn_fill(62, 102), "any", PACT_ALLOW);
    var pr = policy_rule_new("ffff:ffff:ffff:ffff:ffff::255.255.255.255/128");
    policy_rule_add_port(pr, PROTO_TCP, 443);
    policy_add_ingress(np, pr);
    var lt, lv = policy_validate(np);
    if (is_err_result(lt) == 1) {
        _nn_say("  FAIL: ", "policy at the limit did not validate", "");
        _nn_fail = _nn_fail + 1;
    }
    var fw = firewall_new();
    var t = table_new("pol", FAMILY_INET);
    var c = chain_base("input", CHAIN_FILTER, HOOK_INPUT, 0, POLICY_ACCEPT);
    var rules = policy_to_rules(np);
    var i = 0;
    while (i < vec_len(rules)) { chain_add_rule(c, vec_get(rules, i)); i = i + 1; }
    table_add_chain(t, c);
    firewall_add_table(fw, t);
    _nn_render_loads("policy, 128-byte comment", fw);

    # Interface names nft would read as a keyword or a number, as flowtable
    # devices and ifname set and map values: quoted, they load.
    var ifw = firewall_new();
    var it = table_new("ifq", FAMILY_INET);
    var devs = vec_new();
    vec_push(devs, "vxlan");
    vec_push(devs, "3eth");
    vec_push(devs, "ip");
    table_add_flowtable(it, flowtable_new("ft", 0, devs));
    var is = nft_set_new("ifs", SET_IFNAME);
    nft_set_add_element(is, "bridge");
    nft_set_add_element(is, "gre");
    table_add_set(it, is);
    var im = nft_map_new("ifm", SET_IFNAME);
    nft_map_add_entry(im, "eq", MAPV_ACCEPT, 0);
    table_add_map(it, im);
    firewall_add_table(ifw, it);
    _nn_render_loads("interface names as values", ifw);
    return 0;
}

fn main() {
    alloc_init();
    sakshi_set_level(0 - 1);
    if (_nn_available() == 0) {
        println("integration nft_grammar: SKIP — nft or unprivileged user namespaces unavailable here");
        return 0;
    }
    test_keywords();
    test_harvested();
    test_shapes();
    test_short_names();
    test_list_scope();
    test_addresses();
    test_builder_limits();
    sys_unlink(_nn_path);
    sys_rmdir(_nn_dir);
    print("integration nft_grammar: ", 25);
    fmt_int(_nn_agree);
    print(" agree, ", 8);
    fmt_int(_nn_fail);
    print(" failed, ", 9);
    fmt_int(_nn_note);
    println(" notes");
    if (_nn_fail != 0) { return 1; }
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
