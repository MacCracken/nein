# Fuzz: validate.cyr — 9 public validators
#
# Iterates a corpus of adversarial + edge-case inputs through every
# validator. The contract: validators must NEVER crash on any input,
# only return Ok or Err. Outcomes are asserted for two relations only
# (1.9.1): validate_nft_name takes a subset of what validate_identifier
# takes, never with a leading digit or '-'; and validate_addr never takes
# a dotted quad without "::" (nft cannot parse x:x:x:x:x:x:d.d.d.d).

include "src/lib/error.cyr"
include "src/lib/validate.cyr"
include "src/lib/rule.cyr"
include "src/lib/set.cyr"
include "src/lib/nat.cyr"
include "src/lib/chain.cyr"
include "src/lib/table.cyr"
include "src/lib/firewall.cyr"
include "src/lib/builder.cyr"
include "src/lib/policy.cyr"
include "src/lib/geoip.cyr"
include "src/lib/mesh.cyr"
include "src/lib/bridge.cyr"
include "src/lib/engine.cyr"
include "src/lib/config.cyr"
include "src/lib/netns.cyr"

alloc_init();

fn _fail(why) {
    println("fuzz/validate: FAIL");
    println(why);
    syscall(SYS_EXIT, 1);
    return 0;
}

# 1 when s holds a '.' and a ':' but no "::" (s is not NULL).
fn _dotted_uncompressed(s): i64 {
    var n = strlen(s);
    var dot = 0;
    var colon = 0;
    var i = 0;
    while (i < n) {
        var c = load8(s + i);
        if (c == 46) { dot = 1; }
        if (c == 58) {
            colon = 1;
            if (i + 1 < n && load8(s + i + 1) == 58) { return 0; }
        }
        i = i + 1;
    }
    if (dot == 1 && colon == 1) { return 1; }
    return 0;
}

# Each entry hits all 9 validators. No input should crash; only Ok / Err.
fn _hit_all(s) {
    validate_identifier(s);
    var nt, nv = validate_nft_name(s);
    if (is_err_result(nt) == 0) {
        var it, iv = validate_identifier(s);
        if (is_err_result(it) == 1) { _fail("validate_nft_name took what validate_identifier refuses"); }
        var c0 = load8(s);
        if (c0 == 45 || (c0 >= 48 && c0 <= 57)) { _fail("validate_nft_name took a leading digit or '-'"); }
    }
    var at, av = validate_addr(s);
    if (is_err_result(at) == 0) {   # an address taken is not NULL
        if (_dotted_uncompressed(s) == 1) { _fail("validate_addr took a dotted quad without ::"); }
    }
    validate_iface(s);
    validate_ct_state(s);
    validate_comment(s);
    validate_log_prefix(s);
    validate_nft_element(s);
    validate_family(s);
    return 0;
}

# --- Corpus: known-good ---
_hit_all("eth0");
_hit_all("10.0.0.1");
_hit_all("2001:db8::1");
_hit_all("inet");
_hit_all("established");
_hit_all("table-1_foo");
_hit_all("a");

# --- Corpus: nft names and address spellings (1.9.1) ---
_hit_all("fwd");
_hit_all("FWD");
_hit_all("3f2a");
_hit_all("-x");
_hit_all("_x");
_hit_all("gc-interval");
_hit_all("1:2:3:4:5:6:1.2.3.4");
_hit_all("0:0:0:0:0:ffff:10.0.0.1/128");
_hit_all("::ffff:10.0.0.1");
_hit_all("1:2:3:4:5::1.2.3.4");

# --- Corpus: empty / short ---
_hit_all("");
_hit_all("a");
_hit_all("0");
_hit_all(".");
_hit_all(":");

# --- Corpus: injection / dangerous chars ---
_hit_all("evil;drop");
_hit_all("a{b}c");
_hit_all("a|b");
_hit_all("a\nb");
_hit_all("a`b");
_hit_all("a$b");
_hit_all("a\"b");
_hit_all("\\");
_hit_all(";;;;");
_hit_all("{");
_hit_all("|;`$");

# --- Corpus: length boundaries ---
# 64-char identifier (max valid)
_hit_all("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
# 65-char (just over)
_hit_all("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");
# 15-char iface (max valid)
_hit_all("aaaaaaaaaaaaaaa");
# 16-char iface (over)
_hit_all("aaaaaaaaaaaaaaaa");
# 128/129-char comment boundary — built via memset into a fixed buffer
# to avoid 120-char literal lines that fail the lint gate.
var c128[130];
var ci = 0;
while (ci < 128) { store8(&c128 + ci, 97); ci = ci + 1; }
store8(&c128 + 128, 0);
_hit_all(&c128);                     # 128-char (max valid for validate_comment)
store8(&c128 + 128, 97);
store8(&c128 + 129, 0);
_hit_all(&c128);                     # 129-char (one over)

# --- Corpus: mixed valid + dangerous ---
_hit_all("10.0.0.1;DROP");
_hit_all("eth0\nDROP");
_hit_all("good_table_name_with_;injection");

# --- Corpus: high-bit bytes (non-ASCII) ---
_hit_all("\xff\xfe\xfd");
_hit_all("\xc3\xa9\xc3\xa8");   # é è in UTF-8

# --- 256-byte fill test (loop-driven boundary) ---
var big[256];
var i = 0;
while (i < 255) {
    store8(&big + i, 97);   # 'a'
    i = i + 1;
}
store8(&big + 255, 0);
_hit_all(&big);

# Also fill with potentially-dangerous bytes
i = 0;
while (i < 255) {
    store8(&big + i, 33 + (i % 90));   # ASCII printable range
    i = i + 1;
}
store8(&big + 255, 0);
_hit_all(&big);

# Fill with NUL-adjacent embedded zeros — validators must not over-read
i = 0;
while (i < 255) {
    if (i == 100) { store8(&big + i, 0); }
    else { store8(&big + i, 97); }
    i = i + 1;
}
store8(&big + 255, 0);
_hit_all(&big);

println("fuzz/validate: ok");
syscall(SYS_EXIT, 0);
