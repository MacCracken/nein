# nein apply module — execute nftables rules via the nft command
#
# Uses fork+execve to spawn `nft -f -` with the ruleset staged in a memfd on
# its stdin (1.8.2; through 1.8.1 a pipe). Synchronous, with a deadline.
# nft's stderr goes to a second memfd and is logged on failure.

# ================================================================
# nft binary path — pinned, configurable, no PATH consultation
# ================================================================
#
# v1.4.0 hardening (threat-model T-3): the nft subprocess is always
# launched via an *absolute* path. No PATH lookup. The default is
# /usr/sbin/nft; callers running on systems with nft elsewhere
# (Alpine, Void, embedded distros) override via `nein_set_nft_path`.
#
# Pre-v1.4.0 behavior tried /usr/sbin/nft → /sbin/nft → /usr/bin/nft
# in order, which was a soft form of PATH consultation (an attacker
# who controlled /usr/sbin/ could plant a malicious binary before the
# real one). v1.4.0 forces a single explicit path so the operator
# either trusts /usr/sbin/nft exactly, or sets the path explicitly.

# Stored as a global-data cstring slot. alloc_init() sets the default;
# callers can override at runtime via nein_set_nft_path.
var _nein_nft_path = "/usr/sbin/nft";

# --- portable child reap (1.6.12) ---------------------------------------
# agnos and Linux disagree on BOTH the arity and the meaning of waitpid, so
# every reap in this file goes through here rather than calling sys_waitpid
# directly. Linux: `waitpid(pid, &status, 0)` BLOCKS and writes a status word.
# agnos `waitpid(pid)` (#4) takes ONE argument, is NON-BLOCKING by design, and
# answers the exit code / -2 (WOULD_BLOCK) / -1 (no such child) with no status
# word at all — the kernel notes "-2 vs -1 IS THE WHOLE CONTRACT", because
# collapsing them makes "still running" indistinguishable from "no children".
#
# Found by daimon at its 2.1.8 adoption: a raw 3-arg `sys_waitpid` is a hard
# COMPILE error on `--agnos`, so dist/nein-mcp.cyr could not be built for that
# target by any consumer.
#
# Contract here, identical on both: returns > 0 on a successful reap, < 0 on
# failure, and writes a Linux-shaped status word so the existing WEXITSTATUS
# decoding below is unchanged. The agnos arm synthesises that word as
# `exit_code << 8`, which is exactly what Linux reports for a normal exit.
var _NEIN_REAP_TRIES = 2000;      # ~2s at 1ms — nft apply is fast or wedged

fn _nein_waitpid(pid: i64, status_ptr: i64): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    var ts: i64[2];
    store64(&ts, 0);
    store64(&ts + 8, 1000000);              # 1 ms
    var i = 0;
    while (i < _NEIN_REAP_TRIES) {
        var r = sys_waitpid(pid);
        if (r >= 0) { store64(status_ptr, r << 8); return 1; }
        if (r != 0 - 2) { return r; }       # -1 no such child, or other error
        sys_nanosleep(&ts, 0);
        i = i + 1;
    }
    return 0 - 1;                           # outlived the budget: fail closed
    #else
    var wr = sys_waitpid(pid, status_ptr, 0);
    while (wr == 0 - 4) { wr = sys_waitpid(pid, status_ptr, 0); }   # -EINTR
    return wr;
    #endif
}

fn nein_nft_path(): cstring { return _nein_nft_path; }

# Override the absolute path to nft. Must start with '/'. Returns
# Ok(0) on accept, Err(NEIN_ERR_INVALID_RULE) on reject.
#
# The path is COPIED (1.8.2, audit S-10). Through 1.8.1 nein kept the caller's
# pointer, so a path built in a stack buffer or a reused heap buffer later had
# execve run whatever bytes were there by then.
var _nein_nft_path_buf[264];
fn nein_set_nft_path(path: cstring): i64 {
    if (path == 0) { return nein_err(NEIN_ERR_INVALID_RULE); }
    if (load8(path) != 47) { return nein_err(NEIN_ERR_INVALID_RULE); }   # '/'
    var n = strlen(path);
    if (n > 256) { return nein_err(NEIN_ERR_INVALID_RULE); }
    memcpy(&_nein_nft_path_buf, path, n);
    store8(&_nein_nft_path_buf + n, 0);
    _nein_nft_path = &_nein_nft_path_buf;
    return nein_ok();
}

# ================================================================
# SIGPIPE guard (1.6.10, audit H-7)
# ================================================================
#
# Writing the ruleset to nft's stdin raises SIGPIPE if the child is already
# gone — a failed execve, a parse error that made nft exit early, an OOM kill.
# SIGPIPE's default disposition TERMINATES THE WHOLE CALLING PROCESS, so a
# missing or unexecutable /usr/sbin/nft killed the host instead of returning
# an error. Reproduced as exit 141; it also falsified threat-model T-4's claim
# that the parent observes the child's exit status on execve failure.
#
# With SIGPIPE ignored the write returns -EPIPE instead, which the loop
# treated as a hard error. Since 1.8.2 nein writes to no pipe at all (the
# ruleset is staged in a memfd), so the guard is no longer load-bearing for
# nein; it is kept so a host relying on its process-wide effect sees no change,
# and the nft child has SIGPIPE reset to SIG_DFL before exec.
#
# This is process-wide state, so it is worth being explicit about: setting it
# changes SIGPIPE disposition for the ENTIRE host process, not just for nein's
# subprocess window. That is what essentially every process that writes to a
# pipe wants — and nein's consumers (stiva / daimon / aegis / sutra) are
# daemons that already do it — but a host that manages SIGPIPE itself can turn
# it off with `nein_set_sigpipe_guard(0)` before the first apply. Applied once
# and latched; nein never restores the previous disposition, because doing so
# would reopen the same window on the next call.
var _nein_sigpipe_guard = 1;
var _nein_sigpipe_applied = 0;

# Enable (1, default) or disable (0) the SIGPIPE guard. Returns Ok(0).
fn nein_set_sigpipe_guard(enabled: i64): i64 {
    if (enabled == 0) { _nein_sigpipe_guard = 0; } else { _nein_sigpipe_guard = 1; }
    return nein_ok();
}

fn nein_sigpipe_guard(): i64 { return _nein_sigpipe_guard; }

fn _nein_apply_sigpipe_guard() {
    if (_nein_sigpipe_guard == 0) { return 0; }
    if (_nein_sigpipe_applied == 1) { return 0; }
    signal_ignore(13);
    _nein_sigpipe_applied = 1;
    return 0;
}

# ================================================================
# Low-level: run nft with its stdio on memfds (1.8.2)
# ================================================================
#
# Through 1.8.1 the ruleset went to nft over a pipe written AFTER the fork,
# and stderr came back over a second pipe. The 2026-11-03 P(-1) audit found
# four defects in that shape (docs/audit/2026-11-03-audit.md, S-1 to S-4):
#   - the child built argv with alloc() between fork and execve, so in a
#     threaded host it could inherit the allocator's lock held and spin
#     forever, with the parent blocked behind it;
#   - the pipes were not close-on-exec, so any process the host forked during
#     an apply held nft's stdin open and nft saw no EOF until it exited;
#   - a host killed mid-write left nft an EOF on a prefix, which nft commits
#     atomically: for a diff's chain rebuild, the deletes without the adds;
#   - writing everything before draining stderr could deadlock (unreachable
#     with real nft 1.1.7, reachable through nein_set_nft_path).
# Now the whole ruleset is in a memfd BEFORE the fork, stdout and stderr go to
# /dev/null and a memfd, every descriptor nein opens is close-on-exec, the
# child allocates nothing, and the parent waits on a pidfd with a deadline.
# No pipe remains, so none of the four can happen.

var _NEIN_NFT_DEADLINE_MS = 60000;   # a wedged nft is SIGKILLed after this
var _NEIN_ETIMEDOUT = 0 - 110;

#ifndef CYRIUS_TARGET_AGNOS
# Child side, between fork and execve. Allocates nothing (S-1). Puts in_fd /
# out_fd / err_fd on 0 / 1 / 2 by way of close-on-exec copies above 10, so a
# source that already sits on 0-2 (a daemonized host closed them) cannot be
# clobbered by another's dup2 — the class the 1.6.10 `_child_redirect` guarded
# one case of. Resets the signal state nft would otherwise inherit from the
# host (an ignored SIGPIPE, a blocked mask), asks to die with the host, and
# closes every other descriptor the host had open (S-9).
fn _nein_child_exec(in_fd: i64, out_fd: i64, err_fd: i64, argv: i64, ppid: i64) {
    var empty[8];
    store64(&empty, 0);
    sys_sigprocmask(2, &empty, 0);              # SIG_SETMASK: unblock everything
    signal_default(13);                         # SIGPIPE back to SIG_DFL
    signal_default(25);                         # SIGXFSZ back to SIG_DFL
    sys_prctl(1, 9, 0, 0, 0);                   # PR_SET_PDEATHSIG = SIGKILL
    if (sys_getppid() != ppid) { sys_exit(127); }   # host died before the prctl
    var a = sys_fcntl(in_fd, 1030, 10);         # F_DUPFD_CLOEXEC, lowest fd >= 10
    var b = sys_fcntl(out_fd, 1030, 10);
    var c = sys_fcntl(err_fd, 1030, 10);
    if (a < 0 || b < 0 || c < 0) { sys_exit(127); }
    if (sys_dup2(a, 0) < 0) { sys_exit(127); }  # dup2 clears close-on-exec on 0-2
    if (sys_dup2(b, 1) < 0) { sys_exit(127); }
    if (sys_dup2(c, 2) < 0) { sys_exit(127); }
    syscall(436, 3, 0xFFFFFFFF, 0);             # close_range(3, ~0U); best effort, Linux 5.9+
    # Single pinned absolute path — no PATH consultation (T-3).
    sys_execve(_nein_nft_path, argv, 0);
    sys_exit(127);
    return 0;
}

# Parent side: wait for the child with a deadline (S-4). A pidfd turns "the
# child exited" into a readable descriptor, so the wait can time out; on a
# timeout the child is SIGKILLed and reaped and the caller fails closed. A
# kernel without pidfd_open (< 5.3) falls back to the plain blocking wait used
# through 1.8.1. Returns what _nein_waitpid returns, or _NEIN_ETIMEDOUT.
fn _nein_wait_deadline(pid: i64, status_ptr: i64): i64 {
    var pfd = sys_pidfd_open(pid, 0);
    if (pfd >= 0) {
        var r = fd_wait_ready(pfd, 0, _NEIN_NFT_DEADLINE_MS);
        while (r == 0 - 4) { r = fd_wait_ready(pfd, 0, _NEIN_NFT_DEADLINE_MS); }   # -EINTR
        sys_close(pfd);
        if (r == 0) {
            sys_kill(pid, 9);
            _nein_waitpid(pid, status_ptr);
            return _NEIN_ETIMEDOUT;
        }
    }
    return _nein_waitpid(pid, status_ptr);
}

# A fresh close-on-exec memfd holding all of buf[0..len), rewound to 0.
# Returns the fd, or < 0. -EINTR is retried; any other short write fails.
fn _nein_memfd_with(name: cstring, buf: i64, len: i64): i64 {
    var fd = sys_memfd_create(name, 1);         # MFD_CLOEXEC
    if (fd < 0) { return fd; }
    var off = 0;
    while (off < len) {
        var n = sys_write(fd, buf + off, len - off);
        if (n == 0 - 4) { continue; }
        if (n <= 0) { sys_close(fd); return 0 - 5; }
        off = off + n;
    }
    if (sys_lseek(fd, 0, 0) != 0) { sys_close(fd); return 0 - 5; }
    return fd;
}

# Append the memfd's contents (from offset 0, at most `cap` bytes; cap < 0
# for all) to `sb`. With `flatten` set, control bytes become spaces so nft's
# stderr — which echoes rule text — cannot forge lines in a log. The child has
# exited before this runs, so a read of 0 is the end, not a pause: the
# EINTR-truncated capture of 1.8.1 (S-5) cannot happen. Returns bytes or < 0.
fn _nein_memfd_read(fd: i64, sb: i64, cap: i64, flatten: i64): i64 {
    if (sys_lseek(fd, 0, 0) != 0) { return 0 - 5; }
    var buf[4096];
    var total = 0;
    while (cap < 0 || total < cap) {
        var want = 4096;
        if (cap >= 0 && cap - total < want) { want = cap - total; }
        var n = sys_read(fd, &buf, want);
        if (n == 0 - 4) { continue; }
        if (n < 0) { return n; }
        if (n == 0) { break; }
        var i = 0;
        while (i < n) {
            var ch = load8(&buf + i);
            if (flatten == 1 && ch < 32) { ch = 32; }
            str_builder_add_byte(sb, ch);
            i = i + 1;
        }
        total = total + n;
    }
    return total;
}

# Log a failure with up to 1 KiB of nft's own stderr appended (through 1.8.1
# nft's stderr was drained and discarded, so no failure said why).
fn _nein_log_nft_failure(msg: cstring, err_fd: i64): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, msg);
    str_builder_add_cstr(sb, " | nft: ");
    _nein_memfd_read(err_fd, sb, 1024, 1);
    var line = str_data(str_builder_build(sb));
    sakshi_warn(line, strlen(line));
    return 0;
}

# The child's fate as 0 (nft exited 0) or a NEIN_ERR code. `commits` is 1
# when nft was handed a ruleset to apply (`nft -f -`) and 0 for a read
# (`nft list ...`). Where nein cannot learn what the child did — killed at the
# deadline, reaped by someone else, or dead on a signal — an apply may still
# have committed (nft sends its batch, then waits for the kernel's answer), so
# it is NEIN_ERR_OUTCOME_UNKNOWN (1.9.0, audit S-8), never a plain failure a
# caller might retry. A read changes nothing, so for it the same is a failure.
fn _nein_nft_unknown(commits: i64): i64 {
    if (commits == 1) { return NEIN_ERR_OUTCOME_UNKNOWN; }
    return NEIN_ERR_NFT_FAILED;
}

fn _nein_nft_outcome(wr: i64, status: i64, err_fd: i64, commits: i64): i64 {
    if (wr == _NEIN_ETIMEDOUT) {
        _nein_log_nft_failure("nein.apply: nft outlived its deadline and was killed", err_fd);
        return _nein_nft_unknown(commits);
    }
    # The return value MUST be checked (1.6.10, audit MEDIUM). On failure
    # waitpid does not write `status`, which stays 0 — and the stdlib decodes 0
    # as a clean exit-zero child (WIFEXITED(0)==1, WEXITSTATUS(0)==0). So an
    # unchecked wait reported a failed apply as SUCCESS. Reachable whenever the
    # host installs a SIGCHLD reaper or sets SIGCHLD to SIG_IGN, which process
    # supervisors — nein's own consumers — routinely do.
    # Through 1.8.2 this returned NFT_FAILED, which read as "nothing applied".
    if (wr < 0) {
        var sk_wait = "nein.apply: waitpid failed — child fate unknown (SIGCHLD ignored, or reaped elsewhere)";
        sakshi_error(sk_wait, strlen(sk_wait));
        return _nein_nft_unknown(commits);
    }
    if (WIFEXITED(status) == 1) {
        if (WEXITSTATUS(status) == 127) {
            var sk_perm = "nein.apply: nft exit=127 (no executable found, or child setup failed)";
            sakshi_error(sk_perm, strlen(sk_perm));
            return NEIN_ERR_PERMISSION_DENIED;
        }
        if (WEXITSTATUS(status) != 0) {
            _nein_log_nft_failure("nein.apply: nft exit nonzero", err_fd);
            return NEIN_ERR_NFT_FAILED;
        }
        var sk_ok = "nein.apply: nft exit=0";
        sakshi_info(sk_ok, strlen(sk_ok));
        return 0;
    }
    _nein_log_nft_failure("nein.apply: nft died on a signal", err_fd);
    return _nein_nft_unknown(commits);
}
#endif

# ================================================================
# Low-level: run `nft -f -` with the ruleset on stdin.
# Returns Ok(0) on exit 0, Err(NEIN_ERR_*) on refusal or failure, and
# Err(NEIN_ERR_OUTCOME_UNKNOWN) when nft ran and its fate cannot be learned.
# ================================================================

fn _run_nft_stdin(input_buf, input_len) {
    #ifdef CYRIUS_TARGET_AGNOS
    # ⛔ nft does not exist on agnos. nein's apply layer drives LINUX
    # NETFILTER by exec'ing /usr/sbin/nft; agnos is spawn-not-fork-exec and has
    # its own network stack (`sys_net_config` and peers) with no nftables at
    # all, so there is nothing to port until nein grows an agnos BACKEND — a
    # different piece of work from a syscall shim (found by daimon at 2.1.8).
    # Failing closed at the entry point, loudly and specifically, is the honest
    # behaviour: a diagnosable refusal, and the firewall is never half-applied.
    # No span is open here, so none is closed (1.8.2: the old arm called
    # sakshi_span_exit() without an enter and popped the caller's span).
    var sk_agnos = "nein.apply: no nftables backend on agnos - refusing, not half-applying";
    sakshi_error(sk_agnos, strlen(sk_agnos));
    return nein_err(NEIN_ERR_NFT_FAILED);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var sk_span_name = "nein.apply.run_nft_stdin";
    sakshi_span_enter(sk_span_name, strlen(sk_span_name));

    # nft stops parsing at the first NUL byte and exits 0, applying only what
    # came before it (S-6). Refuse instead of half-applying.
    if (memchr(input_buf, 0, input_len) >= 0) {
        var sk_nul = "nein.apply: ruleset contains a NUL byte — nft would apply only the prefix; refusing";
        sakshi_error(sk_nul, strlen(sk_nul));
        sakshi_span_exit();
        return nein_err(NEIN_ERR_INVALID_RULE);
    }

    # Kept for compatibility: the guard predates the memfd path, which writes
    # to no pipe, and is retained so a host that relied on nein's process-wide
    # SIGPIPE disposition sees no change in 1.8.2. See its note above.
    _nein_apply_sigpipe_guard();

    var in_fd = _nein_memfd_with("nein-ruleset", input_buf, input_len);
    if (in_fd < 0) {
        var sk_mfd = "nein.apply: could not stage the ruleset in a memfd";
        sakshi_error(sk_mfd, strlen(sk_mfd));
        sakshi_span_exit();
        return nein_err(NEIN_ERR_NFT_FAILED);
    }
    var err_fd = sys_memfd_create("nein-nft-stderr", 1);
    var null_fd = sys_open("/dev/null", 1 | 524288, 0);   # O_WRONLY | O_CLOEXEC
    if (err_fd < 0 || null_fd < 0) {
        sys_close(in_fd);
        if (err_fd >= 0) { sys_close(err_fd); }
        if (null_fd >= 0) { sys_close(null_fd); }
        var sk_fds = "nein.apply: could not open nft's stdout / stderr";
        sakshi_error(sk_fds, strlen(sk_fds));
        sakshi_span_exit();
        return nein_err(NEIN_ERR_NFT_FAILED);
    }

    # argv: ["nft", "-f", "-", 0], on this frame, built before the fork so the
    # child allocates nothing (S-1).
    var argv[32];
    store64(&argv, "nft");
    store64(&argv + 8, "-f");
    store64(&argv + 16, "-");
    store64(&argv + 24, 0);
    var ppid = sys_getpid();

    var pid = sys_fork();
    if (pid < 0) {
        sys_close(in_fd); sys_close(err_fd); sys_close(null_fd);
        var sk_fork_err = "nein.apply: sys_fork failed";
        sakshi_error(sk_fork_err, strlen(sk_fork_err));
        sakshi_span_exit();
        return nein_err(NEIN_ERR_NFT_FAILED);
    }
    if (pid == 0) { _nein_child_exec(in_fd, null_fd, err_fd, &argv, ppid); }

    sys_close(in_fd);
    sys_close(null_fd);
    var status = 0;
    var wr = _nein_wait_deadline(pid, &status);
    var code = _nein_nft_outcome(wr, status, err_fd, 1);
    sys_close(err_fd);
    sakshi_span_exit();
    if (code == 0) { return nein_ok(); }
    return nein_err(code);
    #endif
}

# ================================================================
# Low-level: spawn nft with args, capture stdout into a Str
# Returns Ok(stdout_str) on success, Err on failure.
# ================================================================

fn _run_nft_capture(argv, nft_path) {
    #ifdef CYRIUS_TARGET_AGNOS
    # ⛔ nft does not exist on agnos. nein's apply layer drives LINUX
    # NETFILTER by exec'ing /usr/sbin/nft; agnos is spawn-not-fork-exec and has
    # its own network stack (`sys_net_config` and peers) with no nftables at
    # all, so there is nothing to port until nein grows an agnos BACKEND — a
    # different piece of work from a syscall shim (found by daimon at 2.1.8).
    # Failing closed at the entry point, loudly and specifically, is the honest
    # behaviour: a diagnosable refusal, and the firewall is never half-applied.
    # No span is open here, so none is closed (1.8.2: the old arm called
    # sakshi_span_exit() without an enter and popped the caller's span).
    var sk_agnos = "nein.apply: no nftables backend on agnos - refusing, not half-applying";
    sakshi_error(sk_agnos, strlen(sk_agnos));
    return nein_err(NEIN_ERR_NFT_FAILED);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var sk_span_name = "nein.apply.run_nft_capture";
    sakshi_span_enter(sk_span_name, strlen(sk_span_name));

    # stdout and stderr to memfds, stdin from /dev/null (through 1.8.1 the
    # capture child read the HOST's stdin and wrote its stderr to the host's,
    # which in a stdio MCP host is the protocol stream).
    var out_fd = sys_memfd_create("nein-nft-stdout", 1);
    var err_fd = sys_memfd_create("nein-nft-stderr", 1);
    var null_fd = sys_open("/dev/null", 0 | 524288, 0);   # O_RDONLY | O_CLOEXEC
    if (out_fd < 0 || err_fd < 0 || null_fd < 0) {
        if (out_fd >= 0) { sys_close(out_fd); }
        if (err_fd >= 0) { sys_close(err_fd); }
        if (null_fd >= 0) { sys_close(null_fd); }
        var sk_pe = "nein.apply: could not open nft capture descriptors";
        sakshi_error(sk_pe, strlen(sk_pe));
        sakshi_span_exit();
        return nein_err(NEIN_ERR_NFT_FAILED);
    }

    var ppid = sys_getpid();
    var pid = sys_fork();
    if (pid < 0) {
        sys_close(out_fd); sys_close(err_fd); sys_close(null_fd);
        var sk_fe = "nein.apply: sys_fork(capture) failed";
        sakshi_error(sk_fe, strlen(sk_fe));
        sakshi_span_exit();
        return nein_err(NEIN_ERR_NFT_FAILED);
    }
    if (pid == 0) { _nein_child_exec(null_fd, out_fd, err_fd, argv, ppid); }

    sys_close(null_fd);
    var status = 0;
    var wr = _nein_wait_deadline(pid, &status);
    var code = _nein_nft_outcome(wr, status, err_fd, 0);
    sys_close(err_fd);
    if (code != 0) {
        sys_close(out_fd);
        sakshi_span_exit();
        return nein_err(code);
    }
    var sb = str_builder_new();
    var got = _nein_memfd_read(out_fd, sb, 0 - 1, 0);
    sys_close(out_fd);
    sakshi_span_exit();
    if (got < 0) { return nein_err(NEIN_ERR_NFT_FAILED); }
    return Ok(str_builder_build(sb));
    #endif
}

# ================================================================
# Build a small nft command string + deliver it over stdin
# ================================================================

fn _nft_cmd(cmd_cstr) {
    return _run_nft_stdin(cmd_cstr, strlen(cmd_cstr));
}

# ================================================================
# Public: batch operations
# ================================================================

# Apply a ruleset (Str or cstr). For Str, caller should use apply_ruleset_str.
fn apply_ruleset_cstr(ruleset_cstr: cstring): i64 {
    return _run_nft_stdin(ruleset_cstr, strlen(ruleset_cstr));
}

fn apply_ruleset_str(ruleset_str: Str): i64 {
    return _run_nft_stdin(str_data(ruleset_str), str_len(ruleset_str));
}

# Validate, render, and apply a Firewall.
#
# Honors the firewall's dry-run flag (`firewall_set_dry_run`): in dry-run the
# ruleset is still validated AND rendered — so a caller gets the same errors a
# real apply would raise — but nft is never spawned. Returns Ok(0).
#
# The flag is checked with `!= 0` rather than `== 1` deliberately: any non-zero
# value means "do not touch the live firewall". Fail-safe direction — a
# malformed flag skips the apply instead of performing one.
fn apply_firewall(fw: i64): i64 {
    var vr1_t, vr1_v = firewall_validate(fw);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    var ruleset = firewall_render(fw);
    if (firewall_dry_run(fw) != 0) {
        var sk_dry = "nein.apply: dry-run set — rendered but not applied";
        sakshi_info(sk_dry, strlen(sk_dry));
        return nein_ok();
    }
    return apply_ruleset_str(ruleset);
}

fn flush_ruleset(): i64 {
    return _nft_cmd("flush ruleset\n");
}

# ================================================================
# Public: table/chain operations
# ================================================================

fn _build_nft_line(verb, family, table, chain_or_null) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, verb);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, family);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, table);
    if (chain_or_null != 0) {
        str_builder_add_cstr(sb, " ");
        str_builder_add_cstr(sb, chain_or_null);
    }
    str_builder_add_cstr(sb, "\n");
    var s = str_builder_build(sb);
    var out = alloc(str_len(s) + 1);
    memcpy(out, str_data(s), str_len(s));
    store8(out + str_len(s), 0);
    return out;
}

fn flush_table(family: cstring, table: cstring): i64 {
    var vr1_t, vr1_v = validate_family(family);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    var vr2_t, vr2_v = validate_nft_name(table);
    if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
    return _nft_cmd(_build_nft_line("flush table", family, table, 0));
}

fn delete_table(family: cstring, table: cstring): i64 {
    var vr1_t, vr1_v = validate_family(family);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    var vr2_t, vr2_v = validate_nft_name(table);
    if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
    return _nft_cmd(_build_nft_line("delete table", family, table, 0));
}

fn flush_chain(family: cstring, table: cstring, chain: cstring): i64 {
    var vr1_t, vr1_v = validate_family(family);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    var vr2_t, vr2_v = validate_nft_name(table);
    if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
    var vr3_t, vr3_v = validate_nft_name(chain);
    if (is_err_result(vr3_t) == 1) { return Err(vr3_v); }
    return _nft_cmd(_build_nft_line("flush chain", family, table, chain));
}

fn delete_chain(family: cstring, table: cstring, chain: cstring): i64 {
    var vr1_t, vr1_v = validate_family(family);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    var vr2_t, vr2_v = validate_nft_name(table);
    if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
    var vr3_t, vr3_v = validate_nft_name(chain);
    if (is_err_result(vr3_t) == 1) { return Err(vr3_v); }
    return _nft_cmd(_build_nft_line("delete chain", family, table, chain));
}

# ================================================================
# Public: incremental rule operations
# ================================================================

# Helper: build "add rule FAM TAB CHN RULE\n" variants
fn _build_rule_line(verb_prefix, family, table, chain, rule, suffix_prefix, suffix_val) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, verb_prefix);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, family);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, table);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, chain);
    if (suffix_prefix != 0) {
        str_builder_add_cstr(sb, " ");
        str_builder_add_cstr(sb, suffix_prefix);
        str_builder_add_cstr(sb, " ");
        str_builder_add_int(sb, suffix_val);
    }
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, rule);
    str_builder_add_cstr(sb, "\n");
    var s = str_builder_build(sb);
    var out = alloc(str_len(s) + 1);
    memcpy(out, str_data(s), str_len(s));
    store8(out + str_len(s), 0);
    return out;
}

fn _validate_rule_args(family, table, chain, rule) {
    var vr1_t, vr1_v = validate_family(family);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    var vr2_t, vr2_v = validate_nft_name(table);
    if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
    var vr3_t, vr3_v = validate_nft_name(chain);
    if (is_err_result(vr3_t) == 1) { return Err(vr3_v); }
    var vr4_t, vr4_v = validate_nft_element(rule);
    if (is_err_result(vr4_t) == 1) { return Err(vr4_v); }
    return nein_ok();
}

# add rule FAM TAB CHN RULE
fn add_rule_live(family: cstring, table: cstring, chain: cstring, rule: cstring): i64 {
    var vr1_t, vr1_v = _validate_rule_args(family, table, chain, rule);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    return _nft_cmd(_build_rule_line("add rule", family, table, chain, rule, 0, 0));
}

# insert rule FAM TAB CHN RULE (prepends)
fn insert_rule_live(family: cstring, table: cstring, chain: cstring, rule: cstring): i64 {
    var vr1_t, vr1_v = _validate_rule_args(family, table, chain, rule);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    return _nft_cmd(_build_rule_line("insert rule", family, table, chain, rule, 0, 0));
}

# add rule FAM TAB CHN position POS RULE
fn add_rule_after_live(family: cstring, table: cstring, chain: cstring, position_handle: i64, rule: cstring): i64 {
    var vr1_t, vr1_v = _validate_rule_args(family, table, chain, rule);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    return _nft_cmd(_build_rule_line("add rule", family, table, chain, rule, "position", position_handle));
}

# replace rule FAM TAB CHN handle H RULE
fn replace_rule_live(family: cstring, table: cstring, chain: cstring, handle: i64, new_rule: cstring): i64 {
    var vr1_t, vr1_v = _validate_rule_args(family, table, chain, new_rule);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    return _nft_cmd(_build_rule_line("replace rule", family, table, chain, new_rule, "handle", handle));
}

# delete rule FAM TAB CHN handle H
fn delete_rule_live(family: cstring, table: cstring, chain: cstring, handle: i64): i64 {
    var vr1_t, vr1_v = validate_family(family);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    var vr2_t, vr2_v = validate_nft_name(table);
    if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
    var vr3_t, vr3_v = validate_nft_name(chain);
    if (is_err_result(vr3_t) == 1) { return Err(vr3_v); }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "delete rule ");
    str_builder_add_cstr(sb, family);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, table);
    str_builder_add_cstr(sb, " ");
    str_builder_add_cstr(sb, chain);
    str_builder_add_cstr(sb, " handle ");
    str_builder_add_int(sb, handle);
    str_builder_add_cstr(sb, "\n");
    var s = str_builder_build(sb);
    var cstr = alloc(str_len(s) + 1);
    memcpy(cstr, str_data(s), str_len(s));
    store8(cstr + str_len(s), 0);
    return _nft_cmd(cstr);
}

# ================================================================
# Public: list / inspect
# ================================================================

fn list_ruleset(): i64 {
    var argv = alloc(32);
    store64(argv, "nft");
    store64(argv + 8, "list");
    store64(argv + 16, "ruleset");
    store64(argv + 24, 0);
    return _run_nft_capture(argv, 0);
}

fn list_ruleset_with_handles(): i64 {
    var argv = alloc(40);
    store64(argv, "nft");
    store64(argv + 8, "-a");
    store64(argv + 16, "list");
    store64(argv + 24, "ruleset");
    store64(argv + 32, 0);
    return _run_nft_capture(argv, 0);
}

# `nft -a list table FAMILY TABLE` — handles, scoped to one table.
#
# The scoped form matters for the comment-keyed handle lookup
# (`find_rules_by_comment` in diff.cyr): listing one table instead of the whole
# ruleset keeps the parse bounded and stops a match in an unrelated table from
# ever entering the result set. Both names are validated before they reach
# argv — they are operator-supplied and land in an execve argument vector.
fn list_table_with_handles(family: cstring, table: cstring): i64 {
    var vr1_t, vr1_v = validate_family(family);
    if (is_err_result(vr1_t) == 1) { return Err(vr1_v); }
    var vr2_t, vr2_v = validate_nft_name(table);
    if (is_err_result(vr2_t) == 1) { return Err(vr2_v); }
    # `list table` reads the name in a scope of its own, where `rules`,
    # `tables`, `count`, ... are keywords (1.9.1): refused here, not by nft
    # with a syntax error after the fork.
    if (_nft_list_keyword(table) == 1) { return nein_err(NEIN_ERR_INVALID_RULE); }

    var argv = alloc(56);
    store64(argv, "nft");
    store64(argv + 8, "-a");
    store64(argv + 16, "list");
    store64(argv + 24, "table");
    store64(argv + 32, family);
    store64(argv + 40, table);
    store64(argv + 48, 0);
    return _run_nft_capture(argv, 0);
}
